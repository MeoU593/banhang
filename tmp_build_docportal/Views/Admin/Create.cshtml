@model Nop.Plugin.Misc.DocumentPortal.Models.Admin.DocumentModel

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = "Thêm tài liệu";
}

<form asp-controller="DocumentPortalAdmin" asp-action="Create" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">Thêm tài liệu mới</h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i> Lưu
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-save"></i> Lưu &amp; tiếp tục
            </button>
            <a asp-action="List" class="btn btn-default">
                <i class="fas fa-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>
    @await Html.PartialAsync("~/Plugins/Misc.DocumentPortal/Views/Admin/_CreateOrUpdate.cshtml", Model)
</form>
