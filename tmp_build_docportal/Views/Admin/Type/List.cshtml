@model IList<Nop.Plugin.Misc.DocumentPortal.Domain.DocumentType>

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = "Loại tài liệu";
}

<div class="content-header clearfix">
    <h1 class="float-left">Loại tài liệu</h1>
    <div class="float-right">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i>
            Thêm loại tài liệu
        </a>
    </div>
</div>

<div class="card card-default">
    <div class="card-body table-responsive p-0">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th style="width: 80px;">ID</th>
                    <th>Tên loại</th>
                    <th>Mô tả</th>
                    <th style="width: 120px;" class="text-center">Thứ tự</th>
                    <th style="width: 160px;" class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center py-3">Không có dữ liệu</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>@item.Description</td>
                        <td class="text-center">@item.DisplayOrder</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary mr-1">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa loại tài liệu này?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
