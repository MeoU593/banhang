@model Nop.Plugin.Misc.DocumentPortal.Models.Admin.ConfigurationModel

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = "Cài đặt Kho tài liệu";
}

<form asp-controller="DocumentPortalAdmin" asp-action="Settings" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">Cài đặt Kho tài liệu</h1>
        <div class="float-right">
            <button type="submit" class="btn btn-primary">
                <i class="far fa-save"></i> Lưu
            </button>
        </div>
    </div>
    <nop-card asp-name="documentportal-settings" asp-icon="fas fa-cogs" asp-title="Cài đặt chung"
              asp-hide-block-attribute-name="DocumentPortal.HideSettingsBlock" asp-hide="false">
        <div class="form-group row">
            <div class="col-md-3"><nop-label asp-for="DefaultPageSize" /></div>
            <div class="col-md-9"><nop-editor asp-for="DefaultPageSize" /></div>
        </div>
        <div class="form-group row">
            <div class="col-md-3"><nop-label asp-for="SearchInContent" /></div>
            <div class="col-md-9"><nop-editor asp-for="SearchInContent" /></div>
        </div>
        <div class="form-group row">
            <div class="col-md-3"><nop-label asp-for="ShowRelatedDocuments" /></div>
            <div class="col-md-9"><nop-editor asp-for="ShowRelatedDocuments" /></div>
        </div>
        <div class="form-group row">
            <div class="col-md-3"><nop-label asp-for="ShowDownloadCount" /></div>
            <div class="col-md-9"><nop-editor asp-for="ShowDownloadCount" /></div>
        </div>
        <div class="form-group row">
            <div class="col-md-3"><nop-label asp-for="AutoGenerateSlug" /></div>
            <div class="col-md-9"><nop-editor asp-for="AutoGenerateSlug" /></div>
        </div>
        <div class="form-group row">
            <div class="col-md-3"><nop-label asp-for="RequireLoginForPrivateDocuments" /></div>
            <div class="col-md-9"><nop-editor asp-for="RequireLoginForPrivateDocuments" /></div>
        </div>
    </nop-card>
</form>
