@model HomepageNewsItemsModel

<link href="~/Plugins/Misc.News/Content/styles.css" rel="stylesheet">

@if (Model.NewsItems.Any())
{
    var previewNews = Model.NewsItems.Take(4).ToList();
    var hiddenNewsCount = Model.NewsItems.Count - previewNews.Count;

    <div class="space-y-3">
        @foreach (var item in previewNews)
        {
            var newsUrl = await NopUrl.RouteGenericUrlAsync<NewsItem>(new { SeName = item.SeName });

            <div class="group flex gap-4 rounded-xl border border-outline-variant/20 bg-surface-container-low p-4 transition hover:bg-surface-container cursor-pointer">
                <div class="flex-1 min-w-0 flex flex-col justify-center">
                    <time datetime="@item.CreatedOn.ToString("yyyy-MM-dd")" class="text-[10px] font-bold uppercase tracking-widest text-military-green/60 mb-1">@item.CreatedOn.ToString("dd/MM/yyyy")</time>
                    <h3 class="text-sm font-bold leading-snug text-on-surface line-clamp-2 transition group-hover:text-military-green">
                        <a href="@newsUrl">@item.Title</a>
                    </h3>
                </div>
                <div class="flex shrink-0 items-center">
                    <a href="@newsUrl" class="inline-flex items-center gap-1 rounded-lg bg-surface-container-highest px-2.5 py-1.5 text-[11px] font-bold text-on-surface-variant transition group-hover:bg-military-green group-hover:text-white">
                        <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                    </a>
                </div>
            </div>
        }

        <div class="flex items-center justify-between rounded-lg border border-outline-variant/20 bg-surface-container px-4 py-2.5 text-xs text-on-surface-variant">
            @if (hiddenNewsCount > 0)
            {
                <span>Còn @hiddenNewsCount bài khác</span>
            }
            else
            {
                <span>Toàn bộ bài đăng</span>
            }
            <a href="@Url.RouteUrl(NewsDefaults.Routes.Public.NewsArchive)" class="font-bold text-military-green hover:underline transition">
                @T("Plugins.Misc.News.ViewAll") →
            </a>
        </div>
    </div>
}
else
{
    <div class="flex flex-col items-center justify-center rounded-xl border border-dashed border-outline-variant bg-surface-container/50 px-6 py-10 text-center">
        <span class="material-symbols-outlined mb-3 text-4xl text-on-surface-variant">article</span>
        <p class="text-sm font-semibold text-on-surface-variant">Chưa có bản tin nào được xuất bản</p>
        @if (User.IsInRole("Administrators"))
        {
            <a href="/Admin/NewsAdmin/NewsItems" class="mt-3 inline-flex items-center gap-1 rounded-lg border border-outline-variant bg-surface-container-lowest px-4 py-2 text-xs font-semibold text-on-surface-variant transition hover:border-military-green hover:text-military-green">
                <span class="material-symbols-outlined" style="font-size:14px">add</span>
                Thêm tin tức
            </a>
        }
    </div>
}
