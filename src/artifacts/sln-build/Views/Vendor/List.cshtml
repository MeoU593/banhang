@model Nop.Plugin.Misc.DocumentPortal.Models.Vendor.VendorDocumentSearchModel
@using Nop.Web.Framework.Models.DataTables

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = "Tài liệu đơn vị";
}

<div class="content-header clearfix">
    <h1 class="float-left">
        <i class="fas fa-folder-open mr-1"></i>
        Tài liệu đơn vị: @Model.VendorName
    </h1>
</div>

<nop-card asp-name="vendor-doc-search" asp-icon="fas fa-search" asp-title="Tìm kiếm"
          asp-hide-block-attribute-name="DocumentPortal.HideVendorSearchBlock" asp-hide="false">
    <div class="row search-row">
        <div class="col-md-4">
            <div class="form-group">
                <label>Từ khóa</label>
                <nop-editor asp-for="SearchKeywords" />
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label>Danh mục</label>
                <nop-select asp-for="SearchCategoryId" asp-items="Model.AvailableCategories" />
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label>Loại tài liệu</label>
                <nop-select asp-for="SearchTypeId" asp-items="Model.AvailableTypes" />
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <label>Trạng thái</label>
                <nop-select asp-for="SearchPublishedId" asp-items="Model.AvailablePublishedOptions" />
            </div>
        </div>
    </div>
    <div class="row mt-2">
        <div class="col-md-12 text-center">
            <button type="button" id="search-vendor-docs" class="btn btn-primary">
                <i class="fas fa-search"></i> Tìm kiếm
            </button>
        </div>
    </div>
</nop-card>

<nop-card asp-name="vendor-doc-list" asp-icon="far fa-file-alt" asp-title="Danh sách tài liệu của đơn vị"
          asp-hide-block-attribute-name="DocumentPortal.HideVendorListBlock" asp-hide="false">
    @await Html.PartialAsync("Table", new DataTablesModel
    {
        Name = "vendor-docs-grid",
        UrlRead = new DataUrl("List", "DocumentPortalVendor", null),
        SearchButtonId = "search-vendor-docs",
        Length = Model.PageSize,
        LengthMenu = Model.AvailablePageSizes,
        Filters = new List<FilterParameter>
        {
            new FilterParameter(nameof(Model.SearchKeywords)),
            new FilterParameter(nameof(Model.SearchCategoryId)),
            new FilterParameter(nameof(Model.SearchTypeId)),
            new FilterParameter(nameof(Model.SearchPublishedId))
        },
        ColumnCollection = new List<ColumnProperty>
        {
            new ColumnProperty(nameof(Nop.Plugin.Misc.DocumentPortal.Models.Admin.DocumentModel.Id)) { Title = "ID", Width = "60" },
            new ColumnProperty(nameof(Nop.Plugin.Misc.DocumentPortal.Models.Admin.DocumentModel.Title)) { Title = "Tiêu đề" },
            new ColumnProperty(nameof(Nop.Plugin.Misc.DocumentPortal.Models.Admin.DocumentModel.Code)) { Title = "Mã", Width = "120" },
            new ColumnProperty(nameof(Nop.Plugin.Misc.DocumentPortal.Models.Admin.DocumentModel.Published))
            {
                Title = "Xuất bản", Width = "90",
                ClassName = NopColumnClassDefaults.CenterAll,
                Render = new RenderBoolean()
            },
            new ColumnProperty(nameof(Nop.Plugin.Misc.DocumentPortal.Models.Admin.DocumentModel.ViewCount)) { Title = "Lượt xem", Width = "90", ClassName = NopColumnClassDefaults.CenterAll },
            new ColumnProperty(nameof(Nop.Plugin.Misc.DocumentPortal.Models.Admin.DocumentModel.DownloadCount)) { Title = "Lượt tải", Width = "90", ClassName = NopColumnClassDefaults.CenterAll },
            @if (Model.IsVendorManager)
            {
                <text>
                new ColumnProperty(nameof(Nop.Plugin.Misc.DocumentPortal.Models.Admin.DocumentModel.Id))
                {
                    Title = "Xóa", Width = "80",
                    ClassName = NopColumnClassDefaults.Button,
                    Render = new RenderButtonRemove(new DataUrl("Delete"))
                }
                </text>
            }
        }
    })
</nop-card>
