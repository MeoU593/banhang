@model IList<ReportPeriod>
@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = "Kỳ báo cáo";
}

<div class="content-header clearfix">
    <h1 class="float-left">Kỳ báo cáo</h1>
    <div class="float-right">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i>
            Tạo kỳ báo cáo
        </a>
    </div>
</div>

<div class="card card-default">
    <div class="card-body table-responsive p-0">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Mã</th>
                    <th>Tên</th>
                    <th>Mẫu báo cáo</th>
                    <th>Từ ngày</th>
                    <th>Đến ngày</th>
                    <th>Hạn nộp</th>
                    <th>Trạng thái</th>
                    <th class="text-center">Sửa</th>
                    <th class="text-center">Tạo báo cáo đơn vị</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="10" class="text-center py-3">Không có dữ liệu</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Code</td>
                        <td>@item.Name</td>
                        <td>@item.ReportTemplateId</td>
                        <td>@item.FromDateUtc.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.ToDateUtc.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.DeadlineUtc.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@((ReportPeriodStatus)item.StatusId)</td>
                        <td class="text-center"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Sửa</a></td>
                        <td class="text-center">
                            <form method="post" asp-action="GenerateUnitReports">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">Tạo</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
