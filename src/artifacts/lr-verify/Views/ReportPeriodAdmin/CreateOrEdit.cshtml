@model Nop.Plugin.Misc.LogisticsReports.Models.ReportPeriods.ReportPeriodModel
@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = Model.Id == 0 ? "Tạo kỳ báo cáo" : "Sửa kỳ báo cáo";
}

<div class="content-header clearfix">
    <h1 class="float-left">@ViewBag.PageTitle</h1>
</div>

<div class="card card-default">
    <div class="card-body">
        <form method="post">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group"><label asp-for="ReportTemplateId">Mẫu báo cáo</label><input asp-for="ReportTemplateId" class="form-control" /></div>
            <div class="form-group"><label asp-for="Code">Mã</label><input asp-for="Code" class="form-control" /><span asp-validation-for="Code" class="text-danger"></span></div>
            <div class="form-group"><label asp-for="Name">Tên</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
            <div class="form-group"><label asp-for="PeriodTypeId">Loại kỳ</label><input asp-for="PeriodTypeId" class="form-control" /></div>
            <div class="form-group"><label asp-for="FromDateUtc">Từ ngày</label><input asp-for="FromDateUtc" type="datetime-local" class="form-control" /></div>
            <div class="form-group"><label asp-for="ToDateUtc">Đến ngày</label><input asp-for="ToDateUtc" type="datetime-local" class="form-control" /></div>
            <div class="form-group"><label asp-for="DeadlineUtc">Hạn nộp</label><input asp-for="DeadlineUtc" type="datetime-local" class="form-control" /></div>
            <div class="form-group"><label asp-for="StatusId">Trạng thái</label><input asp-for="StatusId" class="form-control" /></div>
            <div class="form-check mb-3"><input asp-for="IsLocked" class="form-check-input" /><label asp-for="IsLocked" class="form-check-label">Khóa kỳ báo cáo</label></div>

            <button type="submit" class="btn btn-primary">Lưu</button>
            <a asp-action="List" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</div>
