@model IList<Nop.Plugin.Misc.LogisticsReports.Models.Organizations.CustomerOrganizationUnitModel>
@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = "Ánh xạ người dùng - đơn vị";
}

<div class="content-header clearfix">
    <h1 class="float-left">Ánh xạ người dùng - đơn vị</h1>
    <div class="float-right">
        <a class="btn btn-primary" href="@Url.Action("Create")">
            <i class="fas fa-plus"></i>
            Thêm ánh xạ
        </a>
    </div>
</div>

<div class="card card-default">
    <div class="card-body table-responsive p-0">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Người dùng</th>
                    <th>Đơn vị</th>
                    <th>Chính</th>
                    <th>Nhập liệu</th>
                    <th>Duyệt cấp dưới</th>
                    <th>Gửi báo cáo</th>
                    <th>Khóa</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center py-3">Không có dữ liệu</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CustomerDisplay</td>
                        <td>@item.OrganizationDisplay</td>
                        <td>@(item.IsPrimary ? "Có" : "Không")</td>
                        <td>@(item.CanInputReport ? "Có" : "Không")</td>
                        <td>@(item.CanReviewChildReports ? "Có" : "Không")</td>
                        <td>@(item.CanSubmitReport ? "Có" : "Không")</td>
                        <td>@(item.CanLockReport ? "Có" : "Không")</td>
                        <td class="text-center">
                            <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Edit", new { id = item.Id })">Sửa</a>
                            <form method="post" action="@Url.Action("Delete", new { id = item.Id })" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa ánh xạ này?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
