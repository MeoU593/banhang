@model Nop.Plugin.Misc.LogisticsReports.Models.Organizations.OrganizationUnitModel
@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = Model.Id == 0 ? "Tạo đơn vị" : "Sửa đơn vị";
}

<div class="content-header clearfix">
    <h1 class="float-left">@ViewBag.PageTitle</h1>
</div>

<div class="card card-default">
    <div class="card-body">
        <form method="post">
            <input asp-for="Id" type="hidden" />
            <input asp-for="IsRootUnit" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group">
                <label asp-for="Code">Mã</label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Name">Tên</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            @if (Model.IsRootUnit)
            {
                <div class="form-group">
                    <label>Đơn vị cấp trên</label>
                    <input class="form-control" value="(Đơn vị gốc)" disabled />
                </div>
            }
            else
            {
                <div class="form-group">
                    <label asp-for="ParentId">Đơn vị cấp trên</label>
                    <select asp-for="ParentId" asp-items="Model.AvailableParentUnits" class="form-control"></select>
                    <span asp-validation-for="ParentId" class="text-danger"></span>
                </div>
            }
            <div class="form-group">
                <label asp-for="DisplayOrder">Thứ tự hiển thị</label>
                <input asp-for="DisplayOrder" class="form-control" />
            </div>
            <div class="form-check mb-3">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Kích hoạt</label>
            </div>

            <button type="submit" class="btn btn-primary">Lưu</button>
            <a asp-action="List" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</div>
