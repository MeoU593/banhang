@model Nop.Plugin.Misc.LogisticsReports.Models.UnitReports.UnitReportIndexModel
@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = "Báo cáo đơn vị";
}

<div class="content-header clearfix">
    <h1 class="float-left">Báo cáo đơn vị</h1>
</div>

<div class="card card-default">
    <div class="card-body">
        <form method="get" class="row align-items-end">
            <div class="form-group col-md-6 col-lg-4">
                <label>Kỳ báo cáo</label>
                <select name="reportPeriodId" class="form-control" onchange="this.form.submit()">
                    @foreach (var item in Model.ReportPeriods)
                    {
                        <option value="@item.Id" selected="@(Model.SelectedReportPeriodId == item.Id)">@item.Name</option>
                    }
                </select>
            </div>
        </form>
    </div>
</div>

<div class="card card-default">
    <div class="card-body table-responsive p-0">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Đơn vị</th>
                    <th>Trạng thái</th>
                    <th>Ngày gửi</th>
                    <th>Ngày tổng hợp</th>
                    <th class="text-center">Mở</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Items.Any())
            {
                <tr>
                    <td colspan="6" class="text-center py-3">Không có dữ liệu</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.OrganizationUnitName</td>
                        <td>@item.Status</td>
                        <td>@(item.SubmittedOnUtc?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                        <td>@(item.LastAggregatedOnUtc?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                        <td class="text-center"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Mở</a></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
