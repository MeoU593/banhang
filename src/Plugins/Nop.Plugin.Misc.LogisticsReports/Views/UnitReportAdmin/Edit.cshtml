@model Nop.Plugin.Misc.LogisticsReports.Models.UnitReports.UnitReportEditModel
@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = "Chi tiết báo cáo đơn vị";
}

<div class="content-header clearfix">
    <h1 class="float-left">Chi tiết báo cáo đơn vị</h1>
</div>

<div class="alert alert-info">
    <strong>Kỳ báo cáo:</strong> @Model.ReportPeriodName<br />
    <strong>Đơn vị:</strong> @Model.VendorName<br />
    <strong>Trạng thái:</strong> @Model.Status
</div>

<div class="card card-default">
    <div class="card-body">
    @if (Model.CanImport)
    {
        <form method="post" asp-action="Import" enctype="multipart/form-data" class="mb-3">
            <input asp-for="Id" type="hidden" />
            <div class="form-row align-items-end">
                <div class="col-md-5 mb-2">
                    <label asp-for="ImportFile">Tệp nhập liệu</label>
                    <input asp-for="ImportFile" type="file" class="form-control" />
                </div>
                <div class="col-md-3 mb-2">
                    <button type="submit" class="btn btn-outline-secondary">Nhập từ Excel</button>
                </div>
            </div>
        </form>
    }

    @if (Model.CanAggregate)
    {
        <form method="post" asp-action="Aggregate" class="d-inline">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-outline-secondary">Tổng hợp từ đơn vị con</button>
        </form>
    }

    @if (Model.CanSubmit)
    {
        <form method="post" asp-action="Submit" class="d-inline">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-primary">Gửi báo cáo</button>
        </form>
    }

    @if (Model.CanLock)
    {
        <form method="post" asp-action="Lock" class="d-inline">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">Khóa</button>
        </form>
    }
    </div>
</div>

<div class="card card-default">
<div class="card-body table-responsive p-0">
<form method="post" asp-action="Save">
    <input asp-for="Id" type="hidden" />
    <table class="table table-striped table-hover mb-0">
        <thead>
        <tr>
            <th>Mã</th>
            <th>Tên chỉ tiêu</th>
            <th>Đơn vị</th>
            <th>Tự nhập</th>
            <th>Tổng hợp con</th>
            <th>Điều chỉnh</th>
            <th>Kết quả</th>
            <th>Ghi chú</th>
        </tr>
        </thead>
        <tbody>
        @for (var i = 0; i < Model.Values.Count; i++)
        {
            <tr>
                <td>
                    @Model.Values[i].IndicatorCode
                    <input asp-for="Values[i].Id" type="hidden" />
                    <input asp-for="Values[i].ReportIndicatorId" type="hidden" />
                    <input asp-for="Values[i].IndicatorCode" type="hidden" />
                    <input asp-for="Values[i].IndicatorName" type="hidden" />
                    <input asp-for="Values[i].UnitOfMeasure" type="hidden" />
                </td>
                <td>@Model.Values[i].IndicatorName</td>
                <td>@Model.Values[i].UnitOfMeasure</td>
                <td><input asp-for="Values[i].SelfValueNumber" class="form-control" readonly="@(Model.CanSave ? null : "readonly")" /></td>
                <td>@Model.Values[i].ChildAggregateValueNumber</td>
                <td><input asp-for="Values[i].AdjustmentValueNumber" class="form-control" readonly="@(Model.CanSave ? null : "readonly")" /></td>
                <td>@Model.Values[i].FinalValueNumber</td>
                <td><input asp-for="Values[i].Note" class="form-control" readonly="@(Model.CanSave ? null : "readonly")" /></td>
            </tr>
        }
        </tbody>
    </table>
    <div class="p-3">
        @if (Model.CanSave)
        {
            <button type="submit" class="btn btn-primary">Lưu dữ liệu</button>
        }
        <a asp-action="Index" asp-route-reportPeriodId="@Model.ReportPeriodId" class="btn btn-secondary">Quay lại</a>
    </div>
</form>
</div>
</div>

@if (Model.CanReturn)
{
    <hr />
    <form method="post" asp-action="Return">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="form-group">
            <label asp-for="ReturnReason">Lý do trả lại</label>
            <textarea asp-for="ReturnReason" class="form-control" required></textarea>
        </div>
        <button type="submit" class="btn btn-warning">Trả về đơn vị cấp dưới</button>
    </form>
}
