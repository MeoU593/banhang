@model IList<OrganizationUnit>
@{ 
    Layout = "_AdminLayout";
    ViewBag.PageTitle = "Đơn vị";
    var organizationLookup = Model.ToDictionary(x => x.Id, x => x.Name);
}

<div class="content-header clearfix">
    <h1 class="float-left">Đơn vị</h1>
    <div class="float-right">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i>
            Tạo đơn vị
        </a>
    </div>
</div>

<div class="card card-default">
    <div class="card-body table-responsive p-0">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Mã</th>
                    <th>Tên</th>
                    <th>Đơn vị cấp trên</th>
                    <th>Cấp</th>
                    <th>Path</th>
                    <th>Kích hoạt</th>
                    <th class="text-center">Sửa</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center py-3">Không có dữ liệu</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    var isRootUnit = !item.ParentId.HasValue;
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Code</td>
                        <td>@item.Name</td>
                        <td>@(item.ParentId.HasValue && organizationLookup.TryGetValue(item.ParentId.Value, out var parentName) ? parentName : "-")</td>
                        <td>@item.Level</td>
                        <td>@item.Path</td>
                        <td>@(item.IsActive ? "Có" : "Không")</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary mr-1">Sửa</a>
                            @if (isRootUnit)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" disabled title="Không thể xóa đơn vị gốc">Xóa</button>
                            }
                            else
                            {
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa đơn vị này?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
