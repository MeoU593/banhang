@model List<Nop.Plugin.Misc.LogisticsReports.Models.VendorStaff.VendorStaffAccessModel>

@{
    Layout = "_AdminLayout";
    ViewBag.Title = "Cấp quyền nhân viên";
}

<div class="content-header clearfix">
    <h1 class="float-left">Cấp quyền truy cập nhân viên</h1>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-default">
            <div class="card-header">
                <h3 class="card-title">Danh sách nhân viên trong đơn vị</h3>
            </div>
            <div class="card-body">
                <p class="text-muted">
                    Nhân viên có quyền truy cập sẽ có thể đăng nhập vào khu vực quản lý đơn vị.
                    Bạn không thể thay đổi quyền của chính mình (trưởng đơn vị).
                </p>
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>Họ tên</th>
                            <th>Vai trò</th>
                            <th>Trạng thái</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Email</td>
                                <td>@item.FullName</td>
                                <td>
                                    @if (item.IsLeader)
                                    {
                                        <span class="badge badge-primary">Trưởng đơn vị</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">Nhân viên</span>
                                    }
                                </td>
                                <td>
                                    @if (item.HasAccess)
                                    {
                                        <span class="badge badge-success">Có quyền truy cập</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">Chưa có quyền</span>
                                    }
                                </td>
                                <td>
                                    @if (!item.IsLeader)
                                    {
                                        if (item.HasAccess)
                                        {
                                            <form asp-action="RevokeAccess" method="post" style="display:inline">
                                                <input type="hidden" name="customerId" value="@item.CustomerId" />
                                                <button type="submit" class="btn btn-sm btn-danger"
                                                        onclick="return confirm('Thu hồi quyền truy cập của @item.Email?')">
                                                    Thu hồi
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="GrantAccess" method="post" style="display:inline">
                                                <input type="hidden" name="customerId" value="@item.CustomerId" />
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    Cấp quyền
                                                </button>
                                            </form>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
