@model Nop.Plugin.Misc.DocumentPortal.Models.Public.DocumentListPageModel
@using Nop.Plugin.Misc.DocumentPortal

@{
    Layout = "_ColumnsOne";
    var dateFromQuery = Model.Search.DateFrom?.ToString("yyyy-MM-dd") ?? string.Empty;
    var dateToQuery = Model.Search.DateTo?.ToString("yyyy-MM-dd") ?? string.Empty;
}

@section Breadcrumb
{
    <nav class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.14em] text-slate-500" aria-label="Breadcrumb">
        <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="transition hover:text-military-green">Trang chủ</a>
        <span class="material-symbols-outlined text-sm text-slate-400">chevron_right</span>
        <span class="text-slate-700">Kho tài liệu</span>
    </nav>
}

<div class="page document-portal-page py-2">
    <div class="page-body space-y-6">

        <section class="mb-2 overflow-hidden rounded-2xl border border-[#d6b95a]/30 bg-[linear-gradient(120deg,#29313a_0%,#574500_52%,#8a6a2a_100%)] p-5 text-white shadow-[0_24px_60px_-35px_rgba(15,23,42,0.85)] sm:p-6">
            <div class="flex flex-wrap items-start justify-between gap-4">
                <div class="space-y-1.5">
                    <h1 class="public-hero-title font-black tracking-tight text-white">Hệ thống văn bản pháp quy hậu cần</h1>
                    <p class="text-xs leading-5 text-slate-200 sm:text-sm">Tra cứu, lưu trữ và quản lý tập trung các văn bản hậu cần.</p>
                </div>
                <div class="rounded-xl border border-white/20 bg-white/10 px-4 py-3 text-center backdrop-blur">
                    <p class="text-[11px] uppercase tracking-[0.14em] text-slate-200">Tài liệu</p>
                    <p class="mt-1 text-base font-black sm:text-lg">@Model.TotalCount</p>
                </div>
            </div>
        </section>

        <div class="grid gap-4 lg:grid-cols-[280px_1fr]">

            <aside class="space-y-3 lg:sticky lg:top-6 lg:self-start">
                <div class="border border-slate-200 bg-white p-3 shadow-sm">
                    <h3 class="mb-2.5 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-900">Bộ lọc</h3>
                    <form method="get" action="/tai-lieu/tim-kiem" class="space-y-2">
                        <label class="block space-y-0.5">
                            <span class="text-[9px] font-bold uppercase tracking-[0.08em] text-slate-500">Danh mục</span>
                            <select name="categoryId" asp-items="Model.AvailableCategories" class="h-8 w-full rounded-md border border-slate-200 bg-slate-50 px-2 text-xs text-slate-700 outline-none transition focus:border-military-green focus:bg-white focus:ring-2 focus:ring-military-green/10"></select>
                        </label>
                        <label class="block space-y-0.5">
                            <span class="text-[9px] font-bold uppercase tracking-[0.08em] text-slate-500">Loại tài liệu</span>
                            <select name="typeId" asp-items="Model.AvailableTypes" class="h-8 w-full rounded-md border border-slate-200 bg-slate-50 px-2 text-xs text-slate-700 outline-none transition focus:border-military-green focus:bg-white focus:ring-2 focus:ring-military-green/10"></select>
                        </label>
                        <label class="block space-y-0.5">
                            <span class="text-[9px] font-bold uppercase tracking-[0.08em] text-slate-500">Cơ quan ban hành</span>
                            <select name="issuerId" asp-items="Model.AvailableIssuers" class="h-8 w-full rounded-md border border-slate-200 bg-slate-50 px-2 text-xs text-slate-700 outline-none transition focus:border-military-green focus:bg-white focus:ring-2 focus:ring-military-green/10"></select>
                        </label>
                        <label class="block space-y-0.5">
                            <span class="text-[9px] font-bold uppercase tracking-[0.08em] text-slate-500">Từ ngày</span>
                            <input type="date" name="dateFrom" value="@dateFromQuery" class="h-8 w-full rounded-md border border-slate-200 bg-slate-50 px-2 text-xs text-slate-700 outline-none transition focus:border-military-green focus:bg-white focus:ring-2 focus:ring-military-green/10" />
                        </label>
                        <label class="block space-y-0.5">
                            <span class="text-[9px] font-bold uppercase tracking-[0.08em] text-slate-500">Đến ngày</span>
                            <input type="date" name="dateTo" value="@dateToQuery" class="h-8 w-full rounded-md border border-slate-200 bg-slate-50 px-2 text-xs text-slate-700 outline-none transition focus:border-military-green focus:bg-white focus:ring-2 focus:ring-military-green/10" />
                        </label>

                        <div class="space-y-1 border-t border-slate-100 pt-2">
                            <button type="submit" class="flex h-8 w-full items-center justify-center gap-1 rounded-md bg-military-green px-2 text-[10px] font-bold text-white shadow-sm transition hover:bg-military-green/90">
                                <span class="material-symbols-outlined text-[14px]">filter_alt</span>
                                Áp dụng
                            </button>
                            @if (Model.Search.CategoryId.HasValue || Model.Search.TypeId.HasValue || Model.Search.IssuerId.HasValue || Model.Search.DateFrom.HasValue || Model.Search.DateTo.HasValue || !string.IsNullOrWhiteSpace(Model.Search.Q))
                            {
                                <a href="/tai-lieu" class="flex h-7 items-center justify-center rounded-md text-[9px] font-bold uppercase tracking-[0.08em] text-slate-500 transition hover:bg-slate-50 hover:text-military-green">Xóa bộ lọc</a>
                            }
                        </div>
                    </form>
                </div>

                @if (Model.IsAuthenticated)
                {
                    <a href="/tai-lieu/upload"
                       class="flex h-9 items-center justify-center gap-2 rounded-lg border border-dashed border-military-green/35 bg-military-green/5 px-2 text-[10px] font-bold text-military-green shadow-sm transition hover:border-military-green/70 hover:bg-military-green/10">
                        <span class="material-symbols-outlined" style="font-size:16px">upload_file</span>
                        Gửi tài liệu mới
                    </a>
                }
            </aside>

            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <p class="text-sm text-on-surface-variant">
                        Tìm thấy <strong class="text-on-surface font-bold">@Model.TotalCount</strong> tài liệu
                        @if (!string.IsNullOrWhiteSpace(Model.Search.Q))
                        {
                            <span> cho "<em>@Model.Search.Q</em>"</span>
                        }
                    </p>
                </div>

                @if (!Model.Documents.Any())
                {
                    <div class="flex flex-col items-center justify-center rounded-xl border border-dashed border-outline-variant py-16 text-center">
                        <span class="material-symbols-outlined mb-3 text-5xl text-on-surface-variant">folder_off</span>
                        <p class="text-sm font-semibold text-on-surface-variant">Không tìm thấy tài liệu nào</p>
                        <a href="/tai-lieu" class="mt-3 text-xs text-military-green hover:underline">Xem tất cả tài liệu</a>
                    </div>
                }
                else
                {
                    <div class="rounded-xl border border-outline-variant/30 bg-surface-container-lowest px-4 py-3 text-xs font-semibold text-on-surface-variant shadow-sm">
                        Hiển thị @(((Model.Search.Page - 1) * Model.Search.PageSize) + 1)-@Math.Min(Model.Search.Page * Model.Search.PageSize, Model.TotalCount) trong số @Model.TotalCount tài liệu
                    </div>

                    <div class="space-y-3">
                        @foreach (var doc in Model.Documents)
                        {
                            <article class="group overflow-hidden rounded-xl border border-outline-variant/30 bg-surface-container-lowest p-5 shadow-sm transition hover:shadow-md">
                                <div class="flex items-start gap-4">
                                    <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-military-green/10">
                                        <span class="material-symbols-outlined text-military-green" style="font-size:20px">description</span>
                                    </div>
                                    <div class="min-w-0 flex-1 space-y-1.5">
                                        <div class="flex flex-wrap items-center gap-1.5">
                                            @if (!string.IsNullOrWhiteSpace(doc.Code))
                                            {
                                                <span class="rounded bg-surface-container px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-on-surface-variant">@doc.Code</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(doc.TypeName))
                                            {
                                                <span class="rounded bg-amber-50 px-2 py-0.5 text-[10px] font-semibold text-amber-700">@doc.TypeName</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(doc.CategoryName))
                                            {
                                                <span class="rounded bg-red-50 px-2 py-0.5 text-[10px] font-semibold text-red-700">@doc.CategoryName</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(doc.AccessScopeName))
                                            {
                                                <span class="rounded bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-700">@doc.AccessScopeName</span>
                                            }
                                        </div>
                                        <h2 class="public-list-title font-bold text-on-surface transition group-hover:text-military-green">
                                            <a href="/tai-lieu/@doc.Slug">@doc.Title</a>
                                        </h2>
                                        @if (!string.IsNullOrWhiteSpace(doc.Summary))
                                        {
                                            <p class="line-clamp-2 text-xs leading-5 text-on-surface-variant">@doc.Summary</p>
                                        }
                                        <div class="flex flex-wrap items-center gap-3 text-xs text-on-surface-variant">
                                            @if (doc.IssuedDate.HasValue)
                                            {
                                                <span class="flex items-center gap-1">
                                                    <span class="material-symbols-outlined text-military-green" style="font-size:13px">calendar_today</span>
                                                    @doc.IssuedDate.Value.ToString("dd/MM/yyyy")
                                                </span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(doc.IssuerName))
                                            {
                                                <span class="flex items-center gap-1">
                                                    <span class="material-symbols-outlined text-military-green" style="font-size:13px">account_balance</span>
                                                    @doc.IssuerName
                                                </span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(doc.OwnerVendorName))
                                            {
                                                <span class="flex items-center gap-1">
                                                    <span class="material-symbols-outlined text-military-green" style="font-size:13px">corporate_fare</span>
                                                    @doc.OwnerVendorName
                                                </span>
                                            }
                                            <span class="flex items-center gap-1">
                                                <span class="material-symbols-outlined" style="font-size:13px">download</span>
                                                @doc.DownloadCount lượt tải
                                            </span>
                                        </div>
                                    </div>
                                    <div class="flex flex-shrink-0 items-center gap-2">
                                        <a href="/tai-lieu/@doc.Slug"
                                           class="inline-flex items-center gap-1 rounded-lg bg-surface-container px-3 py-1.5 text-xs font-bold text-on-surface-variant transition hover:bg-military-green hover:text-white">
                                            <span class="material-symbols-outlined" style="font-size:14px">open_in_new</span>
                                            Xem
                                        </a>
                                        @if (doc.AllowDownload)
                                        {
                                            <a href="/tai-lieu/tai/@doc.Id"
                                               class="inline-flex items-center gap-1 rounded-lg bg-slate-800 px-3 py-1.5 text-xs font-bold text-white transition hover:bg-slate-700">
                                                <span class="material-symbols-outlined" style="font-size:14px">download</span>
                                                Tải
                                            </a>
                                        }
                                        @if (doc.CanDelete)
                                        {
                                            <form method="post" action="/tai-lieu/xoa/@doc.Id" onsubmit="return confirm('Xóa tài liệu này?')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="inline-flex items-center gap-1 rounded-lg bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-600 transition hover:bg-red-100">
                                                    <span class="material-symbols-outlined" style="font-size:14px">delete</span>
                                                    Xóa
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                    </div>

                    @if (Model.TotalPages > 1)
                    {
                        <nav class="flex flex-wrap items-center justify-center gap-2 pt-4" aria-label="Phân trang tài liệu">
                            @if (Model.Search.Page > 1)
                            {
                                var previousPage = Model.Search.Page - 1;
                                <a href="?q=@Model.Search.Q&categoryId=@Model.Search.CategoryId&typeId=@Model.Search.TypeId&issuerId=@Model.Search.IssuerId&dateFrom=@dateFromQuery&dateTo=@dateToQuery&page=@previousPage"
                                   class="inline-flex h-9 items-center justify-center gap-1 rounded-lg border border-outline-variant/40 bg-surface-container-lowest px-3 text-sm font-semibold text-on-surface-variant transition hover:border-military-green hover:text-military-green">
                                    <span class="material-symbols-outlined text-[16px]">chevron_left</span>
                                    Trước
                                </a>
                            }

                            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                            {
                                var pageClass = pageNumber == Model.Search.Page
                                    ? "inline-flex h-9 min-w-9 items-center justify-center rounded-lg bg-military-green px-3 text-sm font-bold text-white"
                                    : "inline-flex h-9 min-w-9 items-center justify-center rounded-lg border border-outline-variant/40 bg-surface-container-lowest px-3 text-sm font-medium text-on-surface-variant transition hover:border-military-green hover:text-military-green";
                                <a href="?q=@Model.Search.Q&categoryId=@Model.Search.CategoryId&typeId=@Model.Search.TypeId&issuerId=@Model.Search.IssuerId&dateFrom=@dateFromQuery&dateTo=@dateToQuery&page=@pageNumber"
                                   class="@pageClass">@pageNumber</a>
                            }

                            @if (Model.Search.Page < Model.TotalPages)
                            {
                                var nextPage = Model.Search.Page + 1;
                                <a href="?q=@Model.Search.Q&categoryId=@Model.Search.CategoryId&typeId=@Model.Search.TypeId&issuerId=@Model.Search.IssuerId&dateFrom=@dateFromQuery&dateTo=@dateToQuery&page=@nextPage"
                                   class="inline-flex h-9 items-center justify-center gap-1 rounded-lg border border-outline-variant/40 bg-surface-container-lowest px-3 text-sm font-semibold text-on-surface-variant transition hover:border-military-green hover:text-military-green">
                                    Sau
                                    <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                                </a>
                            }
                        </nav>
                    }
                }

                @if (TempData["UploadSuccess"] != null)
                {
                    <div class="rounded-xl border border-green-200 bg-green-50 p-4 text-sm font-semibold text-green-700">
                        <span class="material-symbols-outlined mr-1 align-middle" style="font-size:16px">check_circle</span>
                        @TempData["UploadSuccess"]
                    </div>
                }
            </div>
        </div>
    </div>
</div>
