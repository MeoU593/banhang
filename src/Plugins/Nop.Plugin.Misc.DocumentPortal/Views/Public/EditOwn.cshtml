@model Nop.Plugin.Misc.DocumentPortal.Models.Public.DocumentUploadModel

@{
    Layout = "_ColumnsOne";
}

@section Breadcrumb
{
    <nav class="public-breadcrumb flex flex-wrap items-center gap-2 text-slate-500" aria-label="Breadcrumb">
        <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="transition hover:text-military-green">Trang chủ</a>
        <span class="material-symbols-outlined text-sm text-slate-400">chevron_right</span>
        <a href="/customer/profile#profile-tab-documents" class="transition hover:text-military-green">Hồ sơ cá nhân</a>
        <span class="material-symbols-outlined text-sm text-slate-400">chevron_right</span>
        <span class="text-slate-700">Chỉnh sửa tài liệu</span>
    </nav>
}

<div class="page document-edit-page">
    <div class="page-body">
        <div class="public-page-shell mx-auto max-w-3xl space-y-6">
            <section class="public-blue-hero">
                <div class="public-blue-hero-content">
                    <div class="public-blue-hero-copy space-y-1.5">
                        <h1 class="public-hero-title public-blue-hero-title font-black tracking-tight">Chỉnh sửa tài liệu đã đăng</h1>
                        <p class="public-hero-subtitle public-blue-hero-subtitle max-w-2xl">Tài khoản thường chỉnh sửa tài liệu đã duyệt sẽ chuyển tài liệu về trạng thái chờ duyệt lại.</p>
                    </div>
                </div>
            </section>

            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                <div class="border-b border-slate-100 px-6 py-5">
                    <h2 class="public-section-title flex items-center gap-2 font-black text-slate-900">
                        <span class="material-symbols-outlined text-military-green" style="font-size:24px">edit_document</span>
                        Thông tin tài liệu
                    </h2>
                    <p class="public-body-text mt-1 text-slate-500">Cập nhật nội dung mô tả, phân loại, mức truy cập hoặc thay file đính kèm.</p>
                </div>

                <form method="post" action="/tai-lieu/cua-toi/sua/@Model.Id" enctype="multipart/form-data" class="space-y-5 px-6 py-6">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="IsEdit" />

                    <div asp-validation-summary="ModelOnly" class="rounded-lg bg-red-50 p-4 text-sm text-red-700"></div>

                    <div class="space-y-1">
                        <label for="Title" class="block text-sm font-semibold text-slate-700">Tiêu đề <span class="text-red-500">*</span></label>
                        <input type="text" id="Title" name="Title" value="@(Model.Title ?? "")" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-military-green/50 focus:bg-white focus:outline-none" />
                        <span asp-validation-for="Title" class="text-xs text-red-600"></span>
                    </div>

                    <div class="grid gap-4 sm:grid-cols-2">
                        <div class="space-y-1">
                            <label for="Code" class="block text-sm font-semibold text-slate-700">Mã tài liệu</label>
                            <input type="text" id="Code" name="Code" value="@(Model.Code ?? "")" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-military-green/50 focus:bg-white focus:outline-none" />
                        </div>
                        <div class="space-y-1">
                            <label for="IssuedDate" class="block text-sm font-semibold text-slate-700">Ngày ban hành</label>
                            <input type="date" id="IssuedDate" name="IssuedDate" value="@(Model.IssuedDate.HasValue ? Model.IssuedDate.Value.ToString("yyyy-MM-dd") : "")" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-military-green/50 focus:bg-white focus:outline-none" />
                        </div>
                    </div>

                    <div class="space-y-1">
                        <label for="Summary" class="block text-sm font-semibold text-slate-700">Tóm tắt</label>
                        <textarea id="Summary" name="Summary" rows="3" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-military-green/50 focus:bg-white focus:outline-none">@(Model.Summary ?? "")</textarea>
                    </div>

                    <div class="grid gap-4 sm:grid-cols-3">
                        <div class="space-y-1">
                            <label for="DocumentCategoryId" class="block text-sm font-semibold text-slate-700">Danh mục</label>
                            <select id="DocumentCategoryId" name="DocumentCategoryId" asp-items="Model.AvailableCategories" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:outline-none"></select>
                        </div>
                        <div class="space-y-1">
                            <label for="DocumentTypeId" class="block text-sm font-semibold text-slate-700">Loại tài liệu</label>
                            <select id="DocumentTypeId" name="DocumentTypeId" asp-items="Model.AvailableTypes" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:outline-none"></select>
                        </div>
                        <div class="space-y-1">
                            <label for="IssuerId" class="block text-sm font-semibold text-slate-700">Cơ quan ban hành</label>
                            <select id="IssuerId" name="IssuerId" asp-items="Model.AvailableIssuers" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:outline-none"></select>
                        </div>
                    </div>

                    <div class="grid gap-4 sm:grid-cols-2">
                        <div class="space-y-1">
                            <label for="AccessScopeId" class="block text-sm font-semibold text-slate-700">Mức truy cập <span class="text-red-500">*</span></label>
                            <select id="AccessScopeId" name="AccessScopeId" asp-items="Model.AvailableAccessScopes" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:outline-none"></select>
                            <span asp-validation-for="AccessScopeId" class="text-xs text-red-600"></span>
                        </div>
                        <div class="space-y-1">
                            <label for="File" class="block text-sm font-semibold text-slate-700">Thay file tài liệu</label>
                            <input type="file" id="File" name="File" class="w-full rounded-xl border border-dashed border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-600" />
                            <span asp-validation-for="File" class="text-xs text-red-600"></span>
                            @if (Model.HasExistingFile)
                            {
                                <p class="text-xs text-slate-500">File hiện tại: @(string.IsNullOrWhiteSpace(Model.CurrentFileName) ? "Đã có file đính kèm" : Model.CurrentFileName)</p>
                            }
                        </div>
                    </div>

                    <div class="flex flex-wrap gap-3 border-t border-slate-100 pt-5">
                        <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-military-green px-6 py-2.5 text-sm font-bold text-white shadow-md transition hover:bg-opacity-90">
                            <span class="material-symbols-outlined" style="font-size:18px">save</span>
                            Lưu thay đổi
                        </button>
                        <a href="/customer/profile#profile-tab-documents" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 px-6 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">Quay lại hồ sơ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
