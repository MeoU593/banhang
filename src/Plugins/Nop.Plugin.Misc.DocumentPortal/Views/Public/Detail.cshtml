@model Nop.Plugin.Misc.DocumentPortal.Models.Public.DocumentDetailModel

@{
    Layout = "_ColumnsOne";
    var documentCommentsById = Model.Comments.ToDictionary(comment => comment.Id);
    var documentGroupedReplies = Model.Comments
        .Where(comment => comment.ReplyToCommentId > 0 && documentCommentsById.ContainsKey(comment.ReplyToCommentId))
        .GroupBy(comment => comment.ReplyToCommentId)
        .ToDictionary(group => group.Key, group => group.OrderBy(comment => comment.CreatedOn).ToList());
    var topLevelDocumentComments = Model.Comments
        .Where(comment => comment.ReplyToCommentId <= 0 || !documentCommentsById.ContainsKey(comment.ReplyToCommentId))
        .OrderBy(comment => comment.CreatedOn)
        .ToList();
}

<div class="page document-detail-page">
    <div class="page-body space-y-6">

        <section class="overflow-hidden rounded-2xl border p-6 text-white shadow-[0_24px_60px_-35px_rgba(15,23,42,0.85)] sm:p-8" style="border-color: rgba(214,185,90,.28); background-color: rgba(33,45,27,.92); background-image: linear-gradient(120deg, #0f1a33 0%, #1f2b1a 52%, #314026 100%), repeating-linear-gradient(135deg, rgba(255,255,255,.05) 0, rgba(255,255,255,.05) 1px, transparent 1px, transparent 14px);">
            <div class="space-y-2">
                <nav class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-slate-200" aria-label="Breadcrumb">
                    <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="transition hover:text-white">Trang chủ</a>
                    <span class="material-symbols-outlined text-sm text-slate-300">chevron_right</span>
                    <a href="/tai-lieu" class="transition hover:text-white">Kho tài liệu</a>
                    <span class="material-symbols-outlined text-sm text-slate-300">chevron_right</span>
                    <span class="text-white">@Model.Title</span>
                </nav>
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#f6dc9a]">Chi tiết tài liệu</p>
                <h1 class="public-hero-title font-black tracking-tight text-white">@Model.Title</h1>
                @if (!string.IsNullOrWhiteSpace(Model.Summary))
                {
                    <p class="max-w-3xl text-sm text-slate-200 sm:text-base">@Model.Summary</p>
                }
            </div>
        </section>

        <div class="grid gap-6 lg:grid-cols-[1fr_300px]">

            <div class="space-y-5">
                <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
                    <div class="border-b border-slate-100 px-6 py-5">
                        <div class="mb-3 flex flex-wrap items-center gap-2">
                            @if (!string.IsNullOrWhiteSpace(Model.Code))
                            {
                                <span class="rounded-md border border-slate-200 bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-700">@Model.Code</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.TypeName))
                            {
                                <span class="rounded-md bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700">@Model.TypeName</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.CategoryName))
                            {
                                <span class="rounded-md bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">@Model.CategoryName</span>
                            }
                        </div>
                        <h1 class="public-page-title font-black text-slate-900">@Model.Title</h1>
                        @if (!string.IsNullOrWhiteSpace(Model.Summary))
                        {
                            <p class="mt-2 text-sm leading-6 text-slate-600">@Model.Summary</p>
                        }

                        <div class="mt-4 flex flex-wrap items-center gap-3">
                            @if (Model.HasDownload && !string.IsNullOrWhiteSpace(Model.DownloadUrl))
                            {
                                <a href="@Model.DownloadUrl"
                                   class="inline-flex items-center gap-2 rounded-xl px-6 py-2.5 text-sm font-bold shadow-md transition"
                                   style="background-color:#2f5e2b;border:1px solid #2f5e2b;color:#fff;text-decoration:none;">
                                    <span class="material-symbols-outlined" style="font-size:18px">download</span>
                                    Tải tài liệu
                                </a>
                            }
                            @if (Model.CanDelete)
                            {
                                <form method="post" action="/tai-lieu/xoa/@Model.Id" onsubmit="return confirm('Xóa tài liệu này?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="inline-flex items-center gap-2 rounded-xl border border-red-200 bg-red-50 px-4 py-2.5 text-sm font-semibold text-red-600 transition hover:bg-red-100">
                                        <span class="material-symbols-outlined" style="font-size:18px">delete</span>
                                        Xóa tài liệu
                                    </button>
                                </form>
                            }
                        </div>
                    </div>

                    @if (Model.HasContent)
                    {
                        <div class="prose prose-sm max-w-none px-6 py-5 text-slate-700">
                            @Html.Raw(Model.Content)
                        </div>
                    }
                    else if (Model.HasDownload && !string.IsNullOrWhiteSpace(Model.PreviewUrl))
                    {
                        <div class="border-t border-slate-100 px-6 py-5">
                            <iframe src="@Model.PreviewUrl" class="h-[70vh] w-full rounded-lg border border-slate-200" title="Xem tài liệu" loading="lazy"></iframe>
                        </div>
                    }
                    else
                    {
                        <div class="border-t border-slate-100 px-6 py-8 text-sm text-slate-600">
                            Tài liệu chưa có nội dung đọc trực tiếp trên web. Vui lòng tải tài liệu để xem đầy đủ.
                        </div>
                    }
                </div>

                <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" id="document-comments">
                    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 bg-slate-50/70 px-6 py-4">
                        <h2 class="public-card-title font-bold text-slate-900">Bình luận (@Model.NumberOfComments)</h2>
                        <div class="flex flex-wrap items-center justify-end gap-2">
                            <span class="text-xs font-semibold uppercase text-slate-500">Cũ nhất</span>
                            @if (Model.CanAddComments)
                            {
                                <a href="#document-comment-form" class="inline-flex h-8 items-center justify-center rounded-lg border px-3 text-xs font-semibold shadow-sm transition hover:brightness-110" style="background-color:#2f5e2b;border-color:#2f5e2b;color:#ffffff;">Viết bình luận</a>
                            }
                            else
                            {
                                @Html.RouteLink("Đăng nhập để bình luận", NopRouteNames.General.LOGIN, null, new { @class = "inline-flex h-8 items-center justify-center rounded-lg border border-slate-200 bg-white px-3 text-xs font-semibold text-slate-700 transition hover:border-military-green hover:text-military-green" })
                            }
                        </div>
                    </div>

                    <div class="space-y-3 bg-slate-50/40 p-4 sm:p-5">
                        @if (TempData["DocumentCommentError"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">@errorMessage</div>
                        }
                        @if (TempData["DocumentCommentSuccess"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
                        {
                            <div class="rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-700">@successMessage</div>
                        }

                        @if (Model.CanAddComments)
                        {
                            <form id="document-comment-form" action="/tai-lieu/binh-luan/@Model.Id" method="post" class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="AddNewComment.ReplyToCommentId" value="0" />
                                <label for="document-comment-text" class="mb-2 block text-sm font-semibold text-slate-700">Nội dung bình luận</label>
                                <textarea id="document-comment-text" name="AddNewComment.CommentText" rows="4" required placeholder="Nhập bình luận của bạn..."
                                          class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm leading-7 text-slate-700 outline-none transition focus:border-military-green focus:bg-white"></textarea>

                                <div class="mt-3 flex justify-end">
                                    <button type="submit" class="inline-flex h-10 items-center justify-center rounded-lg border px-4 text-sm font-semibold shadow-sm transition hover:brightness-110" style="background-color:#2f5e2b;border-color:#2f5e2b;color:#ffffff;">Gửi bình luận</button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">Bạn cần đăng nhập để bình luận tài liệu.</div>
                        }

                        @if (!topLevelDocumentComments.Any())
                        {
                            <p class="rounded-xl border border-dashed border-slate-300 px-4 py-8 text-center text-sm text-slate-500">Chưa có bình luận nào cho tài liệu này.</p>
                        }
                        else
                        {
                            @foreach (var comment in topLevelDocumentComments)
                            {
                                await Html.RenderPartialAsync("_DocumentComment", comment, new ViewDataDictionary(ViewData)
                                {
                                    ["DocumentId"] = Model.Id,
                                    ["AllowCommenting"] = Model.CanAddComments,
                                    ["CanReply"] = Model.CanAddComments
                                });

                                if (documentGroupedReplies.TryGetValue(comment.Id, out var childReplies))
                                {
                                    <div class="ml-6 border-l border-slate-200 pl-3 sm:ml-10 sm:pl-4">
                                        <div class="space-y-3">
                                            @foreach (var reply in childReplies)
                                            {
                                                await Html.RenderPartialAsync("_DocumentComment", reply, new ViewDataDictionary(ViewData)
                                                {
                                                    ["DocumentId"] = Model.Id,
                                                    ["AllowCommenting"] = Model.CanAddComments,
                                                    ["CanReply"] = Model.CanAddComments
                                                });

                                                if (documentGroupedReplies.TryGetValue(reply.Id, out var nestedReplies))
                                                {
                                                    <div class="ml-4 border-l border-slate-200 pl-3 sm:ml-6">
                                                        <div class="space-y-3">
                                                            @foreach (var nestedReply in nestedReplies)
                                                            {
                                                                await Html.RenderPartialAsync("_DocumentComment", nestedReply, new ViewDataDictionary(ViewData)
                                                                {
                                                                    ["DocumentId"] = Model.Id,
                                                                    ["AllowCommenting"] = Model.CanAddComments,
                                                                    ["CanReply"] = false
                                                                });
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        }
                    </div>
                </section>
            </div>

            <aside class="space-y-4">
                <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                    <h3 class="public-label-text mb-4 font-bold uppercase tracking-widest text-slate-500">Thông tin chi tiết</h3>
                    <dl class="space-y-3 text-sm">
                        @if (Model.IssuedDate.HasValue)
                        {
                            <div class="flex items-center justify-between">
                                <dt class="text-slate-500">Ngày ban hành</dt>
                                <dd class="font-semibold text-slate-800">@Model.IssuedDate.Value.ToString("dd/MM/yyyy")</dd>
                            </div>
                        }
                        @if (Model.EffectiveDate.HasValue)
                        {
                            <div class="flex items-center justify-between">
                                <dt class="text-slate-500">Có hiệu lực</dt>
                                <dd class="font-semibold text-slate-800">@Model.EffectiveDate.Value.ToString("dd/MM/yyyy")</dd>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.IssuerName))
                        {
                            <div>
                                <dt class="mb-1 text-slate-500">Cơ quan ban hành</dt>
                                <dd class="font-semibold text-slate-800">@Model.IssuerName</dd>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.AccessScopeName))
                        {
                            <div>
                                <dt class="mb-1 text-slate-500">Mức truy cập</dt>
                                <dd class="font-semibold text-slate-800">@Model.AccessScopeName</dd>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.OwnerVendorName))
                        {
                            <div>
                                <dt class="mb-1 text-slate-500">Đơn vị sở hữu</dt>
                                <dd class="font-semibold text-slate-800">@Model.OwnerVendorName</dd>
                            </div>
                        }
                        <div class="flex items-center justify-between border-t border-slate-100 pt-3">
                            <dt class="text-slate-500">Lượt xem</dt>
                            <dd class="font-bold text-slate-800">@Model.ViewCount</dd>
                        </div>
                        <div class="flex items-center justify-between">
                            <dt class="text-slate-500">Lượt tải</dt>
                            <dd class="font-bold text-slate-800">@Model.DownloadCount</dd>
                        </div>
                    </dl>
                </div>

                @if (Model.RelatedDocuments.Any())
                {
                    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                        <h3 class="public-label-text mb-4 font-bold uppercase tracking-widest text-slate-500">Tài liệu liên quan</h3>
                        <ul class="space-y-3">
                            @foreach (var rel in Model.RelatedDocuments)
                            {
                                <li class="flex items-start gap-2">
                                    <span class="material-symbols-outlined mt-0.5 text-slate-400" style="font-size:16px">description</span>
                                    <a href="/tai-lieu/@rel.Slug" class="text-sm font-medium text-slate-700 leading-5 hover:text-military-green hover:underline">
                                        @rel.Title
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </aside>
        </div>
    </div>
</div>

<script asp-location="Footer">
    document.addEventListener('DOMContentLoaded', function () {
        var replyButtons = document.querySelectorAll('[data-document-reply-target]');
        var cancelButtons = document.querySelectorAll('[data-document-reply-cancel]');

        var hideAllReplyForms = function () {
            document.querySelectorAll('[id^="document-reply-form-"]').forEach(function (form) {
                form.style.display = 'none';
            });
        };

        replyButtons.forEach(function (button) {
            button.addEventListener('click', function (event) {
                event.preventDefault();

                var targetId = button.getAttribute('data-document-reply-target');
                var targetForm = document.getElementById(targetId);
                if (!targetForm) {
                    return;
                }

                var willShow = targetForm.style.display === 'none' || targetForm.style.display === '';
                hideAllReplyForms();

                if (willShow) {
                    targetForm.style.display = 'block';
                    var textarea = targetForm.querySelector('textarea[name="AddNewComment.CommentText"]');
                    if (textarea) {
                        textarea.focus();
                    }
                    targetForm.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
            });
        });

        cancelButtons.forEach(function (button) {
            button.addEventListener('click', function () {
                var targetId = button.getAttribute('data-document-reply-cancel');
                var targetForm = document.getElementById(targetId);
                if (targetForm) {
                    targetForm.style.display = 'none';
                }
            });
        });
    });
</script>
