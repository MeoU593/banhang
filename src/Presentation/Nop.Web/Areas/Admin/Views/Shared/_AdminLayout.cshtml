@inject IWebHelper webHelper
@inject IDateTimeHelper dateTimeHelper
@inject ICustomerService customerService
@inject IEventPublisher eventPublisher
@inject LocalizationSettings localizationSettings
@inject StoreInformationSettings storeInformationSettings
@inject AdminAreaSettings adminAreaSettings
@inject Nop.Services.Localization.ILanguageService languageService

@using Nop.Core.Domain
@using Nop.Core.Domain.Localization
@using Nop.Services.Customers
@using Nop.Services.Helpers

@{
    var returnUrl = webHelper.GetRawUrl(Context.Request);

    //page title
    string adminPageTitle = !string.IsNullOrWhiteSpace(ViewBag.PageTitle) ? ViewBag.PageTitle + " / " : "";
    adminPageTitle += T("Admin.PageTitle").Text;

    //has "Manage Maintenance" permission?
    var canManageMaintenance = await permissionService.AuthorizeAsync(StandardPermission.System.MANAGE_MAINTENANCE);

    //avatar
    var currentCustomer = await workContext.GetCurrentCustomerAsync();

    //event
    await eventPublisher.PublishAsync(new PageRenderingEvent(NopHtml));

    //info: we specify "Admin" area for actions and widgets here for cases when we use this layout in a plugin that is running in a different area than "admin"
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" dir="@Html.GetUIDirection(localizationSettings.IgnoreRtlPropertyForAdminArea)">
<head>
    <title>@adminPageTitle</title>
    <meta http-equiv="Content-type" content="text/html;charset=UTF-8" />
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">

    @NopHtml.GenerateHeadCustom()

    @* CSS & Script resources *@
    @{
        await Html.RenderPartialAsync("_AdminScripts");
    }

    @*Insert favicon and app icons head code*@
    @await Component.InvokeAsync(typeof(FaviconViewComponent))
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" />
    <style>
        .main-sidebar .nav-sidebar > .nav-item > .nav-link {
            border-radius: 0.65rem;
            margin: 0.12rem 0.45rem;
            transition: background-color 160ms ease, color 160ms ease, box-shadow 160ms ease;
        }

        .main-sidebar .nav-sidebar .nav-link .nav-icon {
            transition: color 160ms ease, transform 160ms ease;
        }

        .main-sidebar .nav-sidebar .nav-link.active {
            background: linear-gradient(90deg, rgba(254, 214, 91, 0.32), rgba(255, 255, 255, 0.11)) !important;
            color: #ffffff !important;
            box-shadow: inset 0.25rem 0 0 #fed65b, 0 0.75rem 1.55rem -1rem rgba(254, 214, 91, 0.65);
            font-weight: 700;
        }

        .main-sidebar .nav-sidebar .nav-link.active .nav-icon {
            color: #fed65b !important;
            transform: translateX(1px);
        }

        .main-sidebar .nav-sidebar .nav-link.active-parent {
            color: #fff7d6 !important;
            background: rgba(254, 214, 91, 0.1) !important;
            box-shadow: inset 0.18rem 0 0 rgba(254, 214, 91, 0.75);
        }

        .main-sidebar .nav-sidebar .menu-open > .nav-link {
            color: #ffffff !important;
            background: rgba(255, 255, 255, 0.08) !important;
        }

        .main-sidebar .nav-sidebar [data-menu-system="UnitManagement"] > .nav-link .nav-icon { color: #38bdf8; }
        .main-sidebar .nav-sidebar [data-menu-system="AccountManagement"] > .nav-link .nav-icon { color: #a78bfa; }
        .main-sidebar .nav-sidebar [data-menu-system="SystemLogs"] > .nav-link .nav-icon { color: #fb7185; }
        .main-sidebar .nav-sidebar [data-menu-system="ProductManagement"] > .nav-link .nav-icon { color: #fbbf24; }
        .main-sidebar .nav-sidebar [data-menu-system="DocumentPortal.Root"] > .nav-link .nav-icon { color: #2dd4bf; }
        .main-sidebar .nav-sidebar [data-menu-system="LogisticsReports.Root"] > .nav-link .nav-icon { color: #4ade80; }
        .main-sidebar .nav-sidebar [data-menu-system="SystemManagement"] > .nav-link .nav-icon { color: #f97316; }

        .main-sidebar .nav-sidebar [data-menu-system="UnitDashboard"] > .nav-link .nav-icon,
        .main-sidebar .nav-sidebar [data-menu-system="UnitDirectory"] > .nav-link .nav-icon,
        .main-sidebar .nav-sidebar [data-menu-system="UnitStaff"] > .nav-link .nav-icon,
        .main-sidebar .nav-sidebar [data-menu-system="UnitActivityLog"] > .nav-link .nav-icon { color: #7dd3fc; }

        .main-sidebar .nav-sidebar [data-menu-system="Customers list"] > .nav-link .nav-icon,
        .main-sidebar .nav-sidebar [data-menu-system="Customer roles"] > .nav-link .nav-icon,
        .main-sidebar .nav-sidebar [data-menu-system="Pending customers"] > .nav-link .nav-icon,
        .main-sidebar .nav-sidebar [data-menu-system="Online customers"] > .nav-link .nav-icon { color: #c4b5fd; }

        .main-sidebar .nav-sidebar [data-menu-system="Activity logs"] > .nav-link .nav-icon,
        .main-sidebar .nav-sidebar [data-menu-system="Activity types"] > .nav-link .nav-icon { color: #fda4af; }

        .main-sidebar .nav-sidebar [data-menu-system="Products"] > .nav-link .nav-icon,
        .main-sidebar .nav-sidebar [data-menu-system="Categories"] > .nav-link .nav-icon,
        .main-sidebar .nav-sidebar [data-menu-system="Product reviews"] > .nav-link .nav-icon { color: #fde68a; }

        .main-sidebar .nav-sidebar [data-menu-system="Access control list"] > .nav-link .nav-icon,
        .main-sidebar .nav-sidebar [data-menu-system="Log"] > .nav-link .nav-icon,
        .main-sidebar .nav-sidebar [data-menu-system="Maintenance"] > .nav-link .nav-icon,
        .main-sidebar .nav-sidebar [data-menu-system="Schedule tasks"] > .nav-link .nav-icon,
        .main-sidebar .nav-sidebar [data-menu-system="Topics"] > .nav-link .nav-icon { color: #fdba74; }

        .main-sidebar .nav-sidebar .nav-treeview .nav-link.active {
            background: rgba(254, 214, 91, 0.24) !important;
            color: #fff7d6 !important;
        }

        .main-sidebar .nav-sidebar [data-menu-system="Vendors"] > .nav-link,
        .main-sidebar .nav-sidebar [data-menu-system^="Vendors."] > .nav-link {
            align-items: flex-start;
            min-height: 2.35rem;
            padding-top: 0.5rem;
            padding-bottom: 0.5rem;
        }

        .main-sidebar .nav-sidebar [data-menu-system="Vendors"] > .nav-link .nav-icon,
        .main-sidebar .nav-sidebar [data-menu-system^="Vendors."] > .nav-link .nav-icon {
            flex: 0 0 1.15rem;
            width: 1.15rem;
            margin-top: 0.12rem;
            margin-right: 0.55rem;
            text-align: center;
        }

        .main-sidebar .nav-sidebar [data-menu-system^="Vendors."] > .nav-link .nav-icon {
            color: #9fb3c8;
            font-size: 0.82rem;
        }

        .main-sidebar .nav-sidebar [data-menu-system="Vendors"] > .nav-link p,
        .main-sidebar .nav-sidebar [data-menu-system^="Vendors."] > .nav-link p {
            position: relative;
            min-width: 0;
            margin: 0;
            padding-right: 1.25rem;
            white-space: normal;
            overflow: visible;
            text-overflow: clip;
            line-height: 1.35;
            word-break: normal;
            overflow-wrap: anywhere;
        }

        .main-sidebar .nav-sidebar [data-menu-system="Vendors"] > .nav-link .nav-tree-toggle,
        .main-sidebar .nav-sidebar [data-menu-system^="Vendors."] > .nav-link .nav-tree-toggle {
            position: absolute;
            top: 0.08rem;
            right: 0;
            margin: 0;
        }

        .main-sidebar .nav-sidebar [data-menu-system^="Vendors."] > .nav-link {
            color: #d7dee8;
        }

        .main-sidebar .nav-sidebar [data-menu-system^="Vendors."] > .nav-link:hover {
            color: #ffffff;
            background: rgba(148, 163, 184, 0.12) !important;
        }
    </style>
</head>
<body class="hold-transition sidebar-mini layout-fixed control-sidebar-slide-open">
    <div class="throbber">
        <div class="curtain">
        </div>
        <div class="curtain-content">
            <div>
                <h1 class="throbber-header">@T("Common.Wait")</h1>
                <p>
                    <img src="@Url.Content("~/css/admin/images/throbber-synchronizing.gif")" alt="" />
                </p>
            </div>
        </div>
    </div>
    <div id="ajaxBusy">
        <span>&nbsp;</span>
    </div>
    <div class="wrapper">
        @if (IsSectionDefined("header"))
        {
            @RenderSection("header")
        }
        else
        {
            @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.HeaderBefore })
            <nav class="main-header navbar navbar-expand-md navbar-dark bg-dark">
                <ul class="navbar-nav pl-2 pl-md-0">
                    <li class="nav-item">
                        <a class="nav-link" id="nopSideBarPusher" data-widget="pushmenu" href="#" title="Thu gọn menu" data-toggle="tooltip"><i class="fa fa-bars"></i></a>
                    </li>
                    @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.HeaderToggleAfter })
                </ul>
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarText" aria-controls="navbarText" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.HeaderNavbarBefore })
                <div class="collapse navbar-collapse" id="navbarText">
                    <ul class="navbar-nav ml-auto pl-2">
                        <li class="nav-item">
                            @await Component.InvokeAsync(typeof(AdminLanguageSelectorViewComponent))
                        </li>
                        @if (await customerService.IsRegisteredAsync(currentCustomer))
                        {
                            <li class="nav-item">
                                <a href="#" class="nav-link disabled">@await customerService.GetCustomerFullNameAsync(currentCustomer)</a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Customer" asp-action="Logout" asp-area="" class="nav-link">@T("Admin.Header.Logout")</a>
                            </li>
                        }
                        <li class="nav-item">
                            @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.HeaderMiddle })
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index" asp-area="" class="nav-link" title="Trang người dùng" data-toggle="tooltip">Trang người dùng</a>
                        </li>
                        @if (canManageMaintenance)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link" href="#" data-toggle="dropdown" title="Công cụ hệ thống">
                                    <i class="fas fa-gears"></i>
                                </a>
                                <ul class="maintenance-menu dropdown-menu dropdown-menu-right" role="menu">
                                    <li class="dropdown-item">
                                        <form asp-controller="Common" asp-action="ClearCache" asp-area="@AreaNames.ADMIN">
                                            <input name="returnurl" type="hidden" value="@returnUrl">
                                            <div class="input-group-append">
                                                <button type="submit" style="width:210px;background-color: Transparent;">
                                                    <span>@T("Admin.Header.ClearCache")</span>
                                                </button>
                                            </div>
                                        </form>
                                    </li>
                                    <li class="dropdown-item">
                                        <form asp-controller="Common" asp-action="RestartApplication" asp-area="@AreaNames.ADMIN">
                                            <input name="returnurl" type="hidden" value="@returnUrl">
                                            <button id="restart-application" type="submit" style="width:210px;background-color: Transparent;">
                                                <span>@T("Admin.Header.RestartApplication")</span>
                                            </button>
                                            <script>
                                                $(function() {
                                                    $("#restart-application").off('click.restartApplication').on('click.restartApplication', function (e) {
                                                        showThrobber('@Html.Raw(JavaScriptEncoder.Default.Encode(T("Admin.Header.RestartApplication.Progress").Text))');
                                                    });
                                                });
                                            </script>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
                @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.HeaderNavbarAfter })
            </nav>

            @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.HeaderAfter })
        }
        @if (IsSectionDefined("headermenu"))
        {
            @RenderSection("headermenu")
        }
        else
        {
            <aside class="main-sidebar sidebar-dark-primary elevation-4">
                <!-- Brand Logo -->
                <a href="@Url.Content("~/Admin")" class="brand-link navbar-dark" style="text-decoration:none;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,0.07);display:flex;align-items:center;justify-content:center;overflow:hidden;text-align:center">
                    <div class="brand-text" style="line-height:1.2;min-width:0;text-align:center;font-family:inherit">
                        <div style="font-size:15px;font-weight:600;color:#ffffff;white-space:nowrap">Hậu Cần - Quân Nhu</div>
                        <div style="font-size:14px;font-weight:600;color:#fed65b;white-space:nowrap;margin-top:2px">BC Tăng Thiết Giáp</div>
                    </div>
                </a>
                <div class="sidebar">
                    <div class="sidebar-form">
                        <div id="search-box">
                            <input type="text" class="form-control admin-search-box typeahead" placeholder="@T("Admin.Menu.Search")">
                        </div>
                    </div>
                    <nav class="mt-2">
                        @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.SearchBoxBefore })
                        <script>
                            $(function() {
                                Admin.Search.init();
                            });
                        </script>
                        @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.MenuBefore })
                        @await Html.PartialAsync("Menu")

                    </nav>
                </div>
            </aside>
        }
        <div class="content-wrapper @(adminAreaSettings.UseStickyHeaderLayout ? "sticky-header-layout" : "")">
            @await Html.PartialAsync("Notifications")
            <nop-antiforgery-token />
            @RenderBody()
        </div>
        <div class="main-footer">
            <div class="container-fluid">
                <div class="col-md-12">
                    <div class="row">
                        <div class="col-md-4 col-xs-12 text-md-left text-center">
                            Hệ thống quản trị Cổng thông tin Hậu cần - Quân nhu
                        </div>
                        <div class="col-md-4 col-xs-12 text-center">
                            @((await dateTimeHelper.ConvertToUserTimeAsync(DateTime.Now)).ToString("f", CultureInfo.CurrentCulture))
                        </div>
                        <div class="col-md-4 col-xs-12 text-md-right text-center">
                            <b>Phiên bản triển khai nội bộ</b>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (adminAreaSettings.UseStickyHeaderLayout)
    {
        <script asp-location="Footer">
            $(function() {
                const stickyHeader = document.querySelector(".sticky-header-layout .content-header");

                if (stickyHeader !== null) {
                    const observer = new IntersectionObserver(
                        ([e]) => e.target.classList.toggle("is-pinned", e.intersectionRatio < 1),
                        { threshold: [1] }
                    );

                    observer.observe(stickyHeader);
                    window.addEventListener('beforeunload', function () {
                        observer.disconnect();
                    }, { once: true });
                }
            });
        </script>
    }
    <script>
        var AdminLTEOptions = {
            boxWidgetOptions: {
                boxWidgetIcons: {
                    collapse: 'fa-minus',
                    open: 'fa-plus'
                }
            }
        };
    </script>
    <script>
        $(function() {
            // Rename "Xuất khẩu" → "Xuất" everywhere
            $('*').contents().filter(function() {
                return this.nodeType === 3 && this.nodeValue && this.nodeValue.indexOf('Xuất khẩu') > -1;
            }).each(function() {
                this.nodeValue = this.nodeValue.replace(/Xuất khẩu/g, 'Xuất');
            });
            $('[value]').each(function() {
                if ($(this).val() === 'Xuất khẩu') $(this).val('Xuất');
            });

            // Block access to removed admin pages
            var blockedPaths = ['/Admin/MessageTemplate', '/Admin/Currency', '/Admin/Authentication', '/Admin/ExternalAuthentication', '/Admin/MultiFactorAuthentication'];
            var currentPath = window.location.pathname;
            if (blockedPaths.some(function(p) { return currentPath.toLowerCase().startsWith(p.toLowerCase()); })) {
                window.location.replace('/Admin');
            }
        });
    </script>
    @{
        //scroll to a selected card (if specified)
        var selectedCardName = Html.GetSelectedCardName();
        if (!String.IsNullOrEmpty(selectedCardName))
        {
            <script>
                location.hash = '#@(selectedCardName)';
            </script>
        }
    }
    <a id="backTop" class="btn btn-back-top bg-teal"></a>
    <script>
        $(function() {
            //enable "back top" arrow
            $('#backTop').backTop();

            //enable tooltips
            $('[data-toggle="tooltip"]').tooltip({ placement: 'bottom', trigger: 'hover' })
                .on('mouseleave click', function () {
                    $(this).tooltip('hide');
                });

            $('.nav-sidebar').on('click', '.nav-item.has-treeview > a.nav-link', function (event) {
                if ($(event.target).closest('.nav-tree-toggle').length) {
                    return;
                }

                var href = $(this).attr('href');
                if (href && href !== '#') {
                    event.preventDefault();
                    event.stopImmediatePropagation();
                    window.location.href = href;
                }
            });

            $('.nav-sidebar').on('click', '.nav-tree-toggle', function (event) {
                event.preventDefault();
                event.stopPropagation();

                var $item = $(this).closest('.nav-item.has-treeview');
                var $tree = $item.children('.nav-treeview').first();
                if ($item.hasClass('menu-open')) {
                    $tree.stop(true, true).slideUp(150);
                    $item.removeClass('menu-open');
                } else {
                    $item.addClass('menu-open');
                    $tree.stop(true, true).slideDown(150);
                }
            });

            $('.nav-sidebar').on('mouseleave', '.nav-link', function () {
                $(this).removeClass('hover').tooltip('hide');
            });
        });
    </script>
    @{
        var (licenseTermsDisplay, licenseTermsText) = Context.Items.TryGetValue("licenseTerms", out var licenseTerms) && licenseTerms is LicenseCheckModel licenseCheckModel
            ? (licenseCheckModel.DisplayWarning == true && licenseCheckModel.AcceptedLicenseTerms != true, licenseCheckModel.WarningText)
            : (false, null);
    }
    @if (licenseTermsDisplay && !string.IsNullOrEmpty(licenseTermsText))
    {
        <text>
            <div id="license-terms" class="modal fade" tabindex="-1" role="dialog">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="form-horizontal">
                            <div class="modal-body">
                                @Html.Raw(licenseTermsText)
                            </div>
                            <div class="modal-footer">
                                <button type="button" id="accept-license-terms-button" class="btn btn-primary">Accept terms</button>
                                <a class="btn btn-default float-right" href="https://www.nopcommerce.com/nopcommerce-copyright-removal-key?utm_source=admin-panel&utm_medium=popup-accept-license&utm_campaign=powered_by_nopcommerce&utm_content=key" target="_blank">Buy a key</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <script>
                $(function() {
                    var displayModal = @((licenseTermsDisplay == true).ToString().ToLower());
                    if (displayModal) {
                        $('#license-terms').modal({
                            backdrop: 'static',
                            keyboard: false
                        });
                    }

                    $('#accept-license-terms-button').off('click.licenseTerms').on('click.licenseTerms', function () {
                        var postData = {
                            accepted: true
                        };
                        addAntiForgeryToken(postData);
                        $.ajax({
                            cache: false,
                            type: 'POST',
                            url: '@(Url.Action("AcceptLicenseTerms", "Home"))',
                            data: postData,
                            complete: function (jqXHR, textStatus) {
                                $('#license-terms').modal('hide');
                            }
                        });
                    });
                });
            </script>
        </text>
    }
    @NopHtml.GenerateScripts(ResourceLocation.Footer)
    @NopHtml.GenerateInlineScripts(ResourceLocation.Footer)
</body>
</html>
