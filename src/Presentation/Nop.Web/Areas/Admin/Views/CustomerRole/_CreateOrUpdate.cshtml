@model CustomerRoleModel

<div asp-validation-summary="ModelOnly"></div>
<input asp-for="Id" type="hidden" />

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default">
                    <div class="card-body">
                        <div class="form-group row">
                            <div class="col-md-3">
                                <div class="label-wrapper"><label class="col-form-label">Tên vai trò <span class="required">*</span></label></div>
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="Name" />
                                <span asp-validation-for="Name"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <div class="label-wrapper"><label class="col-form-label">Hoạt động</label></div>
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="Active" />
                                <span asp-validation-for="Active"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <div class="label-wrapper"><label class="col-form-label">Thời hạn mật khẩu</label></div>
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="EnablePasswordLifetime" />
                                <span asp-validation-for="EnablePasswordLifetime"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <div class="label-wrapper"><label class="col-form-label">Vai trò hệ thống</label></div>
                            </div>
                            <div class="col-md-9">
                                <div class="form-text-row">@(Model.IsSystemRole ? "Có" : "Không")</div>
                                <input type="hidden" asp-for="IsSystemRole" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <div class="label-wrapper"><label class="col-form-label">Tên hệ thống</label></div>
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="SystemName" />
                                <span asp-validation-for="SystemName"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
