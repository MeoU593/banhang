@model CustomerRoleModel
@{
    ViewBag.PageTitle = "Chỉnh sửa vai trò";
    NopHtml.SetActiveMenuItemSystemName("Customer roles");
}

<form asp-controller="CustomerRole" asp-action="Edit" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            Chỉnh sửa vai trò — @Model.Name
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="List">Về danh sách</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                Lưu
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                Lưu & tiếp tục
            </button>
            @if (!Model.IsSystemRole)
            {
                <span id="customerrole-delete" class="btn btn-danger">
                    <i class="far fa-trash-can"></i>
                    Xóa
                </span>
            }
        </div>
    </div>
    @await Html.PartialAsync("_CreateOrUpdate", Model)
</form>
@if (!Model.IsSystemRole)
{
    <nop-delete-confirmation asp-model-id="@Model.Id" asp-button-id="customerrole-delete" />
}
