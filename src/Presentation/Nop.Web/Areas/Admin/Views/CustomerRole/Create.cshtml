@model CustomerRoleModel

@{
    ViewBag.PageTitle = "Thêm phân quyền";
    NopHtml.SetActiveMenuItemSystemName("Customer roles");
}

<form asp-controller="CustomerRole" asp-action="Create" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            Thêm phân quyền
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="List">Về danh sách phân quyền</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.SaveContinue")
            </button>
            @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.CustomerRoleDetailsButtons, additionalData = Model })
        </div>
    </div>
    @await Html.PartialAsync("_CreateOrUpdate", Model)
</form>
