@model VendorDetailsSectionModel

<div class="card card-default">
    <div class="card-header">
        <h3 class="card-title">@Model.Title</h3>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Nội dung</th>
                    <th style="width: 140px">Ngày</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.Url))
                                {
                                    <a href="@item.Url">@item.Title</a>
                                }
                                else
                                {
                                    @item.Title
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                                {
                                    <div class="text-muted small">@item.Subtitle</div>
                                }
                            </td>
                            <td>@(item.CreatedOnUtc.HasValue ? item.CreatedOnUtc.Value.ToString("dd/MM/yyyy") : "Chưa có")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="2" class="text-muted text-center">Chưa có dữ liệu.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
