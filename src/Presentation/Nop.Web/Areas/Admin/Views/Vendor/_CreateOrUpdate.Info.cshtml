@model VendorModel

<div class="card-body">

    <div class="form-group row">
        <div class="col-md-3">
            <div class="label-wrapper">
                <label class="col-form-label">Tên đơn vị <span class="required">*</span></label>
            </div>
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="Name" />
            <span asp-validation-for="Name"></span>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-md-3">
            <div class="label-wrapper">
                <label class="col-form-label">Mã đơn vị</label>
            </div>
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="Code" />
            <span asp-validation-for="Code"></span>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-md-3">
            <div class="label-wrapper">
                <label class="col-form-label">Đơn vị cấp trên</label>
            </div>
        </div>
        <div class="col-md-9">
            <select asp-for="ParentId" asp-items="Model.AvailableParents" class="form-control select2"></select>
            <span asp-validation-for="ParentId"></span>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-md-3">
            <div class="label-wrapper">
                <label class="col-form-label">Email liên hệ</label>
            </div>
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="Email" />
            <span asp-validation-for="Email"></span>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-md-3">
            <div class="label-wrapper">
                <label class="col-form-label">Mô tả</label>
            </div>
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="Description" asp-template="RichEditor" />
            <span asp-validation-for="Description"></span>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-md-3">
            <div class="label-wrapper">
                <label class="col-form-label">Hoạt động</label>
            </div>
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="Active" />
            <span asp-validation-for="Active"></span>
        </div>
    </div>

    @if (Model.Id > 0)
    {
        <div class="form-group row">
            <div class="col-md-3">
                <div class="label-wrapper">
                    <label class="col-form-label">Danh sách nhân viên</label>
                </div>
            </div>
            <div class="col-md-9">
                <div class="mb-2 text-right">
                    <form asp-action="ExportStaffExcel" asp-controller="Vendor" method="post" style="display:inline">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-success btn-sm">
                            <i class="far fa-file-excel"></i>
                            Xuất Excel
                        </button>
                    </form>
                    <form asp-action="ExportStaffPdf" asp-controller="Vendor" method="post" style="display:inline">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="far fa-file-pdf"></i>
                            Xuất PDF
                        </button>
                    </form>
                </div>
                @if (Model.AssociatedCustomers.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Tên</th>
                                    <th>Số điện thoại</th>
                                    <th>Gmail</th>
                                    <th>Cấp bậc</th>
                                    <th>Chức vụ</th>
                                    <th>Quyền hạn</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var customer in Model.AssociatedCustomers)
                                {
                                    <tr>
                                        <td>
                                            <a asp-action="Edit" asp-controller="Customer" asp-route-id="@customer.Id">
                                                @(string.IsNullOrWhiteSpace(customer.FullName) ? customer.Email : customer.FullName)
                                            </a>
                                            @if (customer.IsLeader)
                                            {
                                                <span class="badge badge-primary ml-1">Trưởng đơn vị</span>
                                            }
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(customer.Phone) ? "Chưa cập nhật" : customer.Phone)</td>
                                        <td>@customer.Email</td>
                                        <td>@(string.IsNullOrWhiteSpace(customer.Rank) ? "Chưa rõ" : customer.Rank)</td>
                                        <td>@(string.IsNullOrWhiteSpace(customer.PositionTitle) ? "Chưa rõ" : customer.PositionTitle)</td>
                                        <td>@(string.IsNullOrWhiteSpace(customer.RoleNames) ? "Chưa có quyền" : customer.RoleNames)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <span class="text-muted">Chưa có tài khoản nào</span>
                }
            </div>
        </div>

        <div class="form-group row">
            <div class="col-md-3">
                <div class="label-wrapper">
                    <label class="col-form-label">Trưởng đơn vị</label>
                </div>
            </div>
            <div class="col-md-9">
                <input type="hidden" asp-for="PmCustomerId" />
                <div id="customer-info" class="mb-2">
                    @if (Model.PmCustomerId > 0)
                    {
                        <a asp-controller="Customer" asp-action="Edit" asp-route-id="@Model.PmCustomerId">@Model.PmCustomerInfo</a>
                    }
                </div>
                <button type="submit"
                        onclick="javascript:OpenWindow('@(Url.Action("AddCustomerToVendorPopup", new { customerIdInput = Html.IdFor(model => model.PmCustomerId), customerInfoInput = "customer-info", btnId = "btnRefreshCustomer"}))', 800, 850, true); return false;"
                        class="btn btn-primary btn-sm">
                    Chọn trưởng đơn vị
                </button>
                <button type="submit" id="customer-remove" class="btn btn-danger btn-sm">
                    Xóa
                </button>
                <button type="submit" id="btnRefreshCustomer" style="display:none"></button>
                <span asp-validation-for="PmCustomerId"></span>
            </div>
        </div>

        <script asp-location="Footer">
            $(function () {
                const pmCustomerInput = $("#@Html.IdFor(model => model.PmCustomerId)");
                toggleRemoveButton();

                $('#customer-remove').click(function () {
                    $('#customer-info').html('');
                    pmCustomerInput.val('');
                    toggleRemoveButton();
                    return false;
                });

                $('#btnRefreshCustomer').click(function () {
                    toggleRemoveButton();
                    return false;
                });

                function toggleRemoveButton() {
                    if (pmCustomerInput.val() > 0) {
                        $('#customer-remove').show();
                    } else {
                        $('#customer-remove').hide();
                    }
                }
            });
        </script>
    }

    @if (Model.VendorAttributes.Count > 0)
    {
        @await Html.PartialAsync("_VendorAttributes", Model.VendorAttributes)
    }

    <div class="card card-default mt-3">
        <div class="card-header">
            Địa chỉ đơn vị
        </div>
        <div class="card-body">
            @await Html.PartialAsync("_CreateOrUpdate.Address", Model)
        </div>
    </div>

</div>
