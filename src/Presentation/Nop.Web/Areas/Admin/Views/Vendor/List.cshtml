@model VendorSearchModel
@{
    ViewBag.PageTitle = "Quản lý đơn vị";
    NopHtml.SetActiveMenuItemSystemName("Vendors");
}

@{
    const string hideSearchBlockAttributeName = "VendorsPage.HideSearchBlock";
    var hideSearchBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSearchBlockAttributeName);
}

<div class="content-header clearfix">
    <h1 class="float-left">Quản lý đơn vị</h1>
    <div class="float-right">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-square-plus"></i>
            Thêm đơn vị mới
        </a>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default card-search">
                    <div class="card-body">
                        <div class="row search-row @(!hideSearchBlock ? "opened" : "")" data-hideAttribute="@hideSearchBlockAttributeName">
                            <div class="search-text">@T("Admin.Common.Search")</div>
                            <div class="icon-search"><i class="fas fa-magnifying-glass" aria-hidden="true"></i></div>
                            <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchBlock ? "up" : "down")" aria-hidden="true"></i></div>
                        </div>

                        <div class="search-body @(hideSearchBlock ? "closed" : "")">
                            <input asp-for="SearchRootVendorId" type="hidden" />
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <label class="col-form-label">Tên đơn vị</label>
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="SearchName" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <label class="col-form-label">Email liên hệ</label>
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="SearchEmail" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="text-center col-12">
                                    <button type="button" id="search-vendors" class="btn btn-primary btn-search">
                                        <i class="fas fa-magnifying-glass"></i>
                                        Tìm kiếm
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card card-default">
                    <div class="card-body">
                        @await Html.PartialAsync("Table", new DataTablesModel
                        {
                            Name = "vendors-grid",
                            UrlRead = new DataUrl("List", "Vendor", null),
                            SearchButtonId = "search-vendors",
                            Length = Model.PageSize,
                            LengthMenu = Model.AvailablePageSizes,
                            Filters = new List<FilterParameter>
                            {
                                new FilterParameter(nameof(Model.SearchName)),
                                new FilterParameter(nameof(Model.SearchEmail)),
                                new FilterParameter(nameof(Model.SearchRootVendorId))
                            },
                            ColumnCollection = new List<ColumnProperty>
                            {
                                new ColumnProperty(nameof(VendorModel.Level))
                                {
                                    Title = "Cấp",
                                    Width = "70",
                                    ClassName = NopColumnClassDefaults.CenterAll,
                                    Render = new RenderCustom("renderLevel")
                                },
                                new ColumnProperty(nameof(VendorModel.Code))
                                {
                                    Title = "Mã",
                                    Width = "80"
                                },
                                new ColumnProperty(nameof(VendorModel.Name))
                                {
                                    Title = "Tên đơn vị",
                                    Render = new RenderCustom("renderVendorName")
                                },
                                new ColumnProperty(nameof(VendorModel.Path))
                                {
                                    Title = "Đường dẫn phân cấp"
                                },
                                new ColumnProperty(nameof(VendorModel.Active))
                                {
                                    Title = "Hoạt động",
                                    Width = "80",
                                    ClassName = NopColumnClassDefaults.CenterAll,
                                    Render = new RenderBoolean()
                                },
                                new ColumnProperty(nameof(VendorModel.Id))
                                {
                                    Title = "Chi tiết",
                                    Width = "80",
                                    ClassName = NopColumnClassDefaults.Button,
                                    Render = new RenderCustom("renderVendorDetails")
                                },
                                new ColumnProperty(nameof(VendorModel.Id))
                                {
                                    Title = "Sửa",
                                    Width = "50",
                                    ClassName = NopColumnClassDefaults.Button,
                                    Render = new RenderButtonEdit(new DataUrl("~/Admin/Vendor/Edit"))
                                }
                            }
                        })
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    function renderLevel(data, type, row, meta) {
        if (data === 0) return '<span class="badge badge-primary">Cấp 0</span>';
        if (data === 1) return '<span class="badge badge-info">Cấp 1</span>';
        if (data === 2) return '<span class="badge badge-success">Cấp 2</span>';
        return '<span class="badge badge-secondary">Cấp ' + data + '</span>';
    }

    function renderVendorName(data, type, row, meta) {
        if (type !== 'display') {
            return data;
        }

        return '<a href="/Admin/Vendor/Details/' + row.Id + '">' + escapeVendorText(data) + '</a>';
    }

    function renderVendorDetails(data, type, row, meta) {
        return '<a class="btn btn-default" href="/Admin/Vendor/Details/' + data + '"><i class="fas fa-eye"></i>Chi tiết</a>';
    }

    function escapeVendorText(value) {
        return $('<div/>').text(value || '').html();
    }
</script>
