@model UnitActivityLogSearchModel

@{
    ViewBag.PageTitle = $"Nhật ký hệ thống - {Model.VendorName}";
    NopHtml.SetActiveMenuItemSystemName("UnitActivityLog");
}

@{
    const string hideSearchBlockAttributeName = "UnitActivityLogPage.HideSearchBlock";
    var hideSearchBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSearchBlockAttributeName);
}

<div class="content-header clearfix">
    <h1 class="float-left">Nhật ký hệ thống - @Model.VendorName</h1>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default card-search">
                    <div class="card-body">
                        <div class="row search-row @(!hideSearchBlock ? "opened" : "")" data-hideAttribute="@hideSearchBlockAttributeName">
                            <div class="search-text">@T("Admin.Common.Search")</div>
                            <div class="icon-search"><i class="fas fa-magnifying-glass" aria-hidden="true"></i></div>
                            <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchBlock ? "up" : "down")" aria-hidden="true"></i></div>
                        </div>

                        <div class="search-body @(hideSearchBlock ? "closed" : "")">
                            <div class="row">
                                <div class="col-md-5">
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <label class="col-form-label" for="@Html.IdFor(model => model.CreatedOnFrom)">Từ ngày</label>
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="CreatedOnFrom" />
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <label class="col-form-label" for="@Html.IdFor(model => model.CreatedOnTo)">Đến ngày</label>
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="CreatedOnTo" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-7">
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="ActivityLogTypeId" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-select asp-for="ActivityLogTypeId" asp-items="Model.ActivityLogType" />
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="SearchCustomerEmail" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="SearchCustomerEmail" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="text-center col-12">
                                    <button type="button" id="search-unit-log" class="btn btn-primary btn-search">
                                        <i class="fas fa-magnifying-glass"></i>
                                        @T("Admin.Common.Search")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card card-default">
                    <div class="card-body">
                        @await Html.PartialAsync("Table", new DataTablesModel
                        {
                            Name = "unit-activityLog-grid",
                            UrlRead = new DataUrl("ListLogs", "UnitActivityLog", null),
                            SearchButtonId = "search-unit-log",
                            Length = Model.PageSize,
                            LengthMenu = Model.AvailablePageSizes,
                            Filters = new List<FilterParameter>
                            {
                                new FilterParameter(nameof(Model.CreatedOnTo)),
                                new FilterParameter(nameof(Model.CreatedOnFrom)),
                                new FilterParameter(nameof(Model.SearchCustomerEmail)),
                                new FilterParameter(nameof(Model.ActivityLogTypeId))
                            },
                            ColumnCollection = new List<ColumnProperty>
                            {
                                new ColumnProperty(nameof(ActivityLogModel.ActivityLogTypeName))
                                {
                                    Title = T("Admin.Customers.ActivityLog.Fields.ActivityLogType").Text,
                                    Width = "200"
                                },
                                new ColumnProperty(nameof(ActivityLogModel.CustomerEmail))
                                {
                                    Title = T("Admin.Customers.ActivityLog.Fields.CustomerEmail").Text,
                                    Width = "150"
                                },
                                new ColumnProperty(nameof(ActivityLogModel.IpAddress))
                                {
                                    Title = T("Admin.Customers.ActivityLog.Fields.IpAddress").Text,
                                    Width = "100"
                                },
                                new ColumnProperty(nameof(ActivityLogModel.Comment))
                                {
                                    Title = T("Admin.Customers.ActivityLog.Fields.Comment").Text
                                },
                                new ColumnProperty(nameof(ActivityLogModel.CreatedOn))
                                {
                                    Title = T("Admin.Customers.ActivityLog.Fields.CreatedOn").Text,
                                    Width = "200",
                                    Render = new RenderDate()
                                }
                            }
                        })
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
