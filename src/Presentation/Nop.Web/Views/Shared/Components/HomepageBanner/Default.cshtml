@{
    var homepageUrl = Url.RouteUrl(NopRouteNames.General.HOMEPAGE);
}

<style>
    .homepage-command-banner {
        position: relative;
        overflow: hidden;
        border-bottom: 1px solid rgba(246, 220, 154, 0.24);
        color: #f6dc9a;
        background-color: rgba(45, 58, 34, 0.6);
        background-image:
            linear-gradient(90deg, rgba(45, 58, 34, 0.92) 0%, rgba(69, 84, 45, 0.82) 34%, rgba(91, 106, 55, 0.74) 50%, rgba(69, 84, 45, 0.82) 66%, rgba(45, 58, 34, 0.92) 100%),
            repeating-linear-gradient(135deg, rgba(246, 220, 154, 0.08) 0, rgba(246, 220, 154, 0.08) 1px, transparent 1px, transparent 16px);
        -webkit-backdrop-filter: blur(12px);
        backdrop-filter: blur(12px);
    }

    .homepage-command-banner__image {
        pointer-events: none;
        position: absolute;
        top: 0;
        bottom: 0;
        width: 36%;
        height: 100%;
        object-fit: cover;
        opacity: 0.34;
        filter: saturate(0.95) contrast(1.03);
    }

    .homepage-command-banner__image--left {
        left: 0;
        object-position: 60% center;
        mask-image: linear-gradient(90deg, #000 0%, #000 58%, transparent 100%);
        -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 58%, transparent 100%);
    }

    .homepage-command-banner__image--right {
        right: 0;
        object-position: 44% center;
        mask-image: linear-gradient(270deg, #000 0%, #000 58%, transparent 100%);
        -webkit-mask-image: linear-gradient(270deg, #000 0%, #000 58%, transparent 100%);
    }

    .homepage-command-banner__content {
        position: relative;
        z-index: 2;
        display: flex;
        min-height: 72px;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2px;
        padding: 8px 24px;
        text-decoration: none;
        text-align: center;
    }

    .homepage-command-banner__title-line {
        font-size: clamp(0.875rem, 1vw, 1.0625rem);
        font-weight: 900;
        text-transform: uppercase;
        line-height: 1.15;
        letter-spacing: 0.08em;
        color: #f6dc9a;
        text-shadow: 0 2px 10px rgba(15, 23, 42, 0.72);
        white-space: nowrap;
    }

    .homepage-command-banner__title-line--sub {
        color: #ffd166;
        font-size: clamp(0.9375rem, 1.1vw, 1.1875rem);
    }

    @@media (max-width: 1279px) {
        .homepage-command-banner__content {
            padding-left: 20px;
            padding-right: 20px;
        }
    }

    @@media (max-width: 1023px) {
        .homepage-command-banner__image {
            width: 36%;
            opacity: 0.36;
        }

        .homepage-command-banner__title-line {
            font-size: clamp(0.875rem, 2.8vw, 1.0625rem);
            white-space: normal;
        }
    }

    @@media (max-width: 767px) {
        .homepage-command-banner__image {
            display: none;
        }

        .homepage-command-banner__content {
            min-height: 58px;
            padding-top: 8px;
            padding-bottom: 8px;
        }
    }
</style>

<div class="homepage-command-banner">
    <img class="homepage-command-banner__image homepage-command-banner__image--left" src="/images/banner/tank-left-crop.jpeg" alt="Xe tăng" loading="lazy" />
    <img class="homepage-command-banner__image homepage-command-banner__image--right" src="/images/banner/parade-right-crop.jpeg" alt="Duyệt đội ngũ" loading="lazy" />

    <a href="@homepageUrl" class="homepage-command-banner__content" aria-label="Trang chủ">
        <div class="homepage-command-banner__title">
            <div class="homepage-command-banner__title-line">Cổng thông tin Hậu cần - Quân nhu</div>
            <div class="homepage-command-banner__title-line homepage-command-banner__title-line--sub">BINH CHỦNG TĂNG THIẾT GIÁP</div>
        </div>
    </a>
</div>
