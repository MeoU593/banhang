@{
    var homepageUrl = Url.RouteUrl(NopRouteNames.General.HOMEPAGE);
}

<style>
    .homepage-command-banner {
        position: relative;
        overflow: hidden;
        border-bottom: 1px solid rgba(246, 220, 154, 0.18);
        color: #fff7d6;
        background-color: #260001;
        background-image:
            radial-gradient(circle at 50% 8%, rgba(254, 214, 91, 0.16), transparent 34%),
            linear-gradient(90deg, rgba(38, 0, 1, 0.96) 0%, rgba(74, 0, 4, 0.9) 35%, rgba(17, 24, 39, 0.84) 50%, rgba(74, 0, 4, 0.9) 65%, rgba(38, 0, 1, 0.96) 100%),
            repeating-linear-gradient(135deg, rgba(254, 243, 199, 0.06) 0, rgba(254, 243, 199, 0.06) 1px, transparent 1px, transparent 16px);
        -webkit-backdrop-filter: blur(12px);
        backdrop-filter: blur(12px);
    }

    .homepage-command-banner__image {
        pointer-events: none;
        position: absolute;
        top: 0;
        bottom: 0;
        width: 36%;
        height: 100%;
        object-fit: cover;
        opacity: 0.28;
        filter: saturate(0.9) contrast(1.02);
    }

    .homepage-command-banner__image--left {
        left: 0;
        object-position: 60% center;
        mask-image: linear-gradient(90deg, #000 0%, #000 58%, transparent 100%);
        -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 58%, transparent 100%);
    }

    .homepage-command-banner__image--right {
        right: 0;
        object-position: 44% center;
        mask-image: linear-gradient(270deg, #000 0%, #000 58%, transparent 100%);
        -webkit-mask-image: linear-gradient(270deg, #000 0%, #000 58%, transparent 100%);
    }

    .homepage-command-banner__content {
        position: relative;
        z-index: 2;
        display: flex;
        min-height: calc(var(--public-top-banner-height, 82px) * 1.5);
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2px;
        padding: 0.4% 14%;
        text-decoration: none;
        text-align: center;
    }

    .homepage-command-banner__title {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .homepage-command-banner__logo-slot {
        position: absolute;
        z-index: 3;
        top: 50%;
        display: flex;
        height: 76%;
        aspect-ratio: 1;
        transform: translateY(-50%);
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        background: rgba(15, 23, 42, 0.22);
        box-shadow: 0 0.5rem 1.4rem rgba(15, 23, 42, 0.22);
    }

    .homepage-command-banner__logo-slot--left {
        left: 2%;
    }

    .homepage-command-banner__logo-slot--right {
        right: 2%;
    }

    .homepage-command-banner__logo {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .homepage-command-banner__logo-fallback {
        color: #fed65b;
        font-size: 190%;
        filter: drop-shadow(0 1px 3px rgba(254, 214, 91, 0.35));
        font-variation-settings: 'FILL' 1;
    }

    .homepage-command-banner__title-line {
        font-size: clamp(1.18rem, 0.78vw + 1rem, 1.55rem);
        font-weight: 900;
        text-transform: uppercase;
        line-height: 1.08;
        letter-spacing: 0.07em;
        color: #fff7d6;
        text-shadow: 0 2px 10px rgba(15, 23, 42, 0.72);
        white-space: nowrap;
    }

    .homepage-command-banner__title-line--sub {
        color: #fed65b;
    }

    @@media (max-width: 1279px) {
        .homepage-command-banner__content {
            padding-left: 14%;
            padding-right: 14%;
        }
    }

    @@media (max-width: 1023px) {
        .homepage-command-banner__image {
            width: 36%;
            opacity: 0.36;
        }

        .homepage-command-banner__title-line {
            font-size: var(--public-font-card-title, clamp(0.92rem, 2vw, 1.08rem));
            white-space: normal;
        }
    }

    @@media (max-width: 767px) {
        .homepage-command-banner__image {
            display: none;
        }

        .homepage-command-banner__logo-slot {
            height: 70%;
        }

        .homepage-command-banner__content {
            min-height: 102px;
            padding: 1% 15%;
        }

        .homepage-command-banner__title-line {
            font-size: var(--public-font-list-title, clamp(0.82rem, 3.4vw, 1rem));
        }
    }
</style>

<div class="homepage-command-banner">
    <img class="homepage-command-banner__image homepage-command-banner__image--left" src="/images/banner/tank-left-crop.jpeg" alt="Xe tăng" loading="lazy" />
    <img class="homepage-command-banner__image homepage-command-banner__image--right" src="/images/banner/parade-right-crop.jpeg" alt="Duyệt đội ngũ" loading="lazy" />

    <div class="homepage-command-banner__logo-slot homepage-command-banner__logo-slot--left" aria-hidden="true">
        <img class="homepage-command-banner__logo" src="/images/banner/logo-quan-nhu.svg" alt="" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='inline-block';" />
        <span class="material-symbols-outlined homepage-command-banner__logo-fallback" style="display:none;">military_tech</span>
    </div>

    <div class="homepage-command-banner__logo-slot homepage-command-banner__logo-slot--right" aria-hidden="true">
        <img class="homepage-command-banner__logo" src="/images/banner/logo-tang-thiet-giap.svg" alt="" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='inline-block';" />
        <span class="material-symbols-outlined homepage-command-banner__logo-fallback" style="display:none;">shield</span>
    </div>

    <a href="@homepageUrl" class="homepage-command-banner__content" aria-label="Trang chủ">
        <div class="homepage-command-banner__title">
            <div class="homepage-command-banner__title-line">Cổng thông tin Cục hậu cần kĩ thuật</div>
            <div class="homepage-command-banner__title-line homepage-command-banner__title-line--sub">Binh chủng Tăng Thiết Giáp</div>
        </div>
    </a>
</div>
