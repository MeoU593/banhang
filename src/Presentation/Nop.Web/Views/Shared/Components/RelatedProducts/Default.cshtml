@model IList<ProductOverviewModel>
@if (Model.Count > 0)
{
    <style>
        .command-related-grid {
            border: 1px solid rgba(196, 198, 204, 0.35);
            border-radius: 18px;
            background: #ffffff;
            padding: 22px;
            box-shadow: 0 18px 34px -32px rgba(15, 23, 42, 0.55);
        }

        .command-related-grid .title {
            margin: 0 0 14px;
            color: #141c24;
            font-size: 20px;
            font-weight: 900;
            letter-spacing: -0.02em;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .command-related-grid .title .material-symbols-outlined {
            color: #2e0001;
            font-size: 21px;
        }
    </style>

    <section class="related-products-grid product-grid command-related-grid">
        <h2 class="title"><span class="material-symbols-outlined">dynamic_feed</span> @T("Products.RelatedProducts")</h2>
        <div class="item-grid">
            @foreach (var item in Model)
            {
                <div class="item-box">@await Html.PartialAsync("_ProductBox", item)</div>
            }
        </div>
    </section>
}
