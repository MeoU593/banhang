@model IList<ProductOverviewModel>

@using Nop.Core.Domain.Catalog

@if (Model.Count > 0)
{
    var previewProducts = Model.Take(3).ToList();
    var hiddenProductsCount = Model.Count - previewProducts.Count;

    <div class="space-y-3">
        @foreach (var item in previewProducts)
        {
            var picture = item.PictureModels.FirstOrDefault();
            var productUrl = await NopUrl.RouteGenericUrlAsync<Product>(new { SeName = item.SeName });

            <article class="group overflow-hidden rounded-[22px] border border-slate-200 bg-white p-3 shadow-[0_18px_40px_-28px_rgba(15,23,42,0.18)] transition hover:-translate-y-[1px] hover:shadow-[0_24px_48px_-28px_rgba(45,58,34,0.22)]">
                <div class="flex gap-3">
                    <a href="@productUrl" class="h-20 w-20 flex-shrink-0 overflow-hidden rounded-2xl bg-slate-100">
                        <img alt="@picture?.AlternateText" class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]" src="@picture?.ImageUrl" title="@picture?.Title" />
                    </a>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <p class="truncate text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">@(string.IsNullOrWhiteSpace(item.Sku) ? "Sản phẩm trên trang chủ" : item.Sku)</p>
                                <h3 class="mt-1 line-clamp-2 text-sm font-bold tracking-tight text-slate-900">
                                    <a href="@productUrl" class="transition hover:text-military-red">@item.Name</a>
                                </h3>
                            </div>
                            <a href="@productUrl" class="inline-flex h-9 items-center justify-center rounded-xl border border-slate-200 px-3 text-xs font-semibold text-slate-700 transition hover:border-military-green hover:text-military-green active:scale-[0.98]">
                                Chi tiết
                            </a>
                        </div>
                        <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-slate-500">
                            @if (!string.IsNullOrWhiteSpace(item.ProductPrice.Price))
                            {
                                <span class="font-semibold text-slate-900">@item.ProductPrice.Price</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.ProductPrice.OldPrice))
                            {
                                <span class="line-through">@item.ProductPrice.OldPrice</span>
                            }
                            <span class="rounded-full bg-slate-100 px-2.5 py-1 font-medium text-slate-600">
                                @(item.ReviewOverviewModel.TotalReviews > 0 ? $"{item.ReviewOverviewModel.TotalReviews} đánh giá" : "Đang hiển thị trên trang chủ")
                            </span>
                        </div>
                    </div>
                </div>
            </article>
        }

        @if (hiddenProductsCount > 0)
        {
            <div class="rounded-[20px] border border-dashed border-slate-200 bg-slate-50 px-4 py-3 text-xs font-medium text-slate-500">
                Còn @hiddenProductsCount sản phẩm khác đang được giữ ở chế độ teaser.
            </div>
        }
    </div>
}
