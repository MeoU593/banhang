@model BlogPostListModel

@using Nop.Core.Domain.Blogs

@{
    var posts = Model.BlogPosts.ToList();
    var postTypeId = ViewData["HomepagePostTypeId"] as int?;
    var displayVariant = (ViewData["HomepagePostDisplayVariant"] as string ?? string.Empty).Trim().ToLowerInvariant();
    var blogArchiveUrl = postTypeId switch
    {
        0 => Url.RouteUrl(NopRouteNames.Standard.BLOG_NEWS),
        1 => Url.RouteUrl(NopRouteNames.Standard.BLOG_DOCUMENTS),
        _ => Url.RouteUrl(NopRouteNames.General.BLOG)
    };
}

@if (posts.Any())
{
    @if (displayVariant == "main-news")
    {
        var featured = posts.First();
        var relatedPosts = posts.Skip(1).ToList();
        var featuredRouteName = featured.PostTypeId == 1 ? NopRouteNames.Standard.BLOG_DOCUMENT_POST : NopRouteNames.Standard.BLOG_NEWS_POST;
        var featuredUrl = Url.RouteUrl(featuredRouteName, new { SeName = featured.SeName }) ?? await NopUrl.RouteGenericUrlAsync<BlogPost>(new { SeName = featured.SeName });
        var featuredPreviewContent = !string.IsNullOrWhiteSpace(featured.BodyOverview) ? featured.BodyOverview : featured.Body;

        <div class="grid grid-cols-1 gap-6 xl:grid-cols-[1.2fr_0.8fr]">
            <div>
                <a href="@featuredUrl" class="mb-4 block aspect-[16/9] overflow-hidden rounded-xl border border-slate-200 bg-slate-100 shadow-sm">
                    @if (!string.IsNullOrWhiteSpace(featured.ThumbnailImageUrl))
                    {
                        <img src="@featured.ThumbnailImageUrl" alt="@featured.Title" class="h-full w-full object-cover transition duration-500 hover:scale-105" />
                    }
                    else
                    {
                        <div class="public-label-text flex h-full w-full items-center justify-center bg-gradient-to-br from-slate-100 to-slate-200 font-semibold uppercase tracking-[0.12em] text-slate-500">Ảnh minh họa</div>
                    }
                </a>
                <h3 class="public-section-title font-bold text-slate-900">
                    <a href="@featuredUrl" class="transition hover:text-military-green">@featured.Title</a>
                </h3>
                <div class="public-body-text mt-3 line-clamp-4 text-slate-600 [&>*:first-child]:mt-0 [&>*:last-child]:mb-0 [&_a]:text-inherit [&_a]:no-underline">
                    @Html.Raw(featuredPreviewContent)
                </div>
            </div>

            <div class="border-l border-slate-200 pl-5">
                @foreach (var item in relatedPosts)
                {
                    var postRouteName = item.PostTypeId == 1 ? NopRouteNames.Standard.BLOG_DOCUMENT_POST : NopRouteNames.Standard.BLOG_NEWS_POST;
                    var postUrl = Url.RouteUrl(postRouteName, new { SeName = item.SeName }) ?? await NopUrl.RouteGenericUrlAsync<BlogPost>(new { SeName = item.SeName });

                    <a href="@postUrl" class="public-list-title block border-b border-dotted border-slate-300 py-4 text-slate-700 transition hover:text-military-green">
                        <span class="line-clamp-3">@item.Title</span>
                    </a>
                }
            </div>
        </div>
    }
    else if (displayVariant == "headline-list")
    {
        <div class="divide-y divide-slate-100 bg-white">
            @foreach (var item in posts.Take(3))
            {
                var postRouteName = item.PostTypeId == 1 ? NopRouteNames.Standard.BLOG_DOCUMENT_POST : NopRouteNames.Standard.BLOG_NEWS_POST;
                var postUrl = Url.RouteUrl(postRouteName, new { SeName = item.SeName }) ?? await NopUrl.RouteGenericUrlAsync<BlogPost>(new { SeName = item.SeName });

                <a href="@postUrl" class="public-list-title flex items-start gap-2 px-5 py-4 font-semibold text-slate-700 transition hover:bg-slate-50 hover:text-military-green">
                    <span class="mt-1 text-military-green">▪</span>
                    <span class="line-clamp-3">@item.Title</span>
                </a>
            }
        </div>
    }
    else if (displayVariant == "document-list")
    {
        <div class="divide-y divide-slate-100">
            @foreach (var item in posts)
            {
                var postRouteName = item.PostTypeId == 1 ? NopRouteNames.Standard.BLOG_DOCUMENT_POST : NopRouteNames.Standard.BLOG_NEWS_POST;
                var postUrl = Url.RouteUrl(postRouteName, new { SeName = item.SeName }) ?? await NopUrl.RouteGenericUrlAsync<BlogPost>(new { SeName = item.SeName });

                <a href="@postUrl" class="block px-5 py-4 transition hover:bg-slate-50">
                    <div class="public-list-title line-clamp-2 font-semibold text-slate-800">@item.Title</div>
                    <div class="public-label-text home-meta-chip mt-2 inline-flex uppercase tracking-[0.14em]">@item.CreatedOn.ToString("dd/MM/yyyy")</div>
                </a>
            }
        </div>
    }
    else if (displayVariant == "home-news-grid")
    {
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            @foreach (var item in posts.Take(4))
            {
                var postRouteName = item.PostTypeId == 1 ? NopRouteNames.Standard.BLOG_DOCUMENT_POST : NopRouteNames.Standard.BLOG_NEWS_POST;
                var postUrl = Url.RouteUrl(postRouteName, new { SeName = item.SeName }) ?? await NopUrl.RouteGenericUrlAsync<BlogPost>(new { SeName = item.SeName });
                var previewContent = !string.IsNullOrWhiteSpace(item.BodyOverview) ? item.BodyOverview : item.Body;

                <article class="home-card group overflow-hidden transition-shadow">
                    <a href="@postUrl" class="block aspect-video overflow-hidden bg-slate-100">
                        @if (!string.IsNullOrWhiteSpace(item.ThumbnailImageUrl))
                        {
                            <img src="@item.ThumbnailImageUrl" alt="@item.Title" class="size-full object-cover transition-transform duration-500 group-hover:scale-105" />
                        }
                        else
                        {
                            <div class="public-label-text flex h-full w-full items-center justify-center font-semibold uppercase tracking-[0.14em] text-slate-500">Tin tức</div>
                        }
                    </a>
                    <div class="home-card-pad home-news-card-body space-y-3">
                        <h4 class="public-card-title line-clamp-2 font-bold text-slate-800">@item.Title</h4>
                        <div class="public-meta-text line-clamp-3 text-slate-500 [&>*:first-child]:mt-0 [&>*:last-child]:mb-0 [&_a]:text-inherit [&_a]:no-underline">
                            @Html.Raw(previewContent)
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="public-label-text font-medium uppercase text-slate-400">@item.CreatedOn.ToString("dd/MM/yyyy")</span>
                            <a href="@postUrl" class="public-label-text inline-flex items-center gap-1 font-bold text-primary">
                                Chi tiết
                                <span class="material-symbols-outlined text-sm">arrow_forward</span>
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else if (displayVariant == "home-doc-table")
    {
        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <table class="home-table">
                <thead class="public-label-text bg-slate-50 font-bold uppercase tracking-wider text-slate-500">
                    <tr>
                        <th class="home-doc-title-column px-4 py-3">Số hiệu / Trích yếu</th>
                        <th class="home-doc-date-column px-4 py-3 whitespace-nowrap">Ngày ban hành</th>
                        <th class="home-doc-action-column px-4 py-3 text-right whitespace-nowrap">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var item in posts.Take(6))
                    {
                        var postRouteName = item.PostTypeId == 1 ? NopRouteNames.Standard.BLOG_DOCUMENT_POST : NopRouteNames.Standard.BLOG_NEWS_POST;
                        var postUrl = Url.RouteUrl(postRouteName, new { SeName = item.SeName }) ?? await NopUrl.RouteGenericUrlAsync<BlogPost>(new { SeName = item.SeName });
                        var author = string.IsNullOrWhiteSpace(item.AuthorName) ? "Ban hành nội bộ" : item.AuthorName;

                        <tr class="transition-colors hover:bg-slate-50">
                            <td class="px-4 py-3">
                                <a href="@postUrl" class="public-list-title line-clamp-1 font-bold text-slate-800 transition hover:text-primary">@item.Title</a>
                                <p class="public-meta-text line-clamp-1 text-slate-500">@author</p>
                            </td>
                            <td class="home-doc-date-column text-slate-500"><span class="public-meta-text whitespace-nowrap">@item.CreatedOn.ToString("dd/MM/yyyy")</span></td>
                            <td class="px-4 py-3 text-right">
                                <a href="@postUrl" class="inline-flex rounded-lg p-2 text-primary transition hover:bg-primary/10">
                                    <span class="material-symbols-outlined">open_in_new</span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="grid gap-4 md:grid-cols-2">
            @foreach (var item in posts)
            {
                var postRouteName = item.PostTypeId == 1 ? NopRouteNames.Standard.BLOG_DOCUMENT_POST : NopRouteNames.Standard.BLOG_NEWS_POST;
                var postUrl = Url.RouteUrl(postRouteName, new { SeName = item.SeName }) ?? await NopUrl.RouteGenericUrlAsync<BlogPost>(new { SeName = item.SeName });
                var previewContent = !string.IsNullOrWhiteSpace(item.BodyOverview) ? item.BodyOverview : item.Body;
                var typeLabel = item.PostTypeId == 1 ? "Văn bản" : "Tin tức";

                <article class="home-card home-card-pad group flex h-full flex-col transition hover:-translate-y-[1px]">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <p class="public-label-text font-semibold uppercase tracking-[0.18em] text-slate-500">@typeLabel</p>
                            <h3 class="public-list-title mt-2 line-clamp-2 font-bold tracking-tight text-slate-900">
                                <a href="@postUrl" class="transition hover:text-military-green">@item.Title</a>
                            </h3>
                        </div>
                        <time datetime="@item.CreatedOn.ToString("yyyy-MM-dd")" class="public-label-text home-meta-chip whitespace-nowrap font-medium">
                            @item.CreatedOn.ToString("dd/MM/yyyy")
                        </time>
                    </div>

                    <div class="public-body-text mt-3 flex-1 text-slate-600 [&>*:first-child]:mt-0 [&>*:last-child]:mb-0 [&_a]:text-inherit [&_a]:no-underline">
                        <div class="line-clamp-4">
                            @Html.Raw(previewContent)
                        </div>
                    </div>

                    <div class="public-meta-text mt-4 flex items-center justify-between gap-3 border-t border-slate-100 pt-4 text-slate-500">
                        <span class="rounded-full bg-slate-100 px-2.5 py-1 font-medium text-slate-600">
                            @(item.AllowComments ? $"{item.NumberOfComments} phản hồi" : "Đã xuất bản")
                        </span>
                        <a href="@postUrl" class="public-control-text home-action-button inline-flex items-center justify-center transition active:scale-[0.98]">
                            Xem bài viết
                        </a>
                    </div>
                </article>
            }
        </div>
    }
}
else
{
    <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 px-5 py-8 text-center text-slate-500">
        <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
            <div class="space-y-2">
                <p class="public-label-text font-semibold uppercase tracking-[0.2em] text-slate-500">Nguồn blog lõi</p>
                <h3 class="public-card-title font-bold tracking-tight text-slate-900">Chưa có bài viết nào để hiển thị</h3>
                <p class="public-body-text max-w-2xl text-slate-600">Khi bài viết được xuất bản, hệ thống sẽ tự động cập nhật vào các khối trang chủ.</p>
            </div>
            @if (!string.IsNullOrWhiteSpace(blogArchiveUrl))
            {
                <a href="@blogArchiveUrl" class="public-control-text home-action-button inline-flex items-center justify-center bg-white transition">
                    Đi tới lưu trữ blog
                </a>
            }
        </div>
    </div>
}
