@model BlogPostListModel

@using Nop.Core.Domain.Blogs

@{
    var posts = Model.BlogPosts.Take(4).ToList();
    var postTypeId = ViewData["HomepagePostTypeId"] as int?;
    var blogArchiveUrl = postTypeId switch
    {
        0 => Url.RouteUrl(NopRouteNames.Standard.BLOG_NEWS),
        1 => Url.RouteUrl(NopRouteNames.Standard.BLOG_DOCUMENTS),
        _ => Url.RouteUrl(NopRouteNames.General.BLOG)
    };
}

@if (posts.Any())
{
    <div class="grid gap-4 md:grid-cols-2">
        @foreach (var item in posts)
        {
            var postRouteName = item.PostTypeId == 1 ? NopRouteNames.Standard.BLOG_DOCUMENT_POST : NopRouteNames.Standard.BLOG_NEWS_POST;
            var postUrl = Url.RouteUrl(postRouteName, new { SeName = item.SeName }) ?? await NopUrl.RouteGenericUrlAsync<BlogPost>(new { SeName = item.SeName });
            var previewContent = !string.IsNullOrWhiteSpace(item.BodyOverview) ? item.BodyOverview : item.Body;
            var typeLabel = item.PostTypeId == 1 ? "Văn bản" : "Tin tức";

            <article class="group flex h-full flex-col rounded-[22px] border border-slate-200 bg-white p-4 shadow-[0_18px_40px_-28px_rgba(15,23,42,0.18)] transition hover:-translate-y-[1px] hover:shadow-[0_24px_48px_-28px_rgba(45,58,34,0.22)]">
                <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                        <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">@typeLabel</p>
                        <h3 class="mt-2 line-clamp-2 text-base font-bold tracking-tight text-slate-900">
                            <a href="@postUrl" class="transition hover:text-military-green">@item.Title</a>
                        </h3>
                    </div>
                    <time datetime="@item.CreatedOn.ToString("yyyy-MM-dd")" class="whitespace-nowrap rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-medium text-slate-600">
                        @item.CreatedOn.ToString("dd/MM/yyyy")
                    </time>
                </div>

                <div class="mt-3 flex-1 text-sm leading-6 text-slate-600 [&>*:first-child]:mt-0 [&>*:last-child]:mb-0 [&_a]:text-inherit [&_a]:no-underline">
                    <div class="line-clamp-4">
                        @Html.Raw(previewContent)
                    </div>
                </div>

                <div class="mt-4 flex items-center justify-between gap-3 border-t border-slate-100 pt-4 text-xs text-slate-500">
                    <span class="rounded-full bg-slate-100 px-2.5 py-1 font-medium text-slate-600">
                        @(item.AllowComments ? $"{item.NumberOfComments} phản hồi" : "Đã xuất bản")
                    </span>
                    <a href="@postUrl" class="inline-flex h-10 min-w-[132px] items-center justify-center rounded-xl border border-slate-200 px-4 text-sm font-semibold text-slate-700 transition hover:border-military-green hover:text-military-green active:scale-[0.98]">
                        Xem bài viết
                    </a>
                </div>
            </article>
        }
    </div>
}
else
{
    <div class="rounded-[22px] border border-dashed border-slate-200 bg-slate-50/80 p-6 shadow-[inset_0_1px_0_rgba(255,255,255,0.7)]">
        <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
            <div class="space-y-2">
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Nguồn blog lõi</p>
                <h3 class="text-lg font-bold tracking-tight text-slate-900">Chưa có bài viết blog nào để hiển thị trên trang chủ</h3>
                <p class="max-w-2xl text-sm leading-6 text-slate-600">Khối tin trang chủ hiện chỉ lấy dữ liệu thật từ blog core. Khi có bài viết được xuất bản, teaser sẽ tự xuất hiện tại đây.</p>
            </div>
            @if (!string.IsNullOrWhiteSpace(blogArchiveUrl))
            {
                <a href="@blogArchiveUrl" class="inline-flex h-11 min-w-[186px] items-center justify-center rounded-2xl border border-slate-200 bg-white px-5 text-sm font-semibold text-slate-700 transition hover:border-military-green hover:text-military-green active:scale-[0.98]">
                    Đi tới lưu trữ blog
                </a>
            }
        </div>
    </div>
}
