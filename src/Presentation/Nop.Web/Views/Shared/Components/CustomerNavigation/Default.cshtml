@model CustomerNavigationModel
<style>
.account-nav-card { background: var(--tw-bg-surface-container-lowest, #fff); border: 1px solid rgba(196,198,204,0.3); border-radius: 12px; overflow: hidden; box-shadow: 0 4px 14px -8px rgba(15,23,42,0.08); margin-bottom: 16px; }
.account-nav-title { padding: 12px 16px; background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #fbbf24; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.18em; }
.account-nav-list { list-style: none; margin: 0; padding: 6px 0; }
.account-nav-list li a { display: flex; align-items: center; padding: 10px 16px; font-size: 13px; font-weight: 500; color: #44474c; text-decoration: none; transition: background 0.15s, color 0.15s; border-left: 3px solid transparent; }
.account-nav-list li a:hover { background: #e7eefa; color: #141c24; }
.account-nav-list li.active a { color: #2e0001; font-weight: 700; background: #fff4dc; border-left-color: #fed65b; }
</style>
<div class="account-nav-card">
    <div class="account-nav-title">@T("Account.Navigation")</div>
    <ul class="account-nav-list">
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.AccountNavigationBefore, additionalData = Model })
        @foreach (var item in Model.CustomerNavigationItems)
        {
            <li class="@item.ItemClass @(Model.SelectedTab == item.Tab ? "active" : "inactive")">
                <a href="@Url.RouteUrl(item.RouteName)">@(item.Title)</a>
            </li>
        }
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.AccountNavigationAfter, additionalData = Model })
    </ul>
</div>
