@using Nop.Core.Domain.Catalog
@using Nop.Core.Domain.Common
@using Nop.Core.Domain.FilterLevels
@using Nop.Core.Domain.Seo
@using Nop.Services.Security
@using Nop.Core.Events

@inject CatalogSettings catalogSettings
@inject CommonSettings commonSettings
@inject FilterLevelSettings filterLevelSettings
@inject IEventPublisher eventPublisher
@inject IPermissionService permissionService
@inject SeoSettings seoSettings

@{
    if (catalogSettings.DisplayAllPicturesOnCatalogPages)
    {
        NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/lib_npm/swiper/swiper-bundle.min.js");
    }
    if (filterLevelSettings.FilterLevelEnabled && filterLevelSettings.DisplayOnHomePage)
    {
        NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/js/public.filterlevelselect.js");
    }
    NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/js/public.countryselect.js");
    NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/js/public.common.js");
    //when jQuery migrate script logging is active you will see the log in the browser console
    if (commonSettings.JqueryMigrateScriptLoggingActive)
    {
        NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/lib_npm/jquery-migrate/jquery-migrate.js");
    }
    else
    {
        NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/lib_npm/jquery-migrate/jquery-migrate.min.js");
    }
    NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/lib_npm/jquery-ui-dist/jquery-ui.min.js");
    NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/lib_npm/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js");
    NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/lib_npm/jquery-validation/jquery.validate.min.js");
    NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/lib_npm/jquery/jquery.min.js");

    //custom tag(s);
    if (!string.IsNullOrEmpty(seoSettings.CustomHeadTags))
    {
        NopHtml.AppendHeadCustomParts(seoSettings.CustomHeadTags);
    }

    //event
    await eventPublisher.PublishAsync(new PageRenderingEvent(NopHtml));

    var title = await NopHtml.GenerateTitleAsync(false);
    var description = await @NopHtml.GenerateMetaDescriptionAsync();
    var keywords = await NopHtml.GenerateMetaKeywordsAsync();
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" dir="@Html.GetUIDirection(!await Html.ShouldUseRtlThemeAsync())" class="@NopHtml.GeneratePageCssClasses()">
<head>
    <title>@title</title>

    <meta http-equiv="Content-type" content="text/html;charset=UTF-8" />
    <meta name="description" content="@description" />
    <meta name="keywords" content="@keywords" />
    <meta name="generator" content="nopCommerce" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @NopHtml.GenerateHeadCustom()
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config" asp-location="None">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "military-green": "#2d3a22",
                        "military-red": "#b22222",
                        "military-gold": "#d4af37",
                        "sidebar-bg": "#29313a",
                        "primary": "#2d3a22",
                        "on-primary": "#ffffff",
                        "primary-container": "#3d4f2d",
                        "on-primary-container": "#dfe8d4",
                        "primary-fixed": "#dfe8d4",
                        "primary-fixed-dim": "#bcc9aa",
                        "on-primary-fixed": "#1f2918",
                        "on-primary-fixed-variant": "#3d4f2d",
                        "secondary": "#735c00",
                        "on-secondary": "#ffffff",
                        "secondary-container": "#f0d27b",
                        "on-secondary-container": "#745c00",
                        "secondary-fixed": "#ffe2a0",
                        "secondary-fixed-dim": "#e9c349",
                        "on-secondary-fixed": "#241a00",
                        "on-secondary-fixed-variant": "#574500",
                        "tertiary": "#0f1300",
                        "on-tertiary": "#ffffff",
                        "tertiary-container": "#232900",
                        "on-tertiary-container": "#899258",
                        "tertiary-fixed": "#dfe8a6",
                        "tertiary-fixed-dim": "#c3cc8c",
                        "on-tertiary-fixed": "#191e00",
                        "on-tertiary-fixed-variant": "#434b18",
                        "surface": "#f7f7f6",
                        "surface-dim": "#e7e7e2",
                        "surface-bright": "#f7f7f6",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#f4f5f2",
                        "surface-container": "#f0f1ed",
                        "surface-container-high": "#ebece7",
                        "surface-container-highest": "#e4e6df",
                        "surface-variant": "#e6e8e0",
                        "surface-tint": "#2d3a22",
                        "inverse-surface": "#29313a",
                        "inverse-on-surface": "#e9f1fd",
                        "inverse-primary": "#bcc9aa",
                        "background": "#f7f7f6",
                        "on-background": "#141c24",
                        "on-surface": "#141c24",
                        "on-surface-variant": "#44474c",
                        "outline": "#75777c",
                        "outline-variant": "#c4c6cc",
                        "error": "#ba1a1a",
                        "on-error": "#ffffff",
                        "error-container": "#ffdad6",
                        "on-error-container": "#93000a"
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    fontFamily: {
                        "sans": ["Inter", "sans-serif"],
                        "headline": ["Inter", "sans-serif"],
                        "body": ["Inter", "sans-serif"],
                        "label": ["Inter", "sans-serif"]
                    }
                }
            }
        }
    </script>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries" asp-location="None"></script>
    @*This is used so that themes can inject content into the header*@
    @await Html.PartialAsync("Head")

    @NopHtml.GenerateCssFiles()
    <style>
        :root {
            --app-font-family: 'Inter', Arial, Helvetica, sans-serif;
            --app-font-size-base: 15px;
            --app-font-size-small: 14px;
            --app-font-size-button: 14px;
            --app-line-height-base: 1.55;
            --app-control-height: 40px;
            --app-content-max-width: 1440px;
            --display-lg: 3.5rem;
            --headline-sm: 1.5rem;
            --title-sm: 1rem;
            --label-sm: 0.6875rem;
            --public-font-body: 15px;
            --public-font-control: 14px;
            --public-font-page-title: clamp(1.75rem, 2.4vw, 2.375rem);
            --public-font-hero-title: clamp(1.375rem, 1.8vw, 1.75rem);
            --public-font-section-title: clamp(1.375rem, 1.8vw, 1.75rem);
            --public-font-card-title: 1.125rem;
            --public-font-list-title: 1rem;
            --public-font-meta: 0.75rem;
            --public-font-label: 0.6875rem;
            --primary: #2d3a22;
            --on-primary: #ffffff;
            --primary-container: #3d4f2d;
            --on-primary-container: #dfe8d4;
            --secondary: #735c00;
            --secondary-container: #f0d27b;
            --on-secondary-container: #745c00;
            --surface: #f7f7f6;
            --surface-dim: #e7e7e2;
            --surface-bright: #f7f7f6;
            --surface-container-lowest: #ffffff;
            --surface-container-low: #f4f5f2;
            --surface-container: #f0f1ed;
            --surface-container-high: #ebece7;
            --surface-container-highest: #e4e6df;
            --surface-variant: #e6e8e0;
            --surface-tint: #2d3a22;
            --on-surface: #141c24;
            --on-surface-variant: #44474c;
            --outline: #75777c;
            --outline-variant: #c4c6cc;
            --inverse-surface: #29313a;
            --inverse-on-surface: #e9f1fd;
            --tertiary-container: #232900;
            --error: #ba1a1a;
            --error-container: #ffdad6;
            --app-radius-md: 0.5rem;
            --app-radius-lg: 0.75rem;
            --app-border-soft: rgba(148, 163, 184, 0.25);
            --app-border-focus: rgba(45, 58, 34, 0.4);
            --app-shadow-soft: 0 16px 32px -26px rgba(20, 28, 36, 0.2);
            --app-shadow-ambient: 0 24px 40px -28px rgba(20, 28, 36, 0.24);
        }

        /* Universal font override – beats all element-level Arial rules in styles.css */
        *,
        *::before,
        *::after {
            font-family: var(--app-font-family) !important;
        }

        /* Preserve monospace for code blocks */
        pre, code, kbd, samp, tt {
            font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, monospace !important;
        }

        body {
            background: var(--surface-container-low);
            color: var(--on-surface);
            font-size: var(--app-font-size-base);
            line-height: var(--app-line-height-base);
            letter-spacing: 0.01em;
        }

        button,
        input,
        select,
        textarea,
        .button-1,
        .button-2 {
            font-size: var(--app-font-size-button);
        }

        .material-symbols-outlined {
            font-family: 'Material Symbols Outlined' !important;
            font-weight: normal;
            font-style: normal;
            font-size: 24px;
            line-height: 1;
            letter-spacing: normal;
            text-transform: none;
            display: inline-block;
            white-space: nowrap;
            word-wrap: normal;
            direction: ltr;
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        /* Sidebar scrollbar */
        aside::-webkit-scrollbar { width: 4px; }
        aside::-webkit-scrollbar-track { background: transparent; }
        aside::-webkit-scrollbar-thumb { background: #44474c; border-radius: 10px; }

        .master-wrapper-page > aside {
            background: #0f172a;
        }

        .master-wrapper-page > div > .sticky {
            background: rgba(255, 255, 255, 0.85);
            box-shadow: none;
            backdrop-filter: blur(10px);
        }

        .master-wrapper-page,
        .master-wrapper-content,
        .master-column-wrapper,
        .center-1,
        .page,
        .page-body {
            width: 100%;
            margin: 0;
        }

        .master-wrapper-content,
        .master-column-wrapper,
        .center-1 {
            position: static;
        }

        .center-1,
        .page,
        .buttons,
        .fieldset,
        .section {
            margin-bottom: 0;
        }

        .center-1 {
            max-width: var(--app-content-max-width);
            margin-inline: auto;
        }

        .auth-standalone-shell {
            max-width: none !important;
            margin-inline: 0;
        }

        .app-content-shell {
            max-width: var(--app-content-max-width);
            margin-inline: auto;
            width: 100%;
        }

        .page {
            text-align: left;
            min-height: auto;
        }

        .page h1,
        .page h2,
        .page h3,
        .page h4 {
            letter-spacing: -0.02em;
        }

        .page h1 {
            font-size: var(--public-font-page-title);
            line-height: 1.15;
        }

        .page h2 {
            font-size: var(--public-font-section-title);
            line-height: 1.2;
        }

        .page h3 {
            font-size: var(--public-font-card-title);
            line-height: 1.25;
        }

        .public-hero-title {
            font-size: var(--public-font-hero-title) !important;
            line-height: 1.12 !important;
            letter-spacing: -0.03em;
        }

        .public-page-title {
            font-size: var(--public-font-page-title) !important;
            line-height: 1.15 !important;
            letter-spacing: -0.025em;
        }

        .public-section-title {
            font-size: var(--public-font-section-title) !important;
            line-height: 1.2 !important;
            letter-spacing: -0.02em;
        }

        .public-card-title {
            font-size: var(--public-font-card-title) !important;
            line-height: 1.3 !important;
        }

        .public-list-title {
            font-size: var(--public-font-list-title) !important;
            line-height: 1.45 !important;
        }

        .public-body-text {
            font-size: var(--public-font-body) !important;
            line-height: 1.65 !important;
        }

        .public-meta-text {
            font-size: var(--public-font-meta) !important;
            line-height: 1.45 !important;
        }

        .public-label-text {
            font-size: var(--public-font-label) !important;
            line-height: 1.35 !important;
        }

        .page .rounded-xl {
            border-radius: var(--app-radius-md);
        }

        .page .rounded-2xl,
        .page .rounded-3xl {
            border-radius: var(--app-radius-lg);
        }

        .page .shadow-sm {
            box-shadow: var(--app-shadow-soft) !important;
        }

        .page .shadow-lg {
            box-shadow: var(--app-shadow-ambient) !important;
        }

        .page input:not([type="checkbox"]):not([type="radio"]),
        .page select,
        .page textarea {
            min-height: var(--app-control-height);
            border-radius: var(--app-radius-md);
            background: var(--surface-container-lowest);
            border: 1px solid var(--app-border-soft);
            color: var(--on-surface);
        }

        .page input:focus,
        .page select:focus,
        .page textarea:focus {
            border-color: var(--app-border-focus);
            box-shadow: 0 0 0 3px rgba(45, 58, 34, 0.12);
            outline: 0;
        }

        .page .button-1,
        .page .button-2 {
            min-height: var(--app-control-height);
            border-radius: var(--app-radius-md);
            font-weight: 700;
            background-image: linear-gradient(135deg, rgba(185, 29, 32, 0.2), rgba(185, 29, 32, 0));
            box-shadow: var(--app-shadow-soft);
            transition: box-shadow 0.2s ease, background-color 0.2s ease;
        }

        .page .button-1:hover,
        .page .button-2:hover {
            box-shadow: var(--app-shadow-ambient);
        }

        .page .text-xs.uppercase,
        .page .text-[11px].uppercase,
        .page .text-[10px].uppercase {
            font-size: var(--label-sm);
            letter-spacing: 0.11em;
            font-weight: 700;
        }

        /* ── Required * trước label — pattern .inputs (nopCommerce standard) ── */
        .inputs {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            align-items: baseline;
            column-gap: 4px;
            row-gap: 5px;
        }
        .inputs > label {
            order: 2;
            flex-shrink: 0;
            margin: 0 !important;
            font-size: 0.8125rem;
            font-weight: 600;
            color: #374151;
        }
        .inputs > span.required {
            order: 1;
            flex-shrink: 0;
            color: #e11d48;
            font-weight: 700;
            font-size: 13px;
            line-height: 1.5;
        }
        .inputs > input:not([type=checkbox]):not([type=radio]),
        .inputs > select,
        .inputs > textarea,
        .inputs > div,
        .inputs > .form-input-wrapper {
            order: 3;
            flex-basis: 100%;
            margin-top: 2px !important;
        }
        .inputs > span:not(.required),
        .inputs > a,
        .inputs > .please-wait,
        .inputs > .change-password-recovery-link {
            order: 4;
            flex-basis: 100%;
        }

        /* ── Required * trước label — pattern .account-field ── */
        .account-field {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            align-items: baseline;
            column-gap: 4px;
            row-gap: 5px;
            margin-bottom: 1rem;
        }
        .account-field:last-child { margin-bottom: 0; }
        .account-field > label { order: 2; flex-shrink: 0; margin: 0 !important; }
        .account-field > span.required { order: 1; flex-shrink: 0; color: #e11d48; font-weight: 700; font-size: 13px; line-height: 1.5; }
        .account-field > input, .account-field > select,
        .account-field > textarea, .account-field > div {
            order: 3; flex-basis: 100%; margin-top: 2px !important;
        }
        .account-field > span:not(.required), .account-field > a {
            order: 4; flex-basis: 100%;
        }

        .page-title,
        .header-menu {
            display: none;
        }

        /* Đảm bảo input với icon không bị theme ghi đè padding */
        .login-page .relative input[style*="padding-left"] {
            padding-left: 2.75rem !important;
        }

        .message-error ul,
        .field-validation-error,
        .validation-summary-errors {
            color: #b91c1c;
        }

        .field-validation-error,
        .field-validation-valid,
        .message-error,
        .validation-summary-errors {
            display: block;
            margin-top: 0.5rem;
            font-size: 0.875rem;
            line-height: 1.25rem;
        }

        .validation-summary-valid {
            display: none;
        }

        .nop-required {
            color: #b91c1c;
        }

        .auth-red-text {
            color: #b22222 !important;
        }

        .auth-red-action {
            background: #b22222 !important;
            border-color: #b22222 !important;
            color: #d4af37 !important;
        }

        .auth-red-action:hover,
        .auth-red-action:focus {
            background: #991b1b !important;
            border-color: #991b1b !important;
        }

        /* ── Account pages (ChangePassword, Addresses…) ── */
        .account-page .page-body {
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        .account-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 1.5rem;
            box-shadow: 0 12px 28px -22px rgba(15,23,42,0.18);
        }

        .account-card-title {
            font-size: 0.625rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            color: #94a3b8;
            margin-bottom: 1.25rem;
            padding-bottom: 0.625rem;
            border-bottom: 1px solid #f1f5f9;
        }

        .account-field {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            align-items: baseline;
            column-gap: 0.25rem;
            row-gap: 0.375rem;
            margin-bottom: 1rem;
        }

        .account-field:last-child { margin-bottom: 0; }

        .account-field label {
            order: 2;
            flex-shrink: 0;
            font-size: 0.8125rem !important;
            font-weight: 600 !important;
            color: #374151 !important;
            margin: 0 !important;
        }

        .account-field > span.required {
            order: 1;
            flex-shrink: 0;
            margin: 0;
            line-height: 1;
        }

        .account-field > input,
        .account-field > select,
        .account-field > textarea,
        .account-field > div,
        .account-field > .form-input-wrapper {
            order: 3;
            flex-basis: 100%;
            margin-top: 2px !important;
        }

        .account-field > span:not(.required),
        .account-field > a,
        .account-field > .please-wait,
        .account-field > .change-password-recovery-link {
            order: 4;
            flex-basis: 100%;
        }

        .account-field input,
        .account-field select,
        .account-field textarea {
            height: 40px !important;
            border-radius: 10px !important;
            border: 1px solid #e2e8f0 !important;
            background: #f8fafc !important;
            padding: 0 0.875rem !important;
            font-size: 13px !important;
            color: #334155 !important;
        }

        .account-field input:focus,
        .account-field select:focus,
        .account-field textarea:focus {
            border-color: rgba(45,58,34,0.5) !important;
            background: #fff !important;
            box-shadow: 0 0 0 3px rgba(45,58,34,0.10) !important;
            outline: none !important;
        }

        /* ── Pager ── */
        .pager { margin: 0; }
        .pager ul {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            font-size: 0.8125rem;
            flex-wrap: wrap;
        }
        .pager li { display: inline-flex; }
        .pager li a,
        .pager li span {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 34px;
            height: 34px;
            padding: 0 10px;
            border-radius: 8px;
            font-size: 0.8125rem;
            font-weight: 600;
            line-height: 1;
            text-decoration: none;
            transition: background 0.15s, color 0.15s, border-color 0.15s;
            border: 1px solid #e2e8f0;
            background: transparent;
            color: #374151;
            background-image: none !important;
        }
        .pager li a:hover {
            background: #f1f5f9;
            border-color: #cbd5e1;
            color: #1e293b;
        }
        .pager li.current-page span {
            background: #b22222;
            border-color: #b22222;
            color: #d4af37;
            font-weight: 700;
        }
        .pager li.previous-page a,
        .pager li.next-page a,
        .pager li.first-page a,
        .pager li.last-page a {
            background: #f8fafc;
            color: #475569;
            min-width: unset;
            padding: 0 12px;
        }
        .pager li.previous-page a:hover,
        .pager li.next-page a:hover,
        .pager li.first-page a:hover,
        .pager li.last-page a:hover {
            background: #f1f5f9;
            color: #1e293b;
        }

        /* ── Buttons toàn site ── */
        .page .button-1,
        .page button.button-1 {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 40px;
            padding: 0 1.25rem;
            background: #b22222 !important;
            color: #d4af37 !important;
            border-radius: 10px !important;
            font-size: 0.8125rem !important;
            font-weight: 700 !important;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            border: none !important;
            box-shadow: 0 12px 28px -16px rgba(178,34,34,0.6) !important;
            transition: box-shadow 0.2s, transform 0.15s !important;
            background-image: none !important;
        }

        .page .button-1:hover {
            box-shadow: 0 16px 32px -14px rgba(178,34,34,0.7) !important;
            transform: translateY(-1px);
        }

        .page .button-2,
        .page button.button-2 {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 36px;
            padding: 0 1rem;
            background: #f8fafc !important;
            color: #374151 !important;
            border-radius: 8px !important;
            font-size: 0.8125rem !important;
            font-weight: 600 !important;
            border: 1px solid #e2e8f0 !important;
            box-shadow: none !important;
            transition: background 0.15s, border-color 0.15s !important;
            background-image: none !important;
        }

        .page .button-2:hover {
            background: #f1f5f9 !important;
            border-color: #cbd5e1 !important;
        }

        /* Tailwind compatibility layer: legacy DefaultClean selectors are more specific than utility classes. */
