@inject Nop.Services.Security.IPermissionService headerPermissionService
@{
    var currentPath = Context.Request.Path.Value ?? "/";
    var productListingUrl = Url.RouteUrl(NopRouteNames.General.CATEGORIES);
    var blogUrl = Url.RouteUrl(NopRouteNames.General.BLOG);
    var documentPortalUrl = "/tai-lieu";
    var boardsUrl = Url.RouteUrl(NopRouteNames.General.BOARDS);
    var unitsUrl = Url.RouteUrl(NopRouteNames.General.UNITS);
    var directoryUrl = Url.RouteUrl(NopRouteNames.General.UNIT_DIRECTORY) ?? "/danh-ba";
    var userGuideUrl = Url.RouteUrl(NopRouteNames.General.USER_GUIDE) ?? "/tai-lieu-huong-dan";
    var customerInfoUrl = Url.RouteUrl(NopRouteNames.General.CUSTOMER_PROFILE_ACCOUNT);
    var homeUrl = Url.RouteUrl(NopRouteNames.General.HOMEPAGE) ?? "/";
    var canAccessAdminPanel = await headerPermissionService.AuthorizeAsync(Nop.Services.Security.StandardPermission.Security.ACCESS_ADMIN_PANEL);
    var isAdmin = await headerPermissionService.AuthorizeAsync(Nop.Services.Security.StandardPermission.Customers.CUSTOMERS_VIEW);
    var showAdminLink = canAccessAdminPanel;
    var sidebarVerticalClass = "inset-y-0";

    bool IsPathActive(string path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return false;

        if (path == "/")
            return currentPath.Equals("/", StringComparison.OrdinalIgnoreCase);

        return currentPath.Equals(path, StringComparison.OrdinalIgnoreCase)
            || currentPath.StartsWith(path + "/", StringComparison.OrdinalIgnoreCase);
    }

    string NavClass(bool active)
    {
        return active
            ? "public-nav-item public-nav-item-active flex items-center gap-3 rounded-lg border-l-4 border-[#4a5d3a] bg-[rgba(45,58,34,0.4)] px-4 py-3 text-white"
            : "public-nav-item flex items-center gap-3 rounded-lg px-4 py-3 text-slate-400 transition-colors hover:bg-slate-800 hover:text-white";
    }
}

<a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[80] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-slate-900" href="#main">@T("Header.SkipNavigation.Text")</a>
@await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderBefore })

<aside class="public-sidebar public-command-sidebar fixed @sidebarVerticalClass left-0 z-[60] hidden flex-col border-r border-slate-700 bg-slate-900 lg:flex">
    <a href="@homeUrl" class="public-sidebar-brand navbar-dark border-b border-slate-700 bg-gradient-to-b from-[#111827] to-[#0f172a]">
        <div class="public-sidebar-brand-text">
            <div class="public-sidebar-brand-title">Chuyển đổi số</div>
            <div class="public-sidebar-brand-subtitle">Ngành Quân nhu</div>
        </div>
    </a>

    <nav class="flex-1 space-y-1 px-4 py-2" aria-label="Điều hướng quân nhu">
        <a href="@homeUrl" class="@NavClass(IsPathActive("/"))">
            <span class="material-symbols-outlined text-blue-400">home</span>
            <span class="public-control-text font-medium">Trang chủ</span>
        </a>
        <a href="@productListingUrl" class="@NavClass(IsPathActive(productListingUrl ?? "/categories"))">
            <span class="material-symbols-outlined text-amber-400">restaurant</span>
            <span class="public-control-text font-medium">Sản phẩm / Năng lực</span>
        </a>
        <a href="@blogUrl" class="@NavClass(IsPathActive("/blog"))">
            <span class="material-symbols-outlined text-purple-400">article</span>
            <span class="public-control-text font-medium">Tin tức &amp; Văn bản</span>
        </a>
        <a href="@documentPortalUrl" class="@NavClass(IsPathActive("/tai-lieu"))">
            <span class="material-symbols-outlined text-teal-400">folder_open</span>
            <span class="public-control-text font-medium">Kho tài liệu</span>
        </a>
        <a href="@boardsUrl" class="@NavClass(IsPathActive("/boards"))">
            <span class="material-symbols-outlined text-pink-400">forum</span>
            <span class="public-control-text font-medium">Diễn đàn</span>
        </a>
        <a href="@unitsUrl" class="@NavClass(IsPathActive("/don-vi"))">
            <span class="material-symbols-outlined text-cyan-400">corporate_fare</span>
            <span class="public-control-text font-medium">Đơn vị</span>
        </a>
        <a href="@customerInfoUrl" class="@NavClass(IsPathActive("/customer/profile") || IsPathActive("/customer/edit"))">
            <span class="material-symbols-outlined text-lime-400">account_circle</span>
            <span class="public-control-text font-medium">Hồ sơ cá nhân</span>
        </a>
    </nav>

    <div class="space-y-2 border-t border-slate-800 p-4">
        @if (showAdminLink)
        {
            <details class="group rounded-lg border border-slate-800 bg-slate-900/50">
                <summary class="flex cursor-pointer list-none items-center gap-3 rounded-lg px-4 py-3 text-slate-300 transition-colors hover:bg-slate-800 hover:text-white">
                    <span class="material-symbols-outlined">widgets</span>
                    <span class="public-control-text font-medium">Tiện ích</span>
                    <span class="material-symbols-outlined ml-auto text-base transition group-open:rotate-180">expand_more</span>
                </summary>
                <div class="space-y-1 px-3 pb-3">
                    <a href="@directoryUrl" class="public-control-text flex items-center gap-2 rounded-lg px-3 py-2 font-medium text-slate-400 transition hover:bg-slate-800 hover:text-white">
                        <span class="material-symbols-outlined text-[18px]">contacts</span>
                        Danh bạ
                    </a>
                    <a href="@userGuideUrl" class="public-control-text flex items-center gap-2 rounded-lg px-3 py-2 font-medium text-slate-400 transition hover:bg-slate-800 hover:text-white">
                        <span class="material-symbols-outlined text-[18px]">menu_book</span>
                        Tài liệu hướng dẫn
                    </a>
                </div>
            </details>
            <a href="/Admin" class="flex items-center gap-3 rounded-lg px-4 py-3 text-slate-300 transition-colors hover:bg-slate-800 hover:text-white">
                <span class="material-symbols-outlined">admin_panel_settings</span>
                <span class="public-control-text font-medium">@(isAdmin ? "Quản trị hệ thống" : "Quản trị đơn vị")</span>
            </a>
        }
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a href="@Url.RouteUrl(NopRouteNames.Standard.LOGOUT)" class="flex items-center gap-3 rounded-lg px-4 py-3 text-rose-300 transition-colors hover:bg-rose-500/10 hover:text-rose-200">
                <span class="material-symbols-outlined">arrow_back</span>
                <span class="public-control-text font-medium">Đăng xuất</span>
            </a>
        }
        else
        {
            <a href="@Url.RouteUrl(NopRouteNames.General.LOGIN)" class="flex items-center gap-3 rounded-lg border border-emerald-500/50 bg-emerald-700/20 px-4 py-2.5 text-emerald-200 font-semibold transition-colors hover:bg-emerald-700/40 hover:text-white hover:border-emerald-400">
                <span class="material-symbols-outlined">arrow_forward</span>
                <span class="public-control-text font-medium">Đăng nhập</span>
            </a>
        }
    </div>
</aside>

@await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderAfter })
