@{
    Layout = "_Root";
    var isAuthStandalone = ViewData["AuthStandalone"] as bool? ?? false;
}

@if (IsSectionDefined("Breadcrumb"))
{
    <div class="center-1 w-full px-4 pt-4 sm:px-6 lg:px-8 xl:px-10">
        @await RenderSectionAsync("Breadcrumb")
    </div>
}

@if (isAuthStandalone)
{
    <section class="center-1 auth-standalone-shell min-h-[100dvh] bg-slate-100">
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.MainColumnBefore })
        @RenderBody()
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.MainColumnAfter })
    </section>
}
else
{
    <section class="center-1 min-h-screen w-full px-4 py-6 sm:px-6 lg:px-8 xl:px-10">
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.MainColumnBefore })
        @RenderBody()
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.MainColumnAfter })
    </section>
}
