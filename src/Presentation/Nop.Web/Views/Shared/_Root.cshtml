@{
    Layout = "_Root.Head";
    var isAuthStandalone = ViewData["AuthStandalone"] as bool? ?? false;
    var displayName = Context.User.Identity?.IsAuthenticated == true && !string.IsNullOrWhiteSpace(Context.User.Identity?.Name)
        ? Context.User.Identity!.Name!
        : "Sĩ quan trực ban";
    var avatarInitial = displayName.Substring(0, 1).ToUpperInvariant();
}
@await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BodyStartHtmlTagAfter })
@{ await Html.RenderPartialAsync("_Notifications"); }
@{ await Html.RenderPartialAsync("_JavaScriptDisabledWarning"); }
<div class="master-wrapper-page flex min-h-[100dvh] bg-slate-100 text-slate-900">
    @if (!isAuthStandalone)
    {
        await Html.RenderPartialAsync("_Header");
    }
    <div class="flex min-w-0 flex-1 flex-col">
        @if (!isAuthStandalone)
        {
            <div class="sticky top-0 z-40 border-b border-slate-200 bg-white/80 backdrop-blur">
                <div class="flex h-16 items-center justify-between gap-4 px-6 lg:px-8">
                    <form asp-route="@NopRouteNames.General.SEARCH" method="get" class="w-full max-w-md">
                        <label class="relative block">
                            <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-slate-400 material-symbols-outlined text-[20px]">search</span>
                            <input type="search" name="q" class="h-11 w-full rounded-2xl border border-slate-200 bg-slate-100 pr-4 text-sm text-slate-700 outline-none ring-0 transition placeholder:text-slate-400 focus:border-slate-300 focus:bg-white focus:shadow-[0_18px_35px_-24px_rgba(15,23,42,0.35)]" style="padding-left:2.75rem!important" placeholder="Tìm kiếm tài liệu, sản phẩm, đơn vị..." />
                        </label>
                    </form>

                    <div class="flex items-center gap-4">
                        <button type="button" class="relative flex h-11 w-11 items-center justify-center rounded-2xl border border-slate-200 bg-white text-slate-600 shadow-[0_14px_32px_-24px_rgba(15,23,42,0.5)] transition hover:-translate-y-[1px] hover:text-slate-900 active:scale-[0.98]" aria-label="Thông báo">
                            <span class="material-symbols-outlined text-[22px]">notifications</span>
                            <span class="absolute right-3 top-3 h-2.5 w-2.5 rounded-full bg-military-red"></span>
                        </button>

                        <div class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-white px-3 py-2 shadow-[0_14px_32px_-24px_rgba(15,23,42,0.5)]">
                            <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-military-green text-sm font-bold text-military-gold">@avatarInitial</div>
                            <div class="hidden text-right sm:block">
                                <div class="text-sm font-semibold text-slate-900">@displayName</div>
                                <div class="text-xs text-slate-500">Sĩ quan điều phối hậu cần</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        <main class="master-wrapper-content flex-1" id="main">
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ContentBefore })

            @if (IsSectionDefined("Breadcrumb"))
            {
                @RenderSection("Breadcrumb") 
            }
            <div class="master-column-wrapper">
                @RenderBody()
            </div>
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ContentAfter })
        </main>
        @if (!isAuthStandalone)
        {
            <div class="border-t border-slate-200 bg-white/80 px-6 py-6 text-sm text-slate-500 backdrop-blur lg:px-8">
                @await Component.InvokeAsync(typeof(FooterViewComponent))
            </div>
        }
    </div>
</div>
@await Component.InvokeAsync(typeof(EuCookieLawViewComponent))
@await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BodyEndHtmlTagBefore })
