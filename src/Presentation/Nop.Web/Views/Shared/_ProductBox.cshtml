@model ProductOverviewModel

@using Nop.Core
@using Nop.Core.Domain.Catalog
@using Nop.Web.Models.Catalog

@inject CatalogSettings catalogSettings

@{
    var productUrl = await NopUrl.RouteGenericUrlAsync<Product>(new { SeName = Model.SeName });
    var picture = Model.PictureModels.FirstOrDefault();
    var hasPrice = !string.IsNullOrWhiteSpace(Model.ProductPrice.Price);
    var hasShortDescription = catalogSettings.ShowShortDescriptionOnCatalogPages && !string.IsNullOrWhiteSpace(Model.ShortDescription);
    var hasSku = !string.IsNullOrWhiteSpace(Model.Sku);
    var hasBasePrice = !string.IsNullOrWhiteSpace(Model.ProductPrice.BasePricePAngV);
    var leftBadge = hasSku ? Model.Sku : Model.ProductType.ToString();
    var rightBadge = Model.ProductPrice.AvailableForPreOrder
        ? "Đặt trước"
        : Model.ProductPrice.DisableBuyButton || Model.ProductPrice.CallForPrice || Model.ProductPrice.HidePrices
            ? "Liên hệ"
            : hasPrice
                ? "Có sẵn"
                : "Cập nhật";
    var rightBadgeClass = rightBadge == "Đặt trước"
        ? "bg-amber-500 text-white"
        : rightBadge == "Liên hệ"
            ? "bg-slate-700 text-white"
            : rightBadge == "Có sẵn"
                ? "bg-[#1152d4] text-white"
                : "bg-slate-200 text-slate-700";
    var descriptionText = hasShortDescription ? Model.ShortDescription : Model.FullDescription;
    var metaRows = new List<(string Label, string Value)>();

    foreach (var group in Model.ProductSpecificationModel.Groups ?? Enumerable.Empty<ProductSpecificationAttributeGroupModel>())
    {
        foreach (var attribute in group.Attributes ?? Enumerable.Empty<ProductSpecificationAttributeModel>())
        {
            var firstValue = attribute.Values?.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value.ValueRaw))?.ValueRaw;
            if (string.IsNullOrWhiteSpace(attribute.Name) || string.IsNullOrWhiteSpace(firstValue))
                continue;

            metaRows.Add((attribute.Name, firstValue));
            if (metaRows.Count == 2)
            {
                break;
            }
        }

        if (metaRows.Count == 2)
        {
            break;
        }
    }

    if (metaRows.Count < 2 && hasSku)
    {
        metaRows.Add(("Mã sản phẩm", Model.Sku));
    }

    if (metaRows.Count < 2 && hasPrice)
    {
        metaRows.Add(("Mức giá", Model.ProductPrice.Price));
    }

    if (metaRows.Count < 2 && hasBasePrice)
    {
        metaRows.Add(("Đơn vị", Model.ProductPrice.BasePricePAngV));
    }

    if (metaRows.Count < 2)
    {
        metaRows.Add(("Loại", Model.ProductType.ToString()));
    }

    var searchData = string.Join(" ", new[]
    {
        Model.Name,
        leftBadge,
        descriptionText,
        string.Join(" ", metaRows.Select(meta => $"{meta.Label} {meta.Value}"))
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
}

<article class="product-item group flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-[0_12px_28px_-24px_rgba(15,23,42,0.22)] transition duration-300 hover:shadow-[0_18px_36px_-24px_rgba(15,23,42,0.24)]" data-productid="@Model.Id" data-product-search="@searchData">
    <div class="picture relative h-48 overflow-hidden bg-slate-100">
        @if (!string.IsNullOrWhiteSpace(leftBadge))
        {
            <div class="absolute left-3 top-3 z-10 rounded-sm border border-slate-200 bg-white/95 px-2 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-700">
                @leftBadge
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(rightBadge))
        {
            <div class="absolute right-3 top-3 z-10 rounded-sm px-2 py-1 text-[10px] font-bold uppercase tracking-[0.12em] @rightBadgeClass">
                @rightBadge
            </div>
        }
        <a class="block h-full w-full" href="@productUrl" title="@picture?.Title">
            <img class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" alt="@picture?.AlternateText" src="@picture?.ImageUrl" title="@picture?.Title" />
        </a>
    </div>

    <div class="details flex flex-1 flex-col gap-4 p-5">
        <div class="space-y-1">
            <h2 class="product-title text-lg font-bold leading-tight text-slate-900">
                <a class="transition group-hover:text-[#1152d4]" href="@productUrl">@Model.Name</a>
            </h2>

            @if (!string.IsNullOrWhiteSpace(descriptionText))
            {
                <div class="description line-clamp-2 text-xs font-medium leading-5 text-slate-500">
                    @Html.Raw(descriptionText)
                </div>
            }
        </div>

        <div class="add-info flex flex-1 flex-col">
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductBoxAddinfoBefore, additionalData = Model })

            <div class="space-y-2 text-sm text-slate-600">
                @foreach (var meta in metaRows.Take(2))
                {
                    <div class="flex items-start gap-2">
                        <span aria-hidden="true" class="mt-1 inline-flex h-2 w-2 flex-none rounded-full bg-slate-300"></span>
                        <div class="min-w-0">
                            <span class="text-slate-500">@meta.Label:</span>
                            <span class="ml-1 font-medium text-slate-900">@Html.Raw(meta.Value)</span>
                        </div>
                    </div>
                }
            </div>

            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductBoxAddinfoMiddle, additionalData = Model })

            <div class="buttons mt-4 pt-2">
                <a href="@productUrl" class="inline-flex h-[42px] w-full items-center justify-center gap-2 rounded-lg bg-slate-100 px-4 text-sm font-bold text-slate-900 transition hover:bg-[#1152d4] hover:text-white active:scale-[0.98]">
                    <span>Xem chi tiết</span>
                    <svg aria-hidden="true" class="h-4 w-4" fill="none" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
                        <path d="M3.33334 8H12.6667" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" />
                        <path d="M8.66669 4L12.6667 8L8.66669 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" />
                    </svg>
                </a>
            </div>

            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductBoxAddinfoAfter, additionalData = Model })
        </div>
    </div>
</article>
