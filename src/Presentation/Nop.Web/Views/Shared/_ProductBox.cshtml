@model ProductOverviewModel

@using Nop.Core
@using Nop.Core.Domain.Catalog
@using Nop.Web.Models.Catalog

@inject CatalogSettings catalogSettings

@{
    var productUrl = await NopUrl.RouteGenericUrlAsync<Product>(new { SeName = Model.SeName });
    var picture = Model.PictureModels.FirstOrDefault();
    var hasPrice = !string.IsNullOrWhiteSpace(Model.ProductPrice.Price);
    var hasShortDescription = !string.IsNullOrWhiteSpace(Model.ShortDescription);
    var hasSku = !string.IsNullOrWhiteSpace(Model.Sku);
    var hasBasePrice = !string.IsNullOrWhiteSpace(Model.ProductPrice.BasePricePAngV);
    var categoryBadge = ViewData["categoryName"] as string;
    var leftBadge = !string.IsNullOrWhiteSpace(categoryBadge) ? categoryBadge : (hasSku ? Model.Sku : Model.ProductType.ToString());
    var availabilityStatus = Model.ProductPrice.AvailableForPreOrder
        ? "preorder"
        : Model.ProductPrice.DisableBuyButton
            ? "supplying"
            : "available";
    var availabilityText = availabilityStatus == "preorder"
        ? "Đặt trước"
        : availabilityStatus == "supplying"
            ? "Đang cung ứng"
            : "Có sẵn";
    var availabilityBadgeClass = availabilityStatus == "preorder"
        ? "bg-amber-500 text-white"
        : availabilityStatus == "supplying"
            ? "bg-orange-500 text-white"
            : "bg-emerald-600 text-white";
    var availabilityDotClass = availabilityStatus == "preorder"
        ? "bg-amber-500"
        : availabilityStatus == "supplying"
            ? "bg-orange-500"
            : "bg-emerald-500";
    var descriptionText = hasShortDescription ? Model.ShortDescription : Model.FullDescription;
    var metaRows = new List<(string Label, string Value)>();

    foreach (var group in Model.ProductSpecificationModel.Groups ?? Enumerable.Empty<ProductSpecificationAttributeGroupModel>())
    {
        foreach (var attribute in group.Attributes ?? Enumerable.Empty<ProductSpecificationAttributeModel>())
        {
            var firstValue = attribute.Values?.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value.ValueRaw))?.ValueRaw;
            if (string.IsNullOrWhiteSpace(attribute.Name) || string.IsNullOrWhiteSpace(firstValue))
                continue;

            metaRows.Add((attribute.Name, firstValue));
            if (metaRows.Count == 2)
                break;
        }

        if (metaRows.Count == 2)
            break;
    }

    if (metaRows.Count < 2 && hasSku)
        metaRows.Add(("Mã sản phẩm", Model.Sku));

    if (metaRows.Count < 2 && hasBasePrice)
        metaRows.Add(("Đơn vị", Model.ProductPrice.BasePricePAngV));

    if (metaRows.Count < 2 && hasPrice)
        metaRows.Add(("Mức giá", Model.ProductPrice.Price));

    if (metaRows.Count < 2)
        metaRows.Add(("Loại", Model.ProductType.ToString()));

    var supplierText = metaRows.FirstOrDefault().Value;
    var detailText = metaRows.Skip(1).FirstOrDefault().Value;
    var searchData = string.Join(" ", new[]
    {
        Model.Name,
        leftBadge,
        availabilityText,
        descriptionText,
        supplierText,
        detailText,
        string.Join(" ", metaRows.Select(meta => $"{meta.Label} {meta.Value}"))
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    var favoriteIcon = Model.IsFavorite ? "favorite" : "favorite_border";
    var favoriteTitle = Model.IsFavorite ? "Bo yeu thich" : "Danh dau yeu thich";
}

<article class="command-product-card product-item group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_14px_32px_-28px_rgba(15,23,42,0.5)] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_24px_44px_-30px_rgba(15,23,42,0.55)]" data-productid="@Model.Id" data-product-search="@searchData" data-product-status="@availabilityStatus">
    <div class="picture relative h-48 overflow-hidden bg-slate-100">
        <div class="absolute left-3 top-3 z-20 rounded-sm bg-slate-900/80 px-2 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-white backdrop-blur-sm">
            @leftBadge
        </div>
        <a class="block h-full w-full" href="@productUrl" title="@(picture?.Title ?? Model.Name)">
            @if (!string.IsNullOrWhiteSpace(picture?.ImageUrl))
            {
                <img class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.05]" alt="@(picture?.AlternateText ?? Model.Name)" src="@picture.ImageUrl" title="@(picture?.Title ?? Model.Name)" />
            }
            else
            {
                <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-slate-200 to-slate-100 text-slate-500">
                    <span class="material-symbols-outlined text-4xl">inventory_2</span>
                </div>
            }
        </a>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-12 bg-gradient-to-t from-black/20 to-transparent"></div>
    </div>

    <div class="details flex flex-1 flex-col p-4">
        <div class="flex-1 space-y-2">
            <div class="flex items-start gap-2">
                <h2 class="product-title public-list-title min-w-0 flex-1 font-bold text-slate-900 line-clamp-2">
                    <a class="transition group-hover:text-primary" href="@productUrl">@Model.Name</a>
                </h2>
                <button type="button"
                        class="favorite-toggle-btn ml-auto inline-flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full border bg-white transition hover:border-rose-300 hover:bg-rose-50 hover:text-rose-600 @(Model.IsFavorite ? "border-rose-300 text-rose-600" : "border-slate-200 text-slate-600")"
                        data-product-id="@Model.Id"
                        data-is-favorite="@Model.IsFavorite.ToString().ToLowerInvariant()"
                        title="@favoriteTitle"
                        aria-label="@favoriteTitle">
                    <span class="material-symbols-outlined text-[18px]">@favoriteIcon</span>
                </button>
            </div>

            <p class="min-h-[34px] text-[11px] leading-[1.5] text-slate-500 line-clamp-2">
                @if (!string.IsNullOrWhiteSpace(descriptionText))
                {
                    @Html.Raw(descriptionText)
                }
            </p>

            @{
                var showSupplierText = !string.IsNullOrWhiteSpace(supplierText) && supplierText != leftBadge && supplierText != Model.Sku;
            }
            @if (showSupplierText)
            {
                <p class="truncate text-[11px] text-slate-500">@Html.Raw(supplierText)</p>
            }

        </div>

        <div class="add-info mt-auto pt-3 flex flex-col gap-2.5">
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductBoxAddinfoBefore, additionalData = Model })

            <div class="flex items-center justify-between border-t border-slate-100 pt-2.5">
                <div class="flex items-center gap-1.5">
                    <span class="h-1.5 w-1.5 rounded-full flex-shrink-0 @availabilityDotClass @(availabilityStatus == "available" ? "animate-pulse" : string.Empty)"></span>
                    <span class="text-[10px] font-semibold uppercase tracking-wide text-slate-500">@availabilityText</span>
                </div>
                @if (hasPrice)
                {
                    <span class="text-sm font-black tracking-tight text-primary">@Html.Raw(Model.ProductPrice.Price)</span>
                }
                else if (hasSku)
                {
                    <span class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-mono font-semibold text-slate-500">@Model.Sku</span>
                }
            </div>

            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductBoxAddinfoMiddle, additionalData = Model })

            <a href="@productUrl" class="product-detail-btn inline-flex h-9 w-full items-center justify-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-4 text-xs font-bold text-slate-700 transition hover:border-primary hover:bg-primary hover:text-white active:scale-[0.98]">
                <span>Xem chi tiết</span>
                <span class="material-symbols-outlined text-[15px]">arrow_right_alt</span>
            </a>

            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductBoxAddinfoAfter, additionalData = Model })
        </div>
    </div>
</article>

<script asp-location="Footer">
    $(function () {
        $(document)
            .off('click.productFavorite', '.favorite-toggle-btn')
            .on('click.productFavorite', '.favorite-toggle-btn', function () {
                var $btn = $(this);
                var productId = Number($btn.data('product-id'));
                if (!productId || $btn.prop('disabled'))
                    return;

                var postData = {
                    productId: productId
                };
                addAntiForgeryToken(postData);

                $btn.prop('disabled', true);

                $.ajax({
                    cache: false,
                    url: '@Url.Action("ToggleFavorite", "Product")',
                    type: 'POST',
                    data: postData,
                    success: function (response) {
                        if (!response || !response.success) {
                            if (response && response.loginUrl) {
                                setLocation(response.loginUrl);
                                return;
                            }
                            return;
                        }

                        var isFavorite = !!response.isFavorite;
                        $btn.data('is-favorite', isFavorite ? 'true' : 'false');
                        $btn.attr('title', isFavorite ? 'Bo yeu thich' : 'Danh dau yeu thich');
                        $btn.attr('aria-label', isFavorite ? 'Bo yeu thich' : 'Danh dau yeu thich');

                        var $icon = $btn.find('.material-symbols-outlined');
                        $icon.text(isFavorite ? 'favorite' : 'favorite_border');

                        if (isFavorite)
                            $btn.addClass('text-rose-600 border-rose-300');
                        else
                            $btn.removeClass('text-rose-600 border-rose-300');
                    },
                    complete: function () {
                        $btn.prop('disabled', false);
                    }
                });
            });
    });
</script>
