@using Nop.Services.Localization
@using Nop.Core
@inject ILocalizationService localizationService
@inject IStoreContext storeContext

@{
    Layout = "_ColumnsOne";

    var homepageTitle = await localizationService.GetLocalizedAsync(await storeContext.GetCurrentStoreAsync(), s => s.HomepageTitle);

    if (!string.IsNullOrEmpty(homepageTitle))
    {
        NopHtml.AddTitleParts(homepageTitle);
    }

    var homepageDescription = await localizationService.GetLocalizedAsync(await storeContext.GetCurrentStoreAsync(), s => s.HomepageDescription);

    if (!string.IsNullOrEmpty(homepageDescription))
    {
        NopHtml.AddMetaDescriptionParts(homepageDescription);
    }

    NopHtml.AppendPageCssClassParts("html-home-page");

    var displayName = Context.User.Identity?.IsAuthenticated == true && !string.IsNullOrWhiteSpace(Context.User.Identity?.Name)
        ? Context.User.Identity!.Name!
        : "đồng chí phụ trách";
    var blogArchiveUrl = Url.RouteUrl(NopRouteNames.General.BLOG);
    var productListingUrl = Url.RouteUrl(NopRouteNames.General.CATEGORIES);
}

<div class="page home-page">
    <div class="page-body space-y-8">
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HomepageTop })

        <section class="overflow-hidden rounded-[28px] bg-military-green text-white shadow-[0_24px_60px_-30px_rgba(45,58,34,0.85)]">
            <div class="grid gap-8 px-8 py-10 lg:grid-cols-[1.2fr_0.8fr] lg:px-10 lg:py-12">
                <div class="space-y-6">
                    <span class="inline-flex items-center rounded-full border border-white/15 bg-white/10 px-4 py-2 text-xs font-semibold tracking-[0.24em] text-military-gold shadow-[inset_0_1px_0_rgba(255,255,255,0.1)] backdrop-blur">
                        HỆ THỐNG QUẢN LÝ THÔNG TIN QUÂN SỰ
                    </span>
                    <div class="space-y-3">
                        <h1 class="max-w-3xl text-4xl font-black tracking-tight text-white md:text-5xl">Chào mừng, @displayName</h1>
                        <p class="text-base text-white/90 md:text-lg">Đơn vị: Bộ Tư lệnh Tăng Thiết Giáp</p>
                        <p class="max-w-2xl text-sm leading-7 text-white/75 md:text-base">Bảng điều phối tập trung cho kho bãi, văn bản nghiệp vụ và thông tin sản phẩm chiến lược trong toàn mạng lưới hậu cần - quân nhu.</p>
                    </div>
                    <div class="flex flex-wrap gap-3">
                        <a href="@productListingUrl" class="inline-flex items-center justify-center rounded-2xl border border-white/20 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10 active:scale-[0.98]">Xem sản phẩm</a>
                        <a href="@Url.RouteUrl(NopRouteNames.General.CUSTOMER_INFO)" class="inline-flex items-center justify-center rounded-2xl bg-military-red px-5 py-3 text-sm font-semibold text-white shadow-[0_20px_40px_-25px_rgba(185,28,28,0.9)] transition hover:-translate-y-[1px] active:scale-[0.98]">Hồ sơ đơn vị</a>
                    </div>
                </div>

                <div class="grid gap-4 rounded-[24px] border border-white/10 bg-white/10 p-5 shadow-[inset_0_1px_0_rgba(255,255,255,0.1)] backdrop-blur">
                    <div class="rounded-2xl border border-white/10 bg-slate-950/20 p-4">
                        <div class="text-xs font-semibold uppercase tracking-[0.24em] text-military-gold">Bản xem nhanh trang chủ</div>
                        <p class="mt-3 text-sm leading-6 text-white/75">Trang chủ đang lấy trực tiếp dữ liệu từ sản phẩm hiển thị trên homepage, blog lõi của hệ thống và chủ đề diễn đàn đang hoạt động.</p>
                    </div>
                    <div class="grid gap-4 sm:grid-cols-2">
                        <a href="@productListingUrl" class="rounded-2xl border border-white/10 bg-white/5 p-4 transition hover:bg-white/10 active:scale-[0.98]">
                            <div class="text-xs uppercase tracking-[0.2em] text-white/60">Sản phẩm</div>
                            <div class="mt-2 text-lg font-bold text-white">Danh mục nổi bật</div>
                            <div class="mt-1 text-sm text-white/60">Danh sách teaser ngắn gọn từ dữ liệu thật</div>
                        </a>
                        <a href="@Url.RouteUrl(NopRouteNames.General.BOARDS)" class="rounded-2xl border border-white/10 bg-white/5 p-4 transition hover:bg-white/10 active:scale-[0.98]">
                            <div class="text-xs uppercase tracking-[0.2em] text-white/60">Diễn đàn</div>
                            <div class="mt-2 text-lg font-bold text-white">Chủ đề mới cập nhật</div>
                            <div class="mt-1 text-sm text-white/60">Đi tới các thảo luận đang có hoạt động</div>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <section class="grid grid-cols-2 gap-4 md:grid-cols-4">
            <a href="@productListingUrl" class="flex flex-col items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white p-5 text-center shadow-[0_18px_40px_-28px_rgba(15,23,42,0.18)] transition hover:border-military-green hover:-translate-y-[2px] hover:shadow-[0_22px_50px_-30px_rgba(45,58,34,0.35)] active:scale-[0.98]">
                <span class="material-symbols-outlined text-3xl text-military-green">search</span>
                <span class="text-xs font-bold uppercase tracking-[0.18em] text-slate-700">Tra cứu sản phẩm</span>
            </a>
            <a href="@blogArchiveUrl" class="flex flex-col items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white p-5 text-center shadow-[0_18px_40px_-28px_rgba(15,23,42,0.18)] transition hover:border-military-green hover:-translate-y-[2px] hover:shadow-[0_22px_50px_-30px_rgba(45,58,34,0.35)] active:scale-[0.98]">
                <span class="material-symbols-outlined text-3xl text-military-green">newsmode</span>
                <span class="text-xs font-bold uppercase tracking-[0.18em] text-slate-700">Tin tức</span>
            </a>
            <a href="@Url.RouteUrl(NopRouteNames.General.BOARDS)" class="flex flex-col items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white p-5 text-center shadow-[0_18px_40px_-28px_rgba(15,23,42,0.18)] transition hover:border-military-green hover:-translate-y-[2px] hover:shadow-[0_22px_50px_-30px_rgba(45,58,34,0.35)] active:scale-[0.98]">
                <span class="material-symbols-outlined text-3xl text-military-green">chat_bubble</span>
                <span class="text-xs font-bold uppercase tracking-[0.18em] text-slate-700">Diễn đàn</span>
            </a>
            <a href="@productListingUrl" class="flex flex-col items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white p-5 text-center shadow-[0_18px_40px_-28px_rgba(15,23,42,0.18)] transition hover:border-military-green hover:-translate-y-[2px] hover:shadow-[0_22px_50px_-30px_rgba(45,58,34,0.35)] active:scale-[0.98]">
                <span class="material-symbols-outlined text-3xl text-military-green">manage_search</span>
                <span class="text-xs font-bold uppercase tracking-[0.18em] text-slate-700">Kho dữ liệu</span>
            </a>
        </section>

        <section class="grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(320px,1fr)]">
            <div class="space-y-6">
                <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
                    <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
                        <h2 class="flex items-center gap-2 text-lg font-bold text-slate-800">
                            <span class="material-symbols-outlined text-[22px] text-military-green">newsmode</span>
                            Tin tức &amp; Thông báo mới
                        </h2>
                        <a href="@blogArchiveUrl" class="text-sm font-semibold text-military-green transition hover:underline">Tất cả tin tức</a>
                    </div>
                    <div class="p-5">
                        @await Component.InvokeAsync(typeof(HomepageBlogPostsViewComponent))
                    </div>
                </div>

                <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
                    <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
                        <h2 class="flex items-center gap-2 text-lg font-bold text-slate-800">
                            <span class="material-symbols-outlined text-[22px] text-military-green">description</span>
                            Văn bản mới ban hành
                        </h2>
                    </div>
                    <div class="p-5">
                        <div class="min-h-40 rounded-2xl border border-dashed border-slate-300 bg-slate-50/80 shadow-[inset_0_1px_0_rgba(255,255,255,0.7)]"></div>
                    </div>
                </div>
            </div>

            <div class="space-y-6">
                <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
                    <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
                        <h2 class="flex items-center gap-2 text-lg font-bold text-slate-800">
                            <span class="material-symbols-outlined text-[22px] text-military-green">precision_manufacturing</span>
                            Sản phẩm tiêu biểu
                        </h2>
                    </div>
                    <div class="p-5">
                        @await Component.InvokeAsync(typeof(HomepageProductsViewComponent))
                    </div>
                    <div class="border-t border-slate-100 px-5 py-4">
                        <a href="@productListingUrl" class="text-sm font-semibold text-military-green transition hover:underline">Xem toàn bộ danh mục</a>
                    </div>
                </div>

                <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
                    <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
                        <h2 class="flex items-center gap-2 text-lg font-bold text-slate-800">
                            <span class="material-symbols-outlined text-[22px] text-military-green">chat_bubble</span>
                            Hoạt động diễn đàn
                        </h2>
                        <a href="@Url.RouteUrl(NopRouteNames.General.BOARDS)" class="text-sm font-semibold text-military-green transition hover:underline">Đi tới diễn đàn</a>
                    </div>
                    <div class="p-5">
                        @await Component.InvokeAsync(typeof(ForumActiveDiscussionsSmallViewComponent))
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
