@inject Nop.Core.Domain.Common.DutyMessageSettings dutyMessageSettings
<style>
    .auth-left-panel {
        font-family: var(--app-font-family);
        background: radial-gradient(circle at 15% 20%, rgba(254,214,91,0.18), transparent 26%), linear-gradient(135deg, #2e0001 0%, #111827 56%, #232900 100%);
    }

    .auth-left-panel :where(*):not(.material-symbols-outlined) {
        font-family: var(--app-font-family) !important;
    }

    .auth-left-panel .material-symbols-outlined {
        font-family: 'Material Symbols Outlined' !important;
    }

    .auth-left-pattern {
        background-image: radial-gradient(circle, rgba(255,255,255,0.05) 1px, transparent 1px);
        background-size: 50px 50px;
    }

    .auth-left-kicker {
        color: #fbbf24;
        font-size: var(--public-font-label);
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }

    .auth-left-meta {
        color: #cbd5e1;
        font-size: var(--public-font-control);
    }

    .auth-left-title {
        color: #fef3c7;
        font-size: var(--public-font-page-title);
        font-weight: 800;
        letter-spacing: -0.015em;
        line-height: 1.15;
    }

    .auth-left-subtitle {
        color: #e2e8f0;
        font-size: var(--public-font-section-title);
        font-weight: 700;
    }

    .auth-left-description {
        max-width: 32rem;
        color: #cbd5e1;
        font-size: var(--public-font-body);
        font-weight: 500;
        line-height: 1.6;
    }

    .auth-duty-quote {
        margin-top: 1rem;
        color: #ffffff;
        font-size: var(--public-font-body);
        font-style: normal;
        font-weight: 600;
        line-height: 1.6;
    }

    .auth-duty-author {
        margin-top: 1rem;
        color: #94a3b8;
        font-size: var(--public-font-meta);
        font-weight: 500;
    }

    .auth-left-card-title {
        color: #ffffff;
        font-size: var(--public-font-card-title);
        font-weight: 700;
    }

    .auth-left-card-text {
        color: #94a3b8;
        font-size: var(--public-font-meta);
        font-weight: 500;
    }
</style>
<section class="auth-left-panel relative hidden min-h-[34rem] w-full overflow-hidden lg:flex lg:flex-col lg:items-start lg:justify-center lg:gap-[6%] lg:px-[8%] lg:py-[7%]">
    <div class="auth-left-pattern absolute inset-0"></div>
    <div class="pointer-events-none absolute -right-40 -top-40 h-96 w-96 rounded-full bg-yellow-500/10 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-40 -left-40 h-96 w-96 rounded-full bg-red-900/20 blur-3xl"></div>

    <div class="relative w-full space-y-[7%] text-white">
        <div class="flex items-center gap-4">
            <div class="flex-shrink-0 inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-white/20 bg-white/10 backdrop-blur-sm shadow-[inset_0_1px_0_rgba(255,255,255,0.15)]">
                <span class="material-symbols-outlined text-3xl text-yellow-400">shield</span>
            </div>
            <div>
                <p class="auth-left-kicker">HỆ THỐNG ĐIỀU PHỐI</p>
                <p class="auth-left-meta">Cổng thông tin nội bộ</p>
            </div>
        </div>

        <div class="space-y-4">
            <h1 class="auth-left-title">
                @(string.IsNullOrWhiteSpace(dutyMessageSettings.LoginTitle) ? "Cổng thông tin Hậu cần – Quân nhu" : dutyMessageSettings.LoginTitle)
            </h1>
            <p class="auth-left-subtitle">
                @(string.IsNullOrWhiteSpace(dutyMessageSettings.LoginSubtitle) ? "Binh chủng Tăng Thiết Giáp" : dutyMessageSettings.LoginSubtitle)
            </p>
            <p class="auth-left-description">
                @(string.IsNullOrWhiteSpace(dutyMessageSettings.LoginDescription) ? "Quản lý kho bãi, danh mục vật tư và luồng văn bản nghiệp vụ trên một giao diện thống nhất, ưu tiên tốc độ xử lý và tính sẵn sàng." : dutyMessageSettings.LoginDescription)
            </p>
        </div>
    </div>

    <div class="relative w-full space-y-[4%]">
        @if (!string.IsNullOrWhiteSpace(dutyMessageSettings.Message))
        {
            <div class="rounded-2xl border border-white/10 bg-white/5 p-[5%] text-slate-100 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] backdrop-blur-md">
                <p class="auth-left-kicker">THÔNG ĐIỆP TRỰC BAN</p>
                <blockquote class="auth-duty-quote">"@dutyMessageSettings.Message"</blockquote>
                @if (!string.IsNullOrWhiteSpace(dutyMessageSettings.Author))
                {
                    <p class="auth-duty-author">- @dutyMessageSettings.Author</p>
                }
            </div>
        }

        <div class="rounded-2xl border border-white/10 bg-white/5 p-[5%] backdrop-blur-md">
            <div class="flex items-center gap-4">
                <div class="flex-shrink-0 h-12 w-12 rounded-lg bg-white/10 flex items-center justify-center">
                    <span class="material-symbols-outlined text-2xl text-yellow-400">verified</span>
                </div>
                <div>
                    <h4 class="auth-left-card-title">Bảo mật &amp; Tập trung</h4>
                    <p class="auth-left-card-text">Dữ liệu được mã hóa đa lớp tiêu chuẩn quân đội.</p>
                </div>
            </div>
        </div>
    </div>
</section>
