@using Nop.Core
@model CustomerInfoModel
@inject Nop.Core.IWebHelper webHelper
@{
    Layout = "_ColumnsTwo";

    NopHtml.AddTitleParts(T("PageTitle.Account").Text);
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-customer-info-page");

    var fullName = $"{Model.FirstName} {Model.LastName}".Trim();
    if (string.IsNullOrWhiteSpace(fullName))
        fullName = Context.User.Identity?.Name ?? "Hồ sơ quân nhân";

    var avatarReturnUrl = webHelper.GetRawUrl(Context.Request);

    string getAvatarInitial(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var namePart = name.Trim()
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .LastOrDefault() ?? name.Trim();

        return namePart.Substring(0, 1).ToUpper(new System.Globalization.CultureInfo("vi-VN"));
    }
}

@section left
{
    @await Component.InvokeAsync(typeof(CustomerNavigationViewComponent), new { selectedTabId = CustomerNavigationEnum.Info })
}

@section Breadcrumb
{
    <nav class="public-breadcrumb flex flex-wrap items-center gap-2 text-slate-500" aria-label="Breadcrumb">
        <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="transition hover:text-military-green">Trang chủ</a>
        <span class="material-symbols-outlined text-sm text-slate-400">chevron_right</span>
        <a asp-route="@NopRouteNames.General.CUSTOMER_PROFILE_ACCOUNT" class="transition hover:text-military-green">Hồ sơ cá nhân</a>
        <span class="material-symbols-outlined text-sm text-slate-400">chevron_right</span>
        <span class="text-slate-700">Cập nhật hồ sơ</span>
    </nav>
}

<style>
.command-edit-page {
    padding: 0 0 32px;
    background: transparent;
    min-height: auto;
}

.command-header {
    margin-bottom: 8px;
}

.customer-info-page .command-header {
    min-height: auto !important;
    margin-bottom: 14px !important;
    padding: 1rem 1.25rem !important;
    border-radius: 18px !important;
}

.customer-info-page .command-header .public-blue-hero-content {
    gap: 0.75rem !important;
}

.customer-info-page .command-header .public-hero-title {
    font-size: clamp(1.35rem, 0.55vw + 1.1rem, 1.7rem) !important;
}

.customer-info-page .command-header .public-hero-subtitle {
    font-size: 0.92rem !important;
}

.command-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
}

.command-chip {
    border-radius: 6px;
    padding: 3px 8px;
    background: #dbe3ef;
    color: #44474c;
    font-size: var(--public-font-label);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
}

.command-shell {
    display: block;
}

.profile-side-card,
.command-card,
.command-footer {
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 20px 40px -34px rgba(20, 28, 36, 0.25);
}

.profile-side-card {
    padding: 26px;
    text-align: center;
}

.profile-photo-wrap {
    position: relative;
    width: 140px;
    height: 140px;
    margin: 0 auto 16px;
}

.profile-photo {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(135deg, #0f172a 0%, #29313a 100%);
    border: 4px solid #dbe3ef;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffe088;
    font-size: 46px;
    font-weight: 800;
    letter-spacing: -0.02em;
    overflow: hidden;
}

.profile-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.profile-photo-link {
    position: absolute;
    right: 4px;
    bottom: 4px;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 999px;
    background: #2e0001;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    cursor: pointer;
}

.profile-side-card h2 {
    margin: 0;
    color: #141c24;
    font-size: var(--public-font-card-title);
    font-weight: 800;
}

.profile-meta {
    margin-top: 8px;
    color: #64748b;
    font-size: var(--public-font-meta);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
}

.profile-side-action {
    margin-top: 18px;
    display: block;
    border-radius: 8px;
    padding: 10px 12px;
    background: #f0f1ed;
    color: #141c24;
    text-decoration: none;
    font-size: var(--public-font-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

.profile-side-action + .profile-side-action {
    margin-top: 10px;
}

.profile-side-action-danger {
    width: 100%;
    border: 0;
    background: #ffdad6;
    color: #93000a;
    cursor: pointer;
}

.command-card {
    overflow: hidden;
    border: 1px solid #e2e8f0;
}

.command-section {
    padding: 20px;
    background: #fff;
}

.command-section + .command-section {
    background: #f7f9ff;
}

.command-section h3 {
    margin: 0 0 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    color: #141c24;
    font-size: var(--public-font-list-title);
    font-weight: 700;
}

.command-section h3::before {
    content: "";
    width: 4px;
    height: 18px;
    border-radius: 999px;
    background: #b91d20;
}

.command-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 12px;
}

.command-profile-section .command-profile-top-grid {
    grid-template-columns: minmax(22%, 28%) repeat(2, minmax(0, 1fr));
    align-items: stretch;
}

.command-profile-section .command-profile-rest-grid {
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1.1fr) minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: end;
    margin-top: 10px;
}

.command-profile-section .command-unit-field,
.command-profile-section .command-position-field,
.command-profile-section .command-enlistment-field,
.command-profile-section .command-gender-field {
    grid-column: auto;
}

.command-profile-section .command-gender-field {
    align-self: start;
}

.command-field {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 4px;
    row-gap: 4px;
}

.command-field > label,
.command-field > .label {
    order: 2;
    flex-shrink: 0;
    width: auto !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    color: #44474c !important;
    font-size: var(--public-font-label) !important;
    font-weight: 800 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.1em !important;
}

.command-field > .required,
.command-field > .nop-required {
    order: 1;
    flex-shrink: 0;
    margin: 0;
    line-height: 1;
}

.command-field > .input-shell,
.command-field > input,
.command-field > select,
.command-field > textarea,
.command-field > .gdpr-row,
.command-field > .command-readonly,
.command-field > div:not(.required):not(.nop-required):not(.label) {
    order: 3;
    flex-basis: 100%;
    margin-top: 2px;
}

.command-field > span:not(.required):not(.nop-required):not(.label),
.command-field > a,
.command-field > .please-wait,
.command-field > .field-validation-error,
.command-field > .field-validation-valid {
    order: 4;
    flex-basis: 100%;
}

.input-shell {
    position: relative;
}

.input-icon {
    position: absolute;
    left: 11px;
    top: 50%;
    transform: translateY(-50%);
    color: #75777c;
    font-size: 18px;
    pointer-events: none;
}

.command-enlistment-field .input-icon {
    left: 11px;
    font-size: 20px;
}

.command-field input[type="text"],
.command-field input[type="email"],
.command-field input[type="tel"],
.command-field input[type="password"],
.command-field input[type="date"],
.command-field select,
.command-field textarea,
.command-readonly {
    width: 100%;
    min-height: 44px;
    border: 0;
    border-radius: 8px;
    background: #ffffff;
    box-shadow: inset 0 0 0 1px rgba(196, 198, 204, 0.35);
    padding: 11px 12px 11px 42px !important;
    color: #141c24;
    font-size: var(--public-font-control);
    font-weight: 600;
    transition: box-shadow .18s ease;
}

.command-field textarea {
    min-height: 96px;
    padding-top: 12px !important;
}

.command-field input:focus,
.command-field select:focus,
.command-field textarea:focus {
    outline: none;
    box-shadow: inset 0 0 0 2px rgba(185, 29, 32, 0.4);
}

.command-field input[type="date"]::-webkit-calendar-picker-indicator {
    width: auto;
    height: auto;
    margin-right: 0;
    padding: 0;
    opacity: 1;
    cursor: pointer;
}

.command-field input[type="date"]::-webkit-inner-spin-button,
.command-field input[type="date"]::-webkit-clear-button {
    display: none;
}

.command-readonly {
    display: flex;
    align-items: center;
    background: #f4f5f2;
    color: #44474c;
}

.field-validation-error {
    color: #ba1a1a;
    font-size: var(--public-font-meta);
    font-weight: 700;
}

.message-error {
    margin-bottom: 14px;
    border-radius: 10px;
    background: #ffdad6;
    color: #93000a;
    padding: 10px 14px;
    font-size: var(--public-font-meta);
    font-weight: 600;
}

.gdpr-row,
.newsletter-row,
.attribute-box {
    border-radius: 8px;
    background: #fff;
    box-shadow: inset 0 0 0 1px rgba(196, 198, 204, 0.3);
    padding: 10px 12px;
}

.gdpr-row {
    display: flex;
    gap: 10px;
    align-items: flex-start;
}

.gender-options {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 8px;
    min-height: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    padding: 0;
}

.gender-options span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    border-radius: 999px;
    background: #f8fafc;
    padding: 0 12px;
}

.gender-options input[type="radio"] {
    width: 14px !important;
    height: 14px !important;
    min-height: 0 !important;
    margin: 0;
}

.gender-options label {
    margin: 0 !important;
    color: #334155 !important;
    font-size: var(--public-font-control) !important;
    font-weight: 800 !important;
    letter-spacing: 0 !important;
    text-transform: none !important;
}

.newsletter-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.auth-table-wrap {
    overflow-x: auto;
    border-radius: 8px;
    box-shadow: inset 0 0 0 1px rgba(196, 198, 204, 0.3);
    background: #fff;
}

.auth-table {
    width: 100%;
    border-collapse: collapse;
}

.auth-table th,
.auth-table td {
    padding: 10px;
    font-size: var(--public-font-meta);
    text-align: left;
    border-bottom: 1px solid rgba(196, 198, 204, 0.3);
}

.auth-table th {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #44474c;
    font-size: var(--public-font-label);
}

.security-tip {
    border-radius: 8px;
    background: #fff;
    box-shadow: inset 0 0 0 1px rgba(254, 214, 91, 0.55);
    padding: 10px 12px;
    color: #745c00;
    font-size: var(--public-font-meta);
    font-style: italic;
    font-weight: 600;
}

.command-footer {
    margin-top: 0;
    padding: 18px 24px;
    background: #f8fafc;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 12px;
}

.command-cancel {
    border: 0;
    background: transparent;
    color: #44474c;
    font-size: var(--public-font-label);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
}

.command-save {
    border: 0;
    border-radius: 8px;
    padding: 12px 18px;
    background: #2e0001;
    color: #fff;
    font-size: var(--public-font-label);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
}

.command-save:hover {
    filter: brightness(1.1);
}

.command-avatar-field {
    display: flex;
    align-items: center;
    gap: 18px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #f8fafc;
    padding: 16px;
}

.command-profile-section .command-avatar-field {
    grid-column: 1;
    grid-row: 1 / span 2;
    min-height: 0;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 8px;
    padding: 10px;
}

.command-avatar-content {
    min-width: 0;
    width: 100%;
}

.command-avatar-field .profile-photo-wrap {
    width: 88px;
    height: 88px;
    margin: 0;
    flex: 0 0 auto;
}

.profile-photo-upload-trigger {
    position: absolute;
    right: -2px;
    bottom: -2px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 3px solid #f8fafc;
    border-radius: 999px;
    background: #2e0001;
    color: #ffffff;
    cursor: pointer;
    box-shadow: 0 8px 18px -12px rgba(15, 23, 42, 0.75);
    transition: transform 0.16s ease, filter 0.16s ease;
}

.profile-photo-upload-trigger:hover,
.profile-photo-upload-trigger:focus-within {
    filter: brightness(1.14);
    transform: translateY(-1px);
}

.profile-photo-upload-trigger .material-symbols-outlined {
    display: block;
    width: 16px;
    height: 16px;
    font-size: 16px;
    line-height: 1;
}

.command-avatar-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 10px;
}

.command-avatar-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    border: 0;
    border-radius: 10px;
    background: #2e0001;
    color: #fff;
    cursor: pointer;
    font-size: var(--public-font-control);
    font-weight: 800;
    padding: 0 14px;
}

.command-avatar-button-danger {
    background: #ffdad6;
    color: #93000a;
}

@@media (max-width: 1200px) {
    .command-shell {
        grid-template-columns: 1fr;
    }
}

@@media (max-width: 560px) {
    .command-edit-page {
        padding: 0 0 24px;
    }

    .command-grid {
        grid-template-columns: 1fr;
    }

    .command-profile-section .command-profile-top-grid,
    .command-profile-section .command-profile-rest-grid {
        grid-template-columns: 1fr;
    }

    .command-profile-section .command-unit-field,
    .command-profile-section .command-position-field,
    .command-profile-section .command-enlistment-field,
    .command-profile-section .command-gender-field {
        grid-column: auto;
    }

    .command-avatar-field {
        flex-direction: column;
        align-items: center;
    }

    .command-profile-section .command-avatar-field {
        grid-column: auto;
        grid-row: auto;
    }

    .command-footer {
        justify-content: stretch;
        flex-direction: column;
        align-items: stretch;
    }
}
</style>

<div class="page account-page command-edit-page customer-info-page public-page-shell public-page-stack">
    <section class="command-header public-blue-hero">
        <div class="public-blue-hero-content">
            <div class="public-blue-hero-copy space-y-1.5">
                <h1 class="public-hero-title public-blue-hero-title font-black tracking-tight">Cập nhật hồ sơ quân nhân</h1>
                <p class="public-hero-subtitle public-blue-hero-subtitle">Điều chỉnh thông tin cơ bản, liên lạc, xác thực và tùy chọn bổ sung cho tài khoản.</p>
            </div>
        </div>
    </section>

    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.CustomerInfoTop, additionalData = Model })

    <form id="customer-avatar-upload-form" asp-route="@NopRouteNames.Standard.CUSTOMER_AVATAR" method="post" enctype="multipart/form-data" class="hidden">
        <input type="hidden" name="returnUrl" value="@avatarReturnUrl" />
        <input type="hidden" name="upload-avatar" value="true" />
    </form>
    <form id="customer-avatar-remove-form" asp-route="@NopRouteNames.Standard.CUSTOMER_AVATAR" method="post" class="hidden">
        <input type="hidden" name="returnUrl" value="@avatarReturnUrl" />
    </form>

    <form asp-route="CustomerEditAccount" method="post" class="public-page-stack">
        <div asp-validation-summary="ModelOnly" class="message-error"></div>

        @if (TempData["ProfileAvatarMessage"] != null)
        {
            <div class="public-body-text mb-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 font-semibold text-emerald-700">
                @TempData["ProfileAvatarMessage"]
            </div>
        }
        @if (TempData["ProfileAvatarError"] != null)
        {
            <div class="public-body-text mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 font-semibold text-red-700">
                @TempData["ProfileAvatarError"]
            </div>
        }

        <div class="command-shell">
            <div class="command-card public-surface-card">
                <section class="command-section command-profile-section public-surface-pad">
                    <h3 class="public-section-title">Thông tin Quân nhân</h3>
                    <div class="command-grid command-profile-top-grid">
                        <div class="command-avatar-field">
                            <div class="profile-photo-wrap">
                                <div class="profile-photo">
                                    <span>@getAvatarInitial(fullName)</span>
                                    @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                                    {
                                        <img src="@Model.AvatarUrl" alt="@fullName" onerror="this.remove()" />
                                    }
                                </div>
                                <label class="profile-photo-upload-trigger" title="Thêm ảnh" aria-label="Thêm ảnh đại diện">
                                    <span class="material-symbols-outlined">photo_camera</span>
                                    <input name="uploadedFile" accept="image/jpeg,image/png,image/gif,image/webp" type="file" form="customer-avatar-upload-form" style="display:none" onchange="this.form.submit()" />
                                </label>
                            </div>
                            <div class="command-avatar-content">
                                <p class="public-label-text font-black uppercase tracking-[0.14em] text-sky-700">Ảnh đại diện hồ sơ</p>
                            </div>
                        </div>

                        <div class="command-field">
                            <label asp-for="FirstName"></label>
                            <div class="input-shell">
                                <span class="material-symbols-outlined input-icon">person</span>
                                <input asp-for="FirstName" />
                            </div>
                            @if (Model.FirstNameRequired)
                            {
                                <nop-required />
                            }
                            <span asp-validation-for="FirstName"></span>
                        </div>

                        <div class="command-field">
                            <label asp-for="LastName"></label>
                            <div class="input-shell">
                                <span class="material-symbols-outlined input-icon">badge</span>
                                <input asp-for="LastName" />
                            </div>
                            @if (Model.LastNameRequired)
                            {
                                <nop-required />
                            }
                            <span asp-validation-for="LastName"></span>
                        </div>

                        <div class="command-field">
                            <label for="@Html.IdFor(model => model.MilitaryCode)">Số hiệu quân nhân</label>
                            <div class="input-shell">
                                <span class="material-symbols-outlined input-icon">military_tech</span>
                                <input asp-for="MilitaryCode" maxlength="100" />
                            </div>
                            <nop-required />
                            <span asp-validation-for="MilitaryCode"></span>
                        </div>

                        <div class="command-field">
                            <label for="@Html.IdFor(model => model.Rank)">Cấp bậc</label>
                            <div class="input-shell">
                                <span class="material-symbols-outlined input-icon">workspace_premium</span>
                                <input asp-for="Rank" maxlength="255" />
                            </div>
                            <span asp-validation-for="Rank"></span>
                        </div>
                    </div>

                    <div class="command-grid command-profile-rest-grid">

                        <div class="command-field command-unit-field">
                            <label for="@Html.IdFor(model => model.UnitName)">Đơn vị công tác</label>
                            <div class="input-shell">
                                <span class="material-symbols-outlined input-icon">home_work</span>
                                <input asp-for="UnitName" maxlength="500" />
                            </div>
                            <span asp-validation-for="UnitName"></span>
                        </div>

                        <div class="command-field command-position-field">
                            <label for="@Html.IdFor(model => model.PositionTitle)">Chức vụ</label>
                            <div class="input-shell">
                                <span class="material-symbols-outlined input-icon">stars</span>
                                <input asp-for="PositionTitle" maxlength="255" />
                            </div>
                            <span asp-validation-for="PositionTitle"></span>
                        </div>

                        <div class="command-field command-enlistment-field">
                            <label for="@Html.IdFor(model => model.EnlistmentDate)">Ngày nhập ngũ</label>
                            <div class="input-shell">
                                <span class="material-symbols-outlined input-icon">event</span>
                                <input asp-for="EnlistmentDate" type="date" />
                            </div>
                            <span asp-validation-for="EnlistmentDate"></span>
                        </div>

                        @if (Model.DateOfBirthEnabled)
                        {
                            <div class="command-field">
                                <span class="label">Ngày sinh</span>
                                <nop-date-picker asp-day-name="@Html.NameFor(x => x.DateOfBirthDay)"
                                    asp-month-name="@Html.NameFor(x => x.DateOfBirthMonth)"
                                    asp-year-name="@Html.NameFor(x => x.DateOfBirthYear)"
                                    asp-begin-year="@(DateTime.Now.AddYears(-110))"
                                    asp-end-year="@(DateTime.UtcNow)"
                                    asp-selected-date="@Model.ParseDateOfBirth()" />
                                @if (Model.DateOfBirthRequired)
                                {
                                    <nop-required />
                                }
                                <span asp-validation-for="DateOfBirthDay"></span>
                                <span asp-validation-for="DateOfBirthMonth"></span>
                                <span asp-validation-for="DateOfBirthYear"></span>
                            </div>
                        }

                        @if (Model.GenderEnabled)
                        {
                            <div class="command-field command-gender-field">
                                <span class="label">Giới tính</span>
                                <div class="gender-options">
                                    <span>
                                        <input type="radio" asp-for="Gender" value="M" checked="@(Model.Gender == "M")" id="gender-male" />
                                        <label class="forcheckbox" for="gender-male">@T("Account.Fields.Gender.Male")</label>
                                    </span>
                                    <span>
                                        <input type="radio" asp-for="Gender" value="F" checked="@(Model.Gender == "F")" id="gender-female" />
                                        <label class="forcheckbox" for="gender-female">@T("Account.Fields.Gender.Female")</label>
                                    </span>
                                    @if (Model.NeutralGenderEnabled)
                                    {
                                        <span>
                                            <input type="radio" asp-for="Gender" value="N" checked="@(Model.Gender == "N")" id="gender-neutral" />
                                            <label class="forcheckbox" for="gender-neutral">@T("Account.Fields.Gender.Neutral")</label>
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </section>

                <section class="command-section public-surface-pad">
                    <h3 class="public-section-title">Liên lạc & Truy cập</h3>
                    <div class="command-grid">
                        <div class="command-field">
                            <label asp-for="Email"></label>
                            <div class="input-shell">
                                <span class="material-symbols-outlined input-icon">mail</span>
                                <input asp-for="Email" />
                            </div>
                            <nop-required />
                            <span asp-validation-for="Email"></span>
                            @if (!string.IsNullOrEmpty(Model.EmailToRevalidate))
                            {
                                <span class="field-validation-error">@T("Account.Fields.EmailToRevalidate"): @Model.EmailToRevalidate</span>
                            }
                        </div>

                        @if (Model.UsernamesEnabled)
                        {
                            if (Model.AllowUsersToChangeUsernames)
                            {
                                <div class="command-field">
                                    <label asp-for="Username"></label>
                                    <div class="input-shell">
                                        <span class="material-symbols-outlined input-icon">alternate_email</span>
                                        <input asp-for="Username" />
                                    </div>
                                    <nop-required />
                                    <span asp-validation-for="Username"></span>
                                    @if (Model.CheckUsernameAvailabilityEnabled)
                                    {
                                        @await Html.PartialAsync("_CheckUsernameAvailability")
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="command-field">
                                    <label asp-for="Username"></label>
                                    <div class="input-shell">
                                        <span class="material-symbols-outlined input-icon">alternate_email</span>
                                        <div class="command-readonly">@Model.Username</div>
                                    </div>
                                </div>
                            }
                        }

                        <div class="command-field">
                            <label asp-for="Phone"></label>
                            <div class="input-shell">
                                <span class="material-symbols-outlined input-icon">call</span>
                                <input asp-for="Phone" />
                            </div>
                            @if (Model.PhoneRequired)
                            {
                                <nop-required />
                            }
                            <span asp-validation-for="Phone"></span>
                        </div>

                        @if (Model.FaxEnabled)
                        {
                            <div class="command-field">
                                <label asp-for="Fax"></label>
                                <div class="input-shell">
                                    <span class="material-symbols-outlined input-icon">print</span>
                                    <input asp-for="Fax" />
                                </div>
                                @if (Model.FaxRequired)
                                {
                                    <nop-required />
                                }
                                <span asp-validation-for="Fax"></span>
                            </div>
                        }
                    </div>
                </section>

                <section class="command-section public-surface-pad">
                    <h3 class="public-section-title">Thông tin bổ sung</h3>
                    <div class="command-grid">
                        @if (Model.DisplayVatNumber)
                        {
                            <div class="command-field">
                                <label asp-for="VatNumber"></label>
                                <div class="input-shell">
                                    <span class="material-symbols-outlined input-icon">receipt_long</span>
                                    <input asp-for="VatNumber" />
                                </div>
                                @if (Model.VatNumberRequired)
                                {
                                    <nop-required />
                                }
                                <span asp-validation-for="VatNumber"></span>
                            </div>
                        }

                        <div class="command-field">
                            <label asp-for="StreetAddress"></label>
                            <div class="input-shell">
                                <span class="material-symbols-outlined input-icon">location_on</span>
                                <input asp-for="StreetAddress" />
                            </div>
                            @if (Model.StreetAddressRequired)
                            {
                                <nop-required />
                            }
                            <span asp-validation-for="StreetAddress"></span>
                        </div>

                        <div class="command-field">
                            <label asp-for="StreetAddress2"></label>
                            <div class="input-shell">
                                <span class="material-symbols-outlined input-icon">pin_drop</span>
                                <input asp-for="StreetAddress2" />
                            </div>
                            @if (Model.StreetAddress2Required)
                            {
                                <nop-required />
                            }
                            <span asp-validation-for="StreetAddress2"></span>
                        </div>

                        <div class="command-field">
                            <label asp-for="City"></label>
                            <div class="input-shell">
                                <span class="material-symbols-outlined input-icon">apartment</span>
                                <input asp-for="City" />
                            </div>
                            @if (Model.CityRequired)
                            {
                                <nop-required />
                            }
                            <span asp-validation-for="City"></span>
                        </div>

                        <div class="command-field">
                            <label asp-for="County"></label>
                            <div class="input-shell">
                                <span class="material-symbols-outlined input-icon">map</span>
                                <input asp-for="County" />
                            </div>
                            @if (Model.CountyRequired)
                            {
                                <nop-required />
                            }
                            <span asp-validation-for="County"></span>
                        </div>

                        @if (Model.ZipPostalCodeEnabled)
                        {
                            <div class="command-field">
                                <label asp-for="ZipPostalCode"></label>
                                <div class="input-shell">
                                    <span class="material-symbols-outlined input-icon">markunread_mailbox</span>
                                    <input asp-for="ZipPostalCode" />
                                </div>
                                @if (Model.ZipPostalCodeRequired)
                                {
                                    <nop-required />
                                }
                                <span asp-validation-for="ZipPostalCode"></span>
                            </div>
                        }

                        @if (Model.CountryEnabled)
                        {
                            <div class="command-field">
                                <label asp-for="CountryId"></label>
                                <div class="input-shell">
                                    <span class="material-symbols-outlined input-icon">flag</span>
                                    <select asp-for="CountryId" asp-items="Model.AvailableCountries"
                                        data-trigger="country-select"
                                        data-url="@(Url.RouteUrl(NopRouteNames.Ajax.GET_STATES_BY_COUNTRY_ID))"
                                        data-stateprovince="#@Html.IdFor(model => model.StateProvinceId)"
                                        data-loading="#states-loading-progress"></select>
                                </div>
                                @if (Model.CountryRequired)
                                {
                                    <nop-required />
                                }
                                <span asp-validation-for="CountryId"></span>
                            </div>
                        }

                        @if (Model.CountryEnabled && Model.StateProvinceEnabled)
                        {
                            <div class="command-field">
                                <label asp-for="StateProvinceId"></label>
                                <div class="input-shell">
                                    <span class="material-symbols-outlined input-icon">location_city</span>
                                    <select asp-for="StateProvinceId" asp-items="Model.AvailableStates"></select>
                                </div>
                                @if (Model.StateProvinceRequired)
                                {
                                    <nop-required />
                                }
                                <span id="states-loading-progress" style="display:none;" class="field-validation-error">@T("Common.Wait")</span>
                                <span asp-validation-for="StateProvinceId"></span>
                            </div>
                        }

                        @if (Model.AllowCustomersToSetTimeZone)
                        {
                            <div class="command-field">
                                <label asp-for="TimeZoneId"></label>
                                <div class="input-shell">
                                    <span class="material-symbols-outlined input-icon">schedule</span>
                                    <select asp-for="TimeZoneId" asp-items="Model.AvailableTimeZones"></select>
                                </div>
                                <span asp-validation-for="TimeZoneId"></span>
                            </div>
                        }

                        @if (Model.SignatureEnabled)
                        {
                            <div class="command-field">
                                <label asp-for="Signature"></label>
                                <div class="input-shell">
                                    <span class="material-symbols-outlined input-icon">draw</span>
                                    <textarea asp-for="Signature"></textarea>
                                </div>
                            </div>
                        }
                    </div>
                </section>

                @if (Model.CustomerAttributes.Count > 0)
                {
                    <section class="command-section public-surface-pad">
                        <h3 class="public-section-title">Thuộc tính bổ sung</h3>
                        <div class="attribute-box">
                            @await Html.PartialAsync("_CustomerAttributes", Model.CustomerAttributes)
                        </div>
                    </section>
                }

                @if (Model.NumberOfExternalAuthenticationProviders > 0)
                {
                    <section class="command-section public-surface-pad">
                        <h3 class="public-section-title">Tài khoản liên kết</h3>
                        @if (Model.AssociatedExternalAuthRecords.Count > 0)
                        {
                            <div class="auth-table-wrap">
                                <table class="auth-table">
                                    <thead>
                                        <tr>
                                            <th>@T("Account.AssociatedExternalAuth.AuthMethodName")</th>
                                            <th>@T("Account.AssociatedExternalAuth.Email")</th>
                                            <th>@T("Account.AssociatedExternalAuth.ExternalIdentifier")</th>
                                            @if (Model.AllowCustomersToRemoveAssociations)
                                            {
                                                <th>@T("Account.AssociatedExternalAuth.Remove")</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.AssociatedExternalAuthRecords)
                                        {
                                            <tr>
                                                <td>@item.AuthMethodName</td>
                                                <td>@item.Email</td>
                                                <td>@CommonHelper.EnsureMaximumLength(item.ExternalIdentifier, 40, "...")</td>
                                                @if (Model.AllowCustomersToRemoveAssociations)
                                                {
                                                    <td><a href="#" onclick="return removeexternalassociation(@item.Id)">@T("Account.AssociatedExternalAuth.Remove")</a></td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        @if (Model.NumberOfExternalAuthenticationProviders > Model.AssociatedExternalAuthRecords.Count)
                        {
                            var loginUrl = Url.RouteUrl(NopRouteNames.General.LOGIN, null, webHelper.GetCurrentRequestProtocol());
                            <div class="field-validation-error" style="margin-top:8px;">@T("Account.AssociatedExternalAuth.AddMoreRecords") <a href="@loginUrl">@loginUrl</a></div>
                        }
                    </section>
                }

                @if (Model.GdprConsents.Count > 0)
                {
                    <section class="command-section public-surface-pad">
                        <h3 class="public-section-title">Xác nhận dữ liệu</h3>
                        <div class="command-grid" style="grid-template-columns:1fr;">
                            @foreach (var consent in Model.GdprConsents)
                            {
                                if (consent.IsRequired)
                                {
                                    <script asp-location="Footer">
                                        $(function() {
                                            $('#save-info-button').on('click', function() {
                                                if ($('#consent@(consent.Id)').is(':checked'))
                                                    return true;

                                                alert('@Html.Raw(JavaScriptEncoder.Default.Encode(consent.RequiredMessage))');
                                                return false;
                                            });
                                        });
                                    </script>
                                }

                                <div class="gdpr-row">
                                    <input id="consent@(consent.Id)" type="checkbox" name="consent@(consent.Id)" checked="@consent.Accepted" />
                                    <label for="consent@(consent.Id)">@consent.Message</label>
                                </div>
                            }
                        </div>
                    </section>
                }

                <section class="command-section public-surface-pad">
                    <h3 class="public-section-title">Đổi mật khẩu</h3>
                    <div class="security-tip">
                        Để thay đổi mật khẩu theo chuẩn bảo mật nội bộ, sử dụng trang đổi mật khẩu riêng của tài khoản.
                        <a asp-route="@NopRouteNames.Standard.CUSTOMER_CHANGE_PASSWORD" style="font-weight:800;color:#2e0001;">Mở trang đổi mật khẩu</a>.
                    </div>
                </section>

                <div class="command-footer">
                    <button type="button" class="public-control-text command-cancel" onclick="window.location.href='@Url.RouteUrl(NopRouteNames.General.CUSTOMER_PROFILE_ACCOUNT)'">Hủy thay đổi</button>
                    <button type="submit" id="save-info-button" name="save-info-button" class="public-control-text command-save">Cập nhật hồ sơ</button>
                </div>
            </div>
        </div>
    </form>

    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.CustomerInfoBottom, additionalData = Model })
</div>

<script asp-location="Footer">
    function removeexternalassociation(itemId) {
        if (confirm('@T("Common.AreYouSure")')) {
            var postData = {
                id: itemId
            };
            addAntiForgeryToken(postData);
            $.ajax({
                cache: false,
                type: "POST",
                url: "@Url.RouteUrl(NopRouteNames.Ajax.CUSTOMER_REMOVE_EXTERNAL_ASSOCIATION)",
                data: postData,
                dataType: "json",
                success: function (data, textStatus, jqXHR) {
                    location.href = data.redirect;
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    alert('Failed to delete');
                }
            });
        }

        return false;
    }
</script>
