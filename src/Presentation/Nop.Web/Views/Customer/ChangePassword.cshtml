@model ChangePasswordModel
@{
    Layout = "_ColumnsTwo";
    NopHtml.AddTitleParts(T("PageTitle.Account").Text);
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-change-password-page");
    var returnUrl = Context.Request.Query["returnUrl"];
}
@section left
{
    @await Component.InvokeAsync(typeof(CustomerNavigationViewComponent), new { selectedTabId = CustomerNavigationEnum.ChangePassword })
}

@section Breadcrumb
{
    <nav class="public-breadcrumb flex flex-wrap items-center gap-2 text-slate-500" aria-label="Breadcrumb">
        <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="transition hover:text-military-green">Trang chủ</a>
        <span class="material-symbols-outlined text-sm text-slate-400">chevron_right</span>
        <a asp-route="@NopRouteNames.General.CUSTOMER_PROFILE_ACCOUNT" class="transition hover:text-military-green">Hồ sơ cá nhân</a>
        <span class="material-symbols-outlined text-sm text-slate-400">chevron_right</span>
        <span class="text-slate-700">Đổi mật khẩu</span>
    </nav>
}

<style>
    .change-password-page .password-field-label {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
    }

    .change-password-page .password-field-label .required {
        margin: 0 !important;
        color: #ba1a1a;
        font-size: var(--public-font-label) !important;
        font-weight: 800;
        line-height: 1;
        vertical-align: baseline;
    }

    .change-password-page .password-field-label label {
        width: auto !important;
        min-height: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        border: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
        vertical-align: baseline;
    }

    .change-password-page .password-field-input {
        height: 2.75rem !important;
        width: 100% !important;
        border: 1px solid #e2e8f0 !important;
        border-radius: 0.75rem !important;
        background: #f8fafc !important;
        padding: 0.5rem 1rem 0.5rem 2.75rem !important;
        color: #334155 !important;
        font-weight: 600;
        outline: none;
    }

    .change-password-page .password-field-input:focus {
        border-color: #b91d20 !important;
        background: #ffffff !important;
    }

    .change-password-page .password-submit-button {
        border: 0 !important;
        background: #2e0001 !important;
        color: #ffffff !important;
        text-transform: none !important;
    }

    .change-password-page .password-submit-button:hover,
    .change-password-page .password-submit-button:focus {
        background: #550005 !important;
        filter: brightness(1.1);
    }
</style>

<div class="page account-page change-password-page public-page-shell public-page-stack">
    <section class="public-blue-hero">
        <div class="public-blue-hero-content">
            <div class="public-blue-hero-copy space-y-1.5">
                <h1 class="public-hero-title public-blue-hero-title font-black tracking-tight">@T("Account.ChangePassword")</h1>
                <p class="public-hero-subtitle public-blue-hero-subtitle">Cập nhật mật khẩu định kỳ để bảo vệ tài khoản và dữ liệu nội bộ.</p>
            </div>
        </div>
    </section>

    <div class="page-body public-page-stack">
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.CustomerChangePasswordTop, additionalData = Model })

        <div class="public-surface-card public-surface-pad max-w-lg">
            <p class="public-section-title mb-4 font-black text-slate-900">@T("Account.ChangePassword")</p>

            @if (Model.PasswordExpired || Model.PasswordMustBeChanged)
            {
                <div class="public-body-text mb-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-amber-800">
                    @if (Model.PasswordExpired) { <p>@T("Account.ChangePassword.PasswordIsExpired")</p> }
                    @if (Model.PasswordMustBeChanged) { <p>@T("Account.ChangePassword.MustBeChanged")</p> }
                </div>
            }

            <form asp-route="@NopRouteNames.Standard.CUSTOMER_CHANGE_PASSWORD" method="post" autocomplete="off" asp-route-returnurl="@returnUrl">
                <div asp-validation-summary="ModelOnly" class="public-body-text mb-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-rose-700"></div>

                <div class="space-y-4">
                    <div class="space-y-2">
                        <div class="password-field-label">
                            <span class="required">*</span>
                            <label asp-for="OldPassword" asp-postfix=":" class="public-label-text font-bold uppercase tracking-[0.12em] text-slate-600"></label>
                        </div>
                        <div class="relative">
                            <span class="material-symbols-outlined pointer-events-none absolute left-3 top-1/2 z-[3] -translate-y-1/2 text-[17px] text-slate-400">lock_open</span>
                            <input asp-for="OldPassword" class="public-control-text password-field-input" placeholder="Mật khẩu hiện tại" />
                        </div>
                        <span asp-validation-for="OldPassword" class="public-meta-text text-rose-600"></span>
                        <a asp-route="@NopRouteNames.Standard.PASSWORD_RECOVERY" class="public-meta-text mt-0.5 self-start font-medium text-military-red hover:underline">@T("Account.Login.ForgotPassword")</a>
                    </div>

                    <div class="space-y-2">
                        <div class="password-field-label">
                            <span class="required">*</span>
                            <label asp-for="NewPassword" asp-postfix=":" class="public-label-text font-bold uppercase tracking-[0.12em] text-slate-600"></label>
                        </div>
                        <div class="relative">
                            <span class="material-symbols-outlined pointer-events-none absolute left-3 top-1/2 z-[3] -translate-y-1/2 text-[17px] text-slate-400">lock</span>
                            <input asp-for="NewPassword" class="public-control-text password-field-input" placeholder="Mật khẩu mới" />
                        </div>
                        <span asp-validation-for="NewPassword" class="public-meta-text text-rose-600"></span>
                    </div>

                    <div class="space-y-2">
                        <div class="password-field-label">
                            <span class="required">*</span>
                            <label asp-for="ConfirmNewPassword" asp-postfix=":" class="public-label-text font-bold uppercase tracking-[0.12em] text-slate-600"></label>
                        </div>
                        <div class="relative">
                            <span class="material-symbols-outlined pointer-events-none absolute left-3 top-1/2 z-[3] -translate-y-1/2 text-[17px] text-slate-400">lock_reset</span>
                            <input asp-for="ConfirmNewPassword" class="public-control-text password-field-input" placeholder="Nhập lại mật khẩu mới" />
                        </div>
                        <span asp-validation-for="ConfirmNewPassword" class="public-meta-text text-rose-600"></span>
                    </div>
                </div>

                <div class="mt-6">
                    <button type="submit" class="change-password-button password-submit-button public-control-text inline-flex h-11 items-center justify-center rounded-xl px-5 font-bold transition">@T("Account.ChangePassword.Button")</button>
                </div>
            </form>
        </div>

        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.CustomerChangePasswordBottom, additionalData = Model })
    </div>
</div>
