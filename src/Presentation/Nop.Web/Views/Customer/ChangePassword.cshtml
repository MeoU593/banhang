@model ChangePasswordModel
@{
    Layout = "_ColumnsTwo";
    NopHtml.AddTitleParts(T("PageTitle.Account").Text);
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-change-password-page");
    var returnUrl = Context.Request.Query["returnUrl"];
}
@section left
{
    @await Component.InvokeAsync(typeof(CustomerNavigationViewComponent), new { selectedTabId = CustomerNavigationEnum.ChangePassword })
}

<div class="page account-page change-password-page">
    <div class="page-body">
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.CustomerChangePasswordTop, additionalData = Model })

        <div class="account-card max-w-lg">
            <p class="account-card-title">@T("Account.ChangePassword")</p>

            @if (Model.PasswordExpired || Model.PasswordMustBeChanged)
            {
                <div class="mb-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
                    @if (Model.PasswordExpired) { <p>@T("Account.ChangePassword.PasswordIsExpired")</p> }
                    @if (Model.PasswordMustBeChanged) { <p>@T("Account.ChangePassword.MustBeChanged")</p> }
                </div>
            }

            <form asp-route="@NopRouteNames.Standard.CUSTOMER_CHANGE_PASSWORD" method="post" autocomplete="off" asp-route-returnurl="@returnUrl">
                <div asp-validation-summary="ModelOnly" class="mb-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700"></div>

                <div class="space-y-4">
                    <div class="account-field">
                        <span class="required">*</span>
                        <label asp-for="OldPassword" asp-postfix=":"></label>
                        <div style="position:relative">
                            <span class="material-symbols-outlined" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:17px;color:#94a3b8;pointer-events:none;z-index:3">lock_open</span>
                            <input asp-for="OldPassword" style="padding-left:2.25rem !important" placeholder="Mật khẩu hiện tại" />
                        </div>
                        <span asp-validation-for="OldPassword" class="text-xs text-rose-600"></span>
                        <a asp-route="@NopRouteNames.Standard.PASSWORD_RECOVERY" class="text-xs font-medium text-military-red hover:underline mt-0.5 self-start">@T("Account.Login.ForgotPassword")</a>
                    </div>

                    <div class="account-field">
                        <span class="required">*</span>
                        <label asp-for="NewPassword" asp-postfix=":"></label>
                        <div style="position:relative">
                            <span class="material-symbols-outlined" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:17px;color:#94a3b8;pointer-events:none;z-index:3">lock</span>
                            <input asp-for="NewPassword" style="padding-left:2.25rem !important" placeholder="Mật khẩu mới" />
                        </div>
                        <span asp-validation-for="NewPassword" class="text-xs text-rose-600"></span>
                    </div>

                    <div class="account-field">
                        <span class="required">*</span>
                        <label asp-for="ConfirmNewPassword" asp-postfix=":"></label>
                        <div style="position:relative">
                            <span class="material-symbols-outlined" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:17px;color:#94a3b8;pointer-events:none;z-index:3">lock_reset</span>
                            <input asp-for="ConfirmNewPassword" style="padding-left:2.25rem !important" placeholder="Nhập lại mật khẩu mới" />
                        </div>
                        <span asp-validation-for="ConfirmNewPassword" class="text-xs text-rose-600"></span>
                    </div>
                </div>

                <div class="mt-6">
                    <button type="submit" class="button-1 change-password-button">@T("Account.ChangePassword.Button")</button>
                </div>
            </form>
        </div>

        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.CustomerChangePasswordBottom, additionalData = Model })
    </div>
</div>
