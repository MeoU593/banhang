@model LoginModel
@using Nop.Core
@using Nop.Core.Domain.Customers

@inject IWebHelper webHelper
@inject Nop.Core.Domain.Common.DutyMessageSettings dutyMessageSettings
@{
    Layout = "_ColumnsOne";
    ViewData["AuthStandalone"] = true;

    //title
    NopHtml.AddTitleParts(T("PageTitle.Login").Text);
    //page class
    NopHtml.AppendPageCssClassParts("html-login-page");

    //register URL with return URL (if specified)
    var registerUrl = Url.RouteUrl(NopRouteNames.Standard.REGISTER, new { returnUrl = this.Context.Request.Query["returnUrl"] }, webHelper.GetCurrentRequestProtocol());
}
<div class="page login-page min-h-[100dvh] bg-slate-100">
    @await Html.PartialAsync("_ExternalAuthentication.Errors")
    <div class="page-body grid min-h-[100dvh] lg:grid-cols-2">
        <section class="relative hidden overflow-hidden bg-[linear-gradient(135deg,#1B2E20_0%,#1A365D_100%)] lg:flex lg:flex-col lg:justify-between lg:p-12 xl:p-16">
            <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.35) 1px, transparent 0); background-size: 24px 24px;"></div>
            <div class="relative max-w-xl space-y-8 text-white">
                <div class="inline-flex h-16 w-16 items-center justify-center rounded-[24px] border border-white/10 bg-white/10 shadow-[inset_0_1px_0_rgba(255,255,255,0.1)] backdrop-blur">
                    <span class="material-symbols-outlined text-[34px] text-military-gold">shield</span>
                </div>
                <div class="space-y-4">
                    <p class="text-sm font-semibold uppercase tracking-[0.32em] text-military-gold">Hệ thống điều phối</p>
                    <h1 class="text-4xl font-black tracking-tight whitespace-nowrap">@(string.IsNullOrWhiteSpace(dutyMessageSettings.LoginTitle) ? "Cổng thông tin Hậu cần - Quân nhu" : dutyMessageSettings.LoginTitle)</h1>
                    <p class="text-lg text-slate-200">@(string.IsNullOrWhiteSpace(dutyMessageSettings.LoginSubtitle) ? "Bộ Tư lệnh Tăng Thiết Giáp" : dutyMessageSettings.LoginSubtitle)</p>
                    <p class="max-w-lg text-base leading-8 text-slate-300">@(string.IsNullOrWhiteSpace(dutyMessageSettings.LoginDescription) ? "Quản lý kho bãi, danh mục vật tư và luồng văn bản nghiệp vụ trên một giao diện thống nhất, ưu tiên tốc độ xử lý và tính sẵn sàng." : dutyMessageSettings.LoginDescription)</p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(dutyMessageSettings.Message))
            {
                <div class="relative max-w-xl rounded-[28px] border border-white/10 bg-white/10 p-6 text-slate-100 shadow-[inset_0_1px_0_rgba(255,255,255,0.1)] backdrop-blur">
                    <p class="text-sm uppercase tracking-[0.28em] text-military-gold">Thông điệp trực ban</p>
                    <blockquote class="mt-4 text-xl font-semibold leading-9 text-white">"@dutyMessageSettings.Message"</blockquote>
                    @if (!string.IsNullOrWhiteSpace(dutyMessageSettings.Author))
                    {
                        <p class="mt-4 text-sm text-slate-300">@dutyMessageSettings.Author</p>
                    }
                </div>
            }
        </section>

        <section class="flex min-h-[100dvh] items-center justify-center bg-slate-50 px-4 py-10 sm:px-6 lg:px-10">
            <div class="w-full max-w-md space-y-6">
                @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.LoginTop, additionalData = Model })

                <div class="rounded-[32px] border border-slate-200 bg-white p-7 shadow-[0_28px_70px_-38px_rgba(15,23,42,0.38)] sm:p-8">
                    <div class="space-y-2">
                        <p class="text-sm font-semibold uppercase tracking-[0.28em] text-military-red">Truy cập bảo mật</p>
                        <h2 class="text-3xl font-black tracking-tight text-slate-900">Đăng nhập hệ thống</h2>
                        <p class="text-sm leading-6 text-slate-500">Sử dụng tài khoản nghiệp vụ được cấp để truy cập cổng hậu cần - quân nhu.</p>
                    </div>

                    <style>
                        .login-input-wrap { position: relative; }
                        .login-input-icon {
                            position: absolute;
                            top: 50%;
                            left: 12px;
                            transform: translateY(-50%);
                            z-index: 3;
                            pointer-events: none;
                            display: flex;
                            align-items: center;
                            color: #94a3b8;
                        }
                        .login-input-icon .material-symbols-outlined {
                            font-size: 20px !important;
                            font-family: 'Material Symbols Outlined' !important;
                            line-height: 1;
                        }
                        .login-field {
                            position: relative;
                            z-index: 1;
                            display: block !important;
                            width: 100% !important;
                            height: 48px !important;
                            padding: 0 1rem 0 2.5rem !important;
                            border: 1px solid #e2e8f0 !important;
                            border-radius: 16px !important;
                            background: #f8fafc !important;
                            font-size: 14px !important;
                            color: #334155 !important;
                            outline: none !important;
                            box-shadow: none !important;
                            transition: border-color 0.15s, background 0.15s !important;
                            -webkit-appearance: none !important;
                        }
                        .login-field:focus {
                            border-color: #94a3b8 !important;
                            background: #ffffff !important;
                        }
                        /* Chặn Chrome autofill phủ màu lên icon */
                        .login-field:-webkit-autofill,
                        .login-field:-webkit-autofill:hover,
                        .login-field:-webkit-autofill:focus {
                            -webkit-box-shadow: 0 0 0px 1000px #ffffff inset !important;
                            box-shadow: 0 0 0px 1000px #ffffff inset !important;
                            -webkit-text-fill-color: #334155 !important;
                            transition: background-color 0s 9999s !important;
                        }
                        .login-field-password-wrap { position: relative; }
                        .login-password-eye {
                            position: absolute;
                            top: 50%;
                            right: 14px;
                            transform: translateY(-50%);
                            z-index: 3;
                            display: flex;
                            align-items: center;
                            background: none;
                            border: none;
                            padding: 0;
                            cursor: pointer;
                            color: #94a3b8;
                            transition: color 0.15s;
                        }
                        .login-password-eye:hover { color: #475569; }
                        .login-password-eye .material-symbols-outlined {
                            font-size: 20px !important;
                            font-family: 'Material Symbols Outlined' !important;
                        }
                        .login-field-password { padding-right: 3rem !important; }
                    </style>

                    <form asp-route="@NopRouteNames.General.LOGIN" asp-route-returnurl="@Context.Request.Query["ReturnUrl"]" method="post" autocomplete="off" class="mt-8 space-y-5">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">@T("Account.Login.Unsuccessful")</div>

                        @if (Model.UsernamesEnabled)
                        {
                            <div class="space-y-2">
                                <label asp-for="Username" asp-postfix=":" class="block text-sm font-semibold text-slate-700"></label>
                                <div class="login-input-wrap">
                                    <span class="login-input-icon"><span class="material-symbols-outlined">person</span></span>
                                    <input asp-for="Username" class="login-field" autofocus="autofocus" placeholder="Ví dụ: btl_ttg_admin" />
                                </div>
                                <span asp-validation-for="Username" class="text-sm text-rose-600"></span>
                            </div>
                        }
                        else
                        {
                            <div class="space-y-2">
                                <label asp-for="Email" asp-postfix=":" class="block text-sm font-semibold text-slate-700"></label>
                                <div class="login-input-wrap">
                                    <span class="login-input-icon"><span class="material-symbols-outlined">mail</span></span>
                                    <input asp-for="Email" class="login-field" autofocus="autofocus" placeholder="example@btl-ttg.mil.vn" />
                                </div>
                                <span asp-validation-for="Email" class="text-sm text-rose-600"></span>
                            </div>
                        }

                        <div class="space-y-2">
                            <label asp-for="Password" asp-postfix=":" class="block text-sm font-semibold text-slate-700"></label>
                            <div class="login-input-wrap login-field-password-wrap">
                                <span class="login-input-icon"><span class="material-symbols-outlined">lock</span></span>
                                <input asp-for="Password" class="login-field login-field-password" placeholder="Nhập mật khẩu" />
                                <button type="button" class="login-password-eye" aria-label="Ẩn hoặc hiện mật khẩu">
                                    <span class="material-symbols-outlined password-eye-icon">visibility</span>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-sm text-rose-600"></span>
                        </div>

                        <div class="flex items-center justify-between gap-4 text-sm">
                        <label class="flex items-center gap-3 text-slate-600">
                                <input asp-for="RememberMe" class="h-4 w-4 rounded border-slate-300 text-military-red focus:ring-military-red" />
                                <span>Ghi nhớ đăng nhập</span>
                            </label>
                            <a asp-route="@NopRouteNames.Standard.PASSWORD_RECOVERY" class="font-semibold text-military-red transition hover:text-rose-700">Quên mật khẩu?</a>
                        </div>

                        <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600">
                            Chưa có tài khoản?
                            <a href="@registerUrl" class="font-semibold text-military-red transition hover:text-rose-700">Đăng ký ngay</a>
                        </div>

                        @if (Model.DisplayCaptcha)
                        {
                            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                                <nop-captcha />
                            </div>
                        }

                        <button type="submit" class="flex h-12 w-full items-center justify-center rounded-2xl bg-military-red px-4 text-sm font-bold uppercase tracking-[0.18em] text-white shadow-[0_22px_48px_-28px_rgba(185,28,28,0.85)] transition hover:-translate-y-[1px] active:scale-[0.98]">ĐĂNG NHẬP HỆ THỐNG</button>
                    </form>

                    <div class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-500 space-y-0.5">
                        <div>Hỗ trợ kỹ thuật: <span class="font-semibold text-slate-700">@dutyMessageSettings.SupportDepartment@(string.IsNullOrWhiteSpace(dutyMessageSettings.SupportUnit) ? "" : " - " + dutyMessageSettings.SupportUnit)</span></div>
                        @if (!string.IsNullOrWhiteSpace(dutyMessageSettings.SupportContactName))
                        {
                            <div>Người liên hệ: <span class="font-semibold text-slate-700">@dutyMessageSettings.SupportContactName@(string.IsNullOrWhiteSpace(dutyMessageSettings.SupportContactPosition) ? "" : " - " + dutyMessageSettings.SupportContactPosition)</span></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(dutyMessageSettings.SupportPhone))
                        {
                            <div>Điện thoại: <span class="font-semibold text-slate-700">@dutyMessageSettings.SupportPhone</span></div>
                        }
                    </div>
                </div>

                @* Cards thừa ẩn cho hệ thống nội bộ *@

                @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.LoginBottom, additionalData = Model })

                <footer class="flex flex-wrap items-center justify-between gap-3 px-2 text-xs uppercase tracking-[0.18em] text-slate-400">
                    <span>© 2024 Bộ Tư lệnh Tăng Thiết Giáp</span>
                    <span class="rounded-full border border-slate-200 bg-white px-3 py-1 text-slate-500">v5.00</span>
                </footer>
            </div>
        </section>
    </div>
</div>

<script asp-location="Footer">
    $(function () {
        const password = $("#@Html.IdFor(m => m.Password)");
        const eyeIcon = $(".password-eye-icon");

        $(".password-eye").on("click", function () {
            // toggle the type attribute
            const type = password.attr("type") === "password" ? "text" : "password";
            password.attr("type", type);

            eyeIcon.text(type === "password" ? "visibility" : "visibility_off");
        });
    });
</script>
