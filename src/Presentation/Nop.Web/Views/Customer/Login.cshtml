@model LoginModel
@using Nop.Core
@using Nop.Core.Domain.Customers

@inject IWebHelper webHelper
@{
    Layout = "_ColumnsOne";
    ViewData["AuthStandalone"] = true;

    //title
    NopHtml.AddTitleParts(T("PageTitle.Login").Text);
    //page class
    NopHtml.AppendPageCssClassParts("html-login-page");

    //register URL with return URL (if specified)
    var registerUrl = Url.RouteUrl(NopRouteNames.Standard.REGISTER, new { returnUrl = this.Context.Request.Query["returnUrl"] }, webHelper.GetCurrentRequestProtocol());
}
<div class="page login-page min-h-[100dvh] bg-slate-100">
    @await Html.PartialAsync("_ExternalAuthentication.Errors")
    <div class="page-body grid min-h-[100dvh] lg:grid-cols-2">
        <section class="relative hidden overflow-hidden bg-[linear-gradient(135deg,#1B2E20_0%,#1A365D_100%)] lg:flex lg:flex-col lg:justify-between lg:p-12 xl:p-16">
            <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.35) 1px, transparent 0); background-size: 24px 24px;"></div>
            <div class="relative max-w-xl space-y-8 text-white">
                <div class="inline-flex h-16 w-16 items-center justify-center rounded-[24px] border border-white/10 bg-white/10 shadow-[inset_0_1px_0_rgba(255,255,255,0.1)] backdrop-blur">
                    <span class="material-symbols-outlined text-[34px] text-military-gold">shield</span>
                </div>
                <div class="space-y-4">
                    <p class="text-sm font-semibold uppercase tracking-[0.32em] text-military-gold">Hệ thống điều phối</p>
                    <h1 class="text-5xl font-black tracking-tight">Cổng thông tin Hậu cần - Quân nhu</h1>
                    <p class="text-lg text-slate-200">Bộ Tư lệnh Tăng Thiết Giáp</p>
                    <p class="max-w-lg text-base leading-8 text-slate-300">Quản lý kho bãi, danh mục vật tư và luồng văn bản nghiệp vụ trên một giao diện thống nhất, ưu tiên tốc độ xử lý và tính sẵn sàng.</p>
                </div>
            </div>

            <div class="relative max-w-xl rounded-[28px] border border-white/10 bg-white/10 p-6 text-slate-100 shadow-[inset_0_1px_0_rgba(255,255,255,0.1)] backdrop-blur">
                <p class="text-sm uppercase tracking-[0.28em] text-military-gold">Thông điệp trực ban</p>
                <blockquote class="mt-4 text-xl font-semibold leading-9 text-white">"Kỷ luật dữ liệu là nền của chỉ huy chính xác; hậu cần thông suốt là điều kiện bảo đảm chiến thắng."</blockquote>
                <p class="mt-4 text-sm text-slate-300">Trung tâm kỹ thuật số hóa quân nhu - cụm điều hành số 02</p>
            </div>
        </section>

        <section class="flex min-h-[100dvh] items-center justify-center bg-slate-50 px-4 py-10 sm:px-6 lg:px-10">
            <div class="w-full max-w-md space-y-6">
                @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.LoginTop, additionalData = Model })

                <div class="rounded-[32px] border border-slate-200 bg-white p-7 shadow-[0_28px_70px_-38px_rgba(15,23,42,0.38)] sm:p-8">
                    <div class="space-y-2">
                        <p class="text-sm font-semibold uppercase tracking-[0.28em] text-military-red">Truy cập bảo mật</p>
                        <h2 class="text-3xl font-black tracking-tight text-slate-900">Đăng nhập hệ thống</h2>
                        <p class="text-sm leading-6 text-slate-500">Sử dụng tài khoản nghiệp vụ được cấp để truy cập cổng hậu cần - quân nhu.</p>
                    </div>

                    <form asp-route="@NopRouteNames.General.LOGIN" asp-route-returnurl="@Context.Request.Query["ReturnUrl"]" method="post" autocomplete="off" class="mt-8 space-y-5">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">@T("Account.Login.Unsuccessful")</div>

                        @if (Model.UsernamesEnabled)
                        {
                            <div class="space-y-2">
                                <label asp-for="Username" asp-postfix=":" class="block text-sm font-semibold text-slate-700"></label>
                                <div class="relative">
                                    <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center"><span class="material-symbols-outlined text-slate-400" style="font-size:20px">person</span></span>
                                    <input asp-for="Username" class="username h-12 w-full rounded-2xl border border-slate-200 bg-slate-50 text-sm text-slate-700 transition placeholder:text-slate-400 focus:border-slate-300 focus:bg-white" style="padding-left:2.75rem !important; padding-right:1rem !important;" autofocus="autofocus" placeholder="Ví dụ: btl_ttg_admin" />
                                </div>
                                <span asp-validation-for="Username" class="text-sm text-rose-600"></span>
                            </div>
                        }
                        else
                        {
                            <div class="space-y-2">
                                <label asp-for="Email" asp-postfix=":" class="block text-sm font-semibold text-slate-700"></label>
                                <div class="relative">
                                    <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center"><span class="material-symbols-outlined text-slate-400" style="font-size:20px">person</span></span>
                                    <input asp-for="Email" class="email h-12 w-full rounded-2xl border border-slate-200 bg-slate-50 text-sm text-slate-700 transition placeholder:text-slate-400 focus:border-slate-300 focus:bg-white" style="padding-left:2.75rem !important; padding-right:1rem !important;" autofocus="autofocus" placeholder="Ví dụ: btl_ttg_admin" />
                                </div>
                                <span asp-validation-for="Email" class="text-sm text-rose-600"></span>
                            </div>
                        }

                        <div class="space-y-2">
                            <label asp-for="Password" asp-postfix=":" class="block text-sm font-semibold text-slate-700"></label>
                            <div class="relative login-password">
                                <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center"><span class="material-symbols-outlined text-slate-400" style="font-size:20px">lock</span></span>
                                <input asp-for="Password" class="password h-12 w-full rounded-2xl border border-slate-200 bg-slate-50 text-sm text-slate-700 transition focus:border-slate-300 focus:bg-white" style="padding-left:2.75rem !important; padding-right:3.5rem !important;" placeholder="Nhập mật khẩu" />
                                <button type="button" class="password-eye absolute inset-y-0 right-4 flex items-center text-slate-400 transition hover:text-slate-700" aria-label="Ẩn hoặc hiện mật khẩu">
                                    <span class="material-symbols-outlined text-[20px] password-eye-icon">visibility</span>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-sm text-rose-600"></span>
                        </div>

                        <div class="flex items-center justify-between gap-4 text-sm">
                        <label class="flex items-center gap-3 text-slate-600">
                                <input asp-for="RememberMe" class="h-4 w-4 rounded border-slate-300 text-military-red focus:ring-military-red" />
                                <span>Ghi nhớ đăng nhập</span>
                            </label>
                            <a asp-route="@NopRouteNames.Standard.PASSWORD_RECOVERY" class="font-semibold text-military-red transition hover:text-rose-700">Quên mật khẩu?</a>
                        </div>

                        @if (Model.DisplayCaptcha)
                        {
                            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                                <nop-captcha />
                            </div>
                        }

                        <button type="submit" class="flex h-12 w-full items-center justify-center rounded-2xl bg-military-red px-4 text-sm font-bold uppercase tracking-[0.18em] text-white shadow-[0_22px_48px_-28px_rgba(185,28,28,0.85)] transition hover:-translate-y-[1px] active:scale-[0.98]">ĐĂNG NHẬP HỆ THỐNG</button>
                    </form>

                    <div class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-500">
                        Hỗ trợ kỹ thuật: <span class="font-semibold text-slate-700">Phòng Kỹ thuật - BTL TTG</span>
                    </div>
                </div>

                @* Cards thừa ẩn cho hệ thống nội bộ *@

                @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.LoginBottom, additionalData = Model })

                <footer class="flex flex-wrap items-center justify-between gap-3 px-2 text-xs uppercase tracking-[0.18em] text-slate-400">
                    <span>© 2024 Bộ Tư lệnh Tăng Thiết Giáp</span>
                    <span class="rounded-full border border-slate-200 bg-white px-3 py-1 text-slate-500">v5.00</span>
                </footer>
            </div>
        </section>
    </div>
</div>

<script asp-location="Footer">
    $(function () {
        const password = $("#@Html.IdFor(m => m.Password)");
        const eyeIcon = $(".password-eye-icon");

        $(".password-eye").on("click", function () {
            // toggle the type attribute
            const type = password.attr("type") === "password" ? "text" : "password";
            password.attr("type", type);

            eyeIcon.text(type === "password" ? "visibility" : "visibility_off");
        });
    });
</script>
