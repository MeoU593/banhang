@model CustomerInfoModel
@{
    Layout = "_ColumnsTwo";

    NopHtml.AddTitleParts(T("PageTitle.Account").Text);
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-customer-profile-page");

    var fullName = $"{Model.FirstName} {Model.LastName}".Trim();
    if (string.IsNullOrWhiteSpace(fullName))
        fullName = Context.User.Identity?.Name ?? "Quân nhân";

    var address = string.Join(", ", new[] { Model.StreetAddress, Model.StreetAddress2, Model.City, Model.County }.Where(x => !string.IsNullOrWhiteSpace(x)));
    if (string.IsNullOrWhiteSpace(address))
        address = "Chưa cập nhật";
}

@section left
{
    @await Component.InvokeAsync(typeof(CustomerNavigationViewComponent), new { selectedTabId = CustomerNavigationEnum.Profile })
}

<style>
.command-profile-page {
    padding: 24px;
    background: #edf4ff;
    min-height: calc(100vh - 4rem);
}

.command-hero {
    position: relative;
    margin-bottom: 22px;
}

.hero-cover {
    height: 178px;
    border-radius: 14px;
    background: linear-gradient(120deg, #0f172a 0%, #29313a 66%, #232900 100%);
    box-shadow: 0 28px 44px -34px rgba(20, 28, 36, 0.65);
}

.hero-content {
    display: flex;
    align-items: flex-end;
    gap: 18px;
    margin-top: -60px;
    padding: 0 22px;
}

.hero-avatar {
    width: 130px;
    height: 130px;
    border-radius: 18px;
    background: linear-gradient(145deg, #ffffff 0%, #dbe3ef 100%);
    border: 4px solid #fff;
    box-shadow: 0 18px 30px -24px rgba(20, 28, 36, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 52px;
    font-weight: 900;
    color: #2e0001;
}

.hero-meta {
    flex: 1;
    padding-bottom: 8px;
}

.hero-meta h1 {
    margin: 0;
    font-size: 32px;
    font-weight: 900;
    color: #141c24;
    letter-spacing: -0.02em;
}

.hero-sub {
    margin-top: 6px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    color: #44474c;
    font-size: 13px;
    font-weight: 600;
}

.hero-action {
    border: 0;
    border-radius: 10px;
    background: #141c24;
    color: #fff;
    padding: 11px 16px;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 7px;
}

.profile-layout {
    display: grid;
    grid-template-columns: minmax(260px, 320px) minmax(0, 1fr);
    gap: 20px;
}

.profile-side,
.profile-card,
.profile-badge {
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 20px 38px -34px rgba(20, 28, 36, 0.28);
}

.profile-side {
    overflow: hidden;
}

.profile-nav-btn {
    width: 100%;
    border: 0;
    border-right: 4px solid transparent;
    background: transparent;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    font-size: 13px;
    font-weight: 700;
    text-align: left;
    color: #44474c;
    cursor: pointer;
}

.profile-nav-btn.active {
    border-right-color: #fed65b;
    background: #fff8e1;
    color: #735c00;
}

.profile-badge {
    margin-top: 14px;
    padding: 18px;
    background: linear-gradient(135deg, #29313a 0%, #0f172a 100%);
    color: #fff;
}

.profile-badge p {
    margin: 0;
}

.profile-badge .small {
    color: #fed65b;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 800;
}

.profile-badge .main {
    margin-top: 5px;
    font-size: 22px;
    font-weight: 900;
}

.profile-main {
    display: grid;
    gap: 16px;
}

.profile-panel {
    display: none;
}

.profile-panel.active {
    display: grid;
    gap: 16px;
}

.profile-card {
    padding: 20px;
}

.profile-card h3 {
    margin: 0 0 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 18px;
    font-weight: 800;
    color: #141c24;
}

.profile-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 18px;
}

.profile-item {
    border-radius: 10px;
    background: #f7f9ff;
    padding: 10px 12px;
}

.profile-item span {
    display: block;
}

.profile-item .label {
    color: #75777c;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 800;
}

.profile-item .value {
    margin-top: 4px;
    color: #141c24;
    font-size: 15px;
    font-weight: 700;
}

.profile-contact-row {
    display: flex;
    align-items: center;
    gap: 12px;
    border-radius: 10px;
    background: #f7f9ff;
    padding: 11px 12px;
}

.profile-contact-row + .profile-contact-row {
    margin-top: 10px;
}

.profile-contact-icon {
    width: 38px;
    height: 38px;
    border-radius: 999px;
    background: #fff;
    box-shadow: inset 0 0 0 1px rgba(196, 198, 204, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #44474c;
}

.profile-contact-label {
    color: #75777c;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 800;
}

.profile-contact-value {
    margin-top: 2px;
    color: #141c24;
    font-size: 13px;
    font-weight: 700;
}

.profile-list {
    display: grid;
    gap: 10px;
}

.profile-list-item {
    border-radius: 10px;
    background: #f7f9ff;
    padding: 12px;
}

.profile-list-item-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.profile-list-item-title {
    margin: 0;
    color: #141c24;
    font-size: 14px;
    font-weight: 800;
}

.profile-list-item-title a {
    color: inherit;
    text-decoration: none;
}

.profile-list-item-title a:hover {
    text-decoration: underline;
}

.profile-list-item-meta {
    margin-top: 6px;
    color: #44474c;
    font-size: 12px;
    font-weight: 600;
}

.profile-list-item-time {
    color: #75777c;
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
}

.document-status {
    border-radius: 999px;
    padding: 3px 8px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.document-status.published {
    background: #d9fbe5;
    color: #095b2d;
}

.document-status.pending {
    background: #ffedd5;
    color: #9a3412;
}

.profile-empty {
    border-radius: 10px;
    background: #f7f9ff;
    padding: 16px;
    color: #75777c;
    font-size: 13px;
    font-weight: 600;
}

@@media (max-width: 1200px) {
    .profile-layout {
        grid-template-columns: 1fr;
    }
}

@@media (max-width: 768px) {
    .command-profile-page {
        padding: 14px;
    }

    .hero-content {
        flex-direction: column;
        align-items: flex-start;
    }

    .hero-meta h1 {
        font-size: 26px;
    }

    .profile-grid {
        grid-template-columns: 1fr;
    }
}
</style>

<div class="page account-page command-profile-page customer-profile-page">
    <div class="command-hero">
        <div class="hero-cover"></div>
        <div class="hero-content">
            <div class="hero-avatar">@fullName.Substring(0, 1).ToUpperInvariant()</div>
            <div class="hero-meta">
                <h1>@fullName</h1>
                <div class="hero-sub">
                    <span><span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle;">military_tech</span> @(string.IsNullOrWhiteSpace(Model.Rank) ? "Chưa có cấp bậc" : Model.Rank)</span>
                    <span><span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle;">account_balance</span> @(string.IsNullOrWhiteSpace(Model.UnitName) ? "Chưa có đơn vị" : Model.UnitName)</span>
                </div>
            </div>
            <a class="hero-action" asp-route="@NopRouteNames.General.CUSTOMER_INFO">
                <span class="material-symbols-outlined" style="font-size:18px;">edit</span>
                Chỉnh sửa hồ sơ
            </a>
        </div>
    </div>

    <div class="profile-layout">
        <div>
            <div class="profile-side">
                <button type="button" class="profile-nav-btn active" data-tab-target="profile-tab-general">
                    <span class="material-symbols-outlined">info</span>
                    Thông tin chung
                </button>
                <button type="button" class="profile-nav-btn" data-tab-target="profile-tab-activity">
                    <span class="material-symbols-outlined">history</span>
                    Hoạt động gần đây
                </button>
                <button type="button" class="profile-nav-btn" data-tab-target="profile-tab-documents">
                    <span class="material-symbols-outlined">article</span>
                    Văn bản đã đăng
                </button>
            </div>

            <div class="profile-badge">
                <p class="small">Cấp bậc hiện tại</p>
                <p class="main">@(string.IsNullOrWhiteSpace(Model.PositionTitle) ? "Sĩ quan" : Model.PositionTitle)</p>
                <p style="margin-top:6px;font-size:12px;opacity:.85;">Phục vụ từ @(Model.EnlistmentDate?.ToString("yyyy") ?? "-")</p>
            </div>
        </div>

        <div class="profile-main">
            <section id="profile-tab-general" class="profile-panel active">
                <section class="profile-card">
                    <h3>
                        <span class="material-symbols-outlined">badge</span>
                        Thông tin Quân nhân
                    </h3>
                    <div class="profile-grid">
                        <div class="profile-item">
                            <span class="label">Họ và tên</span>
                            <span class="value">@fullName</span>
                        </div>
                        <div class="profile-item">
                            <span class="label">Số hiệu quân nhân</span>
                            <span class="value">@(string.IsNullOrWhiteSpace(Model.MilitaryCode) ? "Chưa cập nhật" : Model.MilitaryCode)</span>
                        </div>
                        <div class="profile-item">
                            <span class="label">Cấp bậc</span>
                            <span class="value">@(string.IsNullOrWhiteSpace(Model.Rank) ? "Chưa cập nhật" : Model.Rank)</span>
                        </div>
                        <div class="profile-item">
                            <span class="label">Chức vụ</span>
                            <span class="value">@(string.IsNullOrWhiteSpace(Model.PositionTitle) ? "Chưa cập nhật" : Model.PositionTitle)</span>
                        </div>
                        <div class="profile-item">
                            <span class="label">Đơn vị công tác</span>
                            <span class="value">@(string.IsNullOrWhiteSpace(Model.UnitName) ? "Chưa cập nhật" : Model.UnitName)</span>
                        </div>
                        <div class="profile-item">
                            <span class="label">Ngày nhập ngũ</span>
                            <span class="value">@(Model.EnlistmentDate?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</span>
                        </div>
                    </div>
                </section>

                <section class="profile-card">
                    <h3>
                        <span class="material-symbols-outlined">contact_mail</span>
                        Thông tin Liên lạc
                    </h3>
                    <div class="profile-contact-row">
                        <div class="profile-contact-icon"><span class="material-symbols-outlined">mail</span></div>
                        <div>
                            <div class="profile-contact-label">Email nội bộ</div>
                            <div class="profile-contact-value">@(string.IsNullOrWhiteSpace(Model.Email) ? "Chưa cập nhật" : Model.Email)</div>
                        </div>
                    </div>
                    <div class="profile-contact-row">
                        <div class="profile-contact-icon"><span class="material-symbols-outlined">call</span></div>
                        <div>
                            <div class="profile-contact-label">Số điện thoại</div>
                            <div class="profile-contact-value">@(string.IsNullOrWhiteSpace(Model.Phone) ? "Chưa cập nhật" : Model.Phone)</div>
                        </div>
                    </div>
                    <div class="profile-contact-row">
                        <div class="profile-contact-icon"><span class="material-symbols-outlined">location_on</span></div>
                        <div>
                            <div class="profile-contact-label">Địa chỉ thường trú</div>
                            <div class="profile-contact-value">@address</div>
                        </div>
                    </div>
                </section>
            </section>

            <section id="profile-tab-activity" class="profile-panel">
                <section class="profile-card">
                    <h3>
                        <span class="material-symbols-outlined">history</span>
                        Hoạt động gần đây
                    </h3>
                    @if (Model.RecentActivities.Any())
                    {
                        <div class="profile-list">
                            @foreach (var activity in Model.RecentActivities)
                            {
                                <article class="profile-list-item">
                                    <div class="profile-list-item-head">
                                        <p class="profile-list-item-title">@(string.IsNullOrWhiteSpace(activity.ActivityTypeName) ? "Hoạt động hệ thống" : activity.ActivityTypeName)</p>
                                        <span class="profile-list-item-time">@activity.CreatedOnUtc.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                    <p class="profile-list-item-meta">@(string.IsNullOrWhiteSpace(activity.Comment) ? "Không có mô tả chi tiết." : activity.Comment)</p>
                                    @if (!string.IsNullOrWhiteSpace(activity.IpAddress))
                                    {
                                        <p class="profile-list-item-meta">IP: @activity.IpAddress</p>
                                    }
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="profile-empty">Chưa có hoạt động nào được ghi nhận cho tài khoản này.</div>
                    }
                </section>
            </section>

            <section id="profile-tab-documents" class="profile-panel">
                <section class="profile-card">
                    <h3>
                        <span class="material-symbols-outlined">article</span>
                        Văn bản đã đăng
                    </h3>
                    @if (Model.PostedDocuments.Any())
                    {
                        <div class="profile-list">
                            @foreach (var document in Model.PostedDocuments)
                            {
                                var documentUrl = document.Published && !string.IsNullOrWhiteSpace(document.Slug)
                                    ? $"/tai-lieu/{document.Slug}"
                                    : "/tai-lieu";
                                <article class="profile-list-item">
                                    <div class="profile-list-item-head">
                                        <p class="profile-list-item-title"><a href="@documentUrl">@document.Title</a></p>
                                        <span class="document-status @(document.Published ? "published" : "pending")">@(document.Published ? "Đã duyệt" : "Chờ duyệt")</span>
                                    </div>
                                    <p class="profile-list-item-meta">Mã: @(string.IsNullOrWhiteSpace(document.Code) ? "-" : document.Code)</p>
                                    <p class="profile-list-item-meta">Ngày đăng: @document.CreatedOnUtc.ToString("dd/MM/yyyy HH:mm")</p>
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="profile-empty">Bạn chưa đăng văn bản nào. <a href="/tai-lieu/upload">Tải văn bản lên ngay</a>.</div>
                    }
                </section>
            </section>
        </div>
    </div>
</div>

<script asp-location="Footer">
    (() => {
        const navButtons = Array.from(document.querySelectorAll('.profile-nav-btn[data-tab-target]'));
        const panels = Array.from(document.querySelectorAll('.profile-panel'));

        if (!navButtons.length || !panels.length)
            return;

        const activateTab = (targetId) => {
            navButtons.forEach(button => {
                const isActive = button.getAttribute('data-tab-target') === targetId;
                button.classList.toggle('active', isActive);
            });

            panels.forEach(panel => {
                panel.classList.toggle('active', panel.id === targetId);
            });
        };

        navButtons.forEach(button => {
            button.addEventListener('click', () => {
                const targetId = button.getAttribute('data-tab-target');
                if (!targetId)
                    return;

                activateTab(targetId);
            });
        });
    })();
</script>
