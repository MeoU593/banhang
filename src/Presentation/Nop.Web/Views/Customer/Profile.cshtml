@model CustomerInfoModel
@{
    Layout = "_ColumnsTwo";

    NopHtml.AddTitleParts(T("PageTitle.Account").Text);
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-customer-profile-page");

    var fullName = $"{Model.FirstName} {Model.LastName}".Trim();
    if (string.IsNullOrWhiteSpace(fullName))
        fullName = Context.User.Identity?.Name ?? "Quân nhân";

    string getAvatarInitial(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var namePart = name.Trim()
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .LastOrDefault() ?? name.Trim();

        return namePart.Substring(0, 1).ToUpper(new System.Globalization.CultureInfo("vi-VN"));
    }

    var address = string.Join(", ", new[] { Model.StreetAddress, Model.StreetAddress2, Model.City, Model.County }.Where(x => !string.IsNullOrWhiteSpace(x)));
    if (string.IsNullOrWhiteSpace(address))
        address = "Chưa cập nhật";
}

@section left
{
    @await Component.InvokeAsync(typeof(CustomerNavigationViewComponent), new { selectedTabId = CustomerNavigationEnum.Profile })
}

<div class="page account-page customer-profile-page space-y-5 px-4 pb-8 lg:px-0">
    <section class="overflow-hidden rounded-2xl border p-5 text-white shadow-[0_24px_60px_-35px_rgba(15,23,42,0.85)] sm:p-6" style="border-color: rgba(214,185,90,.28); background-color: rgba(33,45,27,.92); background-image: linear-gradient(120deg, #0f1a33 0%, #1f2b1a 52%, #314026 100%), repeating-linear-gradient(135deg, rgba(255,255,255,.05) 0, rgba(255,255,255,.05) 1px, transparent 1px, transparent 14px);">
        <nav class="mb-2 flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-slate-200" aria-label="Breadcrumb">
            <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="transition hover:text-white">Trang chủ</a>
            <span class="material-symbols-outlined text-sm text-slate-300">chevron_right</span>
            <span>Tài khoản</span>
            <span class="material-symbols-outlined text-sm text-slate-300">chevron_right</span>
            <span class="text-white">Hồ sơ cá nhân</span>
        </nav>
        <div class="flex flex-wrap items-end justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="relative flex h-20 w-20 items-center justify-center overflow-hidden rounded-2xl border border-white/20 text-3xl font-black uppercase" style="background:#0f172a;color:#f6dc9a;">
                    <span class="flex h-full w-full items-center justify-center">@getAvatarInitial(fullName)</span>
                    @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" alt="@fullName" class="absolute inset-0 h-full w-full object-cover" onerror="this.remove()" />
                    }
                </div>
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#f6dc9a]">Hồ sơ cá nhân</p>
                    <h1 class="public-hero-title mt-1 font-black tracking-tight text-white">@fullName</h1>
                    <p class="mt-1.5 text-xs leading-5 text-white/80 sm:text-sm">@(string.IsNullOrWhiteSpace(Model.Rank) ? "Chưa cập nhật cấp bậc" : Model.Rank) - @(string.IsNullOrWhiteSpace(Model.UnitName) ? "Chưa cập nhật đơn vị" : Model.UnitName)</p>
                </div>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <a class="inline-flex h-11 items-center justify-center rounded-xl bg-white px-5 text-sm font-bold text-slate-900 transition hover:bg-white/90" asp-route="CustomerEditAccount">
                    Chỉnh sửa hồ sơ
                </a>
            </div>
        </div>
    </section>

    @if (TempData["ProfileAvatarMessage"] != null)
    {
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-700">
            @TempData["ProfileAvatarMessage"]
        </div>
    }
    @if (TempData["ProfileAvatarError"] != null)
    {
        <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">
            @TempData["ProfileAvatarError"]
        </div>
    }

    <div class="grid grid-cols-12 gap-5">
        <aside class="col-span-12 space-y-4 lg:col-span-4">
            <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                <button type="button" data-tab-target="profile-tab-general" class="profile-tab-btn flex w-full items-center gap-2 border-b border-slate-100 bg-slate-900 px-4 py-3 text-left text-sm font-semibold text-white transition hover:bg-slate-800">
                    <span class="material-symbols-outlined text-[18px]">info</span>
                    Thông tin chung
                </button>
                <button type="button" data-tab-target="profile-tab-activity" class="profile-tab-btn flex w-full items-center gap-2 border-b border-slate-100 px-4 py-3 text-left text-sm font-semibold text-slate-600 transition hover:bg-slate-50">
                    <span class="material-symbols-outlined text-[18px]">history</span>
                    Hoạt động gần đây
                </button>
                <button type="button" data-tab-target="profile-tab-documents" class="profile-tab-btn flex w-full items-center gap-2 px-4 py-3 text-left text-sm font-semibold text-slate-600 transition hover:bg-slate-50">
                    <span class="material-symbols-outlined text-[18px]">article</span>
                    Văn bản đã đăng
                </button>
            </section>

            <section class="overflow-hidden rounded-2xl bg-slate-900 p-5 text-white shadow-lg">
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-secondary-container">Chức vụ hiện tại</p>
                <p class="mt-2 text-xl font-black">@(string.IsNullOrWhiteSpace(Model.PositionTitle) ? "Sĩ quan" : Model.PositionTitle)</p>
                <p class="mt-1 text-xs text-slate-300">Phục vụ từ @(Model.EnlistmentDate?.ToString("yyyy") ?? "-")</p>
            </section>
        </aside>

        <div class="col-span-12 space-y-4 lg:col-span-8">
            <section id="profile-tab-general" class="profile-panel space-y-4">
                <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
                    <h2 class="public-section-title mb-4 flex items-center gap-2 font-black text-slate-900">
                        <span class="material-symbols-outlined">badge</span>
                        Thông tin quân nhân
                    </h2>
                    <div class="grid gap-3 sm:grid-cols-2">
                        <div class="rounded-xl bg-slate-50 px-3 py-2.5"><p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-500">Họ và tên</p><p class="mt-1 text-sm font-semibold text-slate-900">@fullName</p></div>
                        <div class="rounded-xl bg-slate-50 px-3 py-2.5"><p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-500">Số hiệu quân nhân</p><p class="mt-1 text-sm font-semibold text-slate-900">@(string.IsNullOrWhiteSpace(Model.MilitaryCode) ? "Chưa cập nhật" : Model.MilitaryCode)</p></div>
                        <div class="rounded-xl bg-slate-50 px-3 py-2.5"><p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-500">Cấp bậc</p><p class="mt-1 text-sm font-semibold text-slate-900">@(string.IsNullOrWhiteSpace(Model.Rank) ? "Chưa cập nhật" : Model.Rank)</p></div>
                        <div class="rounded-xl bg-slate-50 px-3 py-2.5"><p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-500">Chức vụ</p><p class="mt-1 text-sm font-semibold text-slate-900">@(string.IsNullOrWhiteSpace(Model.PositionTitle) ? "Chưa cập nhật" : Model.PositionTitle)</p></div>
                        <div class="rounded-xl bg-slate-50 px-3 py-2.5"><p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-500">Đơn vị công tác</p><p class="mt-1 text-sm font-semibold text-slate-900">@(string.IsNullOrWhiteSpace(Model.UnitName) ? "Chưa cập nhật" : Model.UnitName)</p></div>
                        <div class="rounded-xl bg-slate-50 px-3 py-2.5"><p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-500">Ngày nhập ngũ</p><p class="mt-1 text-sm font-semibold text-slate-900">@(Model.EnlistmentDate?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</p></div>
                    </div>
                </article>

                <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
                    <h2 class="public-section-title mb-4 flex items-center gap-2 font-black text-slate-900">
                        <span class="material-symbols-outlined">contact_mail</span>
                        Thông tin liên lạc
                    </h2>
                    <div class="space-y-3">
                        <div class="flex items-center gap-3 rounded-xl bg-slate-50 px-3 py-2.5">
                            <span class="material-symbols-outlined text-slate-500">mail</span>
                            <div>
                                <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-500">Email nội bộ</p>
                                <p class="text-sm font-semibold text-slate-900">@(string.IsNullOrWhiteSpace(Model.Email) ? "Chưa cập nhật" : Model.Email)</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 rounded-xl bg-slate-50 px-3 py-2.5">
                            <span class="material-symbols-outlined text-slate-500">call</span>
                            <div>
                                <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-500">Số điện thoại</p>
                                <p class="text-sm font-semibold text-slate-900">@(string.IsNullOrWhiteSpace(Model.Phone) ? "Chưa cập nhật" : Model.Phone)</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 rounded-xl bg-slate-50 px-3 py-2.5">
                            <span class="material-symbols-outlined text-slate-500">location_on</span>
                            <div>
                                <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-500">Địa chỉ thường trú</p>
                                <p class="text-sm font-semibold text-slate-900">@address</p>
                            </div>
                        </div>
                    </div>
                </article>
            </section>

            <section id="profile-tab-activity" class="profile-panel hidden">
                <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
                    <h2 class="public-section-title mb-4 flex items-center gap-2 font-black text-slate-900">
                        <span class="material-symbols-outlined">history</span>
                        Hoạt động gần đây
                    </h2>
                    @if (Model.RecentActivities?.Any() == true)
                    {
                        <div class="space-y-3">
                            @foreach (var activity in Model.RecentActivities)
                            {
                                <article class="rounded-xl border border-slate-100 bg-slate-50 px-3 py-2.5">
                                    <div class="flex flex-wrap items-center justify-between gap-2">
                                        <p class="text-sm font-bold text-slate-900">@(string.IsNullOrWhiteSpace(activity.ActivityTypeName) ? "Hoạt động hệ thống" : activity.ActivityTypeName)</p>
                                        <span class="text-xs font-semibold text-slate-500">@activity.CreatedOnUtc.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                    <p class="mt-1 text-xs text-slate-600">@(string.IsNullOrWhiteSpace(activity.Comment) ? "Không có mô tả chi tiết." : activity.Comment)</p>
                                    @if (!string.IsNullOrWhiteSpace(activity.IpAddress))
                                    {
                                        <p class="mt-1 text-xs font-semibold text-slate-500">IP: @activity.IpAddress</p>
                                    }
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="rounded-xl border border-dashed border-slate-300 px-4 py-8 text-center text-sm text-slate-500">Chưa có hoạt động nào được ghi nhận cho tài khoản này.</p>
                    }
                </article>
            </section>

            <section id="profile-tab-documents" class="profile-panel hidden">
                <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
                    <div class="mb-5 flex flex-wrap items-start justify-between gap-3">
                        <div>
                            <h2 class="public-section-title flex items-center gap-2 font-black text-slate-900">
                                <span class="material-symbols-outlined">article</span>
                                Văn bản đã đăng
                            </h2>
                            <p class="mt-1 text-sm text-slate-500">Quản lý tài liệu bạn đã gửi lên kho tài liệu. Tài liệu chờ duyệt vẫn có thể sửa hoặc xóa.</p>
                        </div>
                        <a href="/tai-lieu/upload" class="inline-flex items-center gap-1.5 rounded-xl bg-military-green px-4 py-2 text-sm font-bold text-white transition hover:bg-military-green/90">
                            <span class="material-symbols-outlined text-[17px]">upload_file</span>
                            Tải văn bản lên
                        </a>
                    </div>

                    @if (TempData["ProfileDocumentsMessage"] != null)
                    {
                        <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-700">
                            @TempData["ProfileDocumentsMessage"]
                        </div>
                    }

                    @if (Model.PostedDocuments?.Any() == true)
                    {
                        <div class="mb-4 flex flex-wrap items-center justify-between gap-2 rounded-xl bg-slate-50 px-4 py-3 text-xs font-semibold text-slate-600">
                            <span>Hiển thị @(((Model.PostedDocumentsPage - 1) * Model.PostedDocumentsPageSize) + 1)-@Math.Min(Model.PostedDocumentsPage * Model.PostedDocumentsPageSize, Model.PostedDocumentsTotalCount) trong số @Model.PostedDocumentsTotalCount tài liệu</span>
                            <span>Trang @Model.PostedDocumentsPage/@Model.PostedDocumentsTotalPages</span>
                        </div>

                        <div class="space-y-3">
                            @foreach (var document in Model.PostedDocuments)
                            {
                                var documentUrl = document.CanView && !string.IsNullOrWhiteSpace(document.Slug)
                                    ? $"/tai-lieu/{document.Slug}"
                                    : "/tai-lieu";
                                <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_18px_34px_-32px_rgba(15,23,42,0.55)]">
                                    <div class="flex flex-col gap-4 p-4 sm:flex-row sm:items-start sm:justify-between">
                                        <div class="min-w-0 flex-1">
                                            <div class="mb-2 flex flex-wrap items-center gap-2">
                                                <span class="inline-flex rounded-full px-2.5 py-1 text-[10px] font-black uppercase tracking-[0.12em] @(document.Published ? "bg-emerald-100 text-emerald-700" : "bg-amber-100 text-amber-700")">@(document.Published ? "Đã duyệt" : "Chờ duyệt")</span>
                                                <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-600">@document.AccessScopeName</span>
                                                @if (document.HasDownload)
                                                {
                                                    <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-blue-700">
                                                        <span class="material-symbols-outlined text-[13px]">attach_file</span>
                                                        Có file
                                                    </span>
                                                }
                                            </div>

                                            <h3 class="public-list-title font-black text-slate-900">@document.Title</h3>
                                            @if (!string.IsNullOrWhiteSpace(document.Summary))
                                            {
                                                <p class="mt-1 line-clamp-2 text-xs leading-5 text-slate-500">@document.Summary</p>
                                            }

                                            <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-500">
                                                <span>Mã: <strong class="text-slate-700">@(string.IsNullOrWhiteSpace(document.Code) ? "-" : document.Code)</strong></span>
                                                <span>Đăng: @document.CreatedOnUtc.ToString("dd/MM/yyyy HH:mm")</span>
                                                <span>Cập nhật: @document.UpdatedOnUtc.ToString("dd/MM/yyyy HH:mm")</span>
                                            </div>
                                        </div>

                                        <div class="flex flex-wrap items-center gap-2 sm:justify-end">
                                            @if (document.CanView)
                                            {
                                                <a href="@documentUrl" class="inline-flex items-center gap-1 rounded-lg bg-slate-100 px-3 py-2 text-xs font-bold text-slate-700 transition hover:bg-slate-200">
                                                    <span class="material-symbols-outlined text-[15px]">visibility</span>
                                                    Xem
                                                </a>
                                            }
                                            @if (document.CanEdit)
                                            {
                                                <a href="/tai-lieu/cua-toi/sua/@document.Id" class="inline-flex items-center gap-1 rounded-lg bg-military-green px-3 py-2 text-xs font-bold text-white transition hover:bg-military-green/90">
                                                    <span class="material-symbols-outlined text-[15px]">edit</span>
                                                    Sửa
                                                </a>
                                            }
                                            @if (document.CanDelete)
                                            {
                                                <form method="post" action="/tai-lieu/cua-toi/xoa/@document.Id" onsubmit="return confirm('Xóa tài liệu này?')">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="inline-flex items-center gap-1 rounded-lg bg-red-50 px-3 py-2 text-xs font-bold text-red-600 transition hover:bg-red-100">
                                                        <span class="material-symbols-outlined text-[15px]">delete</span>
                                                        Xóa
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>

                        @if (Model.PostedDocumentsTotalPages > 1)
                        {
                            <div class="mt-5 flex flex-wrap justify-center gap-2">
                                @for (var pageNumber = 1; pageNumber <= Model.PostedDocumentsTotalPages; pageNumber++)
                                {
                                    var pageClass = pageNumber == Model.PostedDocumentsPage
                                        ? "inline-flex h-9 min-w-9 items-center justify-center rounded-lg bg-military-green px-3 text-sm font-black text-white"
                                        : "inline-flex h-9 min-w-9 items-center justify-center rounded-lg border border-slate-200 bg-white px-3 text-sm font-bold text-slate-600 transition hover:border-military-green hover:text-military-green";
                                    <a href="/customer/profile?documentPage=@pageNumber#profile-tab-documents" class="@pageClass">@pageNumber</a>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-4 py-10 text-center">
                            <span class="material-symbols-outlined text-4xl text-slate-300">draft</span>
                            <p class="mt-2 text-sm font-semibold text-slate-600">Bạn chưa đăng văn bản nào.</p>
                            <a href="/tai-lieu/upload" class="mt-4 inline-flex items-center gap-1.5 rounded-xl bg-military-green px-4 py-2 text-sm font-bold text-white transition hover:bg-military-green/90">
                                <span class="material-symbols-outlined text-[17px]">upload_file</span>
                                Tải văn bản lên ngay
                            </a>
                        </div>
                    }
                </article>
            </section>
        </div>
    </div>
</div>

<script asp-location="Footer">
    (() => {
        const navButtons = Array.from(document.querySelectorAll('.profile-tab-btn[data-tab-target]'));
        const panels = Array.from(document.querySelectorAll('.profile-panel'));

        if (!navButtons.length || !panels.length) {
            return;
        }

        const activateTab = (targetId) => {
            navButtons.forEach((button) => {
                const isActive = button.getAttribute('data-tab-target') === targetId;
                button.classList.toggle('bg-slate-900', isActive);
                button.classList.toggle('text-white', isActive);
                button.classList.toggle('text-slate-600', !isActive);
                button.classList.toggle('hover:bg-slate-800', isActive);
                button.classList.toggle('hover:bg-slate-50', !isActive);
            });

            panels.forEach((panel) => {
                panel.classList.toggle('hidden', panel.id !== targetId);
            });
        };

        navButtons.forEach((button) => {
            button.addEventListener('click', () => {
                const targetId = button.getAttribute('data-tab-target');
                if (!targetId) {
                    return;
                }

                activateTab(targetId);
            });
        });

        if (window.location.hash === '#profile-tab-documents') {
            activateTab('profile-tab-documents');
        }
    })();
</script>
