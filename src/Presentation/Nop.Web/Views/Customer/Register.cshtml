@model RegisterModel
@using System.Text.Encodings.Web

@{
    Layout = "_ColumnsOne";
    ViewData["AuthStandalone"] = true;

    NopHtml.AddTitleParts(T("PageTitle.Register").Text);
    NopHtml.AppendPageCssClassParts("html-registration-page");
}

<style>
    .reg-section-label {
        font-size: var(--public-font-label);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.22em;
        color: #94a3b8;
        padding-bottom: 0.375rem;
        border-bottom: 1px solid #f1f5f9;
        margin-bottom: 0.75rem;
    }
    .reg-field-wrap { position: relative; }
    .reg-field-icon {
        position: absolute;
        top: 50%;
        left: 10px;
        transform: translateY(-50%);
        z-index: 3;
        pointer-events: none;
        display: flex;
        align-items: center;
        color: #94a3b8;
    }
    .reg-field-icon .material-symbols-outlined {
        font-size: 17px !important;
        font-family: 'Material Symbols Outlined' !important;
        line-height: 1;
    }
    .reg-field {
        position: relative;
        z-index: 1;
        display: block !important;
        width: 100% !important;
        height: 40px !important;
        padding: 0 0.75rem !important;
        border: 1px solid #e2e8f0 !important;
        border-radius: 10px !important;
        background: #f8fafc !important;
        font-size: var(--public-font-control) !important;
        color: #334155 !important;
        outline: none !important;
        box-shadow: none !important;
        transition: border-color 0.15s, background 0.15s !important;
        -webkit-appearance: none !important;
    }
    .reg-field.has-icon { padding-left: 2.25rem !important; }
    .reg-field:focus {
        border-color: #94a3b8 !important;
        background: #ffffff !important;
    }
    .reg-field:-webkit-autofill,
    .reg-field:-webkit-autofill:focus {
        -webkit-box-shadow: 0 0 0px 1000px #ffffff inset !important;
        -webkit-text-fill-color: #334155 !important;
        transition: background-color 0s 9999s !important;
    }
    .reg-label {
        display: block;
        font-size: var(--public-font-control);
        font-weight: 600;
        color: #374151;
        margin-bottom: 0.25rem;
    }
    .reg-error {
        font-size: var(--public-font-meta);
        color: #e11d48;
        margin-top: 0.2rem;
        display: block;
    }
    .reg-required { color: #e11d48; margin-left: 2px; }
    .reg-radio-group { display: flex; gap: 1.25rem; }
    .reg-radio-group label { font-size: var(--public-font-control); font-weight: 400 !important; display: flex; align-items: center; gap: 0.35rem; cursor: pointer; }
    .reg-gender-field {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.35rem;
    }
    .reg-gender-field > .reg-label { margin: 0; }
    .reg-gender-field > .reg-radio-group {
        order: 2;
        flex-wrap: wrap;
    }
    .reg-checkbox-row { display: flex; align-items: flex-start; gap: 0.625rem; }
    .reg-checkbox-row input[type=checkbox] { margin-top: 2px; flex-shrink: 0; width: 0.9rem; height: 0.9rem; }
    .reg-checkbox-row label { font-size: 0.8125rem; color: #475569; line-height: 1.4; }
    /* * trước label trong từng field wrapper */
    .space-y-0\.5 {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        align-items: baseline;
        column-gap: 4px;
        row-gap: 4px;
    }
    .space-y-0\.5 > .reg-label { order: 2; margin: 0; flex-shrink: 0; }
    .space-y-0\.5 > .reg-required { order: 1; flex-shrink: 0; margin: 0; }
    .space-y-0\.5 > .reg-field-wrap { order: 3; flex-basis: 100%; }
    .space-y-0\.5 > .reg-error { order: 4; flex-basis: 100%; }
</style>

<div class="page registration-page min-h-[100dvh] bg-slate-100">
    <div class="page-body grid min-h-[100dvh] lg:grid-cols-2">
        @await Html.PartialAsync("_AuthLeftPanel")

        <section class="flex h-[100dvh] w-full items-center justify-center bg-slate-50 overflow-y-auto px-4 py-4 sm:px-6 lg:px-8">
            <div class="w-full max-w-xl space-y-3">
                <div class="rounded-2xl border border-slate-200 bg-white/80 px-4 py-3 backdrop-blur lg:hidden">
                    <p class="text-xs font-bold uppercase tracking-[0.22em] text-slate-700">Bộ Tư lệnh Tăng Thiết Giáp</p>
                    <p class="text-[11px] text-slate-500">Cổng thông tin Hậu cần - Quân nhu</p>
                </div>

                @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.RegisterTop, additionalData = Model })

                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_18px_44px_-30px_rgba(15,23,42,0.28)] sm:p-6">
                    <div class="mb-5">
                        <p class="auth-red-text text-xs font-semibold uppercase tracking-[0.28em] text-military-red">Đăng ký hệ thống</p>
                        <h2 class="public-section-title font-black tracking-tight text-slate-900 mt-1">Khởi tạo tài khoản</h2>
                    </div>

                    <form asp-route="@NopRouteNames.Standard.REGISTER" asp-route-returnurl="@Context.Request.Query["ReturnUrl"]" method="post" autocomplete="off" class="space-y-3">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700"></div>

                        @* Thông tin cá nhân *@
                        <div class="space-y-3">
                            <p class="reg-section-label">@T("Account.YourPersonalDetails")</p>

                            @if (Model.GenderEnabled)
                            {
                                <div class="reg-gender-field">
                                    <label class="reg-label">@T("Account.Fields.Gender")</label>
                                    <div class="reg-radio-group">
                                        <label><input type="radio" asp-for="Gender" value="M" checked="@(Model.Gender == "M")" id="gender-male" /> @T("Account.Fields.Gender.Male")</label>
                                        <label><input type="radio" asp-for="Gender" value="F" checked="@(Model.Gender == "F")" id="gender-female" /> @T("Account.Fields.Gender.Female")</label>
                                        @if (Model.NeutralGenderEnabled)
                                        {
                                            <label><input type="radio" asp-for="Gender" value="N" checked="@(Model.Gender == "N")" id="gender-neutral" /> @T("Account.Fields.Gender.Neutral")</label>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="grid gap-4 @(Model.FirstNameEnabled && Model.LastNameEnabled ? "md:grid-cols-2" : "")">
                                @if (Model.FirstNameEnabled)
                                {
                                    <div class="space-y-0.5">
                                        <label asp-for="FirstName" class="reg-label"></label>
                                        <div class="reg-field-wrap">
                                            <span class="reg-field-icon"><span class="material-symbols-outlined">person</span></span>
                                            <input asp-for="FirstName" class="reg-field has-icon" placeholder="Nguyễn Văn" />
                                        </div>
                                        @if (Model.FirstNameRequired) { <span class="reg-required">*</span> }
                                        <span asp-validation-for="FirstName" class="reg-error"></span>
                                    </div>
                                }
                                @if (Model.LastNameEnabled)
                                {
                                    <div class="space-y-0.5">
                                        <label asp-for="LastName" class="reg-label"></label>
                                        <div class="reg-field-wrap">
                                            <span class="reg-field-icon"><span class="material-symbols-outlined">badge</span></span>
                                            <input asp-for="LastName" class="reg-field has-icon" placeholder="A" />
                                        </div>
                                        @if (Model.LastNameRequired) { <span class="reg-required">*</span> }
                                        <span asp-validation-for="LastName" class="reg-error"></span>
                                    </div>
                                }
                            </div>

                            @if (Model.DateOfBirthEnabled)
                            {
                                <div class="space-y-0.5">
                                    <label class="reg-label">@T("Account.Fields.DateOfBirth")</label>
                                    <nop-date-picker asp-day-name="@Html.NameFor(x => x.DateOfBirthDay)"
                                                     asp-month-name="@Html.NameFor(x => x.DateOfBirthMonth)"
                                                     asp-year-name="@Html.NameFor(x => x.DateOfBirthYear)"
                                                     asp-begin-year="@(DateTime.Now.AddYears(-110))"
                                                     asp-end-year="@(DateTime.UtcNow)"
                                                     asp-selected-date="@Model.ParseDateOfBirth()" />
                                    @if (Model.DateOfBirthRequired) { <span class="reg-required">*</span> }
                                    <span asp-validation-for="DateOfBirthDay" class="reg-error"></span>
                                </div>
                            }

                            <div class="space-y-0.5">
                                <label asp-for="Email" class="reg-label"></label>
                                <div class="reg-field-wrap">
                                    <span class="reg-field-icon"><span class="material-symbols-outlined">mail</span></span>
                                    <input asp-for="Email" class="reg-field has-icon" placeholder="example@bqp.gov.vn" />
                                </div>
                                <span class="reg-required">*</span>
                                <span asp-validation-for="Email" class="reg-error"></span>
                            </div>

                            @if (Model.EnteringEmailTwice)
                            {
                                <div class="space-y-0.5">
                                    <label asp-for="ConfirmEmail" class="reg-label"></label>
                                    <div class="reg-field-wrap">
                                        <span class="reg-field-icon"><span class="material-symbols-outlined">alternate_email</span></span>
                                        <input asp-for="ConfirmEmail" class="reg-field has-icon" placeholder="Nhập lại email" />
                                    </div>
                                    <span class="reg-required">*</span>
                                    <span asp-validation-for="ConfirmEmail" class="reg-error"></span>
                                </div>
                            }

                            @if (Model.UsernamesEnabled)
                            {
                                <div class="space-y-0.5">
                                    <label asp-for="Username" class="reg-label"></label>
                                    <div class="reg-field-wrap">
                                        <span class="reg-field-icon"><span class="material-symbols-outlined">account_circle</span></span>
                                        <input asp-for="Username" class="reg-field has-icon" placeholder="Ví dụ: btl_ttg_user" />
                                    </div>
                                    <span class="reg-required">*</span>
                                    <span asp-validation-for="Username" class="reg-error"></span>
                                    @if (Model.CheckUsernameAvailabilityEnabled)
                                    {
                                        @await Html.PartialAsync("_CheckUsernameAvailability")
                                    }
                                </div>
                            }
                        </div>

                        @* Đơn vị công tác *@
                        @if (Model.CompanyEnabled || Model.DisplayVatNumber)
                        {
                            <div class="space-y-3">
                                <p class="reg-section-label">@T("Account.CompanyDetails")</p>
                                <div class="grid gap-3 md:grid-cols-2">
                                    @if (Model.CompanyEnabled)
                                    {
                                        <div class="space-y-0.5">
                                            <label asp-for="Company" class="reg-label"></label>
                                            <div class="reg-field-wrap">
                                                <span class="reg-field-icon"><span class="material-symbols-outlined">account_balance</span></span>
                                                <input asp-for="Company" class="reg-field has-icon" placeholder="Lữ đoàn 201" />
                                            </div>
                                            @if (Model.CompanyRequired) { <span class="reg-required">*</span> }
                                            <span asp-validation-for="Company" class="reg-error"></span>
                                        </div>
                                    }
                                    @if (Model.DisplayVatNumber)
                                    {
                                        <div class="space-y-0.5">
                                            <label asp-for="VatNumber" class="reg-label"></label>
                                            <input asp-for="VatNumber" class="reg-field" />
                                            @if (Model.VatNumberRequired) { <span class="reg-required">*</span> }
                                            <span asp-validation-for="VatNumber" class="reg-error"></span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @* Địa chỉ *@
                        @if (Model.StreetAddressEnabled || Model.StreetAddress2Enabled || Model.ZipPostalCodeEnabled || Model.CityEnabled || Model.CountyEnabled || Model.CountryEnabled)
                        {
                            <div class="space-y-3">
                                <p class="reg-section-label">@T("Account.YourAddress")</p>
                                <div class="grid gap-3 md:grid-cols-2">
                                    @if (Model.StreetAddressEnabled)
                                    {
                                        <div class="space-y-0.5">
                                            <label asp-for="StreetAddress" class="reg-label"></label>
                                            <input asp-for="StreetAddress" class="reg-field" />
                                            @if (Model.StreetAddressRequired) { <span class="reg-required">*</span> }
                                            <span asp-validation-for="StreetAddress" class="reg-error"></span>
                                        </div>
                                    }
                                    @if (Model.StreetAddress2Enabled)
                                    {
                                        <div class="space-y-0.5">
                                            <label asp-for="StreetAddress2" class="reg-label"></label>
                                            <input asp-for="StreetAddress2" class="reg-field" />
                                            @if (Model.StreetAddress2Required) { <span class="reg-required">*</span> }
                                            <span asp-validation-for="StreetAddress2" class="reg-error"></span>
                                        </div>
                                    }
                                    @if (Model.ZipPostalCodeEnabled)
                                    {
                                        <div class="space-y-0.5">
                                            <label asp-for="ZipPostalCode" class="reg-label"></label>
                                            <input asp-for="ZipPostalCode" class="reg-field" />
                                            @if (Model.ZipPostalCodeRequired) { <span class="reg-required">*</span> }
                                            <span asp-validation-for="ZipPostalCode" class="reg-error"></span>
                                        </div>
                                    }
                                    @if (Model.CountyEnabled)
                                    {
                                        <div class="space-y-0.5">
                                            <label asp-for="County" class="reg-label"></label>
                                            <input asp-for="County" class="reg-field" />
                                            @if (Model.CountyRequired) { <span class="reg-required">*</span> }
                                            <span asp-validation-for="County" class="reg-error"></span>
                                        </div>
                                    }
                                    @if (Model.CityEnabled)
                                    {
                                        <div class="space-y-0.5">
                                            <label asp-for="City" class="reg-label"></label>
                                            <input asp-for="City" class="reg-field" />
                                            @if (Model.CityRequired) { <span class="reg-required">*</span> }
                                            <span asp-validation-for="City" class="reg-error"></span>
                                        </div>
                                    }
                                    @if (Model.CountryEnabled)
                                    {
                                        <div class="space-y-0.5">
                                            <label asp-for="CountryId" class="reg-label"></label>
                                            <select asp-for="CountryId" asp-items="Model.AvailableCountries" class="reg-field"
                                                    data-trigger="country-select"
                                                    data-url="@(Url.RouteUrl(NopRouteNames.Ajax.GET_STATES_BY_COUNTRY_ID))"
                                                    data-stateprovince="#@Html.IdFor(model => model.StateProvinceId)"
                                                    data-loading="#states-loading-progress"></select>
                                            @if (Model.CountryRequired) { <span class="reg-required">*</span> }
                                            <span asp-validation-for="CountryId" class="reg-error"></span>
                                        </div>
                                    }
                                    @if (Model.CountryEnabled && Model.StateProvinceEnabled)
                                    {
                                        <div class="space-y-0.5">
                                            <label asp-for="StateProvinceId" class="reg-label"></label>
                                            <select asp-for="StateProvinceId" asp-items="Model.AvailableStates" class="reg-field"></select>
                                            @if (Model.StateProvinceRequired) { <span class="reg-required">*</span> }
                                            <span id="states-loading-progress" style="display:none" class="text-xs text-slate-400">@T("Common.Wait")</span>
                                            <span asp-validation-for="StateProvinceId" class="reg-error"></span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @* Liên hệ *@
                        @if (Model.PhoneEnabled || Model.FaxEnabled)
                        {
                            <div class="space-y-3">
                                <p class="reg-section-label">@T("Account.YourContactInformation")</p>
                                <div class="grid gap-3 md:grid-cols-2">
                                    @if (Model.PhoneEnabled)
                                    {
                                        <div class="space-y-0.5">
                                            <label asp-for="Phone" class="reg-label"></label>
                                            <div class="reg-field-wrap">
                                                <span class="reg-field-icon"><span class="material-symbols-outlined">call</span></span>
                                                <input asp-for="Phone" class="reg-field has-icon" placeholder="09xx xxx xxx" />
                                            </div>
                                            @if (Model.PhoneRequired) { <span class="reg-required">*</span> }
                                            <span asp-validation-for="Phone" class="reg-error"></span>
                                        </div>
                                    }
                                    @if (Model.FaxEnabled)
                                    {
                                        <div class="space-y-0.5">
                                            <label asp-for="Fax" class="reg-label"></label>
                                            <input asp-for="Fax" class="reg-field" />
                                            @if (Model.FaxRequired) { <span class="reg-required">*</span> }
                                            <span asp-validation-for="Fax" class="reg-error"></span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @* Tuỳ chọn khác *@
                        @if (Model.CustomerAttributes.Count > 0)
                        {
                            <div class="space-y-3">
                                <p class="reg-section-label">@T("Account.Options")</p>
                                @await Html.PartialAsync("_CustomerAttributes", Model.CustomerAttributes)
                            </div>
                        }

                        @if (Model.AllowCustomersToSetTimeZone)
                        {
                            <div class="space-y-0.5">
                                <label asp-for="TimeZoneId" class="reg-label"></label>
                                <select asp-for="TimeZoneId" asp-items="Model.AvailableTimeZones" class="reg-field"></select>
                                <span asp-validation-for="TimeZoneId" class="reg-error"></span>
                            </div>
                        }

                        @* Mật khẩu *@
                        <div class="space-y-3">
                            <p class="reg-section-label">@T("Account.YourPassword")</p>
                            <div class="grid gap-3 md:grid-cols-2">
                                <div class="space-y-0.5">
                                    <label asp-for="Password" class="reg-label"></label>
                                    <div class="reg-field-wrap">
                                        <span class="reg-field-icon"><span class="material-symbols-outlined">lock</span></span>
                                        <input asp-for="Password" class="reg-field has-icon" placeholder="••••••••" />
                                    </div>
                                    <span class="reg-required">*</span>
                                    <span asp-validation-for="Password" class="reg-error"></span>
                                </div>
                                <div class="space-y-0.5">
                                    <label asp-for="ConfirmPassword" class="reg-label"></label>
                                    <div class="reg-field-wrap">
                                        <span class="reg-field-icon"><span class="material-symbols-outlined">lock_reset</span></span>
                                        <input asp-for="ConfirmPassword" class="reg-field has-icon" placeholder="••••••••" />
                                    </div>
                                    <span class="reg-required">*</span>
                                    <span asp-validation-for="ConfirmPassword" class="reg-error"></span>
                                </div>
                            </div>
                            @if (Model.DisplayCaptcha)
                            {
                                <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                                    <nop-captcha />
                                </div>
                            }
                            @if (Model.HoneypotEnabled)
                            {
                                @Html.Raw(Html.GenerateHoneypotInput())
                            }
                        </div>

                        @* Điều khoản *@
                        @if (Model.AcceptPrivacyPolicyEnabled || Model.GdprConsents.Count > 0)
                        {
                            <div class="space-y-3">
                                <p class="reg-section-label">@T("Account.UserAgreement")</p>
                                @if (Model.AcceptPrivacyPolicyEnabled)
                                {
                                    <script asp-location="Footer">
                                        $(function () {
                                            $('#register-button').on('click', function () {
                                                if ($('#accept-consent').is(':checked')) { return true; }
                                                else { alert('@Html.Raw(JavaScriptEncoder.Default.Encode(T("Account.Fields.AcceptPrivacyPolicy.Required").Text))'); return false; }
                                            });
                                        });
                                    </script>
                                    <div class="reg-checkbox-row rounded-xl border border-slate-200 bg-slate-50 p-4">
                                        <input id="accept-consent" type="checkbox" name="accept-consent" class="h-4 w-4 rounded border-slate-300 text-military-red focus:ring-military-red" />
                                        <label for="accept-consent" class="text-sm text-slate-600">
                                            @T("Account.Fields.AcceptPrivacyPolicy")
                                            @if (Model.AcceptPrivacyPolicyPopup)
                                            {
                                                <span class="ml-1 cursor-pointer font-semibold text-military-red hover:underline" id="read-privacyinfo">@T("Account.Fields.AcceptPrivacyPolicy.Read")</span>
                                                <script asp-location="Footer">
                                                    $(function () { $('#read-privacyinfo').on('click', function () { displayPopupContentFromUrl('@Url.RouteUrl(NopRouteNames.Ajax.TOPIC_POPUP, new { SystemName = "privacyinfo" })', '@T("Account.Fields.AcceptPrivacyPolicy")'); }); });
                                                </script>
                                            }
                                            else
                                            {
                                                <a class="ml-1 font-semibold text-military-red hover:underline" id="read-privacyinfo" href="@await NopUrl.RouteTopicUrlAsync("privacyinfo")">@T("Account.Fields.AcceptPrivacyPolicy.Read")</a>
                                            }
                                        </label>
                                    </div>
                                }
                                @foreach (var consent in Model.GdprConsents)
                                {
                                    if (consent.IsRequired)
                                    {
                                        <script asp-location="Footer">
                                            $(function () { $('#register-button').on('click', function () { if ($('#consent@(consent.Id)').is(':checked')) { return true; } else { alert('@Html.Raw(JavaScriptEncoder.Default.Encode(consent.RequiredMessage))'); return false; } }); });
                                        </script>
                                    }
                                    <div class="reg-checkbox-row">
                                        <input id="consent@(consent.Id)" type="checkbox" name="consent@(consent.Id)" checked="@consent.Accepted" class="h-4 w-4 rounded border-slate-300 text-military-red focus:ring-military-red" />
                                        <label for="consent@(consent.Id)" class="text-sm text-slate-600">@consent.Message</label>
                                    </div>
                                }
                            </div>
                        }

                        @* Nút đăng ký *@
                        <button type="submit" name="register-button" id="register-button"
                                class="auth-red-action flex w-full items-center justify-center gap-2 rounded-xl bg-military-red px-4 py-3 text-sm font-bold uppercase tracking-[0.18em] text-[#d4af37] shadow-[0_16px_36px_-20px_rgba(185,28,28,0.8)] transition hover:-translate-y-[1px] active:scale-[0.98] group">
                            <span>ĐĂNG KÝ TÀI KHOẢN</span>
                            <span class="material-symbols-outlined text-[18px] transition-transform group-hover:translate-x-1">how_to_reg</span>
                        </button>

                        <div class="text-center text-sm text-slate-500">
                            Đã có tài khoản?
                            <a href="@Url.RouteUrl(NopRouteNames.General.LOGIN)" class="auth-red-text font-semibold text-military-red transition hover:text-rose-700">Đăng nhập ngay</a>
                        </div>
                    </form>

                    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.RegisterBottom, additionalData = Model })

                    <div class="mt-4 flex items-center justify-between text-xs text-slate-400">
                        <span>© 2024 Bộ Tư lệnh Tăng Thiết Giáp</span>
                        <span class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-0.5">Chờ phê duyệt</span>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
