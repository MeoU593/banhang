@model PasswordRecoveryConfirmModel
@{
    Layout = "_ColumnsOne";

    //title
    NopHtml.AddTitleParts(T("PageTitle.PasswordRecovery").Text);
    //page class
    NopHtml.AppendPageCssClassParts("html-password-recovery-page");
}
<div class="page password-recovery-page mx-auto max-w-2xl px-4 py-8">
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-[0_24px_70px_-45px_rgba(15,23,42,0.55)] sm:p-8">
        <div class="mb-6">
            <p class="public-label-text font-bold uppercase tracking-[0.18em] text-military-red">Thiết lập bảo mật</p>
            <h1 class="public-page-title mt-2 font-black text-slate-950">@T("Account.PasswordRecovery")</h1>
        </div>

        @if (!string.IsNullOrEmpty(Model.Result))
        {
            <div class="result rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-emerald-800">
                @Model.Result
            </div>
            <div class="mt-5">
                <a href="@Model.ReturnUrl" class="button-1 public-control-text inline-flex min-h-11 items-center justify-center rounded-xl bg-military-red px-6 font-bold uppercase tracking-[0.12em] text-white transition hover:brightness-110">@T("Common.Continue")</a>
            </div>
        }
        @if (!Model.DisablePasswordChanging)
        {
            <form asp-route="@NopRouteNames.Standard.PASSWORD_RECOVERY_CONFIRM" asp-route-token="@Context.Request.Query["token"]" asp-route-guid="@Context.Request.Query["guid"]" method="post" autocomplete="off" class="space-y-5">
                <div asp-validation-summary="ModelOnly" class="message-error"></div>
                <div class="space-y-2">
                    <label asp-for="NewPassword" asp-postfix=":" class="public-control-text block font-bold text-slate-700"></label>
                    <input asp-for="NewPassword" class="w-full" />
                    <nop-required />
                    <span asp-validation-for="NewPassword"></span>
                </div>
                <div class="space-y-2">
                    <label asp-for="ConfirmNewPassword" asp-postfix=":" class="public-control-text block font-bold text-slate-700"></label>
                    <input asp-for="ConfirmNewPassword" class="w-full" />
                    <nop-required />
                    <span asp-validation-for="ConfirmNewPassword"></span>
                </div>
                <button type="submit" name="set-password" class="button-1 new-password-button public-control-text inline-flex min-h-11 items-center justify-center rounded-xl bg-military-red px-6 font-bold uppercase tracking-[0.12em] text-white transition hover:brightness-110">@T("Account.PasswordRecovery.ChangePasswordButton")</button>
            </form>
        }
    </section>
</div>
