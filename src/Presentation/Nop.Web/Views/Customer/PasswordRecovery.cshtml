@model PasswordRecoveryModel
@{
    Layout = "_ColumnsOne";

    //title
    NopHtml.AddTitleParts(T("PageTitle.PasswordRecovery").Text);
    //page class
    NopHtml.AppendPageCssClassParts("html-password-recovery-page");
}
<div class="page password-recovery-page mx-auto max-w-2xl px-4 py-8">
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-[0_24px_70px_-45px_rgba(15,23,42,0.55)] sm:p-8">
        <div class="mb-6">
            <p class="public-label-text font-bold uppercase tracking-[0.18em] text-military-red">Khôi phục truy cập</p>
            <h1 class="public-page-title mt-2 font-black text-slate-950">@T("Account.PasswordRecovery")</h1>
            <p class="public-body-text mt-3 text-slate-600">@T("Account.PasswordRecovery.Tooltip")</p>
        </div>

        <form asp-route="@NopRouteNames.Standard.PASSWORD_RECOVERY" method="post" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="message-error"></div>
            <div class="space-y-2">
                <label asp-for="Email" asp-postfix=":" class="public-control-text block font-bold text-slate-700"></label>
                <div class="relative">
                    <span class="material-symbols-outlined pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">mail</span>
                    <input asp-for="Email" class="email w-full pl-11" />
                </div>
                <nop-required />
                <span asp-validation-for="Email"></span>
            </div>
            @if (Model.DisplayCaptcha)
            {
                <nop-captcha />
            }
            <button type="submit" name="send-email" class="button-1 password-recovery-button public-control-text inline-flex min-h-11 items-center justify-center rounded-xl bg-military-red px-6 font-bold uppercase tracking-[0.12em] text-white transition hover:brightness-110">@T("Account.PasswordRecovery.RecoverButton")</button>
        </form>
    </section>
</div>
