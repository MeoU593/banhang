@model WishlistModel

@{
    Layout = "_ColumnsOne";
    NopHtml.AddTitleParts("Danh sách sản phẩm quan tâm");
}

@section Breadcrumb
{
    <nav class="public-breadcrumb flex min-w-0 flex-nowrap items-center gap-2 overflow-hidden whitespace-nowrap text-slate-500" aria-label="Breadcrumb">
        <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="shrink-0 transition hover:text-military-green">Trang chủ</a>
        <span class="material-symbols-outlined shrink-0 text-sm text-slate-300">chevron_right</span>
        <span class="truncate text-slate-700">Danh sách sản phẩm quan tâm</span>
    </nav>
}

<div class="page wishlist-page py-2">
    <div class="page-body space-y-6">
        <section class="public-blue-hero">
            <div class="public-blue-hero-content">
                <div class="public-blue-hero-copy space-y-1.5">
                    <h1 class="public-hero-title public-blue-hero-title font-black tracking-tight">Danh sách sản phẩm quan tâm</h1>
                    <p class="public-hero-subtitle public-blue-hero-subtitle max-w-3xl">Theo dõi các sản phẩm và năng lực cần quan tâm để tra cứu nhanh khi cần.</p>
                </div>
                <div class="public-blue-hero-stats">
                    <div class="public-blue-hero-stat">
                        <p class="public-label-text font-bold uppercase tracking-[0.14em] text-sky-900">Sản phẩm</p>
                        <p class="public-stat-value mt-1 font-black text-sky-950">@Model.Products.Count</p>
                    </div>
                </div>
            </div>
        </section>

        @if (!Model.Products.Any())
        {
            <div class="public-body-text rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center text-slate-500">
                Chưa có sản phẩm nào trong danh sách quan tâm.
            </div>
        }
        else
        {
            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                @foreach (var product in Model.Products)
                {
                    <div class="relative">
                        @await Html.PartialAsync("_ProductBox", product)
                        <form method="post" action="/wishlist/delete/@product.Id" class="absolute right-3 top-3 z-30">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-rose-200 bg-white text-rose-600 shadow-sm transition hover:bg-rose-50" title="Xóa khỏi quan tâm" aria-label="Xóa khỏi quan tâm">
                                <span class="material-symbols-outlined text-[18px]">close</span>
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
</div>
