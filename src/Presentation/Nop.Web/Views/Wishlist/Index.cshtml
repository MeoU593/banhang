@model WishlistModel

@{
    Layout = "_ColumnsOne";
    NopHtml.AddTitleParts("Danh sách yêu thích");
}

@section Breadcrumb
{
    <nav class="mb-4 flex min-w-0 flex-nowrap items-center gap-2 overflow-hidden whitespace-nowrap text-xs font-semibold uppercase tracking-[0.16em] text-slate-500" aria-label="Breadcrumb">
        <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="shrink-0 transition hover:text-military-green">Trang chủ</a>
        <span class="material-symbols-outlined shrink-0 text-sm text-slate-300">chevron_right</span>
        <span class="truncate text-slate-700">Danh sách yêu thích</span>
    </nav>
}

<div class="page wishlist-page py-2">
    <div class="page-body space-y-6">
        <section class="overflow-hidden rounded-2xl border border-[#d6b95a]/30 bg-[linear-gradient(120deg,#29313a_0%,#574500_52%,#8a6a2a_100%)] p-5 text-white shadow-[0_30px_80px_-45px_rgba(15,23,42,0.95)] sm:p-6">
            <div class="flex flex-wrap items-center justify-between gap-4">
                <div>
                    <h1 class="public-hero-title font-black tracking-tight text-white">Danh sách yêu thích</h1>
                    <p class="mt-1 max-w-3xl text-sm leading-6 text-white/80">Lưu lại các sản phẩm cần theo dõi để tra cứu nhanh khi cần.</p>
                </div>
                <div class="rounded-xl border border-white/20 bg-white/10 px-4 py-3 text-center shadow-sm backdrop-blur">
                    <p class="text-[11px] uppercase tracking-[0.14em] text-white/65">Sản phẩm</p>
                    <p class="mt-1 text-lg font-black text-white">@Model.Products.Count</p>
                </div>
            </div>
        </section>

        @if (!Model.Products.Any())
        {
            <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center text-sm text-slate-500">
                Chưa có sản phẩm nào trong danh sách yêu thích.
            </div>
        }
        else
        {
            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                @foreach (var product in Model.Products)
                {
                    <div class="relative">
                        @await Html.PartialAsync("_ProductBox", product)
                        <form method="post" action="/wishlist/delete/@product.Id" class="absolute right-3 top-3 z-30">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-rose-200 bg-white text-rose-600 shadow-sm transition hover:bg-rose-50" title="Xóa khỏi yêu thích" aria-label="Xóa khỏi yêu thích">
                                <span class="material-symbols-outlined text-[18px]">close</span>
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
</div>
