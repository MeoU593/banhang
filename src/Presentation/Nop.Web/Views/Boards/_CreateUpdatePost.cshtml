@model EditForumPostModel
@using Nop.Core.Domain.Forums;
@{
    //page class
    NopHtml.AppendPageCssClassParts("html-forum-edit-page");
}

@await Html.PartialAsync("_ForumHeader")
<div class="page forum-edit-page public-page-shell public-page-stack">
    <div class="page-title public-blue-hero">
        <div class="public-blue-hero-content">
            <div class="public-blue-hero-copy">
        @if (Model.IsEdit)
        {
            <h1 class="public-hero-title public-blue-hero-title font-black tracking-tight">@T("Forum.EditPost")</h1>
            <p class="public-hero-subtitle public-blue-hero-subtitle mt-2">Cập nhật bình luận để bổ sung thông tin đúng bối cảnh thảo luận.</p>
        }
        else
        {
            <h1 class="public-hero-title public-blue-hero-title font-black tracking-tight">@T("Forum.NewPost")</h1>
            <p class="public-hero-subtitle public-blue-hero-subtitle mt-2">Thêm phản hồi mới và giữ mạch trao đổi thông suốt.</p>
        }
            </div>
        </div>
    </div>
    <div class="page-body">
        <div asp-validation-summary="ModelOnly" class="public-body-text message-error mb-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-rose-700"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ForumTopicId" />
        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="space-y-4">
                <div class="grid gap-3 sm:grid-cols-2">
                    <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
                        <p class="public-label-text font-bold uppercase tracking-[0.12em] text-slate-500">@T("Forum.ForumName")</p>
                        <p class="public-list-title mt-1 font-semibold text-slate-900">@Model.ForumName</p>
                    </div>
                    <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
                        <p class="public-label-text font-bold uppercase tracking-[0.12em] text-slate-500">@T("Forum.TopicTitle")</p>
                        <p class="public-list-title mt-1 font-semibold text-slate-900">@Model.ForumTopicSubject</p>
                    </div>
                </div>
                @if (Model.ForumEditor == EditorType.MarkdownEditor)
                {
                    @await Html.PartialAsync("_MarkdownEditor", new ForumPostTextModel { Text = Model.Text })
                }
                @if (Model.ForumEditor == EditorType.BBCodeEditor)
                {
                    <div class="public-form-row space-y-2">
                        <nop-bb-code-editor asp-for="Text" />
                        <textarea aria-label="@T("Forum.Post.Text")" asp-for="Text" class="public-control-text forum-post-text min-h-[220px] w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-700 outline-none transition focus:border-military-green focus:bg-white"></textarea>
                        <span asp-validation-for="Text"></span>
                    </div>
                }
                @if ((Model.ForumEditor == EditorType.SimpleTextBox))
                {
                    <div class="public-form-row space-y-2">
                        <textarea aria-label="@T("Forum.Post.Text")" asp-for="Text" class="public-control-text forum-post-text min-h-[220px] w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-700 outline-none transition focus:border-military-green focus:bg-white"></textarea>
                        <span asp-validation-for="Text"></span>
                    </div>
                }
                @if (Model.IsCustomerAllowedToSubscribe)
                {
                    <input type="hidden" asp-for="Subscribed" value="false" />
                }
                @if (Model.DisplayCaptcha)
                {
                    <nop-captcha />
                }
            </div>
        </section>
        <section class="buttons mt-4 flex flex-wrap items-center gap-2">
            <button type="submit" class="public-control-text button-1 submit-post-button inline-flex h-11 items-center justify-center rounded-xl bg-military-green px-5 font-semibold text-white transition hover:brightness-110">@T("Forum.Submit")</button>
            <button type="button" class="public-control-text button-2 cancel-post-button inline-flex h-11 items-center justify-center rounded-xl border border-slate-200 px-5 font-semibold text-slate-700 transition hover:border-military-green hover:text-military-green" onclick="setLocation('@Url.RouteUrl(NopRouteNames.Standard.TOPIC_SLUG, new { id = Model.ForumTopicId, slug = Model.ForumTopicSeName })')">@T("Forum.Cancel")</button>
        </section>
    </div>
</div>
