@{
    var boardsUrl = Url.RouteUrl(NopRouteNames.General.BOARDS) ?? "/boards";
    var unreadUrl = Url.RouteUrl(NopRouteNames.General.BOARDS, new { unread = 1 }) ?? "/boards?unread=1";
    var isUnreadMode = string.Equals(Context.Request.Query["unread"], "1", StringComparison.OrdinalIgnoreCase);
    var forumId = 0;

    if (ViewData["ForumId"] is int value)
        forumId = value;
    else if (!string.IsNullOrWhiteSpace(Convert.ToString(ViewData["ForumId"])))
        int.TryParse(Convert.ToString(ViewData["ForumId"]), out forumId);

    var createTopicUrl = forumId > 0
        ? (Url.RouteUrl(NopRouteNames.Standard.TOPIC_CREATE, new { id = forumId }) ?? $"/boards/topiccreate/{forumId}")
        : null;

    var boardsSearchUrl = Url.RouteUrl(NopRouteNames.Standard.BOARDS_SEARCH) ?? "/boards/search";
    var disableSearchForm = ViewData["DisableSearchForm"] is bool valueDisable && valueDisable;
    var searchTerms = Context.Request.Query["searchterms"].ToString();
}

<style>
    .boards-toolbar-v2 {
        margin-bottom: 1.25rem;
        border: 1px solid #e5c7c8;
        border-radius: 16px;
        background: #ffffff;
        padding: 12px;
        box-shadow: 0 12px 30px -24px rgba(46, 0, 1, 0.45);
    }

    .boards-toolbar-v2__row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .boards-toolbar-v2__actions {
        display: flex;
        min-width: 0;
        flex-wrap: wrap;
        align-items: center;
        flex: 0 1 auto;
        justify-content: flex-start;
        gap: 8px;
    }

    .boards-toolbar-v2__link {
        display: inline-flex;
        height: 42px;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
        border: 1px solid #e5c7c8;
        border-radius: 12px;
        padding: 0 16px;
        background: #ffffff;
        color: #2e0001;
        font-size: 15px;
        font-weight: 800;
        line-height: 1;
        text-decoration: none;
    }

    .boards-toolbar-v2__link:hover {
        border-color: #b91d20;
        background: #fff5f5;
        color: #8f1418;
    }

    .boards-toolbar-v2__link--primary {
        border-color: #2e0001;
        background: #2e0001;
        color: #ffffff;
    }

    .boards-toolbar-v2__link--primary:hover {
        border-color: #550005;
        background: #550005;
        color: #ffffff;
    }

    .boards-toolbar-v2__search {
        display: flex;
        width: auto;
        max-width: 100%;
        min-width: 0;
        flex: 1 1 28rem;
        margin: 0;
        align-items: center;
        gap: 8px;
    }

    .boards-toolbar-v2__search-label {
        position: relative;
        display: block;
        width: 100%;
        min-width: 0;
        flex: 1 1 auto;
    }

    .boards-toolbar-v2__search-icon {
        pointer-events: none;
        position: absolute;
        left: 16px;
        top: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 18px;
        z-index: 2;
    }

    .boards-toolbar-v2__search-input {
        box-sizing: border-box;
        width: 100%;
        height: 42px;
        border: 1px solid #e5c7c8;
        border-radius: 12px !important;
        background: #fffafa;
        padding: 0 12px 0 46px !important;
        color: #2e0001;
        font-size: 15px;
        line-height: 42px;
        outline: none;
    }

    .boards-toolbar-v2__search-input:focus {
        border-color: #b91d20;
        background: #ffffff;
        box-shadow: 0 0 0 3px rgba(185, 29, 32, 0.12);
    }

    .boards-toolbar-v2__search-submit {
        height: 42px;
        border: 1px solid #2e0001 !important;
        border-radius: 12px;
        background: #2e0001 !important;
        background-image: none !important;
        padding: 0 16px;
        color: #ffffff !important;
        font-size: 15px;
        font-weight: 600;
        line-height: 1;
        box-shadow: none !important;
    }

    .boards-toolbar-v2__search-submit:hover {
        border-color: #550005 !important;
        background: #550005 !important;
    }

    @@media (min-width: 1280px) {
        .boards-toolbar-v2__row {
            flex-wrap: nowrap;
            gap: 1rem;
        }

        .boards-toolbar-v2__actions {
            justify-content: flex-start;
        }

        .boards-toolbar-v2__search {
            margin: 0;
        }
    }

    @@media (max-width: 767px) {
        .boards-toolbar-v2__actions,
        .boards-toolbar-v2__search {
            width: 100%;
        }

        .boards-toolbar-v2__link {
            flex: 1 1 auto;
        }
    }
</style>

<div class="boards-toolbar-v2">
    <div class="boards-toolbar-v2__row">
        <div class="boards-toolbar-v2__actions">
            @if (!string.IsNullOrWhiteSpace(createTopicUrl))
            {
                <a href="@createTopicUrl" class="boards-toolbar-v2__link boards-toolbar-v2__link--primary">
                    @T("Forum.NewTopic")
                </a>
            }

            <a href="@unreadUrl" class="boards-toolbar-v2__link @(isUnreadMode ? "boards-toolbar-v2__link--primary" : string.Empty)">
                Xem chủ đề chưa xem
            </a>

            @if (isUnreadMode)
            {
                <a href="@boardsUrl" class="boards-toolbar-v2__link">
                    Tất cả chủ đề
                </a>
            }
        </div>

        @if (!disableSearchForm)
        {
            <form action="@boardsSearchUrl" method="get" class="boards-toolbar-v2__search">
                <label for="forums-small-searchterms" class="boards-toolbar-v2__search-label">
                    <span class="material-symbols-outlined boards-toolbar-v2__search-icon">search</span>
                    <input type="text" id="forums-small-searchterms" name="searchterms" value="@searchTerms" placeholder="@T("Forum.SearchForumsTooltip")" class="boards-toolbar-v2__search-input" autocomplete="off" />
                </label>
                <button type="submit" class="boards-toolbar-v2__search-submit">@T("Forum.SearchButton")</button>
            </form>
        }
        else
        {
            <div class="boards-toolbar-v2__search">
                <label for="forums-small-searchterms" class="boards-toolbar-v2__search-label">
                    <span class="material-symbols-outlined boards-toolbar-v2__search-icon">search</span>
                    <input type="text" id="forums-small-searchterms" name="searchterms" value="@searchTerms" placeholder="@T("Forum.SearchForumsTooltip")" class="boards-toolbar-v2__search-input" autocomplete="off" onkeydown="if(event.key==='Enter'){event.preventDefault();window.location.href='@boardsSearchUrl?searchterms='+encodeURIComponent(this.value||'');}" />
                </label>
                <button type="button" class="boards-toolbar-v2__search-submit" onclick="window.location.href='@boardsSearchUrl?searchterms='+encodeURIComponent(document.getElementById('forums-small-searchterms')?.value||'');">@T("Forum.SearchButton")</button>
            </div>
        }
    </div>
</div>
