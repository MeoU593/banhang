@model ForumPostModel
@using Nop.Core

@inject IWebHelper webHelper;
@{
    var thisPageUrl = webHelper.GetThisPageUrl(true);
    var customerInitial = !string.IsNullOrWhiteSpace(Model.CustomerName)
        ? Model.CustomerName.Substring(0, 1).ToUpperInvariant()
        : "?";
}

<article class="topic-post rounded-2xl border border-slate-200 bg-white p-4 shadow-sm" id="@Html.Encode($"post{Model.Id}")" style="overflow:visible;">
    <div class="flex items-start gap-3">
        @if (!string.IsNullOrWhiteSpace(Model.CustomerAvatarUrl))
        {
            <img src="@Model.CustomerAvatarUrl" alt="avatar" class="h-10 w-10 rounded-full object-cover" />
        }
        else
        {
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-800 text-xs font-bold text-amber-300">@customerInitial</div>
        }

        <div class="min-w-0 flex-1 space-y-3">
            <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="flex flex-wrap items-center gap-2 text-xs">
                    <span class="font-bold text-slate-900">
                        @if (Model.AllowViewingProfiles)
                        {
                            @Html.RouteLink(Model.CustomerName, NopRouteNames.Standard.CUSTOMER_PROFILE, new { id = Model.CustomerId }, new { @class = "hover:text-military-green" })
                        }
                        else
                        {
                            @Model.CustomerName
                        }
                    </span>
                    @if (!string.IsNullOrWhiteSpace(Model.Rank))
                    {
                        <span class="rounded bg-slate-100 px-2 py-0.5 font-semibold text-slate-600">@Model.Rank</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.UnitName))
                    {
                        <span class="rounded bg-slate-100 px-2 py-0.5 text-slate-500">@Model.UnitName</span>
                    }
                    <span class="text-slate-400">@Model.PostCreatedOnStr</span>
                </div>

                <a id="post-link-@Model.Id" title="@T("Forum.PostLinkTitle")" class="inline-flex h-7 items-center justify-center rounded-md border border-slate-200 bg-white px-2.5 text-xs font-semibold text-slate-700 transition hover:border-military-green hover:text-military-green" href="@(thisPageUrl)#post@(Model.Id)">#@(Model.Id)</a>
            </div>

            <div class="post-text prose prose-slate w-full max-w-full break-words rounded-xl border border-slate-100 bg-slate-50 px-4 py-3 text-sm leading-7 text-slate-700" data-post-content="@Model.Id" style="width:100%;max-width:100%;box-sizing:border-box;overflow-wrap:anywhere;word-break:break-word;white-space:normal;">
                @Html.Raw(Model.FormattedText)
            </div>

            @if (Model.AllowPostVoting)
            {
                <script asp-location="Footer">
                    $(function() {
                        var post = '#post-vote-' + @Model.Id;
                        $(post + ' span.vote').on('click', function () {
                            var postData = {
                                postId: @Model.Id,
                                IsUp: $(this).hasClass('up')
                            };
                            addAntiForgeryToken(postData);
                            $.ajax({
                                cache: false,
                                type: "POST",
                                url: "@Url.RouteUrl(NopRouteNames.Ajax.POST_VOTE)",
                                data: postData,
                                success: function (data, textStatus, jqXHR) {
                                    if (data.Error) {
                                        alert(data.Error);
                                    }
                                    else {
                                        $(post + ' div.vote-count-post').html(data.VoteCount);
                                        $(post + ' span.up').removeClass('selected');
                                        $(post + ' span.down').removeClass('selected');
                                        if (data.IsUp) {
                                            $(post + ' span.up').addClass('selected');
                                        }
                                        if (data.IsUp == false) {
                                            $(post + ' span.down').addClass('selected');
                                        }
                                    }
                                },
                                error: function (jqXHR, textStatus, errorThrown) {
                                    alert('Failed to vote');
                                }
                            });
                        });
                    });
                </script>
            }

            @if (Model.AllowPostVoting)
            {
                <div class="post-vote mt-3 inline-flex items-center gap-2 rounded-lg bg-slate-50 px-2.5 py-1.5" id="@($"post-vote-{Model.Id}")">
                    <span class="vote up inline-flex h-7 w-7 items-center justify-center rounded-md border border-slate-200 bg-white text-slate-600 transition hover:border-emerald-400 hover:text-emerald-600 @if (Model.VoteIsUp.HasValue && (bool)Model.VoteIsUp){<text>selected</text>}" title="@T("Forum.Post.IsUseful")"></span>
                    <div class="vote-count-post min-w-[24px] text-center text-xs font-bold text-slate-700">@Model.VoteCount</div>
                    <span class="vote down inline-flex h-7 w-7 items-center justify-center rounded-md border border-slate-200 bg-white text-slate-600 transition hover:border-rose-400 hover:text-rose-600 @if (Model.VoteIsUp.HasValue && (bool)!Model.VoteIsUp){<text>selected</text>}" title="@T("Forum.Post.IsNotUseful")"></span>
                </div>
            }

            <div class="mt-3 border-t border-slate-100 pt-3" style="display:flex;flex-wrap:wrap;align-items:center;gap:6px;clear:both;width:100%;overflow:visible;">
                @if (Model.IsCurrentCustomerAllowedToCreatePost)
                {
                    <a href="#"
                       class="inline-flex h-8 items-center justify-center rounded-lg border px-3 text-xs font-semibold shadow-sm transition hover:brightness-110"
                       style="display:inline-flex;align-items:center;justify-content:center;height:32px;padding:0 12px;background-color:#2f5e2b;border-color:#2f5e2b;color:#ffffff;text-decoration:none;"
                       data-inline-reply-target="inline-reply-form-@Model.Id">Trả lời</a>
                }
                @if (Model.IsCurrentCustomerAllowedToEditPost)
                {
                    @Html.RouteLink(T("Forum.EditPost").Text, NopRouteNames.Standard.POST_EDIT, new { id = Model.Id }, new { @class = "inline-flex h-8 items-center justify-center rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-700 transition hover:border-military-green hover:text-military-green", style = "display:inline-flex;align-items:center;justify-content:center;height:32px;padding:0 12px;text-decoration:none;" })
                }
                @if (Model.IsCurrentCustomerAllowedToDeletePost)
                {
                    <a href="#" class="inline-flex h-8 items-center justify-center rounded-lg border border-rose-200 bg-rose-50 px-3 text-xs font-semibold text-rose-700 transition hover:bg-rose-100" style="display:inline-flex;align-items:center;justify-content:center;height:32px;padding:0 12px;text-decoration:none;" onclick="return deletepost(@(Model.Id))">@T("Forum.DeletePost").Text</a>
                }
            </div>

            @if (Model.IsCurrentCustomerAllowedToCreatePost)
            {
                <form id="inline-reply-form-@Model.Id"
                      asp-route="@NopRouteNames.Standard.POST_CREATE"
                      asp-route-id="@Model.ForumTopicId"
                      method="post"
                      class="mt-3 rounded-lg border border-slate-200 bg-slate-50 p-3"
                      style="display:none;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="FromTopicInline" value="true" />
                    <input type="hidden" name="ForumTopicId" value="@Model.ForumTopicId" />
                    <input type="hidden" name="ReplyToPostId" value="@Model.Id" />
                    <input type="hidden" name="Subscribed" value="true" />

                    <label class="mb-2 block text-xs font-semibold uppercase tracking-[0.12em] text-slate-600">Trả lời @Model.CustomerName</label>
                    <textarea name="Text" rows="3" required
                              class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm leading-6 text-slate-700 outline-none transition focus:border-military-green"></textarea>

                    <div class="mt-2 flex items-center justify-end gap-2">
                        <button type="button"
                                class="inline-flex h-8 items-center justify-center rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-700"
                                data-inline-reply-cancel="inline-reply-form-@Model.Id">Hủy</button>
                        <button type="submit"
                                class="inline-flex h-8 items-center justify-center rounded-lg border px-3 text-xs font-semibold shadow-sm"
                                style="background-color:#2f5e2b;border-color:#2f5e2b;color:#ffffff;">Gửi trả lời</button>
                    </div>
                </form>
            }

            @if (Model.SignaturesEnabled & !string.IsNullOrEmpty(Model.FormattedSignature))
            {
                <div class="signature border-t border-slate-100 pt-3 text-xs text-slate-500">
                    @Html.Raw(Model.FormattedSignature)
                </div>
            }
        </div>
    </div>
</article>
