@using Nop.Core
@using Nop.Core.Domain.Forums
@using Nop.Core.Domain.Seo
@using Nop.Services.Localization

@model ForumTopicPageModel

@inject ILocalizationService localizationService
@inject IWebHelper webHelper
@inject SeoSettings seoSettings

@{
    Layout = "_ColumnsOne";

    NopHtml.AddTitleParts(Model.MetaTitle);
    NopHtml.AddMetaDescriptionParts(Model.MetaDescription);
    NopHtml.AppendPageCssClassParts("html-forum-topic-page");

    if (seoSettings.CanonicalUrlsEnabled)
    {
        var topicUrl = Model.PostsPageIndex > 0
            ? Url.RouteUrl(NopRouteNames.Standard.TOPIC_SLUG_PAGED,
                new { id = Model.Id, slug = Model.SeName, pageNumber = Model.PostsPageIndex + 1 }, webHelper.GetCurrentRequestProtocol()).ToLowerInvariant()
            : Url.RouteUrl(NopRouteNames.Standard.TOPIC_SLUG,
                new { id = Model.Id, slug = Model.SeName }, webHelper.GetCurrentRequestProtocol()).ToLowerInvariant();

        NopHtml.AddCanonicalUrlParts(topicUrl, seoSettings.QueryStringInCanonicalUrlsEnabled);
    }

    NopHtml.AddJsonLdParts(Model.JsonLd);

    ForumPostModel mainPost = null;
    if (Model.ForumPostModels.Count > 0)
        mainPost = Model.ForumPostModels[0];

    var pager = await Html.PagerAsync(new PagerModel(localizationService)
    {
        PageSize = Model.PostsPageSize,
        TotalRecords = Model.PostsTotalRecords,
        PageIndex = Model.PostsPageIndex,
        ShowTotalSummary = false,
        RouteActionName = NopRouteNames.Standard.TOPIC_SLUG_PAGED,
        UseRouteLinks = true,
        RouteValues = new SlugRouteValues { Id = Model.Id, Slug = Model.SeName }
    });

    var showPager = !string.IsNullOrEmpty(await pager.RenderHtmlContentAsync());
    var isAuthenticated = Context.User.Identity?.IsAuthenticated ?? false;
    var commentPosts = Model.ForumPostModels.Where(post => post.Id != Model.MainPostId).ToList();
    var commentPostsById = commentPosts.ToDictionary(post => post.Id);
    var groupedReplies = commentPosts
        .Where(post => post.ReplyToPostId > 0 && commentPostsById.ContainsKey(post.ReplyToPostId))
        .GroupBy(post => post.ReplyToPostId)
        .ToDictionary(group => group.Key, group => group.OrderByDescending(post => post.PostCreatedOn).ToList());
    var topLevelComments = commentPosts
        .Where(post => post.ReplyToPostId <= 0 || !commentPostsById.ContainsKey(post.ReplyToPostId))
        .OrderByDescending(post => post.PostCreatedOn)
        .ToList();
}

<div class="page forum-topic-page px-4 pb-8 lg:px-0">
    @await Html.PartialAsync("_ForumHeader", null, new ViewDataDictionary(ViewData) { ["ForumId"] = Model.ForumId })
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BoardsTopicAfterHeader, additionalData = Model })

    <div class="mb-5 overflow-hidden rounded-2xl border p-5 text-white shadow-[0_24px_60px_-35px_rgba(15,23,42,0.85)] sm:p-6" style="border-color: rgba(214,185,90,.28); background-color: rgba(33,45,27,.92); background-image: linear-gradient(120deg, #0f1a33 0%, #1f2b1a 52%, #314026 100%), repeating-linear-gradient(135deg, rgba(255,255,255,.05) 0, rgba(255,255,255,.05) 1px, transparent 1px, transparent 14px);">
        <nav class="mb-2 flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-slate-200" aria-label="Breadcrumb">
            <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="transition hover:text-white">Trang chủ</a>
            <span class="material-symbols-outlined text-sm text-slate-300">chevron_right</span>
            <a href="@Url.RouteUrl(NopRouteNames.General.BOARDS)" class="transition hover:text-white">Diễn đàn</a>
            <span class="material-symbols-outlined text-sm text-slate-300">chevron_right</span>
            <span class="line-clamp-1 text-white">@Model.Subject</span>
        </nav>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#f6dc9a]">Chi tiết thảo luận</p>
        <h1 class="public-hero-title font-black tracking-tight text-white">@Model.Subject</h1>
    </div>

    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BoardsTopicTop, additionalData = Model })
    @if (showPager)
    {
        <div class="pager upper mb-4 rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
            @pager
        </div>
    }

    @if (Model.ForumEditor == EditorType.MarkdownEditor)
    {
        <script asp-location="Footer" src="~/lib_npm/marked/marked.umd.js"></script>
        <script asp-location="Footer">
            document.addEventListener('DOMContentLoaded', function() {
                @foreach (var post in Model.ForumPostModels)
                {
                    <text>
                        document.querySelector('[data-post-content="@post.Id"]').innerHTML = marked.parse(@Html.Raw(Json.Serialize(post.FormattedText)), { gfm: true, breaks: true });
                    </text>
                }
            });
        </script>
    }

    <div class="mt-5 grid grid-cols-12 gap-6">
        <section class="col-span-12 space-y-5 lg:col-span-8">
            @if (mainPost != null)
            {
                <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                    <div class="border-b border-slate-100 px-6 py-5">
                        <div class="mb-3 flex flex-wrap items-center gap-2 text-xs text-slate-500">
                            @if (!string.IsNullOrWhiteSpace(Model.ForumName))
                            {
                                <a href="@Url.RouteUrl(NopRouteNames.General.BOARDS)" class="rounded-full bg-red-50 px-2.5 py-1 font-bold uppercase tracking-wide text-red-700">@Model.ForumName</a>
                            }
                            <span>@mainPost.PostCreatedOnStr</span>
                        </div>

                        <div class="flex flex-wrap items-center justify-between gap-3">
                            <div class="flex items-center gap-3">
                                @if (!string.IsNullOrWhiteSpace(mainPost.CustomerAvatarUrl))
                                {
                                    <img src="@mainPost.CustomerAvatarUrl" alt="avatar" class="h-11 w-11 rounded-full object-cover" />
                                }
                                else
                                {
                                    var initial = !string.IsNullOrWhiteSpace(mainPost.CustomerName) ? mainPost.CustomerName.Substring(0, 1).ToUpperInvariant() : "?";
                                    <div class="flex h-11 w-11 items-center justify-center rounded-full bg-slate-800 text-sm font-bold text-amber-300">@initial</div>
                                }
                                <div>
                                    <p class="text-sm font-bold text-slate-900">@mainPost.CustomerName</p>
                                    <p class="text-xs text-slate-500">@mainPost.Rank @(!string.IsNullOrWhiteSpace(mainPost.UnitName) ? $"- {mainPost.UnitName}" : string.Empty)</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-4 text-xs text-slate-500">
                                <span class="inline-flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">visibility</span>@Model.PostsTotalRecords</span>
                                <span class="inline-flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">forum</span>@(Model.PostsTotalRecords > 0 ? Model.PostsTotalRecords - 1 : 0)</span>
                            </div>
                        </div>
                    </div>

                    <div class="prose prose-slate max-w-none px-6 py-6 text-sm leading-7 text-slate-700" data-post-content="@mainPost.Id">
                        @Html.Raw(mainPost.FormattedText)
                    </div>
                </article>
            }

            <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 bg-slate-50/70 px-6 py-4">
                    <h2 class="public-card-title font-bold text-slate-900">Bình luận (@(Model.PostsTotalRecords > 0 ? Model.PostsTotalRecords - 1 : 0))</h2>
                    <div class="flex flex-wrap items-center justify-end gap-2">
                        <span class="text-xs font-semibold uppercase text-slate-500">Mới nhất</span>
                        @if (isAuthenticated)
                        {
                            <a href="#quick-reply-form" class="inline-flex h-8 items-center justify-center rounded-lg border px-3 text-xs font-semibold shadow-sm transition hover:brightness-110" style="background-color:#2f5e2b;border-color:#2f5e2b;color:#ffffff;">Viết bình luận</a>
                        }
                        else
                        {
                            @Html.RouteLink("Đăng nhập để bình luận", NopRouteNames.General.LOGIN, null, new { @class = "inline-flex h-8 items-center justify-center rounded-lg border border-slate-200 bg-white px-3 text-xs font-semibold text-slate-700 transition hover:border-military-green hover:text-military-green" })
                        }
                    </div>
                </div>

                <div class="space-y-3 bg-slate-50/40 p-4 sm:p-5">
                    @if (isAuthenticated && Model.IsCustomerAllowedToCreatePost)
                    {
                        <form id="quick-reply-form" asp-route="@NopRouteNames.Standard.POST_CREATE" asp-route-id="@Model.Id" method="post" class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="FromTopicInline" value="true" />
                            <input type="hidden" name="ForumTopicId" value="@Model.Id" />
                            <input type="hidden" name="Id" value="0" />
                            <input type="hidden" name="IsEdit" value="false" />
                            <input type="hidden" name="ForumEditor" value="@((int)Model.ForumEditor)" />
                            <input type="hidden" name="ForumName" value="@Model.ForumName" />
                            <input type="hidden" name="ForumTopicSubject" value="@Model.Subject" />
                            <input type="hidden" name="ForumTopicSeName" value="@Model.SeName" />
                            <input type="hidden" name="IsCustomerAllowedToSubscribe" value="@Model.IsCustomerAllowedToSubscribe" />
                            <input type="hidden" name="DisplayCaptcha" value="false" />

                            <label for="quick-reply-text" class="mb-2 block text-sm font-semibold text-slate-700">Nội dung bình luận</label>
                            <textarea id="quick-reply-text" name="Text" rows="4" required
                                      class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm leading-7 text-slate-700 outline-none transition focus:border-military-green focus:bg-white"
                                      placeholder="Nhập bình luận của bạn..."></textarea>

                            <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
                                @if (Model.IsCustomerAllowedToSubscribe)
                                {
                                    <label class="inline-flex items-center gap-2 text-sm text-slate-700">
                                        <input type="checkbox" name="Subscribed" value="true" class="h-4 w-4 rounded border-slate-300 text-military-green focus:ring-military-green" />
                                        <span>Nhận thông báo khi có phản hồi mới</span>
                                    </label>
                                }
                                else
                                {
                                    <span></span>
                                }
                                <button type="submit" class="inline-flex h-10 items-center justify-center rounded-lg border px-4 text-sm font-semibold shadow-sm transition hover:brightness-110" style="background-color:#2f5e2b;border-color:#2f5e2b;color:#ffffff;">
                                    Gửi bình luận
                                </button>
                            </div>
                        </form>
                    }

                    @if (!commentPosts.Any())
                    {
                        <p class="rounded-xl border border-dashed border-slate-300 px-4 py-8 text-center text-sm text-slate-500">Chưa có bình luận nào cho chủ đề này.</p>
                    }
                    else
                    {
                        @foreach (var commentPost in topLevelComments)
                        {
                            await Html.RenderPartialAsync("_ForumPost", commentPost);

                            if (groupedReplies.TryGetValue(commentPost.Id, out var childReplies))
                            {
                                <div class="ml-6 border-l border-slate-200 pl-3 sm:ml-10 sm:pl-4">
                                    <div class="space-y-3">
                                        @foreach (var replyPost in childReplies)
                                        {
                                            await Html.RenderPartialAsync("_ForumPost", replyPost);

                                            if (groupedReplies.TryGetValue(replyPost.Id, out var nestedReplies))
                                            {
                                                <div class="ml-4 border-l border-slate-200 pl-3 sm:ml-6">
                                                    <div class="space-y-3">
                                                        @foreach (var nestedReply in nestedReplies)
                                                        {
                                                            await Html.RenderPartialAsync("_ForumPost", nestedReply);
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>
            </section>
        </section>

        <aside class="col-span-12 space-y-4 lg:col-span-4">
            @if (mainPost != null)
            {
                <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                    <div class="h-16 bg-slate-900"></div>
                    <div class="px-5 pb-5">
                        <div class="-mt-8 mb-3 h-16 w-16 overflow-hidden rounded-full border-4 border-white bg-white shadow-sm">
                            @if (!string.IsNullOrWhiteSpace(mainPost.CustomerAvatarUrl))
                            {
                                <img src="@mainPost.CustomerAvatarUrl" alt="avatar" class="h-full w-full object-cover" />
                            }
                            else
                            {
                                var initial = !string.IsNullOrWhiteSpace(mainPost.CustomerName) ? mainPost.CustomerName.Substring(0, 1).ToUpperInvariant() : "?";
                                <div class="flex h-full w-full items-center justify-center bg-slate-800 text-lg font-bold text-amber-300">@initial</div>
                            }
                        </div>
                        <h3 class="public-list-title font-black text-slate-900">@mainPost.CustomerName</h3>
                        <p class="mt-1 text-sm text-slate-500">@(string.IsNullOrWhiteSpace(mainPost.Rank) ? "Thành viên diễn đàn" : mainPost.Rank)</p>
                        @if (!string.IsNullOrWhiteSpace(mainPost.UnitName))
                        {
                            <p class="text-xs text-slate-500">@mainPost.UnitName</p>
                        }
                    </div>
                </section>
            }

            <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                <div class="border-b border-slate-100 bg-slate-50 px-4 py-3 text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Bài viết liên quan</div>
                <div class="space-y-3 p-4">
                    @if (Model.RelatedTopics.Count == 0)
                    {
                        <p class="text-sm text-slate-500">Chưa có bài viết liên quan.</p>
                    }
                    else
                    {
                        @foreach (var topic in Model.RelatedTopics)
                        {
                            <a href="@Url.RouteUrl(NopRouteNames.Standard.TOPIC_SLUG, new { id = topic.Id, slug = topic.SeName })" class="block rounded-xl border border-slate-100 p-3 transition hover:border-military-green/50 hover:bg-slate-50">
                                <p class="line-clamp-2 text-sm font-bold text-slate-800">@topic.Subject</p>
                                <p class="mt-1 text-xs text-slate-500">@topic.CreatedOnStr</p>
                            </a>
                        }
                    }
                </div>
            </section>

            <section class="overflow-hidden rounded-2xl bg-slate-900 p-5 text-white shadow-lg">
                <h3 class="public-meta-text mb-2 font-bold uppercase tracking-[0.12em] text-secondary-container">Lưu ý bảo mật</h3>
                <p class="text-xs leading-6 text-slate-300">Nội dung chia sẻ phải tuân thủ quy định bảo mật thông tin và quy tắc sử dụng diễn đàn của đơn vị.</p>
            </section>
        </aside>
    </div>

    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BoardsTopicBottom, additionalData = Model })
</div>

<script asp-location="Footer">
    (function () {
        var storageKey = 'boards.viewedTopicIds';
        var maxTopics = 500;
        var currentTopicId = @Model.Id;

        if (!window.localStorage || !currentTopicId) {
            return;
        }

        var viewedTopicIds = [];
        try {
            viewedTopicIds = JSON.parse(localStorage.getItem(storageKey) || '[]');
            if (!Array.isArray(viewedTopicIds)) {
                viewedTopicIds = [];
            }
        } catch (error) {
            viewedTopicIds = [];
        }

        var normalizedTopicIds = viewedTopicIds
            .map(function (id) { return parseInt(id, 10); })
            .filter(function (id) { return Number.isInteger(id) && id > 0; });

        if (normalizedTopicIds.indexOf(currentTopicId) === -1) {
            normalizedTopicIds.push(currentTopicId);
        }

        if (normalizedTopicIds.length > maxTopics) {
            normalizedTopicIds = normalizedTopicIds.slice(normalizedTopicIds.length - maxTopics);
        }

        localStorage.setItem(storageKey, JSON.stringify(normalizedTopicIds));
    })();

    document.addEventListener('DOMContentLoaded', function () {
        var replyButtons = document.querySelectorAll('[data-inline-reply-target]');
        var cancelButtons = document.querySelectorAll('[data-inline-reply-cancel]');

        if (!replyButtons.length) {
            return;
        }

        var hideAllReplyForms = function () {
            document.querySelectorAll('[id^="inline-reply-form-"]').forEach(function (form) {
                form.style.display = 'none';
            });
        };

        replyButtons.forEach(function (button) {
            button.addEventListener('click', function (event) {
                event.preventDefault();

                var targetId = button.getAttribute('data-inline-reply-target');
                var targetForm = document.getElementById(targetId);

                if (!targetForm) {
                    return;
                }

                var willShow = targetForm.style.display === 'none' || targetForm.style.display === '';
                hideAllReplyForms();

                if (willShow) {
                    targetForm.style.display = 'block';
                    var textarea = targetForm.querySelector('textarea[name="Text"]');
                    if (textarea) {
                        textarea.focus();
                    }
                    targetForm.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
            });
        });

        cancelButtons.forEach(function (button) {
            button.addEventListener('click', function () {
                var targetId = button.getAttribute('data-inline-reply-cancel');
                var targetForm = document.getElementById(targetId);
                if (targetForm) {
                    targetForm.style.display = 'none';
                }
            });
        });
    });

    function deletepost(postId) {
        if (confirm('@T("Common.AreYouSure")')) {
            var postData = { id: postId };
            addAntiForgeryToken(postData);
            $.ajax({
                cache: false,
                type: "POST",
                url: "@Url.RouteUrl(NopRouteNames.Standard.POST_DELETE)",
                data: postData,
                dataType: "json",
                success: function (data, textStatus, jqXHR) { location.href = data.redirect; },
                error: function (jqXHR, textStatus, errorThrown) { alert('Failed to delete'); }
            });
        }
        return false;
    }
</script>
