@model ForumGroupModel

<section class="forum-group space-y-4">
    <div class="flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
        <span class="material-symbols-outlined text-secondary-container">forum</span>
        @Html.RouteLink(Model.Name, NopRouteNames.Standard.FORUM_GROUP_SLUG, new { id = Model.Id, slug = Model.SeName }, new { @class = "public-list-title font-bold text-slate-900 hover:text-military-green" })
    </div>

    @if (Model.Forums.Count == 0)
    {
        <div class="public-body-text rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-10 text-center text-slate-500">
            Chưa có diễn đàn nào trong nhóm này.
        </div>
    }
    else
    {
        @foreach (var forum in Model.Forums)
        {
            var forumUrl = Url.RouteUrl(NopRouteNames.Standard.FORUM_SLUG, new { id = forum.Id, slug = forum.SeName });
            <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-military-green/40 hover:shadow-md">
                <div class="min-w-0">
                        <h3 class="public-card-title font-bold text-slate-900">
                            <a href="@forumUrl" class="transition hover:text-military-green">@forum.Name</a>
                        </h3>
                        @if (!string.IsNullOrWhiteSpace(forum.Description))
                        {
                            <p class="public-body-text mt-1 text-slate-600">@forum.Description</p>
                        }

                        <div class="mt-4 grid gap-3 sm:grid-cols-[auto_auto_1fr]">
                            <div class="rounded-xl bg-slate-50 px-3 py-2 text-center">
                                <p class="public-stat-value font-black text-slate-900">@forum.NumTopics</p>
                                <p class="public-label-text uppercase tracking-[0.12em] text-slate-500">@T("Forum.Topics")</p>
                            </div>
                            <div class="rounded-xl bg-slate-50 px-3 py-2 text-center">
                                <p class="public-stat-value font-black text-slate-900">@forum.NumPosts</p>
                                <p class="public-label-text uppercase tracking-[0.12em] text-slate-500">@T("Forum.Posts")</p>
                            </div>
                            <div class="public-meta-text rounded-xl border border-slate-200 px-3 py-2 text-slate-500">
                                <p class="mb-1 font-bold uppercase tracking-[0.12em] text-slate-400">@T("Forum.LatestPost")</p>
                                @await Component.InvokeAsync(typeof(ForumLastPostViewComponent), new { forumPostId = forum.LastPostId, showTopic = true })
                            </div>
                        </div>

                        <div class="mt-4 border-t border-slate-100 pt-4 text-right">
                             <a href="@forumUrl" class="public-control-text inline-flex h-9 items-center justify-center rounded-lg border border-slate-200 px-3 font-semibold text-slate-700 transition hover:border-military-green hover:text-military-green">
                                Mở diễn đàn
                            </a>
                        </div>
                </div>
            </article>
        }
    }
</section>
