@model EditForumTopicModel
@using Nop.Core.Domain.Forums;
@{
    NopHtml.AppendPageCssClassParts("html-forum-edit-page");
}

@await Html.PartialAsync("_ForumHeader", null, new ViewDataDictionary(ViewData) { ["ForumId"] = Model.ForumId, ["DisableSearchForm"] = true })
<div class="page forum-edit-page px-4 pb-8 lg:px-0">
    <div class="page-title mb-5 overflow-hidden rounded-2xl border border-[#d6b95a]/30 bg-[linear-gradient(120deg,#29313a_0%,#574500_52%,#8a6a2a_100%)] p-5 text-white shadow-[0_30px_80px_-45px_rgba(15,23,42,0.95)] sm:p-6">
        @if (Model.IsEdit)
        {
            <h1 class="public-page-title font-black tracking-tight">@T("Forum.EditTopic")</h1>
            <p class="mt-2 text-sm text-white/80">Điều chỉnh nội dung để chủ đề rõ ràng, đầy đủ và dễ theo dõi hơn.</p>
        }
        else
        {
            <h1 class="public-page-title font-black tracking-tight">@T("Forum.NewTopic")</h1>
            <p class="mt-2 text-sm text-white/80">Khởi tạo thảo luận mới trong diễn đàn @Model.ForumName.</p>
        }
    </div>

    <div class="page-body grid grid-cols-12 gap-5">
        <section class="col-span-12 lg:col-span-8">
            <div asp-validation-summary="ModelOnly" class="message-error mb-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-700"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ForumId" />

            <section class="fieldset rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
                <div class="mb-5 flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-4">
                    <h2 class="text-base font-black uppercase tracking-[0.12em] text-slate-700">Nội dung chủ đề</h2>
                    <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">@Model.ForumName</span>
                </div>

                <div class="form-fields space-y-5">
                    <div class="inputs">
                        <label asp-for="Subject" class="mb-2 block text-sm font-semibold text-slate-700">@T("Forum.TopicTitle")</label>
                        <input asp-for="Subject" class="forum-topic-title-text h-11 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm text-slate-700 outline-none transition focus:border-military-green focus:bg-white" placeholder="Nhập tiêu đề ngắn gọn, dễ hiểu" />
                        <span asp-validation-for="Subject" class="mt-1 block text-xs text-rose-600"></span>
                    </div>

                    @if (Model.ForumEditor == EditorType.MarkdownEditor)
                    {
                        @await Html.PartialAsync("_MarkdownEditor", new ForumPostTextModel { Text = Model.Text })
                    }

                    @if (Model.ForumEditor != EditorType.MarkdownEditor)
                    {
                        <div class="inputs">
                            <label asp-for="Text" class="mb-2 block text-sm font-semibold text-slate-700">@T("Forum.Post.Text")</label>
                            @if (Model.ForumEditor == EditorType.BBCodeEditor)
                            {
                                <nop-bb-code-editor asp-for="Text" />
                            }
                            <textarea aria-label="@T("Forum.Post.Text")" asp-for="Text" class="forum-post-text min-h-[260px] w-full resize-y rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm leading-7 text-slate-700 outline-none transition focus:border-military-green focus:bg-white" placeholder="Mô tả đầy đủ bối cảnh, nội dung và thông tin liên quan"></textarea>
                            <span asp-validation-for="Text" class="mt-1 block text-xs text-rose-600"></span>
                        </div>
                    }

                    @if (Model.IsCustomerAllowedToSetTopicPriority)
                    {
                        <div class="inputs">
                            <label asp-for="TopicTypeId" class="mb-2 block text-sm font-semibold text-slate-700">@T("Forum.Priority")</label>
                            <select asp-for="TopicTypeId" asp-items="@(new SelectList(Model.TopicPriorities, "Value", "Text", Model.TopicTypeId))" class="h-11 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 text-sm text-slate-700 outline-none transition focus:border-military-green focus:bg-white"></select>
                        </div>
                    }

                    @if (Model.IsCustomerAllowedToSubscribe)
                    {
                        <div class="inputs rounded-xl border border-slate-200 bg-slate-50 px-3 py-3">
                            <label asp-for="Subscribed" class="inline-flex cursor-pointer items-center gap-2 text-sm font-medium text-slate-700">
                                <input asp-for="Subscribed" class="h-4 w-4 rounded border-slate-300 text-military-green focus:ring-military-green" />
                                <span>@T("Forum.NotifyWhenSomeonePostsInThisTopic")</span>
                            </label>
                        </div>
                    }

                    @if (Model.DisplayCaptcha)
                    {
                        <div class="rounded-xl border border-slate-200 bg-white p-3">
                            <nop-captcha />
                        </div>
                    }
                </div>
            </section>

            <section class="buttons mt-4 flex flex-wrap items-center gap-2">
                <button type="submit" class="button-1 submit-topic-button inline-flex h-11 items-center justify-center rounded-xl bg-military-green px-5 text-sm font-semibold text-white transition hover:brightness-110">@T("Forum.Submit")</button>
                <button type="button" class="button-2 cancel-topic-button inline-flex h-11 items-center justify-center rounded-xl border border-slate-200 px-5 text-sm font-semibold text-slate-700 transition hover:border-military-green hover:text-military-green" onclick="setLocation('@Url.RouteUrl(NopRouteNames.Standard.FORUM_SLUG, new { id = Model.ForumId, slug = Model.ForumSeName })')">@T("Forum.Cancel")</button>
            </section>
        </section>

        <aside class="col-span-12 space-y-4 lg:col-span-4">
            <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                <h3 class="public-label-text font-black uppercase tracking-[0.12em] text-slate-500">Gợi ý đăng bài</h3>
                <ul class="mt-3 space-y-2 text-sm leading-6 text-slate-600">
                    <li>- Tiêu đề nên ngắn gọn, nêu đúng vấn đề chính.</li>
                    <li>- Mô tả rõ bối cảnh, dữ liệu và yêu cầu hỗ trợ.</li>
                    <li>- Tránh đưa thông tin nhạy cảm hoặc chưa kiểm chứng.</li>
                </ul>
            </section>

            <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                <h3 class="public-label-text font-black uppercase tracking-[0.12em] text-slate-500">Điều hướng nhanh</h3>
                <a href="@Url.RouteUrl(NopRouteNames.Standard.FORUM_SLUG, new { id = Model.ForumId, slug = Model.ForumSeName })" class="mt-3 inline-flex h-10 w-full items-center justify-center rounded-xl border border-slate-200 px-4 text-sm font-semibold text-slate-700 transition hover:border-military-green hover:text-military-green">Quay lại danh sách chủ đề</a>
            </section>
        </aside>
    </div>
</div>
