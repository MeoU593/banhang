@using Nop.Core
@using Nop.Core.Domain.Seo
@using Nop.Services.Localization

@model ForumPageModel

@inject ILocalizationService localizationService
@inject IWebHelper webHelper
@inject SeoSettings seoSettings

@{
    Layout = "_ColumnsOne";

    NopHtml.AddTitleParts(Model.Name);
    NopHtml.AppendPageCssClassParts("html-forum-page");

    if (seoSettings.CanonicalUrlsEnabled)
    {
        var forumUrl = Model.IsRootBoards
            ? (Model.TopicPageIndex > 0
                ? Url.RouteUrl(NopRouteNames.Standard.BOARDS_PAGED,
                    new { pageNumber = Model.TopicPageIndex + 1 }, webHelper.GetCurrentRequestProtocol())
                : Url.RouteUrl(NopRouteNames.General.BOARDS, null, webHelper.GetCurrentRequestProtocol()))
            : (Model.TopicPageIndex > 0
                ? Url.RouteUrl(NopRouteNames.Standard.FORUM_SLUG_PAGED,
                    new { id = Model.Id, slug = Model.SeName, pageNumber = Model.TopicPageIndex + 1 }, webHelper.GetCurrentRequestProtocol())
                : Url.RouteUrl(NopRouteNames.Standard.FORUM_SLUG,
                    new { id = Model.Id, slug = Model.SeName }, webHelper.GetCurrentRequestProtocol()));

        if (!string.IsNullOrWhiteSpace(forumUrl))
            NopHtml.AddCanonicalUrlParts(forumUrl.ToLowerInvariant(), seoSettings.QueryStringInCanonicalUrlsEnabled);
    }

    var showUnreadOnly = Model.IsRootBoards && string.Equals(Context.Request.Query["unread"], "1", StringComparison.OrdinalIgnoreCase);

    var pager = await Html.PagerAsync(new PagerModel(localizationService)
    {
        PageSize = Model.TopicPageSize,
        TotalRecords = Model.TopicTotalRecords,
        PageIndex = Model.TopicPageIndex,
        ShowTotalSummary = false,
        RouteActionName = Model.IsRootBoards ? NopRouteNames.Standard.BOARDS_PAGED : NopRouteNames.Standard.FORUM_SLUG_PAGED,
        UseRouteLinks = true,
        RouteValues = Model.IsRootBoards
            ? new BoardsPageRouteValues { Unread = showUnreadOnly ? 1 : null }
            : new SlugRouteValues { Id = Model.Id, Slug = Model.SeName }
    });
    var showPager = !string.IsNullOrEmpty(await pager.RenderHtmlContentAsync());
}

<div class="page forum-page px-4 pb-8 lg:px-0">
    <div class="mb-6 overflow-hidden rounded-2xl border p-5 text-white shadow-[0_24px_60px_-35px_rgba(15,23,42,0.85)] sm:p-6" style="border-color: rgba(214,185,90,.28); background-color: rgba(33,45,27,.92); background-image: linear-gradient(120deg, #0f1a33 0%, #1f2b1a 52%, #314026 100%), repeating-linear-gradient(135deg, rgba(255,255,255,.05) 0, rgba(255,255,255,.05) 1px, transparent 1px, transparent 14px);">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="space-y-1.5">
                <nav class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-slate-200" aria-label="Breadcrumb">
                    <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="transition hover:text-white">Trang chủ</a>
                    <span class="material-symbols-outlined text-sm text-slate-300">chevron_right</span>
                    <a href="@Url.RouteUrl(NopRouteNames.General.BOARDS)" class="transition hover:text-white">Diễn đàn</a>
                    @if (!Model.IsRootBoards)
                    {
                        <span class="material-symbols-outlined text-sm text-slate-300">chevron_right</span>
                        <span class="text-white">@Model.Name</span>
                    }
                </nav>
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#f6dc9a]">Chuyên mục diễn đàn</p>
                <h1 class="public-hero-title font-black tracking-tight text-white">@Model.Name</h1>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="max-w-none text-xs leading-5 text-white/80 sm:text-sm lg:whitespace-nowrap">@Model.Description</p>
                }
                else
                {
                    <p class="max-w-none text-xs leading-5 text-white/80 sm:text-sm lg:whitespace-nowrap">Theo dõi các chủ đề trao đổi nghiệp vụ, cập nhật kinh nghiệm và tài liệu hỗ trợ trong chuyên mục này.</p>
                }
            </div>
            @if (Model.ForumFeedsEnabled)
            {
                <a href="@Url.RouteUrl(NopRouteNames.Standard.FORUM_RSS, new { id = Model.Id })" class="inline-flex h-10 items-center justify-center rounded-xl border border-white/30 bg-white/10 px-4 text-sm font-semibold text-white transition hover:bg-white/20" title="@T("Forum.ForumRSSLinkTitle")">@T("Forum.RSS")</a>
            }
        </div>
    </div>

    @await Html.PartialAsync("_ForumHeader", null, new ViewDataDictionary(ViewData) { ["ForumId"] = Model.Id })
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BoardsForumAfterHeader, additionalData = Model })

    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BoardsForumTop, additionalData = Model })

    <div class="grid grid-cols-12 gap-6">
        <section class="col-span-12 lg:col-span-8" id="boards-topic-list">
            @await Html.PartialAsync("_ForumTopicCards", Model.TopicCards)
            <div id="boards-unread-empty" class="hidden rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center text-sm text-slate-500">
                Không còn chủ đề chưa xem trong trang hiện tại.
            </div>
        </section>

        <aside class="col-span-12 space-y-4 lg:col-span-4">
            <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                <div class="border-b border-slate-100 bg-slate-50 px-4 py-3 text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Bài viết đáng chú ý</div>
                <div class="space-y-3 p-4">
                    @if (Model.FeaturedTopicCards.Count == 0)
                    {
                        <p class="text-sm text-slate-500">Chưa có chủ đề nổi bật.</p>
                    }
                    else
                    {
                        @foreach (var topic in Model.FeaturedTopicCards)
                        {
                            <a href="@Url.RouteUrl(NopRouteNames.Standard.TOPIC_SLUG, new { id = topic.Id, slug = topic.SeName })" class="block rounded-xl border border-slate-100 p-3 transition hover:border-military-green/50 hover:bg-slate-50">
                                <p class="line-clamp-2 text-sm font-bold text-slate-800">@topic.Subject</p>
                                <p class="mt-1 text-xs text-slate-500">@topic.CreatedOnStr • @topic.Views lượt xem</p>
                            </a>
                        }
                    }
                </div>
            </section>

            <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                <div class="border-b border-slate-100 bg-slate-50 px-4 py-3 text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Công cụ nhanh</div>
                <div class="space-y-2 p-4">
                    <a href="@Url.RouteUrl(NopRouteNames.Standard.ACTIVE_DISCUSSIONS)" class="flex items-center justify-between rounded-xl border border-slate-100 px-3 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-military-green hover:text-military-green">
                        <span>Thảo luận mới nhất</span>
                        <span class="material-symbols-outlined text-[18px]">north_east</span>
                    </a>
                    <a href="@Url.RouteUrl(NopRouteNames.Standard.BOARDS_SEARCH)" class="flex items-center justify-between rounded-xl border border-slate-100 px-3 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-military-green hover:text-military-green">
                        <span>Tìm kiếm trong diễn đàn</span>
                        <span class="material-symbols-outlined text-[18px]">search</span>
                    </a>
                </div>
            </section>
        </aside>
    </div>

    @if (showPager)
    {
        <div class="pager lower mt-5 rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
            @pager
        </div>
    }

    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BoardsForumBottom, additionalData = Model })
</div>

@if (Model.IsRootBoards)
{
    <script asp-location="Footer">
        (function () {
            var unreadOnly = '@(showUnreadOnly ? "1" : "0")' === '1';
            if (!unreadOnly || !window.localStorage) {
                return;
            }

            var storageKey = 'boards.viewedTopicIds';
            var viewedTopicIds = [];

            try {
                viewedTopicIds = JSON.parse(localStorage.getItem(storageKey) || '[]');
                if (!Array.isArray(viewedTopicIds)) {
                    viewedTopicIds = [];
                }
            } catch (error) {
                viewedTopicIds = [];
            }

            var viewedSet = new Set(viewedTopicIds
                .map(function (id) { return parseInt(id, 10); })
                .filter(function (id) { return Number.isInteger(id) && id > 0; }));

            var cards = Array.prototype.slice.call(document.querySelectorAll('#boards-topic-list .forum-topic-card'));
            var visibleCount = 0;

            cards.forEach(function (card) {
                var topicId = parseInt(card.getAttribute('data-topic-id') || '0', 10);
                var isUnread = !viewedSet.has(topicId);
                card.style.display = isUnread ? '' : 'none';
                if (isUnread) {
                    visibleCount += 1;
                }
            });

            var emptyBlock = document.getElementById('boards-unread-empty');
            if (emptyBlock) {
                emptyBlock.classList.toggle('hidden', visibleCount > 0);
            }
        })();
    </script>
}
