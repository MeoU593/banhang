@model ForumGroupModel
@{
    Layout = "_ColumnsOne";

    //title
    NopHtml.AddTitleParts(Model.Name);
    //page class
    NopHtml.AppendPageCssClassParts("html-forum-group-page");
    var totalTopics = Model.Forums.Sum(x => x.NumTopics);
    var totalPosts = Model.Forums.Sum(x => x.NumPosts);
}
<div class="page forum-group-page px-4 pb-8 lg:px-0">
    @await Html.PartialAsync("_ForumHeader")
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BoardsForumGroupAfterHeader, additionalData = Model })
    <div class="mb-5 overflow-hidden rounded-3xl border border-slate-200 bg-gradient-to-r from-slate-900 via-slate-800 to-military-green p-6 text-white shadow-[0_30px_80px_-45px_rgba(15,23,42,0.95)] sm:p-8">
        <nav class="mb-2 flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-slate-200" aria-label="Breadcrumb">
            <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="transition hover:text-white">Trang chủ</a>
            <span class="material-symbols-outlined text-sm text-slate-300">chevron_right</span>
            <a href="@Url.RouteUrl(NopRouteNames.General.BOARDS)" class="transition hover:text-white">Diễn đàn</a>
            <span class="material-symbols-outlined text-sm text-slate-300">chevron_right</span>
            <span class="text-white">@Model.Name</span>
        </nav>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-secondary-container">Nhóm diễn đàn</p>
        <h1 class="public-page-title mt-2 font-black tracking-tight">@Model.Name</h1>
        <p class="mt-2 text-sm text-white/80">Tổng hợp các diễn đàn thành phần thuộc nhóm chuyên đề này.</p>
        <div class="mt-3 flex flex-wrap gap-2 text-xs">
            <span class="rounded-lg bg-white/10 px-2.5 py-1 font-semibold">@Model.Forums.Count diễn đàn</span>
            <span class="rounded-lg bg-white/10 px-2.5 py-1 font-semibold">@totalTopics chủ đề</span>
            <span class="rounded-lg bg-white/10 px-2.5 py-1 font-semibold">@totalPosts bài viết</span>
        </div>
    </div>
    @await Html.PartialAsync("_ForumGroup", Model)
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BoardsForumGroupBottom, additionalData = Model })
</div>
