@model ForumGroupModel
@{
    Layout = "_ColumnsOne";

    //title
    NopHtml.AddTitleParts(Model.Name);
    //page class
    NopHtml.AppendPageCssClassParts("html-forum-group-page");
    var totalTopics = Model.Forums.Sum(x => x.NumTopics);
    var totalPosts = Model.Forums.Sum(x => x.NumPosts);
}

@section Breadcrumb
{
    <nav class="public-breadcrumb flex flex-wrap items-center gap-2 text-slate-500" aria-label="Breadcrumb">
        <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="transition hover:text-military-green">Trang chủ</a>
        <span class="material-symbols-outlined text-sm text-slate-400">chevron_right</span>
        <a href="@Url.RouteUrl(NopRouteNames.General.BOARDS)" class="transition hover:text-military-green">Diễn đàn</a>
        <span class="material-symbols-outlined text-sm text-slate-400">chevron_right</span>
        <span class="text-slate-700">@Model.Name</span>
    </nav>
}
<div class="page forum-group-page public-page-shell public-page-stack">
    @await Html.PartialAsync("_ForumHeader")
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BoardsForumGroupAfterHeader, additionalData = Model })
    <div class="public-blue-hero">
        <div class="public-blue-hero-content">
            <div class="public-blue-hero-copy space-y-1.5">
                <h1 class="public-hero-title public-blue-hero-title font-black tracking-tight">@Model.Name</h1>
                <p class="public-hero-subtitle public-blue-hero-subtitle max-w-2xl">Tổng hợp các diễn đàn thành phần thuộc nhóm chuyên đề này.</p>
            </div>
            <div class="public-blue-hero-stats sm:min-w-[300px]">
                <div class="public-blue-hero-stat">
                    <p class="public-stat-value font-black text-sky-950">@Model.Forums.Count</p>
                    <p class="public-label-text uppercase tracking-[0.12em] text-sky-700">Diễn đàn</p>
                </div>
                <div class="public-blue-hero-stat">
                    <p class="public-stat-value font-black text-sky-950">@totalTopics</p>
                    <p class="public-label-text uppercase tracking-[0.12em] text-sky-700">Chủ đề</p>
                </div>
                <div class="public-blue-hero-stat">
                    <p class="public-stat-value font-black text-sky-950">@totalPosts</p>
                    <p class="public-label-text uppercase tracking-[0.12em] text-sky-700">Bài viết</p>
                </div>
            </div>
        </div>
    </div>
    @await Html.PartialAsync("_ForumGroup", Model)
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BoardsForumGroupBottom, additionalData = Model })
</div>
