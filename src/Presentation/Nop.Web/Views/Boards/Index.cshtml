@model BoardsIndexModel
@{
    Layout = "_ColumnsOne";
    NopHtml.AddTitleParts(T("Forum.PageTitle.Default").Text);
    NopHtml.AppendPageCssClassParts("html-forums-main-page");
}

@section Breadcrumb
{
    <nav class="public-breadcrumb flex flex-wrap items-center gap-2 text-slate-500" aria-label="Breadcrumb">
        <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="transition hover:text-military-green">Trang chủ</a>
        <span class="material-symbols-outlined text-sm text-slate-400">chevron_right</span>
        <span class="text-slate-700">Diễn đàn</span>
    </nav>
}

<div class="page forum-home-page public-page-shell public-page-stack">
    <div class="public-blue-hero">
        <div class="public-blue-hero-content">
        <div class="public-blue-hero-copy space-y-2">
            <h1 class="public-hero-title public-blue-hero-title font-black tracking-tight">Diễn đàn Hậu cần - Quân nhu</h1>
            <p class="public-hero-subtitle public-blue-hero-subtitle max-w-2xl">Trao đổi nghiệp vụ, chia sẻ kinh nghiệm và cập nhật giải pháp thực tế trong công tác bảo đảm hậu cần.</p>
        </div>
        <div class="public-blue-hero-stats">
                <div class="public-blue-hero-stat">
                    <p class="public-stat-value font-black text-sky-950">@Model.TotalForums</p>
                    <p class="public-label-text font-bold uppercase tracking-[0.12em] text-sky-900">Diễn đàn</p>
                </div>
                <div class="public-blue-hero-stat">
                    <p class="public-stat-value font-black text-sky-950">@Model.TotalTopics</p>
                    <p class="public-label-text font-bold uppercase tracking-[0.12em] text-sky-900">Chủ đề</p>
                </div>
                <div class="public-blue-hero-stat">
                    <p class="public-stat-value font-black text-sky-950">@Model.TotalPosts</p>
                    <p class="public-label-text font-bold uppercase tracking-[0.12em] text-sky-900">Bài viết</p>
                </div>
            <a href="@Url.RouteUrl(NopRouteNames.Standard.ACTIVE_DISCUSSIONS)" class="public-control-text public-blue-hero-action col-span-2 inline-flex w-full items-center justify-center font-bold transition">
                Xem thảo luận mới
            </a>
        </div>
        </div>
    </div>

    @await Html.PartialAsync("_ForumHeader")

    @await Component.InvokeAsync(typeof(TopicBlockViewComponent), new { systemName = "ForumWelcomeMessage" })
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BoardsMainAfterHeader, additionalData = Model })

    <div class="grid grid-cols-12 gap-6">
        <section class="col-span-12 space-y-4 lg:col-span-8">
            @await Html.PartialAsync("_ForumTopicCards", Model.TopicCards)
        </section>

        <aside class="col-span-12 space-y-4 lg:col-span-4">
            <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                <div class="public-label-text border-b border-slate-100 bg-slate-50 px-4 py-3 font-bold uppercase tracking-[0.14em] text-slate-500">Bài viết nổi bật</div>
                <div class="space-y-3 p-4">
                    @if (Model.FeaturedTopicCards.Count == 0)
                    {
                        <p class="public-body-text text-slate-500">Chưa có dữ liệu nổi bật.</p>
                    }
                    else
                    {
                        @foreach (var topic in Model.FeaturedTopicCards)
                        {
                            <a href="@Url.RouteUrl(NopRouteNames.Standard.TOPIC_SLUG, new { id = topic.Id, slug = topic.SeName })" class="block rounded-xl border border-slate-100 p-3 transition hover:border-military-green/50 hover:bg-slate-50">
                                <p class="public-list-title line-clamp-2 font-bold text-slate-800">@topic.Subject</p>
                                <p class="public-meta-text mt-1 text-slate-500">@topic.CreatedOnStr • @topic.NumReplies bình luận</p>
                            </a>
                        }
                    }
                </div>
            </section>

            <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                <div class="public-label-text border-b border-slate-100 bg-slate-50 px-4 py-3 font-bold uppercase tracking-[0.14em] text-slate-500">Chuyên mục phổ biến</div>
                <div class="space-y-2 p-4">
                    @if (Model.PopularForums.Count == 0)
                    {
                        <p class="public-body-text text-slate-500">Chưa có chuyên mục.</p>
                    }
                    else
                    {
                        @foreach (var forum in Model.PopularForums)
                        {
                            <a href="@Url.RouteUrl(NopRouteNames.Standard.FORUM_SLUG, new { id = forum.Id, slug = forum.SeName })" class="public-control-text flex items-center justify-between rounded-xl border border-slate-100 px-3 py-2.5 font-semibold text-slate-700 transition hover:border-military-green hover:text-military-green">
                                <span class="line-clamp-1">@forum.Name</span>
                                <span class="public-label-text rounded bg-slate-100 px-2 py-0.5 text-slate-500">@forum.NumTopics</span>
                            </a>
                        }
                    }
                </div>
            </section>

            <section class="overflow-hidden rounded-2xl bg-slate-900 p-5 text-white shadow-lg">
                <p class="public-label-text mb-4 font-bold uppercase tracking-[0.18em] text-secondary-container">Thống kê diễn đàn</p>
                <div class="grid grid-cols-3 gap-3 text-center">
                    <div class="rounded-xl bg-white/5 px-3 py-3">
                        <p class="public-stat-value font-black">@Model.TotalForums</p>
                        <p class="public-label-text uppercase text-slate-400">Diễn đàn</p>
                    </div>
                    <div class="rounded-xl bg-white/5 px-3 py-3">
                        <p class="public-stat-value font-black">@Model.TotalTopics</p>
                        <p class="public-label-text uppercase text-slate-400">Chủ đề</p>
                    </div>
                    <div class="rounded-xl bg-white/5 px-3 py-3">
                        <p class="public-stat-value font-black">@Model.TotalPosts</p>
                        <p class="public-label-text uppercase text-slate-400">Bài viết</p>
                    </div>
                </div>
            </section>
        </aside>
    </div>

    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BoardsMainBeforeActivediscussions, additionalData = Model })
    @await Component.InvokeAsync(typeof(ForumActiveDiscussionsSmallViewComponent))
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BoardsMainAfterActivediscussions, additionalData = Model })
</div>
