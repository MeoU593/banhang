@model BoardsIndexModel
@{
    Layout = "_ColumnsOne";
    NopHtml.AddTitleParts(T("Forum.PageTitle.Default").Text);
    NopHtml.AppendPageCssClassParts("html-forums-main-page");
}

<div class="page forum-home-page px-4 pb-8 lg:px-0">
    <div class="mb-6 flex flex-wrap items-start justify-between gap-4 rounded-3xl border border-slate-200 bg-gradient-to-r from-slate-900 via-slate-800 to-military-green p-6 text-white shadow-[0_30px_80px_-45px_rgba(15,23,42,0.95)] sm:p-8">
        <div class="space-y-2">
            <nav class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-slate-200" aria-label="Breadcrumb">
                <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="transition hover:text-white">Trang chủ</a>
                <span class="material-symbols-outlined text-sm text-slate-300">chevron_right</span>
                <span class="text-white">Diễn đàn</span>
            </nav>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-secondary-container">Cộng đồng hậu cần</p>
            <h1 class="public-page-title font-black tracking-tight">Diễn đàn Hậu cần - Quân nhu</h1>
            <p class="max-w-2xl text-sm text-white/80 sm:text-base">Trao đổi nghiệp vụ, chia sẻ kinh nghiệm và cập nhật giải pháp thực tế trong công tác bảo đảm hậu cần.</p>
        </div>
        <a href="@Url.RouteUrl(NopRouteNames.Standard.ACTIVE_DISCUSSIONS)" class="inline-flex h-11 items-center justify-center rounded-xl bg-white px-5 text-sm font-bold text-slate-900 transition hover:bg-white/90">
            Xem thảo luận mới
        </a>
    </div>

    @await Html.PartialAsync("_ForumHeader")

    @await Component.InvokeAsync(typeof(TopicBlockViewComponent), new { systemName = "ForumWelcomeMessage" })
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BoardsMainAfterHeader, additionalData = Model })

    <div class="grid grid-cols-12 gap-6">
        <section class="col-span-12 space-y-4 lg:col-span-8">
            @await Html.PartialAsync("_ForumTopicCards", Model.TopicCards)
        </section>

        <aside class="col-span-12 space-y-4 lg:col-span-4">
            <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                <div class="border-b border-slate-100 bg-slate-50 px-4 py-3 text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Bài viết nổi bật</div>
                <div class="space-y-3 p-4">
                    @if (Model.FeaturedTopicCards.Count == 0)
                    {
                        <p class="text-sm text-slate-500">Chưa có dữ liệu nổi bật.</p>
                    }
                    else
                    {
                        @foreach (var topic in Model.FeaturedTopicCards)
                        {
                            <a href="@Url.RouteUrl(NopRouteNames.Standard.TOPIC_SLUG, new { id = topic.Id, slug = topic.SeName })" class="block rounded-xl border border-slate-100 p-3 transition hover:border-military-green/50 hover:bg-slate-50">
                                <p class="line-clamp-2 text-sm font-bold text-slate-800">@topic.Subject</p>
                                <p class="mt-1 text-xs text-slate-500">@topic.CreatedOnStr • @topic.NumReplies bình luận</p>
                            </a>
                        }
                    }
                </div>
            </section>

            <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                <div class="border-b border-slate-100 bg-slate-50 px-4 py-3 text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Chuyên mục phổ biến</div>
                <div class="space-y-2 p-4">
                    @if (Model.PopularForums.Count == 0)
                    {
                        <p class="text-sm text-slate-500">Chưa có chuyên mục.</p>
                    }
                    else
                    {
                        @foreach (var forum in Model.PopularForums)
                        {
                            <a href="@Url.RouteUrl(NopRouteNames.Standard.FORUM_SLUG, new { id = forum.Id, slug = forum.SeName })" class="flex items-center justify-between rounded-xl border border-slate-100 px-3 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-military-green hover:text-military-green">
                                <span class="line-clamp-1">@forum.Name</span>
                                <span class="rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-500">@forum.NumTopics</span>
                            </a>
                        }
                    }
                </div>
            </section>

            <section class="overflow-hidden rounded-2xl bg-slate-900 p-5 text-white shadow-lg">
                <p class="mb-4 text-xs font-bold uppercase tracking-[0.18em] text-secondary-container">Thống kê diễn đàn</p>
                <div class="grid grid-cols-3 gap-3 text-center">
                    <div class="rounded-xl bg-white/5 px-3 py-3">
                        <p class="text-lg font-black">@Model.TotalForums</p>
                        <p class="text-[10px] uppercase text-slate-400">Diễn đàn</p>
                    </div>
                    <div class="rounded-xl bg-white/5 px-3 py-3">
                        <p class="text-lg font-black">@Model.TotalTopics</p>
                        <p class="text-[10px] uppercase text-slate-400">Chủ đề</p>
                    </div>
                    <div class="rounded-xl bg-white/5 px-3 py-3">
                        <p class="text-lg font-black">@Model.TotalPosts</p>
                        <p class="text-[10px] uppercase text-slate-400">Bài viết</p>
                    </div>
                </div>
            </section>
        </aside>
    </div>

    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BoardsMainBeforeActivediscussions, additionalData = Model })
    @await Component.InvokeAsync(typeof(ForumActiveDiscussionsSmallViewComponent))
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BoardsMainAfterActivediscussions, additionalData = Model })
</div>
