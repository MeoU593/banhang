@model TopicMoveModel
@{
    Layout = "_ColumnsOne";

    NopHtml.AddTitleParts(T("Forum.PageTitle.MoveTopic").Text);
    NopHtml.AppendPageCssClassParts("html-move-topic-page");
}
@section Breadcrumb
{
    <nav class="public-breadcrumb flex flex-wrap items-center gap-2 text-slate-500" aria-label="Breadcrumb">
        <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="transition hover:text-military-green">Trang chủ</a>
        <span class="material-symbols-outlined text-sm text-slate-400">chevron_right</span>
        <a href="@Url.RouteUrl(NopRouteNames.General.BOARDS)" class="transition hover:text-military-green">Diễn đàn</a>
        <span class="material-symbols-outlined text-sm text-slate-400">chevron_right</span>
        <span class="text-slate-700">Di chuyển chủ đề</span>
    </nav>
}
@await Html.PartialAsync("_ForumHeader")
<div class="page move-topic-page public-page-shell public-page-stack">
    <div class="page-title public-blue-hero">
        <div class="public-blue-hero-content">
            <div class="public-blue-hero-copy">
                <h1 class="public-hero-title public-blue-hero-title font-black tracking-tight">@T("Forum.MoveTopic")</h1>
                <p class="public-hero-subtitle public-blue-hero-subtitle mt-2 max-w-3xl">Chọn chuyên mục phù hợp để sắp xếp lại nội dung và giữ luồng thảo luận thông suốt.</p>
            </div>
        </div>
    </div>

    <div class="page-body space-y-4">
        <form asp-route="@NopRouteNames.Standard.TOPIC_MOVE" method="post">
            <input type="hidden" asp-for="Id"/>
            <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
                <div class="space-y-3">
                    <div class="public-meta-text rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 font-medium text-amber-800">
                        @T("Forum.SelectTheForumToMoveTopic")
                    </div>
                    <div class="public-form-row space-y-2">
                        <label asp-for="ForumSelected" class="public-label-text mb-2 block font-semibold text-slate-700">Diễn đàn đích</label>
                        <select asp-for="ForumSelected" asp-items="@(new SelectList(Model.ForumList, "Value", "Text"))" class="public-control-text h-11 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 text-slate-700 outline-none transition focus:border-slate-400 focus:bg-white"></select>
                    </div>
                </div>
            </section>

            <section class="buttons mt-4 flex flex-wrap items-center gap-2 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                <button type="submit" class="public-control-text button-1 submit-forum-topic-button inline-flex h-11 items-center justify-center rounded-xl bg-military-green px-5 font-semibold text-white transition hover:brightness-110">@T("Forum.Submit")</button>
                <button type="button" class="public-control-text button-2 cancel-forum-topic-button inline-flex h-11 items-center justify-center rounded-xl border border-slate-200 px-5 font-semibold text-slate-700 transition hover:border-slate-300" onclick="setLocation('@Url.RouteUrl(NopRouteNames.Standard.TOPIC_SLUG, new { id = Model.Id, slug = Model.TopicSeName })')">@T("Forum.Cancel")</button>
            </section>
        </form>
    </div>
</div>
