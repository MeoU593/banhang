@model Nop.Web.Models.Boards.SearchModel
@using Nop.Core.Domain.Forums
@using Microsoft.AspNetCore.Mvc.Rendering
@using Nop.Services.Localization
@using Nop.Web.Factories
@inject ILocalizationService localizationService
@{
    Layout = "_ColumnsOne";

    NopHtml.AddTitleParts(T("Forum.PageTitle.Search").Text);
    NopHtml.AppendPageCssClassParts("html-forum-search-page");
}

<script asp-location="Footer">
    $(function () {
        toggleAdvancedSearch();
        $('#advs').on('click', function () {
            toggleAdvancedSearch();
        });
    });

    function toggleAdvancedSearch() {
        if ($('#advs').is(':checked')) {
            $('#advanced-search').show();
        } else {
            $('#advanced-search').hide();
        }
    }
</script>

<div class="page forum-search-page px-4 pb-8 lg:px-0">
    <div class="mb-5 overflow-hidden rounded-[24px] border border-slate-200 bg-gradient-to-br from-slate-900 via-slate-800 to-military-green p-6 text-white shadow-[0_24px_60px_-35px_rgba(15,23,42,0.8)] sm:p-8">
        <nav class="mb-2 flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-slate-200" aria-label="Breadcrumb">
            <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="transition hover:text-white">Trang chủ</a>
            <span class="material-symbols-outlined text-sm text-slate-300">chevron_right</span>
            <a href="@Url.RouteUrl(NopRouteNames.General.BOARDS)" class="transition hover:text-white">Diễn đàn</a>
            <span class="material-symbols-outlined text-sm text-slate-300">chevron_right</span>
            <span class="text-white">Tìm kiếm</span>
        </nav>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-secondary-container">Tìm kiếm diễn đàn</p>
        <h1 class="public-page-title mt-2 font-black tracking-tight">@T("Forum.Search")</h1>
        <p class="mt-2 text-sm text-white/80">Lọc theo diễn đàn, thời gian và phạm vi để tìm nhanh chủ đề cần thiết.</p>
    </div>

    <div class="page-body space-y-5">
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BoardsSearchBeforeSearchform, additionalData = Model })

        <div class="mx-auto w-full max-w-5xl rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <form asp-route="@NopRouteNames.Standard.BOARDS_SEARCH" method="get" class="space-y-4">
                <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
                    <div class="space-y-2">
                        <label for="searchterms" class="block text-sm font-semibold text-slate-700">@T("Forum.Search.SearchKeyword")</label>
                        <div class="relative">
                            <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400 material-symbols-outlined text-[18px]">search</span>
                            <input type="text" name="searchterms" id="searchterms" value="@Model.SearchTerms" class="h-11 w-full rounded-xl border border-slate-200 bg-slate-50 py-2 pl-12 pr-4 text-sm text-slate-700 outline-none transition focus:border-military-green focus:bg-white" placeholder="Nhập từ khóa chủ đề, nội dung..." />
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center gap-2">
                        <label for="advs" class="inline-flex cursor-pointer items-center gap-2 rounded-xl bg-slate-50 px-3 py-2 text-sm font-medium text-slate-700">
                            <input @(Model.ShowAdvancedSearch ? "checked=\"checked\"" : "") id="advs" name="advs" type="checkbox" value="true" class="h-4 w-4 rounded border-slate-300 text-military-green focus:ring-military-green" />
                            <span>@T("Forum.Search.AdvancedSearch")</span>
                        </label>
                        <button type="submit" class="inline-flex h-11 items-center justify-center rounded-xl bg-military-green px-5 text-sm font-semibold text-white transition hover:brightness-110">@T("Forum.SearchButton")</button>
                    </div>
                </div>

                <div class="mt-1 grid gap-4 md:grid-cols-3" id="advanced-search" style="display:none;">
                    <div class="space-y-2">
                        <label for="forumId" class="block text-sm font-semibold text-slate-700">@T("Forum.Search.SearchInForum")</label>
                        <select name="forumId" id="forumId" asp-items="@(new SelectList(Model.ForumList, "Value", "Text", Model.ForumIdSelected))" class="h-11 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 text-sm text-slate-700 outline-none transition focus:border-military-green focus:bg-white"></select>
                    </div>
                    <div class="space-y-2">
                        <label for="within" class="block text-sm font-semibold text-slate-700">@T("Forum.Search.SearchWithin")</label>
                        <select name="within" id="within" asp-items="@(new SelectList(Model.WithinList, "Value", "Text", Model.WithinSelected))" class="h-11 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 text-sm text-slate-700 outline-none transition focus:border-military-green focus:bg-white"></select>
                    </div>
                    <div class="space-y-2">
                        <label for="limitDays" class="block text-sm font-semibold text-slate-700">@T("Forum.Search.LimitResultsToPrevious")</label>
                        <select name="limitDays" id="limitDays" asp-items="@(new SelectList(Model.LimitList, "Value", "Text", Model.LimitDaysSelected))" class="h-11 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 text-sm text-slate-700 outline-none transition focus:border-military-green focus:bg-white"></select>
                    </div>
                </div>
            </form>
        </div>

        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BoardsSearchAfterSearchform, additionalData = Model })

        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-700">@Model.Error</div>
        }

        <div class="space-y-4">
            @{
                var searchterms = Model.SearchTerms;
                string advs = null;
                string within = null;
                string limitDays = null;
                string forumId = null;

                if (Model.ShowAdvancedSearch)
                {
                    advs = "true";
                    within = Model.WithinSelected.ToString();
                    limitDays = Model.LimitDaysSelected.ToString();
                    forumId = Model.ForumIdSelected.ToString();
                }

                var pager = await Html.PagerAsync(new PagerModel(localizationService)
                {
                    PageSize = Model.TopicPageSize,
                    TotalRecords = Model.TopicTotalRecords,
                    PageIndex = Model.TopicPageIndex,
                    ShowTotalSummary = false,
                    RouteActionName = NopRouteNames.Standard.BOARDS_SEARCH,
                    RouteValues = new ForumModelFactory.ForumSearchRouteValues { Advs = advs, Searchterms = searchterms, ForumId = forumId, Within = within, LimitDays = limitDays }
                });
            }

            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BoardsSearchBeforeResults, additionalData = Model })

            @if (!string.IsNullOrEmpty(await pager.RenderHtmlContentAsync()))
            {
                <div class="rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm">@pager</div>
            }

            @if (Model.NoResultsVisisble)
            {
                <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-10 text-center text-sm text-slate-500">
                    @T("Forum.SearchNoResultsText")
                </div>
            }

            @if (Model.SearchResultsVisible)
            {
                <div class="space-y-4">
                    @foreach (var topic in Model.ForumTopics)
                    {
                        var topicTypeLabel = topic.ForumTopicType switch
                        {
                            ForumTopicType.Sticky => T("Forum.Sticky").Text,
                            ForumTopicType.Announcement => T("Forum.Announcement").Text,
                            _ => string.Empty
                        };

                        <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-military-green/40 hover:shadow-md">
                            <div class="flex flex-wrap items-start gap-4">
                                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-military-green/10 text-military-green">
                                    <span class="material-symbols-outlined">forum</span>
                                </div>

                                <div class="min-w-0 flex-1 space-y-2">
                                    <div class="flex flex-wrap items-center gap-2">
                                        @if (!string.IsNullOrWhiteSpace(topicTypeLabel))
                                        {
                                            <span class="inline-flex rounded-full bg-amber-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-amber-700">@topicTypeLabel</span>
                                        }
                                        <span class="text-xs text-slate-400">#@topic.Id</span>
                                    </div>

                                    <h3 class="public-card-title font-bold text-slate-900">
                                        @Html.RouteLink(topic.Subject, NopRouteNames.Standard.TOPIC_SLUG, new { id = topic.Id, slug = topic.SeName }, new { @class = "transition hover:text-military-green" })
                                    </h3>

                                    @if (topic.NumPosts > Model.PostsPageSize)
                                    {
                                        <div class="topic-pager text-xs">@await Html.ForumTopicSmallPagerAsync(topic)</div>
                                    }

                                    <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500">
                                        <span class="font-semibold text-slate-600">@T("Forum.Author"):</span>
                                        @if (topic.CustomerId > 0)
                                        {
                                            if (topic.AllowViewingProfiles)
                                            {
                                                @Html.RouteLink(topic.CustomerName, NopRouteNames.Standard.CUSTOMER_PROFILE, new { Id = topic.CustomerId }, new { @class = "font-semibold text-slate-700 hover:text-military-green" })
                                            }
                                            else
                                            {
                                                <span class="font-semibold text-slate-700">@topic.CustomerName</span>
                                            }
                                        }
                                    </div>

                                    <div class="flex flex-wrap items-center gap-2 text-xs">
                                        <span class="rounded bg-slate-100 px-2.5 py-1 font-semibold text-slate-600">@topic.NumReplies @T("Forum.Replies")</span>
                                        <span class="rounded bg-slate-100 px-2.5 py-1 font-semibold text-slate-600">@topic.Views @T("Forum.Views")</span>
                                        @if (Model.AllowPostVoting)
                                        {
                                            <span class="rounded bg-slate-100 px-2.5 py-1 font-semibold text-slate-600">@topic.Votes @T("Forum.Votes")</span>
                                        }
                                    </div>
                                </div>

                                <div class="w-full rounded-xl border border-slate-200 px-3 py-2 text-xs text-slate-500 sm:w-64">
                                    <p class="mb-1 font-bold uppercase tracking-[0.12em] text-slate-400">@T("Forum.LatestPost")</p>
                                    @await Component.InvokeAsync(typeof(ForumLastPostViewComponent), new { forumPostId = topic.LastPostId, showTopic = false })
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(await pager.RenderHtmlContentAsync()))
            {
                <div class="rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm">@pager</div>
            }

            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BoardsSearchAfterResults, additionalData = Model })
        </div>
    </div>
</div>
