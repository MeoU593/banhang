@using Nop.Core.Domain.Catalog
@using Nop.Core.Domain.Media
@using Nop.Services.Orders
@model OrderDetailsModel
@inject MediaSettings mediaSettings

@{
    if (!Model.PrintMode)
    {
        Layout = "_ColumnsOne";
    }
    else
    {
        Layout = "_Print";
    }
    NopHtml.AddTitleParts(T("PageTitle.OrderDetails").Text);
    NopHtml.AppendPageCssClassParts("html-order-details-page");
}

@if (Model.PrintMode)
{
    <script asp-location="Footer">
        $(function() { window.print(); });
    </script>
}

<style>
    .order-details-page .page-body { padding: 24px; display: flex; flex-direction: column; gap: 20px; }
    .order-details-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 10px 24px -18px rgba(15,23,42,0.4);
    }
    .order-section-title {
        font-size: 0.625rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #94a3b8;
        margin-bottom: 14px;
    }
    .order-info-row { display: flex; flex-direction: column; gap: 6px; }
    .order-info-item { display: flex; align-items: flex-start; gap: 6px; font-size: 0.8125rem; color: #475569; }
    .order-info-item .label { color: #94a3b8; min-width: 80px; flex-shrink: 0; }
    .order-data-table { width: 100%; border-collapse: collapse; font-size: 0.8125rem; }
    .order-data-table th { text-align: left; font-size: 0.625rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #94a3b8; padding: 0 10px 8px; border-bottom: 1px solid #f1f5f9; }
    .order-data-table td { padding: 10px; border-bottom: 1px solid #f8fafc; color: #374151; vertical-align: middle; }
    .order-data-table tr:last-child td { border-bottom: none; }
    .order-data-table td label.td-title { display: none; }
    @@media (max-width: 640px) {
        .order-data-table, .order-data-table tbody, .order-data-table tr, .order-data-table td { display: block; width: 100%; }
        .order-data-table thead { display: none; }
        .order-data-table td { padding: 4px 0; border: none; }
        .order-data-table td label.td-title { display: inline; font-weight: 600; color: #94a3b8; margin-right: 4px; }
        .order-data-table tr { border-bottom: 1px solid #f1f5f9; padding: 10px 0; }
    }
    .order-total-table { width: 100%; border-collapse: collapse; font-size: 0.8125rem; }
    .order-total-table td { padding: 6px 0; color: #475569; }
    .order-total-table td:last-child { text-align: right; font-weight: 600; color: #1e293b; }
    .order-total-table tr.grand-total td { font-size: 1rem; font-weight: 800; color: #141c24; border-top: 2px solid #e2e8f0; padding-top: 10px; }
</style>

<div class="page order-details-page">
    <div class="page-body">
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.OrderDetailsPageTop, additionalData = Model })

        @* ── Header card ── *@
        <div class="order-details-card">
            <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                    <p class="order-section-title">@T("Order.OrderInformation")</p>
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-[22px] text-slate-400">receipt_long</span>
                        <span class="text-xl font-black text-slate-900">#@Model.CustomOrderNumber</span>
                        @{
                            var statusKey = Model.OrderStatusText.ToLowerInvariant();
                            var statusBadge = statusKey switch
                            {
                                var s when s.Contains("hoàn") || s.Contains("complete") => "bg-emerald-50 text-emerald-700 border-emerald-200",
                                var s when s.Contains("xử") || s.Contains("process") => "bg-blue-50 text-blue-700 border-blue-200",
                                var s when s.Contains("hủy") || s.Contains("cancel") => "bg-rose-50 text-rose-700 border-rose-200",
                                _ => "bg-amber-50 text-amber-700 border-amber-200"
                            };
                        }
                        <span class="rounded-full border px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide @statusBadge">@Model.OrderStatusText</span>
                    </div>
                    <div class="mt-3 flex flex-wrap gap-4 text-xs text-slate-500">
                        <div class="flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-[14px]">calendar_today</span>
                            <span>@Model.CreatedOn.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="flex items-center gap-1.5 font-bold text-slate-800">
                            <span class="material-symbols-outlined text-[14px]">payments</span>
                            <span>@Model.OrderTotal</span>
                        </div>
                    </div>
                </div>
                @if (!Model.PrintMode)
                {
                    <div class="flex flex-wrap gap-2">
                        <a href="@Url.RouteUrl(NopRouteNames.Standard.PRINT_ORDER_DETAILS, new { orderId = Model.Id })" target="_blank" class="inline-flex h-8 items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-3 text-xs font-semibold text-slate-600 transition hover:bg-slate-100">
                            <span class="material-symbols-outlined text-[14px]">print</span>
                            @T("Order.Print")
                        </a>
                        @if (!Model.PdfInvoiceDisabled)
                        {
                            <a href="@Url.RouteUrl(NopRouteNames.Standard.GET_ORDER_PDF_INVOICE, new { orderId = Model.Id })" class="inline-flex h-8 items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-3 text-xs font-semibold text-slate-600 transition hover:bg-slate-100">
                                <span class="material-symbols-outlined text-[14px]">picture_as_pdf</span>
                                @T("Order.GetPDFInvoice")
                            </a>
                        }
                        @if (Model.CanCancelOrder)
                        {
                            <a id="cancel_order" href="@Url.RouteUrl("CancelOrder", new { orderId = Model.Id })" class="inline-flex h-8 items-center gap-1.5 rounded-lg border border-rose-200 bg-rose-50 px-3 text-xs font-semibold text-rose-700 transition hover:bg-rose-100">
                                <span class="material-symbols-outlined text-[14px]">cancel</span>
                                @T("Order.Cancel")
                            </a>
                            <script asp-location="Footer">
                                $(function() { $('#cancel_order').on('click', function() { return confirm('@T("Common.AreYouSure")'); }); });
                            </script>
                        }
                    </div>
                }
            </div>
        </div>

        @* ── Address & Payment ── *@
        <div class="grid gap-4 sm:grid-cols-2">
            <div class="order-details-card">
                <p class="order-section-title">@T("Order.BillingAddress")</p>
                <div class="order-info-row text-sm">
                    <div class="font-semibold text-slate-800">@Model.BillingAddress.FirstName @Model.BillingAddress.LastName</div>
                    @if (!string.IsNullOrEmpty(Model.BillingAddress.Email))
                    {
                        <div class="flex items-center gap-1.5 text-xs text-slate-500">
                            <span class="material-symbols-outlined text-[13px]">mail</span> @Model.BillingAddress.Email
                        </div>
                    }
                    @if (Model.BillingAddress.PhoneEnabled && !string.IsNullOrEmpty(Model.BillingAddress.PhoneNumber))
                    {
                        <div class="flex items-center gap-1.5 text-xs text-slate-500">
                            <span class="material-symbols-outlined text-[13px]">phone</span> @Model.BillingAddress.PhoneNumber
                        </div>
                    }
                    @if (Model.BillingAddress.CompanyEnabled && !string.IsNullOrEmpty(Model.BillingAddress.Company))
                    {
                        <div class="flex items-center gap-1.5 text-xs text-slate-500">
                            <span class="material-symbols-outlined text-[13px]">apartment</span> @Model.BillingAddress.Company
                        </div>
                    }
                    @foreach (var item in Model.BillingAddress.AddressFields)
                    {
                        <div class="text-xs text-slate-500">@item.Value</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.BillingAddress.FormattedCustomAddressAttributes))
                    {
                        <div class="text-xs text-slate-500">@Html.Raw(Model.BillingAddress.FormattedCustomAddressAttributes)</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.VatNumber))
                    {
                        <div class="text-xs text-slate-500">@T("Order.VATNumber"): @Model.VatNumber</div>
                    }
                    @await Html.PartialAsync("_OrderCustomValues", Model.CustomValues?.GetValuesByDisplayLocation(CustomValueDisplayLocation.BillingAddress))
                    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.OrderDetailsBillingAddress, additionalData = Model })
                </div>

                @if (!string.IsNullOrEmpty(Model.PaymentMethod))
                {
                    <div class="mt-4 border-t border-slate-100 pt-4">
                        <p class="order-section-title">@T("Order.Payment")</p>
                        <div class="order-info-row text-xs text-slate-600">
                            <div>@T("Order.Payment.Method"): <span class="font-semibold text-slate-800">@Model.PaymentMethod</span></div>
                            @if (!Model.PrintMode)
                            {
                                <div>@T("Order.Payment.Status"): <span class="font-semibold text-slate-800">@Model.PaymentMethodStatus</span></div>
                            }
                            @if (!Model.PrintMode && Model.CanRePostProcessPayment)
                            {
                                <form asp-route="@NopRouteNames.Standard.ORDER_DETAILS" method="post" class="mt-2">
                                    <button type="submit" name="repost-payment" class="inline-flex h-8 items-center gap-1.5 rounded-lg bg-[#b22222] px-3 text-xs font-bold text-[#d4af37]">
                                        @T("Order.RetryPayment")
                                    </button>
                                </form>
                            }
                            @await Html.PartialAsync("_OrderCustomValues", Model.CustomValues?.GetValuesByDisplayLocation(CustomValueDisplayLocation.Payment))
                        </div>
                    </div>
                }
            </div>

            @if (Model.IsShippable)
            {
                <div class="order-details-card">
                    <p class="order-section-title">@(Model.PickupInStore ? T("Order.PickupAddress") : T("Order.ShippingAddress"))</p>
                    <div class="order-info-row text-sm">
                        @if (!Model.PickupInStore)
                        {
                            <div class="font-semibold text-slate-800">@Model.ShippingAddress.FirstName @Model.ShippingAddress.LastName</div>
                            @if (!string.IsNullOrEmpty(Model.ShippingAddress.Email))
                            {
                                <div class="flex items-center gap-1.5 text-xs text-slate-500">
                                    <span class="material-symbols-outlined text-[13px]">mail</span> @Model.ShippingAddress.Email
                                </div>
                            }
                            @if (Model.ShippingAddress.PhoneEnabled && !string.IsNullOrEmpty(Model.ShippingAddress.PhoneNumber))
                            {
                                <div class="flex items-center gap-1.5 text-xs text-slate-500">
                                    <span class="material-symbols-outlined text-[13px]">phone</span> @Model.ShippingAddress.PhoneNumber
                                </div>
                            }
                            @if (Model.ShippingAddress.CompanyEnabled && !string.IsNullOrEmpty(Model.ShippingAddress.Company))
                            {
                                <div class="flex items-center gap-1.5 text-xs text-slate-500">
                                    <span class="material-symbols-outlined text-[13px]">apartment</span> @Model.ShippingAddress.Company
                                </div>
                            }
                            @foreach (var item in Model.ShippingAddress.AddressFields)
                            {
                                <div class="text-xs text-slate-500">@item.Value</div>
                            }
                            @if (!string.IsNullOrEmpty(Model.ShippingAddress.FormattedCustomAddressAttributes))
                            {
                                <div class="text-xs text-slate-500">@Html.Raw(Model.ShippingAddress.FormattedCustomAddressAttributes)</div>
                            }
                            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.OrderDetailsShippingAddress, additionalData = Model })
                        }
                        else
                        {
                            @foreach (var item in Model.PickupAddress.AddressFields)
                            {
                                <div class="text-xs text-slate-500">@item.Value</div>
                            }
                        }
                        @await Html.PartialAsync("_OrderCustomValues", Model.CustomValues?.GetValuesByDisplayLocation(CustomValueDisplayLocation.ShippingAddress))
                    </div>

                    <div class="mt-4 border-t border-slate-100 pt-4">
                        <p class="order-section-title">@T("Order.Shipping")</p>
                        <div class="text-xs text-slate-600">
                            <div>@T("Order.Shipping.Name"): <span class="font-semibold text-slate-800">@Model.ShippingMethod</span></div>
                            @if (!Model.PrintMode)
                            {
                                <div class="mt-1">@T("Order.Shipping.Status"): <span class="font-semibold text-slate-800">@Model.ShippingStatus</span></div>
                            }
                            @await Html.PartialAsync("_OrderCustomValues", Model.CustomValues?.GetValuesByDisplayLocation(CustomValueDisplayLocation.Shipping))
                        </div>
                    </div>
                </div>
            }
        </div>

        @* ── Shipments ── *@
        @if (!Model.PrintMode && Model.Shipments.Count > 0)
        {
            <div class="order-details-card">
                <p class="order-section-title">@T("Order.Shipments")</p>
                <div class="overflow-x-auto">
                    <table class="order-data-table">
                        <thead>
                            <tr>
                                <th>@T("Order.Shipments.ID")</th>
                                <th>@T("Order.Shipments.TrackingNumber")</th>
                                <th>@(Model.PickupInStore ? T("Order.Shipments.ReadyForPickupDate") : T("Order.Shipments.ShippedDate"))</th>
                                <th>@T("Order.Shipments.DeliveryDate")</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Shipments)
                            {
                                <tr>
                                    <td><label class="td-title">@T("Order.Shipments.ID"):</label> @item.Id</td>
                                    <td><label class="td-title">@T("Order.Shipments.TrackingNumber"):</label> @item.TrackingNumber</td>
                                    @if (Model.PickupInStore)
                                    {
                                        <td><label class="td-title">@T("Order.Shipments.ReadyForPickupDate"):</label> @(item.ReadyForPickupDate.HasValue ? item.ReadyForPickupDate.Value.ToString("dd/MM/yyyy") : T("Order.Shipments.ReadyForPickupDate.NotYet").Text)</td>
                                    }
                                    else
                                    {
                                        <td><label class="td-title">@T("Order.Shipments.ShippedDate"):</label> @(item.ShippedDate.HasValue ? item.ShippedDate.Value.ToString("dd/MM/yyyy") : T("Order.Shipments.ShippedDate.NotYet").Text)</td>
                                    }
                                    <td><label class="td-title">@T("Order.Shipments.DeliveryDate"):</label> @(item.DeliveryDate.HasValue ? item.DeliveryDate.Value.ToString("dd/MM/yyyy") : T("Order.Shipments.DeliveryDate.NotYet").Text)</td>
                                    <td>
                                        <a href="@Url.RouteUrl(NopRouteNames.Standard.SHIPMENT_DETAILS, new { shipmentId = item.Id })" class="text-xs font-semibold text-[#b22222] hover:underline">
                                            @T("Order.Shipments.ViewDetails")
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* ── Order notes ── *@
        @if (!Model.PrintMode && Model.Items.Count > 0 && Model.OrderNotes.Count > 0)
        {
            <div class="order-details-card">
                <p class="order-section-title">@T("Order.Notes")</p>
                <div class="space-y-2">
                    @foreach (var item in Model.OrderNotes)
                    {
                        <div class="rounded-lg bg-slate-50 px-3 py-2.5 text-xs text-slate-600">
                            <div class="mb-1 text-[10px] font-semibold text-slate-400">@item.CreatedOn.ToString("dd/MM/yyyy HH:mm")</div>
                            @Html.Raw(item.Note)
                            @if (item.HasDownload)
                            {
                                <div class="mt-1.5">
                                    <a href="@Url.RouteUrl(NopRouteNames.Standard.GET_ORDER_NOTE_FILE, new { ordernoteid = item.Id })" class="flex items-center gap-1 font-semibold text-[#b22222] hover:underline">
                                        <span class="material-symbols-outlined text-[12px]">download</span> @T("Order.Notes.Download")
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @* ── Products ── *@
        @if (Model.Items.Count > 0)
        {
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.OrderDetailsPageBeforeproducts, additionalData = Model })
            <div class="order-details-card">
                <p class="order-section-title">@T("Order.Product(s)")</p>
                <div class="overflow-x-auto">
                    <table class="order-data-table">
                        <thead>
                            <tr>
                                @if (Model.ShowSku) { <th>@T("Order.Product(s).SKU")</th> }
                                @if (Model.ShowProductThumbnail) { <th></th> }
                                <th>@T("Order.Product(s).Name")</th>
                                @if (Model.ShowVendorName) { <th>@T("Order.Product(s).VendorName")</th> }
                                <th>@T("Order.Product(s).Price")</th>
                                <th>@T("Order.Product(s).Quantity")</th>
                                <th>@T("Order.Product(s).Total")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    @if (Model.ShowSku)
                                    {
                                        <td><label class="td-title">@T("Order.Product(s).SKU"):</label> <span class="font-mono text-[11px]">@item.Sku</span></td>
                                    }
                                    @if (Model.ShowProductThumbnail)
                                    {
                                        <td>
                                            <a href="@(await NopUrl.RouteGenericUrlAsync<Product>(new { SeName = item.ProductSeName }))">
                                                <img alt="@item.Picture.AlternateText" src="@item.Picture.ImageUrl" title="@item.Picture.Title" class="h-12 w-12 rounded-lg object-cover" />
                                            </a>
                                        </td>
                                    }
                                    <td>
                                        <label class="td-title">@T("Order.Product(s).Name"):</label>
                                        @if (!Model.PrintMode)
                                        {
                                            <a href="@(await NopUrl.RouteGenericUrlAsync<Product>(new { SeName = item.ProductSeName }))" class="font-semibold text-slate-900 hover:text-[#b22222]">@item.ProductName</a>
                                        }
                                        else { @item.ProductName }
                                        @if (!string.IsNullOrEmpty(item.AttributeInfo)) { <div class="mt-0.5 text-[11px] text-slate-500">@Html.Raw(item.AttributeInfo)</div> }
                                        @if (item.DownloadId > 0)
                                        {
                                            <div class="mt-1"><a href="@Url.RouteUrl(NopRouteNames.Standard.GET_DOWNLOAD, new { orderItemId = item.OrderItemGuid })" class="text-xs font-semibold text-[#b22222] hover:underline">@T("DownloadableProducts.Fields.Download")</a></div>
                                        }
                                        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.OrderDetailsProductLine, additionalData = item })
                                    </td>
                                    @if (Model.ShowVendorName) { <td><label class="td-title">@T("Order.Product(s).VendorName"):</label> @item.VendorName</td> }
                                    <td><label class="td-title">@T("Order.Product(s).Price"):</label> @item.UnitPrice</td>
                                    <td><label class="td-title">@T("Order.Product(s).Quantity"):</label> @item.Quantity</td>
                                    <td class="font-semibold"><label class="td-title">@T("Order.Product(s).Total"):</label> @item.SubTotal</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.DisplayTaxShippingInfo)
                {
                    <p class="mt-3 text-[11px] text-slate-400">@T(Model.PricesIncludeTax ? "Order.TaxShipping.InclTax" : "Order.TaxShipping.ExclTax", await NopUrl.RouteTopicUrlAsync("shippinginfo"))</p>
                }
            </div>
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.OrderDetailsPageAfterproducts, additionalData = Model })

            @* ── Totals & Actions ── *@
            <div class="order-details-card">
                <div class="flex flex-col items-end gap-4">
                    <table class="order-total-table w-full max-w-xs">
                        <tbody>
                            <tr>
                                <td>@T("Order.SubTotal"):</td>
                                <td>@Model.OrderSubtotal</td>
                            </tr>
                            @if (Model.IsShippable)
                            {
                                <tr><td>@T("Order.Shipping"):</td><td>@Model.OrderShipping</td></tr>
                            }
                            @if (!string.IsNullOrEmpty(Model.PaymentMethodAdditionalFee))
                            {
                                <tr><td>@T("Order.PaymentMethodAdditionalFee"):</td><td>@Model.PaymentMethodAdditionalFee</td></tr>
                            }
                            @if (Model.DisplayTaxRates && Model.TaxRates.Count > 0)
                            {
                                @foreach (var taxRate in Model.TaxRates)
                                {
                                    <tr><td>@string.Format(T("Order.TaxRateLine").Text, taxRate.Rate):</td><td>@taxRate.Value</td></tr>
                                }
                            }
                            @if (Model.DisplayTax)
                            {
                                <tr><td>@T("Order.Tax"):</td><td>@Model.Tax</td></tr>
                            }
                            <tr class="grand-total">
                                <td>@T("Order.OrderTotal"):</td>
                                <td>@Model.OrderTotal</td>
                            </tr>
                        </tbody>
                    </table>

                    @if (!Model.PrintMode)
                    {
                        <div class="flex gap-2">
                            @if (Model.IsReOrderAllowed)
                            {
                                <button type="button" class="inline-flex h-9 items-center gap-1.5 rounded-lg bg-[#b22222] px-4 text-xs font-bold text-[#d4af37] transition hover:opacity-90" onclick="setLocation('@Url.RouteUrl(NopRouteNames.Standard.RE_ORDER, new { orderId = Model.Id })')">
                                    <span class="material-symbols-outlined text-[14px]">refresh</span>
                                    @T("Order.Reorder")
                                </button>
                            }
                            @if (Model.IsReturnRequestAllowed)
                            {
                                <button type="button" class="return-items-button inline-flex h-9 items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-4 text-xs font-semibold text-slate-600 transition hover:bg-slate-50" onclick="setLocation('@Url.RouteUrl(NopRouteNames.Standard.RETURN_REQUEST, new { orderId = Model.Id })')">
                                    <span class="material-symbols-outlined text-[14px]">assignment_return</span>
                                    @T("Order.ReturnItems")
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.OrderDetailsPageBottom, additionalData = Model })
    </div>
</div>
