@using Nop.Services
@model CustomerOrderListModel
@{
    Layout = "_ColumnsTwo";
    NopHtml.AddTitleParts(T("PageTitle.Account").Text);
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-order-list-page");
}
@section left
{
    @await Component.InvokeAsync(typeof(CustomerNavigationViewComponent), new { selectedTabId = CustomerNavigationEnum.Orders })
}
<div class="page account-page order-list-page">
    <div class="page-body">
        <div class="account-card">
            <p class="account-card-title">@T("Account.CustomerOrders")</p>

            <form asp-route="@NopRouteNames.General.CUSTOMER_ORDERS" method="post" class="mb-5">
                <div class="flex items-center gap-3">
                    <label class="text-xs font-semibold text-slate-500">@T("Account.CustomerOrders.Period")</label>
                    <select id="periodSelector" asp-items="@Model.AvailableLimits" class="h-8 rounded-lg border border-slate-200 bg-white px-3 text-xs font-medium text-slate-700 focus:outline-none"></select>
                </div>
            </form>

            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.CustomerOrdersTop, additionalData = Model })

            @if (Model.Orders.Count > 0)
            {
                <div class="space-y-3">
                    @foreach (var order in Model.Orders)
                    {
                        var statusKey = order.OrderStatusEnum.ToString().ToLowerInvariant();
                        var statusBadge = statusKey switch
                        {
                            "complete"   => "bg-emerald-50 text-emerald-700 border-emerald-200",
                            "processing" => "bg-blue-50 text-blue-700 border-blue-200",
                            "cancelled"  => "bg-rose-50 text-rose-700 border-rose-200",
                            _            => "bg-amber-50 text-amber-700 border-amber-200"
                        };
                        <div class="order-item rounded-xl border border-slate-200 bg-slate-50/40 p-4">
                            <div class="flex items-center justify-between gap-3">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-[18px] text-slate-400">receipt_long</span>
                                    <span class="text-sm font-bold text-slate-900">#@order.CustomOrderNumber</span>
                                </div>
                                <span class="order-status @statusKey rounded-full border px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide @statusBadge">@order.OrderStatus</span>
                            </div>

                            <div class="mt-3 grid grid-cols-2 gap-y-1.5 text-xs text-slate-600">
                                <div class="flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-[13px] text-slate-400">calendar_today</span>
                                    <span class="order-date">@order.CreatedOn.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <div class="flex items-center gap-1.5 font-semibold text-slate-800">
                                    <span class="material-symbols-outlined text-[13px] text-slate-400">payments</span>
                                    <span class="order-total">@order.OrderTotal</span>
                                </div>
                            </div>

                            <div class="mt-3 flex gap-2 border-t border-slate-100 pt-3">
                                @if (order.IsReturnRequestAllowed)
                                {
                                    <button type="button" class="return-items-button inline-flex h-8 items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 text-xs font-semibold text-slate-600 transition hover:bg-slate-100" onclick="setLocation('@Url.RouteUrl(NopRouteNames.Standard.RETURN_REQUEST, new { orderId = order.Id })')">
                                        <span class="material-symbols-outlined text-[13px]">assignment_return</span>
                                        @T("Account.CustomerOrders.ReturnItems")
                                    </button>
                                }
                                <button type="button" class="order-details-button inline-flex h-8 items-center gap-1.5 rounded-lg bg-[#b22222] px-3 text-xs font-bold text-[#d4af37] transition hover:opacity-90" onclick="setLocation('@Url.RouteUrl(NopRouteNames.Standard.ORDER_DETAILS, new { orderId = order.Id })')">
                                    <span class="material-symbols-outlined text-[13px]">visibility</span>
                                    @T("Account.CustomerOrders.OrderDetails")
                                </button>
                            </div>
                        </div>
                    }
                </div>

                @await Html.PagerAsync(Model.PagerModel)
            }
            else
            {
                <div class="flex flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-slate-200 py-10 text-center">
                    <span class="material-symbols-outlined text-4xl text-slate-300">receipt_long</span>
                    <p class="text-sm font-semibold text-slate-400">@T("Account.CustomerOrders.NoOrders")</p>
                </div>
            }

            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.CustomerOrdersBottom, additionalData = Model })
        </div>
    </div>
</div>

<script asp-location="Footer">
    $(function() {
        $('#periodSelector').on('change', function() {
            window.location.href = '@Url.RouteUrl(NopRouteNames.General.CUSTOMER_ORDERS, new { limit = (object)null })/' + $(this).val();
        });
    })
</script>
