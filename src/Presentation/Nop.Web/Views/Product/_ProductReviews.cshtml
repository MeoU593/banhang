@model ProductReviewsModel

@inject Nop.Services.Html.IHtmlFormatter htmlFormatter

<section class="page product-reviews command-review-section">
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductReviewsPageTop, additionalData = Model })

    @if (!Model.AddProductReview.CanCurrentCustomerLeaveReview)
    {
        <div class="result review-already-added command-review-message public-body-text">
            @T("Reviews.OnlyRegisteredUsersCanWriteReviews")
        </div>
    }
    else if (!Model.AddProductReview.CanAddNewReview)
    {
        <div class="result review-already-added command-review-message public-body-text">
            @T("Reviews.AlreadyAddedProductReviews")
        </div>
    }
    else
    {
        <div class="write-review command-review-card" id="review-form">
            <a name="addreview"></a>
            <form asp-action="ProductReviews" asp-fragment="addreview" method="post" id="product-review-form">
                <input type="hidden" asp-for="ProductId" />
                <input type="hidden" asp-for="AddProductReview.Title" />
                <div asp-validation-summary="ModelOnly" class="message-error"></div>
                <div class="review-form-card command-review-body">
                    <div class="command-review-field command-review-field--full command-review-textarea-shell">
                        <textarea asp-for="AddProductReview.ReviewText" class="review-text command-review-textarea" rows="5" placeholder="Mô tả trải nghiệm sử dụng, điểm phù hợp hoặc điều cần lưu ý..."></textarea>
                        <div class="review-rating-field command-rating-panel command-rating-inside">
                            <label asp-for="AddProductReview.Rating" asp-postfix=":" class="command-review-label command-rating-label"></label>
                            <div class="star-selector-wrap">
                                <div class="star-selector">
                                    <input asp-for="AddProductReview.Rating" value="0" type="radio" id="addproductrating_0" class="star-radio" />
                                    <input asp-for="AddProductReview.Rating" value="1" type="radio" id="addproductrating_1" class="star-radio" />
                                    <label for="addproductrating_1" class="star-lbl" data-tip="@T("Reviews.Fields.Rating.Bad")">★</label>
                                    <input asp-for="AddProductReview.Rating" value="2" type="radio" id="addproductrating_2" class="star-radio" />
                                    <label for="addproductrating_2" class="star-lbl" data-tip="@T("Reviews.Fields.Rating.NotGood")">★</label>
                                    <input asp-for="AddProductReview.Rating" value="3" type="radio" id="addproductrating_3" class="star-radio" />
                                    <label for="addproductrating_3" class="star-lbl" data-tip="@T("Reviews.Fields.Rating.NotBadNotExcellent")">★</label>
                                    <input asp-for="AddProductReview.Rating" value="4" type="radio" id="addproductrating_4" class="star-radio" />
                                    <label for="addproductrating_4" class="star-lbl" data-tip="@T("Reviews.Fields.Rating.Good")">★</label>
                                    <input asp-for="AddProductReview.Rating" value="5" type="radio" id="addproductrating_5" class="star-radio" />
                                    <label for="addproductrating_5" class="star-lbl" data-tip="@T("Reviews.Fields.Rating.Excellent")">★</label>
                                </div>
                                <span class="star-tip command-review-rating-tip"></span>
                            </div>
                        </div>
                        <button type="submit" name="add-review" id="add-review" class="button-1 write-product-review-button command-review-submit-inside">@T("Reviews.SubmitButton")</button>
                        <span asp-validation-for="AddProductReview.ReviewText" class="command-review-validation"></span>
                    </div>
                    @if (Model.AddProductReview.DisplayCaptcha)
                    {
                        <div class="captcha-box">
                            <nop-captcha action-name="ProductReviews" />
                        </div>
                    }
                </div>
            </form>
        </div>
        <script>
        (function () {
            var form = document.getElementById('product-review-form');
            var reviewText = document.getElementById('AddProductReview_ReviewText');
            var titleInput = document.getElementById('AddProductReview_Title');

            function syncReviewTitle() {
                if (!reviewText || !titleInput) return;

                var text = (reviewText.value || '').trim().replace(/\s+/g, ' ');
                titleInput.value = text ? text.substring(0, 120) : '';
            }

            function autosizeReviewText() {
                if (!reviewText) return;

                reviewText.style.height = 'auto';
                reviewText.style.height = reviewText.scrollHeight + 'px';
            }

            if (reviewText) {
                reviewText.addEventListener('input', function () {
                    syncReviewTitle();
                    autosizeReviewText();
                });
                autosizeReviewText();
                syncReviewTitle();
            }

            if (form) {
                form.addEventListener('submit', syncReviewTitle);
            }

            function initStarSelector(container) {
                var labels = Array.from(container.querySelectorAll('.star-lbl'));
                var tip = container.closest('.star-selector-wrap') && container.closest('.star-selector-wrap').querySelector('.star-tip');

                function updateSelected(val) {
                    labels.forEach(function (l, i) {
                        l.classList.toggle('selected', i < val);
                        l.classList.remove('hovered');
                    });
                    if (tip) tip.textContent = val > 0 ? (labels[val - 1].dataset.tip || '') : '';
                }

                var checked = container.querySelector('.star-radio:checked');
                if (checked && checked.value !== '0') updateSelected(parseInt(checked.value));

                labels.forEach(function (lbl, idx) {
                    lbl.addEventListener('mouseenter', function () {
                        labels.forEach(function (l, i) {
                            l.classList.toggle('hovered', i <= idx);
                            l.classList.remove('selected');
                        });
                        if (tip) tip.textContent = lbl.dataset.tip || '';
                    });
                    lbl.addEventListener('mouseleave', function () {
                        var ch = container.querySelector('.star-radio:checked');
                        var val = ch ? parseInt(ch.value) : 0;
                        labels.forEach(function (l) { l.classList.remove('hovered'); });
                        updateSelected(val);
                    });
                    lbl.addEventListener('click', function () {
                        var val = idx + 1;
                        var radio = container.querySelector('.star-radio[value="' + val + '"]');
                        if (radio) radio.checked = true;
                        updateSelected(val);
                    });
                });
            }
            document.querySelectorAll('.star-selector').forEach(initStarSelector);
        })();
        </script>
    }

    @if (Model.Items.Count > 0)
    {
        <div class="product-review-list command-review-card">
            <a name="productreviews"></a>
            <div class="command-review-body command-review-list">
            @foreach (var review in Model.Items)
            {
                var ratingStars = new string('★', Math.Max(0, Math.Min(5, review.Rating)));
                <div class="product-review-item command-review-item">
                    <div class="review-item-head command-review-item-head">
                        <div class="command-review-author">
                            <div class="avatar command-review-avatar">
                                @if (!string.IsNullOrEmpty(review.CustomerAvatarUrl))
                                {
                                    @if (review.AllowViewingProfiles)
                                    {
                                        <a href="@Url.RouteUrl(NopRouteNames.Standard.CUSTOMER_PROFILE, new { id = review.CustomerId })" class="command-review-avatar-link">
                                            <img src="@(review.CustomerAvatarUrl)" class="avatar-img" alt="Avatar" onerror="this.closest('.command-review-avatar').classList.add('is-fallback');this.remove();" />
                                        </a>
                                    }
                                    else
                                    {
                                        <img src="@(review.CustomerAvatarUrl)" class="avatar-img" alt="Avatar" onerror="this.closest('.command-review-avatar').classList.add('is-fallback');this.remove();" />
                                    }
                                }
                                <span class="material-symbols-outlined command-review-avatar-placeholder" aria-hidden="true">person</span>
                            </div>
                            <div class="command-review-author-main">
                                <div class="review-info command-review-meta">
                                    @if (review.AllowViewingProfiles)
                                    {
                                        <a href="@Url.RouteUrl(NopRouteNames.Standard.CUSTOMER_PROFILE, new { id = review.CustomerId })" class="command-review-author-link">@(review.CustomerName)</a>
                                    }
                                    else
                                    {
                                        <span class="command-review-author-link">@review.CustomerName</span>
                                    }
                                </div>
                                <div class="command-review-rating" aria-label="@review.Rating sao">@ratingStars</div>
                                <div class="command-review-date">@review.WrittenOnStr</div>
                            </div>
                        </div>
                    </div>
                    <div class="review-content command-review-content">
                        <div class="review-text command-review-text">
                            <div class="command-review-text-body">
                                @Html.Raw(htmlFormatter.FormatText(review.ReviewText, false, true, false, false, false, false))
                            </div>
                        </div>
                        @await Html.PartialAsync("_ProductReviewHelpfulness", review.Helpfulness)
                        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductReviewsPageInsideReview, additionalData = review })
                        @if (!string.IsNullOrEmpty(review.ReplyText))
                        {
                            <div class="reply command-review-reply">
                                <div class="reply-header command-review-reply-header">@T("Reviews.Reply")</div>
                                <div class="reply-text command-review-reply-text">
                                    @Html.Raw(htmlFormatter.FormatText(review.ReplyText, false, true, false, false, false, false))
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            </div>
        </div>
    }

    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductReviewsPageBottom, additionalData = Model })
</section>
