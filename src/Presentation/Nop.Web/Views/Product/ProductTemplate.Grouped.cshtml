@model ProductDetailsModel

@using Nop.Core
@using Nop.Core.Domain.Catalog
@using Nop.Core.Domain.Seo
@using Nop.Core.Domain.Vendors
@using Nop.Services.Html

@inject IHtmlFormatter htmlFormatter
@inject IWebHelper webHelper
@inject SeoSettings seoSettings

@{
    Layout = "_ColumnsOne";

    NopHtml.AddTitleParts(!string.IsNullOrEmpty(Model.MetaTitle) ? Model.MetaTitle : Model.Name);
    NopHtml.AddMetaDescriptionParts(Model.MetaDescription);
    NopHtml.AddMetaKeywordParts(Model.MetaKeywords);
    NopHtml.AppendPageCssClassParts("html-product-details-page");

    if (seoSettings.CanonicalUrlsEnabled)
    {
        var productUrl = (await NopUrl.RouteGenericUrlAsync<Product>(new { SeName = Model.SeName }, webHelper.GetCurrentRequestProtocol())).ToLowerInvariant();
        NopHtml.AddCanonicalUrlParts(productUrl, seoSettings.QueryStringInCanonicalUrlsEnabled);
    }

    if (seoSettings.OpenGraphMetaTags)
    {
        NopHtml.AddHeadCustomParts("<meta property=\"og:type\" content=\"product\" />");
        NopHtml.AddHeadCustomParts("<meta property=\"og:title\" content=\"" + Html.Encode(Model.Name) + "\" />");
        NopHtml.AddHeadCustomParts("<meta property=\"og:description\" content=\"" + Html.Encode(htmlFormatter.StripTags(Model.MetaDescription)) + "\" />");
        NopHtml.AddHeadCustomParts("<meta property=\"og:image\" content=\"" + Model.DefaultPictureModel.ImageUrl + "\" />");
        NopHtml.AddHeadCustomParts("<meta property=\"og:image:url\" content=\"" + Model.DefaultPictureModel.ImageUrl + "\" />");
        NopHtml.AddHeadCustomParts("<meta property=\"og:url\" content=\"" + webHelper.GetThisPageUrl(false) + "\" />");
        NopHtml.AddHeadCustomParts("<meta property=\"og:site_name\" content=\"" + Html.Encode(Model.CurrentStoreName) + "\" />");
    }

    if (seoSettings.TwitterMetaTags)
    {
        NopHtml.AddHeadCustomParts("<meta property=\"twitter:card\" content=\"summary\" />");
        NopHtml.AddHeadCustomParts("<meta property=\"twitter:site\" content=\"" + Html.Encode(Model.CurrentStoreName) + "\" />");
        NopHtml.AddHeadCustomParts("<meta property=\"twitter:title\" content=\"" + Html.Encode(Model.Name) + "\" />");
        NopHtml.AddHeadCustomParts("<meta property=\"twitter:description\" content=\"" + Html.Encode(htmlFormatter.StripTags(Model.MetaDescription)) + "\" />");
        NopHtml.AddHeadCustomParts("<meta property=\"twitter:image\" content=\"" + Model.DefaultPictureModel.ImageUrl + "\" />");
        NopHtml.AddHeadCustomParts("<meta property=\"twitter:url\" content=\"" + webHelper.GetThisPageUrl(false) + "\" />");
    }

    NopHtml.AddJsonLdParts(Model.JsonLd);

    var parentStateText = string.IsNullOrWhiteSpace(Model.StockAvailability) ? "Có sẵn" : Model.StockAvailability;
    var parentStateClass = string.IsNullOrWhiteSpace(Model.StockAvailability) ? "is-available" : "is-supplying";
}

@section Breadcrumb
{
    @await Html.PartialAsync("_ProductBreadcrumb", Model.Breadcrumb)
}

<style>
    .logistics-grouped-page {
        padding: 0;
    }

    .logistics-grouped-page .page-body {
        padding: clamp(1rem, 1.5vw, 1.75rem);
        display: grid;
        gap: clamp(1rem, 1.45vw, 1.75rem);
    }

    .logistics-grouped-page .grouped-shell {
        display: grid;
        gap: clamp(1rem, 1.45vw, 1.75rem);
    }

    .logistics-grouped-page .hero-grid {
        display: grid;
        gap: clamp(1rem, 1.45vw, 1.75rem);
        grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
        align-items: start;
    }

    .logistics-grouped-page .surface-card,
    .logistics-grouped-page .grouped-section {
        border: 1px solid rgba(196, 198, 204, 0.35);
        border-radius: clamp(1rem, 1.15vw, 1.35rem);
        background: #fff;
        box-shadow: 0 1.4vw 2.6vw -2.2vw rgba(15, 23, 42, 0.6);
    }

    .logistics-grouped-page .media-card {
        padding: clamp(0.625rem, 0.7vw, 0.875rem);
    }

    .logistics-grouped-page .overview-card {
        padding: clamp(1rem, 1.35vw, 1.5rem);
        display: flex;
        flex-direction: column;
        gap: clamp(0.75rem, 1vw, 1rem);
    }

    .logistics-grouped-page .status-pill {
        display: inline-flex;
        align-items: center;
        gap: clamp(0.3rem, 0.45vw, 0.55rem);
        border-radius: 999px;
        padding: clamp(0.375rem, 0.45vw, 0.5rem) clamp(0.75rem, 0.8vw, 1rem);
        font-size: var(--public-font-label);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.12em;
    }

    .logistics-grouped-page .status-pill.is-available {
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #a7f3d0;
    }

    .logistics-grouped-page .status-pill.is-supplying {
        background: #fff7ed;
        color: #c2410c;
        border: 1px solid #fdba74;
    }

    .logistics-grouped-page .status-pill.is-preorder {
        background: #fffbeb;
        color: #b45309;
        border: 1px solid #fcd34d;
    }

    .logistics-grouped-page .product-name h1 {
        margin: 0;
        color: #141c24;
        font-size: var(--public-font-page-title);
        font-weight: 900;
        letter-spacing: -0.03em;
        line-height: 1.1;
    }

    .logistics-grouped-page .short-description {
        color: #475569;
        font-size: var(--public-font-body);
        line-height: 1.7;
        padding: clamp(0.75rem, 0.9vw, 1rem) 0;
        border-top: 1px solid #edf2f7;
        border-bottom: 1px solid #edf2f7;
    }

    .logistics-grouped-page .overview-meta .product-reviews-overview,
    .logistics-grouped-page .overview-meta .product-poster {
        border-radius: clamp(0.55rem, 0.7vw, 0.8rem);
        border: 1px solid #edf2f7;
        background: #f8fafc;
        padding: clamp(0.5rem, 0.6vw, 0.625rem) clamp(0.625rem, 0.8vw, 0.875rem);
        margin-bottom: clamp(0.5rem, 0.7vw, 0.75rem);
    }

    .logistics-grouped-page .overview-meta .product-poster,
    .logistics-grouped-page .variant-overview .product-poster {
        position: relative;
        overflow: visible;
    }

    .logistics-grouped-page .overview-meta .product-poster-line,
    .logistics-grouped-page .variant-overview .product-poster-line {
        display: flex;
        align-items: center;
        gap: 6px;
        min-width: 0;
        white-space: nowrap;
    }

    .logistics-grouped-page .overview-meta .product-poster .label,
    .logistics-grouped-page .variant-overview .product-poster .label {
        font-weight: 700;
        color: #1e293b;
    }

    .logistics-grouped-page .overview-meta .product-poster .poster-details summary,
    .logistics-grouped-page .variant-overview .product-poster .poster-details summary {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        list-style: none;
        font-weight: 700;
        color: #0f172a;
    }

    .logistics-grouped-page .overview-meta .product-poster .poster-name,
    .logistics-grouped-page .variant-overview .product-poster .poster-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .logistics-grouped-page .overview-meta .product-poster .poster-details summary::-webkit-details-marker,
    .logistics-grouped-page .variant-overview .product-poster .poster-details summary::-webkit-details-marker {
        display: none;
    }

    .logistics-grouped-page .overview-meta .product-poster .poster-card,
    .logistics-grouped-page .variant-overview .product-poster .poster-card {
        position: absolute;
        z-index: 60;
        top: calc(100% + 0.45rem);
        right: 0.75rem;
        width: min(22rem, calc(100% - 1.5rem));
        min-width: 0;
        margin-top: 0;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        background: #fff;
        padding: 10px;
        display: grid;
        gap: 6px;
        white-space: normal;
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.16);
    }

    .logistics-grouped-page .overview-meta .product-poster .poster-details:not([open]) .poster-card,
    .logistics-grouped-page .variant-overview .product-poster .poster-details:not([open]) .poster-card {
        display: none;
    }

    .logistics-grouped-page .overview-meta .product-poster .poster-field,
    .logistics-grouped-page .variant-overview .product-poster .poster-field {
        display: grid;
        grid-template-columns: 6rem minmax(0, 1fr);
        align-items: baseline;
        column-gap: 0.5rem;
        row-gap: 0.25rem;
    }

    .logistics-grouped-page .overview-meta .product-poster .poster-field-label,
    .logistics-grouped-page .variant-overview .product-poster .poster-field-label {
        font-size: var(--public-font-label);
        font-weight: 700;
        text-transform: uppercase;
        color: #64748b;
        white-space: nowrap;
    }

    .logistics-grouped-page .overview-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: clamp(0.5rem, 0.7vw, 0.75rem);
        padding-top: clamp(0.5rem, 0.6vw, 0.625rem);
        border-top: 1px solid #edf2f7;
    }

    .logistics-grouped-page .overview-buttons .button-2 {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: clamp(2.3rem, 2.5vw, 2.75rem);
        border-radius: clamp(0.55rem, 0.7vw, 0.8rem);
        border: 1px solid #dbe3ef;
        background: #f8fafc;
        color: #334155;
        font-size: var(--public-font-control);
        font-weight: 700;
        padding: 0 clamp(0.75rem, 0.85vw, 1rem);
        transition: all 0.2s ease;
    }

    .logistics-grouped-page .overview-buttons .button-2:hover {
        border-color: #2e0001;
        background: #2e0001;
        color: #fff;
    }

    .logistics-grouped-page .contact-card {
        border-radius: 12px;
        border: 1px solid #dbe3ef;
        background: #f8fafc;
        padding: 12px;
    }

    .logistics-grouped-page .contact-card-label {
        color: #64748b;
        font-size: var(--public-font-label);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.14em;
    }

    .logistics-grouped-page .contact-card-link {
        margin-top: 6px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #141c24;
        font-size: var(--public-font-control);
        font-weight: 800;
        text-decoration: none;
    }

    .logistics-grouped-page .grouped-section {
        padding: clamp(1rem, 1.35vw, 1.5rem);
    }

    .logistics-grouped-page .section-title {
        margin: 0 0 14px;
        color: #141c24;
        font-size: var(--public-font-section-title);
        font-weight: 900;
        letter-spacing: -0.02em;
    }

    .logistics-grouped-page .grouped-variant-list {
        display: grid;
        gap: clamp(0.75rem, 1vw, 1rem);
    }

    .logistics-grouped-page .grouped-variant-card {
        border: 1px solid #dbe3ef;
        border-radius: clamp(0.8rem, 0.9vw, 1rem);
        background: #f8fafc;
        padding: clamp(0.875rem, 1vw, 1.125rem);
        display: grid;
        gap: clamp(0.75rem, 1vw, 1rem);
        grid-template-columns: 180px minmax(0, 1fr);
    }

    .logistics-grouped-page .variant-picture img {
        width: 100%;
        border-radius: clamp(0.55rem, 0.7vw, 0.8rem);
        border: 1px solid #dbe3ef;
        background: #fff;
        aspect-ratio: 1 / 1;
        object-fit: cover;
    }

    .logistics-grouped-page .variant-name {
        margin: 0;
        color: #1e293b;
        font-size: var(--public-font-card-title);
        font-weight: 800;
        line-height: 1.25;
    }

    .logistics-grouped-page .variant-description {
        margin-top: clamp(0.5rem, 0.6vw, 0.625rem);
        color: #475569;
        font-size: var(--public-font-control);
        line-height: 1.7;
    }

    .logistics-grouped-page .variant-overview .availability,
    .logistics-grouped-page .variant-overview .additional-details,
    .logistics-grouped-page .variant-overview .prices {
        margin-top: clamp(0.5rem, 0.7vw, 0.75rem);
        border-radius: clamp(0.55rem, 0.7vw, 0.8rem);
        border: 1px solid #e2e8f0;
        background: #fff;
        padding: clamp(0.625rem, 0.8vw, 0.875rem);
    }

    .logistics-grouped-page .variant-overview .label {
        font-weight: 700;
        color: #1e293b;
    }

    .logistics-grouped-page .variant-overview .button-1,
    .logistics-grouped-page .variant-overview .button-2 {
        border-radius: clamp(0.55rem, 0.7vw, 0.8rem);
    }

    .logistics-grouped-page .no-associated-products {
        border: 2px dashed #c4c6cc;
        border-radius: 12px;
        background: #f8fafc;
        color: #64748b;
        font-size: var(--public-font-control);
        font-weight: 700;
        padding: clamp(1rem, 1.35vw, 1.5rem);
        text-align: center;
    }

    .logistics-grouped-page .product-specs-box,
    .logistics-grouped-page .product-tags-box {
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        background: #fff;
        padding: 14px;
        margin-top: 14px;
    }

    .logistics-grouped-page .product-specs-box .title,
    .logistics-grouped-page .product-tags-box .title {
        margin: 0 0 10px;
        color: #1e293b;
        font-size: var(--public-font-control);
        font-weight: 800;
    }

    @@media (max-width: 1200px) {
        .logistics-grouped-page .hero-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 900px) {
        .logistics-grouped-page .grouped-variant-card {
            grid-template-columns: 1fr;
        }

        .logistics-grouped-page .variant-picture {
            max-width: 220px;
        }
    }

    @@media (max-width: 767px) {
        .logistics-grouped-page .page-body {
            padding: 14px;
        }

        .logistics-grouped-page .overview-card,
        .logistics-grouped-page .grouped-section {
            padding: 16px;
        }

        .logistics-grouped-page .product-name h1 {
            font-size: var(--public-font-page-title);
        }
    }
</style>

@await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductDetailsAfterBreadcrumb, additionalData = Model })
<div class="page product-details-page logistics-grouped-page">
    <div class="page-body">
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductDetailsTop, additionalData = Model })
        <form asp-route="Product" asp-route-sename="@Model.SeName" method="post" id="product-details-form">
            <article class="grouped-shell" data-productid="@Model.Id">
                @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductDetailsEssentialTop, additionalData = Model })

                <section class="hero-grid">
                    <div class="surface-card media-card">
                        @await Html.PartialAsync("_ProductDetailsPictures", Model)
                        @await Html.PartialAsync("_ProductDetailsVideos", Model)
                    </div>

                    <aside class="surface-card overview-card">
                        @await Html.PartialAsync("_Discontinued", Model)

                        <span class="status-pill @parentStateClass">
                            <span class="material-symbols-outlined text-[15px]">verified</span>
                            <span>@parentStateText</span>
                        </span>

                        <div class="product-name">
                            <h1>@Model.Name</h1>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.ShortDescription))
                        {
                            <div class="short-description">@Html.Raw(Model.ShortDescription)</div>
                        }

                        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductDetailsOverviewTop, additionalData = Model })

                        <div class="overview-meta">
                            @await Html.PartialAsync("_ProductReviewOverview", Model.ProductReviewOverview)
                            @await Html.PartialAsync("_ProductPoster", Model)
                        </div>

                        <div class="overview-buttons">
                            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductDetailsInsideOverviewButtonsBefore, additionalData = Model })
                            @await Html.PartialAsync("_CompareProductsButton", Model)
                            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductDetailsInsideOverviewButtonsAfter, additionalData = Model })
                        </div>

                        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductDetailsOverviewBottom, additionalData = Model })
                    </aside>
                </section>

                @if (!string.IsNullOrEmpty(Model.FullDescription))
                {
                    <section class="grouped-section">
                        <h2 class="section-title">Mô tả chi tiết</h2>
                        <div class="full-description">@Html.Raw(Model.FullDescription)</div>
                    </section>
                }

                @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductDetailsEssentialBottom, additionalData = Model })
                @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductDetailsBeforeCollateral, additionalData = Model })

                <section class="grouped-section product-collateral">
                    <h2 class="section-title">Danh sách biến thể cung ứng</h2>
                    <div class="grouped-variant-list">
                        @foreach (var variant in Model.AssociatedProducts)
                        {
                            <article class="grouped-variant-card" data-productid="@variant.Id">
                                @if (!string.IsNullOrWhiteSpace(variant.DefaultPictureModel.ImageUrl))
                                {
                                    <div class="variant-picture">
                                        <img alt="@variant.DefaultPictureModel.AlternateText" src="@variant.DefaultPictureModel.ImageUrl" title="@variant.DefaultPictureModel.Title" id="main-product-img-@variant.Id" />
                                    </div>
                                }
                                <div class="variant-overview">
                                    @if (!string.IsNullOrWhiteSpace(variant.Name))
                                    {
                                        <h3 class="variant-name">@variant.Name</h3>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(variant.ShortDescription))
                                    {
                                        <div class="variant-description">@Html.Raw(variant.ShortDescription)</div>
                                    }

                                    @await Html.PartialAsync("_ProductPoster", variant)
                                    @await Html.PartialAsync("_Availability", variant)
                                    @await Html.PartialAsync("_SKU_Man_GTIN_Ven", variant)
                                    @await Html.PartialAsync("_DownloadSample", variant)

                                    @{
                                        var dataDictPrice = new ViewDataDictionary(ViewData);
                                        dataDictPrice.TemplateInfo.HtmlFieldPrefix = $"price_{variant.Id}";
                                        @await Html.PartialAsync("_ProductPrice", variant.ProductPrice, dataDictPrice)
                                    }
                                </div>
                            </article>
                        }

                        @if (!Model.AssociatedProducts.Any())
                        {
                            <div class="no-associated-products">@T("Products.NoAssociatedProducts")</div>
                        }
                    </div>

                    @await Html.PartialAsync("_ProductSpecifications", Model.ProductSpecificationModel)
                    @await Html.PartialAsync("_ProductTags", Model.ProductTags)
                </section>

                @await Component.InvokeAsync(typeof(RelatedProductsViewComponent), new { productId = Model.Id })
                @await Component.InvokeAsync(typeof(CompatibleWithFilterLevelValuesViewComponent), new { productId = Model.Id })
            </article>
        </form>

        @if (Model.ProductReviewOverview.AllowCustomerReviews)
        {
            @await Html.PartialAsync("_ProductReviews", Model.ProductReviews)
        }

        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductDetailsBottom, additionalData = Model })
    </div>
</div>
