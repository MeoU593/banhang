@model ProductDetailsModel
@{
    var addtocomparelink = Url.RouteUrl(NopRouteNames.Ajax.ADD_PRODUCT_TO_COMPARE, new { productId = Model.Id });
}
@if (Model.CompareProductsEnabled)
{
    <div class="compare-products">
        <button type="button" class="button-2 add-to-compare-list-button" data-compare-url="@addtocomparelink">@T("Products.Compare.AddToCompareList")</button>
    </div>
}

<script asp-location="Footer">
    $(function () {
        $(document)
            .off('click.productCompare', '.add-to-compare-list-button')
            .on('click.productCompare', '.add-to-compare-list-button', function () {
                var $button = $(this);
                if ($button.prop('disabled')) {
                    return;
                }

                var postData = {};
                addAntiForgeryToken(postData);
                $button.prop('disabled', true);

                $.post($button.data('compare-url'), postData)
                    .done(function (response) {
                        if (response && response.message) {
                            displayBarNotification(response.message, response.success ? 'success' : 'error', 3500);
                        }

                        if (response && response.redirect) {
                            setLocation(response.redirect);
                        }
                    })
                    .fail(function () {
                        displayBarNotification('@JavaScriptEncoder.Default.Encode(T("Common.Error").Text)', 'error', 3500);
                    })
                    .always(function () {
                        $button.prop('disabled', false);
                    });
            });
    });
</script>
