@model ProductDetailsModel.ProductBreadcrumbModel

@using Nop.Core.Domain.Catalog
@using Nop.Core.Domain.Common

@inject CommonSettings commonSettings

@{
    NopHtml.AddJsonLdParts(Model.JsonLd);
}
@if (Model.Enabled)
{
    <nav class="mb-5 flex items-center gap-2 px-6 pt-6 text-xs font-medium uppercase tracking-wider text-on-surface-variant lg:px-8">
        <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="hover:text-military-green transition-colors">Trang chủ</a>
        @foreach (var category in Model.CategoryBreadcrumb)
        {
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <a href="@(await NopUrl.RouteGenericUrlAsync<Category>(new { SeName = category.SeName }))" class="hover:text-military-green transition-colors">@category.Name</a>
        }
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <span class="font-bold text-on-surface line-clamp-1">@Model.ProductName</span>
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductBreadcrumbAfter, additionalData = Model })
    </nav>
}
