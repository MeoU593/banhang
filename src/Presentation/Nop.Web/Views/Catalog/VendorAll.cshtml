@model IList<VendorModel>

@{
    Layout = "_ColumnsOne";
    var totalUnits = Model?.Count ?? 0;

    NopHtml.AddTitleParts("Danh sách đơn vị");
    NopHtml.AddMetaDescriptionParts("Danh sách các đơn vị trực thuộc Bình Chủng Tăng Thiết Giáp");
    NopHtml.AppendPageCssClassParts("html-unit-list-page");
}

@section Breadcrumb
{
    <nav class="public-breadcrumb flex flex-wrap items-center gap-2 text-slate-500" aria-label="Breadcrumb">
        <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="transition hover:text-military-green">Trang chủ</a>
        <span class="material-symbols-outlined text-sm text-slate-400">chevron_right</span>
        <span class="text-slate-700">Danh sách đơn vị</span>
    </nav>
}

<div class="page unit-list-page public-page-shell public-page-stack">
<div class="page-body w-full public-page-stack">
    <section class="public-blue-hero unit-list-hero">
        <div class="public-blue-hero-content unit-list-hero-content">
            <div class="public-blue-hero-copy space-y-1.5">
                <h1 class="public-hero-title public-blue-hero-title font-black tracking-tight">Đơn Vị Trực Thuộc</h1>
                <p class="public-hero-subtitle public-blue-hero-subtitle max-w-2xl">Quản lý và tra cứu thông tin các đơn vị hậu cần, quân sự trong hệ thống nội bộ.</p>
            </div>
            <div class="public-blue-hero-stats">
                <div class="public-blue-hero-stat">
                    <div class="public-label-text uppercase tracking-[0.2em]">Tổng số đơn vị</div>
                    <div class="public-stat-value mt-1 font-black">@totalUnits</div>
                </div>
            </div>
        </div>
    </section>

    <label class="unit-list-search-shell relative block">
        <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400 material-symbols-outlined text-[20px]">search</span>
        <input id="unit-search" type="search" class="public-control-text h-12 w-full rounded-xl border border-slate-200 bg-slate-50 pl-11 pr-4 text-slate-700 placeholder:text-slate-400 outline-none transition focus:border-military-green focus:bg-white" placeholder="Tìm kiếm theo tên hoặc mã đơn vị..." />
    </label>

    <section class="rounded-3xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
        @if (totalUnits == 0)
        {
            <div class="public-body-text rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-12 text-center text-slate-500">
                Chưa có đơn vị nào trong hệ thống.
            </div>
        }
        else
        {
            <div id="unit-grid" class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
                @foreach (var item in Model)
                {
                    var detailUrl = Url.RouteUrl(NopRouteNames.General.UNIT_DETAILS, new { vendorId = item.Id });
                    var searchable = $"{item.Name} {item.Code}".ToLowerInvariant();

                    <article class="unit-card overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-lg" data-search="@searchable">
                        <a href="@detailUrl" class="relative block h-44 overflow-hidden bg-gradient-to-br from-slate-900 via-slate-800 to-military-green">
                            <div class="absolute inset-0 opacity-20" style="background-image:linear-gradient(135deg,rgba(255,255,255,.25) 20%,transparent 20%,transparent 50%,rgba(255,255,255,.25) 50%,rgba(255,255,255,.25) 70%,transparent 70%,transparent)"></div>
                            <div class="relative flex h-full items-center justify-center p-6">
                                @if (!string.IsNullOrWhiteSpace(item.PictureModel.ImageUrl))
                                {
                                    <img src="@item.PictureModel.ImageUrl" alt="@item.PictureModel.AlternateText" title="@item.PictureModel.Title" class="h-24 w-24 rounded-2xl border border-white/20 object-cover bg-white/10" />
                                }
                            </div>
                        </a>

                        <div class="space-y-4 p-5">
                            <div>
                                <h2 class="unit-card-title font-black text-slate-900">
                                    <a href="@detailUrl" class="transition hover:text-military-green">@item.Name</a>
                                </h2>
                                <p class="public-meta-text mt-1 text-slate-500">Cấp đơn vị: @item.Level</p>
                            </div>

                            <div class="public-body-text space-y-2 text-slate-600">
                                <p class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-[18px] text-slate-400">restaurant</span>
                                    <span>@item.NumberOfProducts sản phẩm và năng lực</span>
                                </p>
                                <p class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-[18px] text-slate-400">account_tree</span>
                                    <span>Trực thuộc: @(string.IsNullOrWhiteSpace(item.ParentName) ? "BTL TTG" : item.ParentName)</span>
                                </p>
                            </div>

                            <div class="flex items-center justify-between border-t border-slate-100 pt-4">
                                <span class="public-label-text inline-flex items-center rounded-full bg-sky-100 px-3 py-1 font-bold uppercase tracking-wider text-sky-800">Đơn vị</span>
                                <a href="@detailUrl" class="public-control-text inline-flex h-10 items-center justify-center rounded-xl bg-military-green px-5 font-bold text-white transition hover:brightness-110">Chi tiết</a>
                            </div>
                        </div>
                    </article>
                }
            </div>

            <p id="unit-search-empty" class="public-body-text mt-4 hidden rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-8 text-center text-slate-500">
                Không tìm thấy đơn vị phù hợp với từ khóa vừa nhập.
            </p>
        }
    </section>
</div>
</div>

<script>
    (function () {
        var searchInput = document.getElementById("unit-search");
        var cards = Array.prototype.slice.call(document.querySelectorAll("#unit-grid .unit-card"));
        var emptyState = document.getElementById("unit-search-empty");

        if (!searchInput || !cards.length) {
            return;
        }

        searchInput.addEventListener("input", function () {
            var keyword = (searchInput.value || "").toLowerCase().trim();

            var visibleCount = 0;

            cards.forEach(function (card) {
                var searchText = card.getAttribute("data-search") || "";
                var isVisible = !keyword || searchText.indexOf(keyword) >= 0;
                card.style.display = isVisible ? "" : "none";

                if (isVisible) {
                    visibleCount++;
                }
            });

            if (emptyState) {
                emptyState.classList.toggle("hidden", visibleCount > 0);
            }
        });
    })();
</script>
