@model CategoryModel

@using Nop.Core.Domain.Catalog
@using Nop.Core.Domain.Common
@using Nop.Core.Domain.Seo

@inject Nop.Core.IWebHelper webHelper
@inject SeoSettings seoSettings
@inject CommonSettings commonSettings

@{
    Layout = "_ColumnsOne";

    NopHtml.AddTitleParts(!string.IsNullOrEmpty(Model.MetaTitle) ? Model.MetaTitle : Model.Name);
    NopHtml.AddMetaDescriptionParts(Model.MetaDescription);
    NopHtml.AddMetaKeywordParts(Model.MetaKeywords);
    NopHtml.AppendPageCssClassParts("html-category-page");

    if (seoSettings.CanonicalUrlsEnabled)
    {
        var categoryUrl = (await NopUrl.RouteGenericUrlAsync<Category>(new { SeName = Model.SeName }, webHelper.GetCurrentRequestProtocol())).ToLowerInvariant();
        NopHtml.AddCanonicalUrlParts(categoryUrl, seoSettings.QueryStringInCanonicalUrlsEnabled);
    }

    var breadcrumbDelimiter = commonSettings.BreadcrumbDelimiter;
    NopHtml.AddJsonLdParts(Model.JsonLd);
}

<style>
    .category-page-refined {
        background: #f1f5f9;
        padding: 24px;
    }

    .category-page-refined .category-page-header {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
    }

    .category-page-refined .category-breadcrumbs {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin: 0 0 8px;
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
    }

    .category-page-refined .category-breadcrumb-separator {
        color: #94a3b8;
    }

    .category-page-refined .category-breadcrumbs a {
        color: inherit;
        text-decoration: none;
    }

    .category-page-refined .category-breadcrumbs a:hover {
        color: #0f172a;
    }

    .category-page-refined .category-title {
        margin: 0;
        color: #0f172a;
        font-size: 28px;
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -0.03em;
    }

    .category-page-refined .category-header-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 24px;
        border: 0;
        background: #b91c1c;
        color: #fff;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
        box-shadow: 0 18px 36px -24px rgba(127, 29, 29, 0.6);
        transition: transform 0.2s ease, background-color 0.2s ease;
    }

    .category-page-refined .category-header-action:hover {
        background: #991b1b;
        color: #fff;
        transform: translateY(-1px);
    }

    .category-page-refined .category-page-flow {
        display: grid;
        gap: 24px;
    }

    @@media (max-width: 767px) {
        .category-page-refined {
            padding: 16px;
        }

        .category-page-refined .category-title {
            font-size: 28px;
        }

        .category-page-refined .category-header-action {
            width: 100%;
        }
    }
</style>

<div class="page category-page category-page-refined">
    <div class="category-page-header">
        <div>
            @if (Model.DisplayCategoryBreadcrumb)
            {
                <nav class="category-breadcrumbs" aria-label="Breadcrumb">
                    <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)">Trang chủ</a>
                    <span class="category-breadcrumb-separator">@breadcrumbDelimiter</span>
                    <a href="@Url.RouteUrl(NopRouteNames.General.CATEGORIES)">Sản phẩm &amp; Năng lực</a>
                    @foreach (var cat in Model.CategoryBreadcrumb)
                    {
                        var isLastCategory = cat.Id == Model.Id;

                        <span class="category-breadcrumb-separator">@breadcrumbDelimiter</span>

                        if (isLastCategory)
                        {
                            <span>@cat.Name</span>
                        }
                        else
                        {
                            <a href="@(await NopUrl.RouteGenericUrlAsync<Category>(new { SeName = cat.SeName }))" title="@cat.Name">@cat.Name</a>
                        }
                    }
                </nav>
            }
            <h1 class="category-title">@Model.Name</h1>
        </div>
        <a class="category-header-action" href="#category-products">@(Model.CatalogProductsModel.TotalItems > 0 ? $"Xem {Model.CatalogProductsModel.TotalItems} sản phẩm" : "Mở danh sách")</a>
    </div>

    <div class="category-page-flow" id="category-products">
        @{
            var catalogProductsViewData = new ViewDataDictionary(ViewData);
            catalogProductsViewData["fetchUrl"] = Html.Raw(Url.RouteUrl(NopRouteNames.Ajax.GET_CATEGORY_PRODUCTS, new { categoryId = Model.Id }));
            catalogProductsViewData["categoryName"] = Model.Name;
        }

        @await Html.PartialAsync("_CatalogSelectors", Model.CatalogProductsModel)
        @await Html.PartialAsync("_CatalogProducts", Model.CatalogProductsModel, catalogProductsViewData)
    </div>
</div>
