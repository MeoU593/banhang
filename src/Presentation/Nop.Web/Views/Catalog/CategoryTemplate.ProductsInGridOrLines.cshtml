@model CategoryModel

@using Nop.Core.Domain.Catalog
@using Nop.Core.Domain.Common
@using Nop.Core.Domain.Seo

@inject Nop.Core.IWebHelper webHelper
@inject SeoSettings seoSettings
@inject CommonSettings commonSettings

@{
    Layout = "_ColumnsOne";

    NopHtml.AddTitleParts(!string.IsNullOrEmpty(Model.MetaTitle) ? Model.MetaTitle : Model.Name);
    NopHtml.AddMetaDescriptionParts(Model.MetaDescription);
    NopHtml.AddMetaKeywordParts(Model.MetaKeywords);
    NopHtml.AppendPageCssClassParts("html-category-page");

    if (seoSettings.CanonicalUrlsEnabled)
    {
        var categoryUrl = (await NopUrl.RouteGenericUrlAsync<Category>(new { SeName = Model.SeName }, webHelper.GetCurrentRequestProtocol())).ToLowerInvariant();
        NopHtml.AddCanonicalUrlParts(categoryUrl, seoSettings.QueryStringInCanonicalUrlsEnabled);
    }

    var breadcrumbDelimiter = commonSettings.BreadcrumbDelimiter;
    NopHtml.AddJsonLdParts(Model.JsonLd);
}

<style>
    .category-page-command {
        background: #edf4ff;
        padding: 24px;
    }

    .category-page-command .category-hero {
        border: 1px solid rgba(196, 198, 204, 0.35);
        border-radius: 18px;
        background: linear-gradient(130deg, #ffffff 0%, #f7f9ff 56%, #edf4ff 100%);
        padding: 26px;
        box-shadow: 0 22px 44px -34px rgba(15, 23, 42, 0.5);
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
    }

    .category-page-command .hero-meta {
        max-width: 760px;
    }

    .category-page-command .category-breadcrumbs {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin: 0 0 10px;
        color: #64748b;
        font-size: var(--public-font-meta);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
    }

    .category-page-command .category-breadcrumbs a {
        color: inherit;
        text-decoration: none;
    }

    .category-page-command .category-breadcrumbs a:hover {
        color: #141c24;
    }

    .category-page-command .hero-label {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 8px;
        color: #2e0001;
        font-size: var(--public-font-label);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.16em;
    }

    .category-page-command .category-title {
        margin: 0;
        color: #2e0001;
        font-size: var(--public-font-hero-title);
        font-weight: 900;
        line-height: 1.1;
        letter-spacing: -0.03em;
    }

    .category-page-command .category-description {
        margin-top: 10px;
        color: #4b5563;
        font-size: var(--public-font-body);
        line-height: 1.75;
        max-width: 700px;
    }

    .category-page-command .category-hero-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 14px;
    }

    .category-page-command .hero-stat {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid #dbe3ef;
        border-radius: 999px;
        background: #ffffff;
        padding: 6px 12px;
        color: #334155;
        font-size: var(--public-font-meta);
        font-weight: 700;
    }

    .category-page-command .category-header-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 46px;
        padding: 0 22px;
        border: 0;
        border-radius: 12px;
        background: #2e0001;
        color: #ffffff;
        text-decoration: none;
        font-size: var(--public-font-control);
        font-weight: 800;
        box-shadow: 0 24px 34px -28px rgba(46, 0, 1, 0.9);
        transition: transform 0.2s ease, background-color 0.2s ease;
    }

    .category-page-command .category-header-action:hover {
        background: #550005;
        color: #fff;
        transform: translateY(-1px);
    }

    .category-page-command .category-page-flow {
        display: grid;
        gap: 22px;
    }

    @@media (max-width: 767px) {
        .category-page-command {
            padding: 14px;
        }

        .category-page-command .category-hero {
            padding: 18px;
        }

        .category-page-command .category-title {
            font-size: 1.75rem;
        }

        .category-page-command .category-header-action {
            width: 100%;
        }
    }
</style>

<div class="page category-page category-page-command">
    <header class="category-hero">
        <div class="hero-meta">
            @if (Model.DisplayCategoryBreadcrumb)
            {
                <nav class="category-breadcrumbs" aria-label="Breadcrumb">
                    <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)">Trang chủ</a>
                    <span>@breadcrumbDelimiter</span>
                    <a href="@Url.RouteUrl(NopRouteNames.General.CATEGORIES)">Sản phẩm &amp; Năng lực</a>
                    @foreach (var cat in Model.CategoryBreadcrumb)
                    {
                        var isLastCategory = cat.Id == Model.Id;

                        <span class="category-breadcrumb-separator">@breadcrumbDelimiter</span>

                        if (isLastCategory)
                        {
                            <span>@cat.Name</span>
                        }
                        else
                        {
                            <a href="@(await NopUrl.RouteGenericUrlAsync<Category>(new { SeName = cat.SeName }))" title="@cat.Name">@cat.Name</a>
                        }
                    }
                </nav>
            }
            <div class="hero-label">
                <span class="material-symbols-outlined text-[16px]">bookmark</span>
                <span>Danh mục lưu trữ</span>
            </div>
            <h1 class="category-title">@Model.Name</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="category-description">@Html.Raw(Model.Description)</div>
            }
            <div class="category-hero-stats">
                <span class="hero-stat">
                    <span class="material-symbols-outlined text-[16px]">inventory_2</span>
                    @Model.CatalogProductsModel.TotalItems sản phẩm
                </span>
                <span class="hero-stat">
                    <span class="material-symbols-outlined text-[16px]">layers</span>
                    @Model.CatalogProductsModel.TotalPages trang dữ liệu
                </span>
            </div>
        </div>
        <a class="category-header-action" href="#category-products">
            <span>@(Model.CatalogProductsModel.TotalItems > 0 ? $"Xem {Model.CatalogProductsModel.TotalItems} sản phẩm" : "Mở danh sách")</span>
            <span class="material-symbols-outlined text-[18px]">arrow_downward</span>
        </a>
    </header>

    <div class="category-page-flow" id="category-products">
        @{
            var catalogProductsViewData = new ViewDataDictionary(ViewData);
            catalogProductsViewData["fetchUrl"] = Html.Raw(Url.RouteUrl(NopRouteNames.Ajax.GET_CATEGORY_PRODUCTS, new { categoryId = Model.Id }));
            catalogProductsViewData["categoryName"] = Model.Name;
            catalogProductsViewData["LockCategorySelector"] = false;
            catalogProductsViewData["CurrentCategoryId"] = Model.Id;
            catalogProductsViewData["CurrentCategoryName"] = Model.Name;
            catalogProductsViewData["ResetCategoryUrl"] = Url.Action("CategoryAll", "Catalog");
        }

        @await Html.PartialAsync("_CatalogSelectors", Model.CatalogProductsModel, catalogProductsViewData)
        @await Html.PartialAsync("_CatalogProducts", Model.CatalogProductsModel, catalogProductsViewData)
    </div>
</div>
