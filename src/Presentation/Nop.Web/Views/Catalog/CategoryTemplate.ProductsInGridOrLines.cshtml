@model CategoryModel

@using Nop.Core.Domain.Catalog
@using Nop.Core.Domain.Common
@using Nop.Core.Domain.Seo

@inject Nop.Core.IWebHelper webHelper
@inject SeoSettings seoSettings
@inject CommonSettings commonSettings

@{
    Layout = "_ColumnsOne";

    NopHtml.AddTitleParts(!string.IsNullOrEmpty(Model.MetaTitle) ? Model.MetaTitle : Model.Name);
    NopHtml.AddMetaDescriptionParts(Model.MetaDescription);
    NopHtml.AddMetaKeywordParts(Model.MetaKeywords);
    NopHtml.AppendPageCssClassParts("html-category-page");

    if (seoSettings.CanonicalUrlsEnabled)
    {
        var categoryUrl = (await NopUrl.RouteGenericUrlAsync<Category>(new { SeName = Model.SeName }, webHelper.GetCurrentRequestProtocol())).ToLowerInvariant();
        NopHtml.AddCanonicalUrlParts(categoryUrl, seoSettings.QueryStringInCanonicalUrlsEnabled);
    }

    var breadcrumbDelimiter = commonSettings.BreadcrumbDelimiter;
    NopHtml.AddJsonLdParts(Model.JsonLd);

    var catalogModel = Model.CatalogProductsModel;
    var postingUnitCount = catalogModel.GetType().GetProperty("PostingUnitCount")?.GetValue(catalogModel) as int? ?? 0;
}

@section Breadcrumb
{
    @if (Model.DisplayCategoryBreadcrumb)
    {
        <nav class="public-breadcrumb flex flex-wrap items-center gap-2 text-slate-500" aria-label="Breadcrumb">
            <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="transition hover:text-military-green">Trang chủ</a>
            <span>@breadcrumbDelimiter</span>
            <a href="@Url.RouteUrl(NopRouteNames.General.CATEGORIES)" class="transition hover:text-military-green">Sản phẩm &amp; Năng lực</a>
            @foreach (var cat in Model.CategoryBreadcrumb)
            {
                var isLastCategory = cat.Id == Model.Id;

                <span>@breadcrumbDelimiter</span>

                if (isLastCategory)
                {
                    <span class="text-slate-700">@cat.Name</span>
                }
                else
                {
                    <a href="@(await NopUrl.RouteGenericUrlAsync<Category>(new { SeName = cat.SeName }))" title="@cat.Name" class="transition hover:text-military-green">@cat.Name</a>
                }
            }
        </nav>
    }
}

<div class="page category-page category-page-command catalog-page-shell catalog-page-stack">
    <header class="public-blue-hero catalog-overview-hero">
        <div class="public-blue-hero-content">
        <div class="public-blue-hero-copy">
            <h1 class="public-hero-title public-blue-hero-title font-black tracking-tight">@Model.Name</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="public-hero-subtitle public-blue-hero-subtitle max-w-3xl">@Html.Raw(Model.Description)</div>
            }
        </div>
        <div class="public-blue-hero-stats catalog-overview-stats sm:grid-cols-2">
                <span class="public-blue-hero-stat">
                    <strong class="public-stat-value font-black text-sky-950">@catalogModel.TotalItems</strong>
                    <span class="public-label-text font-bold uppercase tracking-[0.14em] text-sky-700">Tổng sản phẩm</span>
                </span>
                <span class="public-blue-hero-stat">
                    <strong class="public-stat-value font-black text-sky-950">@postingUnitCount</strong>
                    <span class="public-label-text font-bold uppercase tracking-[0.14em] text-sky-700">Đơn vị đăng</span>
                </span>
        </div>
        </div>
    </header>

    <div class="category-page-flow" id="category-products">
        @{
            var catalogProductsViewData = new ViewDataDictionary(ViewData);
            catalogProductsViewData["fetchUrl"] = Html.Raw(Url.RouteUrl(NopRouteNames.Ajax.GET_CATEGORY_PRODUCTS, new { categoryId = Model.Id }));
            catalogProductsViewData["categoryName"] = Model.Name;
            catalogProductsViewData["LockCategorySelector"] = false;
            catalogProductsViewData["CurrentCategoryId"] = Model.Id;
            catalogProductsViewData["CurrentCategoryName"] = Model.Name;
            catalogProductsViewData["ResetCategoryUrl"] = Url.Action("CategoryAll", "Catalog");
        }

        @await Html.PartialAsync("_CatalogSelectors", Model.CatalogProductsModel, catalogProductsViewData)
        @await Html.PartialAsync("_CatalogProducts", Model.CatalogProductsModel, catalogProductsViewData)
    </div>
</div>
