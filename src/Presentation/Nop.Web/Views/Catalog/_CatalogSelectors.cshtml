@model CatalogProductsModel

@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Rendering
@using Nop.Services.Catalog
@using Nop.Services.Seo
@using Nop.Services.Vendors

@inject ICategoryService categoryService
@inject IVendorService vendorService
@inject IUrlRecordService urlRecordService

@{
    var lockCategorySelector = ViewData["LockCategorySelector"] as bool? ?? false;
    var currentCategoryName = (ViewData["CurrentCategoryName"] as string ?? string.Empty).Trim();
    var currentCategoryId = ViewData["CurrentCategoryId"] as int? ?? 0;
    var allCategoriesUrl = Url.Action("CategoryAll", "Catalog");
    var resetCategoryUrl = ViewData["ResetCategoryUrl"] as string ?? (lockCategorySelector ? allCategoriesUrl : string.Empty);

    var categorySelectItems = new List<SelectListItem>();
    var categorySeoUrls = new Dictionary<int, string>();
    if (!lockCategorySelector)
    {
        var allCategories = await categoryService.GetAllCategoriesAsync();
        categorySelectItems = allCategories
            .Select(cat => new SelectListItem { Text = cat.Name, Value = cat.Id.ToString() })
            .ToList();

        foreach (var cat in allCategories)
        {
            var seName = await urlRecordService.GetSeNameAsync(cat);
            if (!string.IsNullOrWhiteSpace(seName))
            {
                var catUrl = await NopUrl.RouteGenericUrlAsync<Nop.Core.Domain.Catalog.Category>(new { SeName = seName });
                categorySeoUrls[cat.Id] = catUrl;
            }
        }
    }

    var allVendors = await vendorService.GetAllVendorsAsync();
    var manufacturerSelectItems = allVendors
        .Select(v => new SelectListItem { Text = v.Name, Value = v.Id.ToString() })
        .ToList();

    var selectedManufacturerIds = new HashSet<int>();
    var selectedManufacturersQuery = Context.Request.Query["ms"].ToString();
    if (!string.IsNullOrWhiteSpace(selectedManufacturersQuery))
    {
        foreach (var value in selectedManufacturersQuery.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (int.TryParse(value, out var manufacturerId) && manufacturerId > 0)
                selectedManufacturerIds.Add(manufacturerId);
        }
    }

    if (!selectedManufacturerIds.Any() && Model.ManufacturerFilter?.Manufacturers?.Any() == true)
    {
        foreach (var manufacturer in Model.ManufacturerFilter.Manufacturers.Where(item => item.Selected))
        {
            if (int.TryParse(manufacturer.Value, out var manufacturerId) && manufacturerId > 0)
                selectedManufacturerIds.Add(manufacturerId);
        }
    }

    var gridColumnsClass = Model.AllowProductSorting ? "md:grid-cols-7" : "md:grid-cols-6";
}

<style>
    .product-selectors-refined {
        border: 1px solid #dbe3ef;
        border-radius: clamp(0.875rem, 1vw, 1.15rem);
        background: linear-gradient(135deg, #ffffff 0%, #f8fafc 62%, #fff7e6 100%);
        padding: clamp(0.75rem, 1vw, 1rem);
        box-shadow: 0 0.9rem 2rem -1.7rem rgba(15, 23, 42, 0.28);
    }

    .product-selectors-heading {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: clamp(0.75rem, 1vw, 1rem);
    }

    .product-selectors-count-chip {
        display: inline-flex;
        align-items: center;
        border: 1px solid #dbeafe;
        border-radius: 999px;
        background: #ffffff;
        color: #0369a1;
        font-weight: 800;
        padding: 0.35rem 0.7rem;
        white-space: nowrap;
    }

    .product-selectors-refined .selector-label {
        margin-bottom: clamp(0.35rem, 0.45vw, 0.5rem);
        display: block;
        color: #8a1114;
        font-size: var(--public-font-label);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        padding: 0 clamp(0.25rem, 0.3vw, 0.375rem);
    }

    .product-selectors-refined > .selector-field {
        display: block;
        min-width: 0;
        margin: 0;
    }

    .product-selectors-refined span {
        vertical-align: initial;
        font-size: inherit;
    }

    .product-selectors-refined .selector-panel,
    .product-selectors-refined .selector-search,
    .product-selectors-refined select {
        appearance: none;
        -webkit-appearance: none;
        box-sizing: border-box;
        width: 100%;
        min-height: clamp(2.6rem, 2.8vw, 3rem);
        border: 1px solid #cbd5e1;
        border-radius: clamp(0.5rem, 0.6vw, 0.7rem);
        background: #ffffff;
        padding: 0 clamp(0.75rem, 0.85vw, 1rem) !important;
        color: #141c24;
        font-size: var(--public-font-control);
        font-weight: 600;
        line-height: 1.35;
        outline: none;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
    }

    .product-selectors-refined .selector-panel {
        display: flex;
        align-items: center;
        color: #334155;
    }

    .product-selectors-refined .selector-panel.readonly {
        font-weight: 700;
    }

    .product-selectors-refined .selector-search-wrap,
    .product-selectors-refined .selector-select-wrap {
        position: relative;
        min-width: 0;
    }

    .product-selectors-refined .selector-search {
        padding-left: clamp(2.6rem, 2.8vw, 3.1rem) !important;
    }

    .product-selectors-refined .selector-search-icon,
    .product-selectors-refined .selector-select-icon {
        pointer-events: none;
        position: absolute;
        top: 50%;
        left: clamp(0.7rem, 0.8vw, 0.9rem);
        transform: translateY(-50%);
        color: #64748b;
        font-size: 18px;
        line-height: 1;
        z-index: 3;
    }

    .product-selectors-refined .selector-select-wrap select {
        margin: 0;
        padding-left: clamp(2.6rem, 2.8vw, 3.1rem) !important;
        padding-right: clamp(0.75rem, 0.85vw, 1rem) !important;
    }

    .product-selectors-refined .selector-sort {
        padding-left: clamp(0.75rem, 0.85vw, 1rem) !important;
    }

    .product-selectors-refined .selector-search:focus,
    .product-selectors-refined select:focus {
        border-color: #b91d20;
        background: #ffffff;
        box-shadow: 0 0 0 3px rgba(185, 29, 32, 0.12);
    }

    .product-selectors-refined .selector-reset {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        box-sizing: border-box;
        width: 100%;
        min-height: clamp(2.6rem, 2.8vw, 3rem);
        border: 1px solid #cbd5e1;
        border-radius: clamp(0.5rem, 0.6vw, 0.7rem);
        background: #ffffff;
        color: #475569;
        font-size: var(--public-font-control);
        font-weight: 700;
        padding: 0 clamp(0.75rem, 0.8vw, 1rem);
        white-space: nowrap;
        transition: all 0.2s ease;
    }

    .product-selectors-refined .selector-reset .material-symbols-outlined {
        font-size: 18px;
        line-height: 1;
    }

    .product-selectors-refined .selector-reset:hover {
        border-color: #b91d20;
        background: #fff4dc;
        color: #2e0001;
    }

    .product-selectors-refined .selector-favorites {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        box-sizing: border-box;
        width: 100%;
        min-height: clamp(2.6rem, 2.8vw, 3rem);
        border: 1px solid #fecdd3;
        border-radius: clamp(0.5rem, 0.6vw, 0.7rem);
        background: #ffffff;
        color: #be123c;
        font-size: var(--public-font-control);
        font-weight: 800;
        padding: 0 clamp(0.75rem, 0.8vw, 1rem);
        white-space: nowrap;
        transition: all 0.2s ease;
    }

    .product-selectors-refined .selector-favorites .material-symbols-outlined {
        font-size: 18px;
        line-height: 1;
    }

    .product-selectors-refined .selector-favorites:hover,
    .product-selectors-refined .selector-favorites.is-active {
        border-color: #2e0001;
        background: #2e0001;
        color: #ffffff;
    }
</style>

<section class="product-selectors-refined" id="category-toolbar">
<div class="grid grid-cols-1 gap-4 @gridColumnsClass md:items-end">
    <div class="selector-field">
        <div class="selector-search-wrap">
            <span class="material-symbols-outlined selector-search-icon">search</span>
            <input id="products-quick-search" class="selector-search" type="search" placeholder="Tên sản phẩm, đơn vị, mã..." autocomplete="off" aria-label="Tìm kiếm nhanh" />
        </div>
    </div>

    <div class="selector-field">
        @if (lockCategorySelector)
        {
            <div class="selector-panel readonly">@(string.IsNullOrWhiteSpace(currentCategoryName) ? "Danh mục hiện tại" : currentCategoryName)</div>
        }
        else
        {
            <div class="selector-select-wrap">
                <span class="material-symbols-outlined selector-select-icon">category</span>
                <select id="products-category-select" aria-label="Danh mục">
                    <option value="" data-url="@allCategoriesUrl">Tất cả danh mục</option>
                    @foreach (var cat in categorySelectItems)
                    {
                        var catId = int.Parse(cat.Value, CultureInfo.InvariantCulture);
                        var catUrl = categorySeoUrls.GetValueOrDefault(catId, "#");
                        if (catId == currentCategoryId)
                        {
                            <option value="@cat.Value" data-url="@catUrl" selected>@cat.Text</option>
                        }
                        else
                        {
                            <option value="@cat.Value" data-url="@catUrl">@cat.Text</option>
                        }
                    }
                </select>
            </div>
        }
    </div>

    <div class="selector-field">
        <div class="selector-select-wrap">
            <span class="material-symbols-outlined selector-select-icon">store</span>
            <select id="products-manufacturer-select" aria-label="Đơn vị cung cấp">
                <option value="">Tất cả đơn vị</option>
                @foreach (var manufacturer in manufacturerSelectItems)
                {
                    var manufacturerId = int.Parse(manufacturer.Value, CultureInfo.InvariantCulture);
                    if (selectedManufacturerIds.Contains(manufacturerId))
                    {
                        <option value="@manufacturer.Value" selected>@manufacturer.Text</option>
                    }
                    else
                    {
                        <option value="@manufacturer.Value">@manufacturer.Text</option>
                    }
                }
            </select>
        </div>
    </div>

    <div class="selector-field">
        <div class="selector-select-wrap">
            <span class="material-symbols-outlined selector-select-icon">flag</span>
            <select id="products-status-filter" aria-label="Trạng thái">
                <option value="">Tất cả</option>
                <option value="available">Có sẵn</option>
                <option value="supplying">Đang cung ứng</option>
                <option value="preorder">Đặt trước</option>
            </select>
        </div>
    </div>
    @if (Model.AllowProductSorting)
    {
        <div class="product-sorting selector-field">
            @Html.DropDownList("products-orderby", Model.AvailableSortOptions, new { aria_label = T("Catalog.OrderBy.Label"), @class = "public-control-text selector-sort" })
        </div>
        <script asp-location="Footer">
            $(function() {
                var $orderByEl = $('#products-orderby');
                $orderByEl
                    .off('change.catalogSelectorsOrderBy')
                    .on('change.catalogSelectorsOrderBy', function () {
                        CatalogProducts.getProducts();
                    });

                $(CatalogProducts).off('before.catalogSelectorsOrderBy').on('before.catalogSelectorsOrderBy', function (e) {
                    e.payload.urlBuilder
                        .addParameter('orderby', $orderByEl.val());
                });
            });
        </script>
    }

    <div class="selector-field">
        <button type="button"
                class="selector-favorites @(Model.CanFilterByFavorites && Model.FavoritesOnly ? "is-active" : string.Empty)"
                id="products-favorites-filter"
                aria-label="Danh sách sản phẩm quan tâm"
                aria-pressed="@(Model.CanFilterByFavorites && Model.FavoritesOnly ? "true" : "false")">
            <span class="material-symbols-outlined">@(Model.CanFilterByFavorites && Model.FavoritesOnly ? "favorite" : "favorite_border")</span>
            <span>Quan tâm</span>
        </button>
    </div>

    <div class="selector-field">
        <button type="button" class="selector-reset" id="products-reset-filters" aria-label="Làm mới bộ lọc">
            <span class="material-symbols-outlined text-[18px]">restart_alt</span>
            <span>Làm mới bộ lọc</span>
        </button>
    </div>
</div>
</section>

<script asp-location="Footer">
    $(function() {
        var $quickSearch = $('#products-quick-search');
        var $categorySelect = $('#products-category-select');
        var $manufacturerSelect = $('#products-manufacturer-select');
        var $statusFilter = $('#products-status-filter');
        var $resetFiltersButton = $('#products-reset-filters');
        var $favoritesButton = $('#products-favorites-filter');
        var resetCategoryUrl = '@resetCategoryUrl';

        function normalizeForSearch(value) {
            var normalized = (value || '').toString().toLowerCase();
            if (!normalized) {
                return '';
            }

            normalized = normalized.replace(/đ/g, 'd');

            if (normalized.normalize) {
                normalized = normalized.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
            }

            return normalized.trim();
        }

        function applyLocalFilters() {
            var searchTerm = normalizeForSearch($quickSearch.val());
            var statusTerm = ($statusFilter.val() || '').toString().trim();
            var visibleCount = 0;

            $('.products-wrapper .item-box').each(function() {
                var $card = $(this).find('[data-product-search]').first();
                var haystack = normalizeForSearch($card.data('product-search'));
                var cardStatus = ($card.data('product-status') || '').toString();
                var matchSearch = searchTerm.length === 0 || haystack.indexOf(searchTerm) > -1;
                var matchStatus = statusTerm.length === 0 || cardStatus === statusTerm;
                var shouldShow = matchSearch && matchStatus;

                $(this).toggle(shouldShow);
                if (shouldShow) {
                    visibleCount++;
                }
            });

            $('#catalog-local-empty').toggleClass('hidden', visibleCount > 0);
        }

        @if (!lockCategorySelector)
        {
            <text>
            $categorySelect
                .off('change.catalogSelectors')
                .on('change.catalogSelectors', function() {
                    var url = $(this).find(':selected').data('url');
                    if (url && url !== '#') {
                        window.location.href = url;
                    }
                });
            </text>
            }
        
        $manufacturerSelect
            .off('change.catalogSelectors')
            .on('change.catalogSelectors', function() {
                CatalogProducts.getProducts();
            });

        $favoritesButton
            .off('click.catalogSelectors')
            .on('click.catalogSelectors', function() {
                var isActive = !$favoritesButton.hasClass('is-active');
                $favoritesButton.toggleClass('is-active', isActive);
                $favoritesButton.attr('aria-pressed', isActive ? 'true' : 'false');
                $favoritesButton.find('.material-symbols-outlined').text(isActive ? 'favorite' : 'favorite_border');
                $('#filter-favorites-only').prop('checked', isActive);
                CatalogProducts.getProducts();
            });

        $(CatalogProducts).off('before.catalogSelectors').on('before.catalogSelectors', function (e) {
            var selectedManufacturerId = ($manufacturerSelect.val() || '').toString();
            if (selectedManufacturerId.length > 0) {
                e.payload.urlBuilder.addParameter('ms', selectedManufacturerId);
            }

            if ($favoritesButton.length && $favoritesButton.hasClass('is-active')) {
                e.payload.urlBuilder.addParameter('favoritesOnly', true);
            }
        });

        $quickSearch.off('input.catalogSelectors').on('input.catalogSelectors', applyLocalFilters);
        $statusFilter.off('change.catalogSelectors').on('change.catalogSelectors', applyLocalFilters);
        if ($resetFiltersButton.length) {
            $resetFiltersButton.off('click.catalogSelectors').on('click.catalogSelectors', function() {
                if (resetCategoryUrl) {
                    window.location.href = resetCategoryUrl;
                    return;
                }

                $quickSearch.val('');
                $statusFilter.val('');
                $manufacturerSelect.val('');
                $favoritesButton.removeClass('is-active').attr('aria-pressed', 'false');
                $favoritesButton.find('.material-symbols-outlined').text('favorite_border');
                $('#filter-favorites-only').prop('checked', false);
                if ($categorySelect.length) {
                    $categorySelect.val('');
                }
                applyLocalFilters();
                CatalogProducts.getProducts();
            });
        }

        $(CatalogProducts).off('loaded.catalogSelectors').on('loaded.catalogSelectors', applyLocalFilters);
    });
</script>
