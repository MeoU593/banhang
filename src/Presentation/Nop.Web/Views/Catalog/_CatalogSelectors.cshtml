@model CatalogProductsModel

@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Rendering
@using Nop.Services.Catalog
@using Nop.Services.Seo
@using Nop.Services.Vendors
@using Nop.Core.Domain.Vendors

@inject ICategoryService categoryService
@inject IVendorService vendorService
@inject IUrlRecordService urlRecordService

@if (Model.Products.Count <= 0 &&
     !Model.PriceRangeFilter.Enabled &&
     !Model.SpecificationFilter.Enabled &&
     !Model.ManufacturerFilter.Enabled)
{
    return;
}

@{
    var lockCategorySelector = ViewData["LockCategorySelector"] as bool? ?? false;
    var currentCategoryName = (ViewData["CurrentCategoryName"] as string ?? string.Empty).Trim();

    var categorySelectItems = new List<SelectListItem>();
    var categorySeoUrls = new Dictionary<int, string>();
    if (!lockCategorySelector)
    {
        var allCategories = await categoryService.GetAllCategoriesAsync();
        categorySelectItems = allCategories
            .Select(cat => new SelectListItem { Text = cat.Name, Value = cat.Id.ToString() })
            .ToList();

        foreach (var cat in allCategories)
        {
            var seName = await urlRecordService.GetSeNameAsync(cat);
            if (!string.IsNullOrWhiteSpace(seName))
            {
                var catUrl = await NopUrl.RouteGenericUrlAsync<Nop.Core.Domain.Catalog.Category>(new { SeName = seName });
                categorySeoUrls[cat.Id] = catUrl;
            }
        }
    }

    var allVendors = await vendorService.GetAllVendorsAsync();
    var manufacturerSelectItems = allVendors
        .Select(v => new SelectListItem { Text = v.Name, Value = v.Id.ToString() })
        .ToList();

    var manufacturerSeoUrls = new Dictionary<int, string>();
    foreach (var vendor in allVendors)
    {
        var seName = await urlRecordService.GetSeNameAsync(vendor);
        if (!string.IsNullOrWhiteSpace(seName))
        {
            var manufacturerUrl = await NopUrl.RouteGenericUrlAsync<Vendor>(new { SeName = seName });
            manufacturerSeoUrls[vendor.Id] = manufacturerUrl;
        }
    }

}

<style>
    .product-selectors-refined {
        border: 1px solid rgba(196, 198, 204, 0.45);
        border-radius: 16px;
        background: #ffffff;
        padding: 16px;
        box-shadow: 0 22px 34px -30px rgba(15, 23, 42, 0.45);
    }

    .product-selectors-refined .selector-label {
        margin-bottom: 6px;
        display: block;
        color: #64748b;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        padding: 0 4px;
    }

    .product-selectors-refined .selector-panel,
    .product-selectors-refined .selector-search,
    .product-selectors-refined select {
        width: 100%;
        min-height: 44px;
        border: 1px solid #dbe3ef;
        border-radius: 10px;
        background: #edf4ff;
        padding: 0 12px;
        color: #141c24;
        font-size: 13px;
        font-weight: 600;
        outline: none;
        transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
    }

    .product-selectors-refined .selector-panel {
        display: flex;
        align-items: center;
        color: #334155;
    }

    .product-selectors-refined .selector-panel.readonly {
        font-weight: 700;
    }

    .product-selectors-refined .selector-search-wrap,
    .product-selectors-refined .selector-select-wrap {
        position: relative;
    }

    .product-selectors-refined .selector-search {
        padding-left: 38px;
    }

    .product-selectors-refined .selector-search-icon,
    .product-selectors-refined .selector-select-icon {
        pointer-events: none;
        position: absolute;
        top: 50%;
        left: 12px;
        transform: translateY(-50%);
        color: #64748b;
        font-size: 18px;
    }

    .product-selectors-refined .selector-select-wrap select {
        padding-left: 38px;
    }

    .product-selectors-refined .selector-search:focus,
    .product-selectors-refined select:focus {
        border-color: #2e0001;
        background: #ffffff;
        box-shadow: 0 0 0 3px rgba(46, 0, 1, 0.08);
    }

    .product-selectors-refined .selector-reset {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        width: 100%;
        min-height: 44px;
        border: 1px solid #dbe3ef;
        border-radius: 10px;
        background: #f8fbff;
        color: #475569;
        font-size: 13px;
        font-weight: 700;
        transition: all 0.2s ease;
    }

    .product-selectors-refined .selector-reset:hover {
        border-color: #c4c6cc;
        background: #f1f5f9;
        color: #141c24;
    }
</style>

<div class="product-selectors product-selectors-refined grid grid-cols-1 gap-4 md:grid-cols-5 md:items-end" id="category-toolbar">
    <div class="selector-field">
        <label class="selector-label" for="products-quick-search">Tìm kiếm nhanh</label>
        <div class="selector-search-wrap">
            <span class="material-symbols-outlined selector-search-icon">search</span>
            <input id="products-quick-search" class="selector-search" type="search" placeholder="Tên sản phẩm, đơn vị, mã..." autocomplete="off" />
        </div>
    </div>

    <div class="selector-field">
        <label class="selector-label" for="products-category-select">Danh mục</label>
        @if (lockCategorySelector)
        {
            <div class="selector-panel readonly">@(string.IsNullOrWhiteSpace(currentCategoryName) ? "Danh mục hiện tại" : currentCategoryName)</div>
        }
        else
        {
            <div class="selector-select-wrap">
                <span class="material-symbols-outlined selector-select-icon">category</span>
                <select id="products-category-select" aria-label="Danh mục">
                    <option value="">Tất cả danh mục</option>
                    @foreach (var cat in categorySelectItems)
                    {
                        var catId = int.Parse(cat.Value, CultureInfo.InvariantCulture);
                        var catUrl = categorySeoUrls.GetValueOrDefault(catId, "#");
                        <option value="@cat.Value" data-url="@catUrl">@cat.Text</option>
                    }
                </select>
            </div>
        }
    </div>

    <div class="selector-field">
        <label class="selector-label" for="products-manufacturer-select">Đơn vị cung cấp</label>
        <div class="selector-select-wrap">
            <span class="material-symbols-outlined selector-select-icon">store</span>
            <select id="products-manufacturer-select" aria-label="Đơn vị cung cấp">
                <option value="">Tất cả đơn vị</option>
                @foreach (var manufacturer in manufacturerSelectItems)
                {
                    var manufacturerId = int.Parse(manufacturer.Value, CultureInfo.InvariantCulture);
                    var manufacturerUrl = manufacturerSeoUrls.GetValueOrDefault(manufacturerId, "#");
                    <option value="@manufacturer.Value" data-url="@manufacturerUrl">@manufacturer.Text</option>
                }
            </select>
        </div>
    </div>

    <div class="selector-field">
        <label class="selector-label" for="products-status-filter">Trạng thái</label>
        <div class="selector-select-wrap">
            <span class="material-symbols-outlined selector-select-icon">flag</span>
            <select id="products-status-filter" aria-label="Trạng thái">
                <option value="">Tất cả</option>
                <option value="available">Có sẵn</option>
                <option value="supplying">Đang cung ứng</option>
                <option value="preorder">Đặt trước</option>
            </select>
        </div>
    </div>
    @if (Model.AllowProductSorting)
    {
        <div class="product-sorting selector-field">
            <label class="selector-label" for="products-orderby">Sắp xếp</label>
            @Html.DropDownList("products-orderby", Model.AvailableSortOptions, new { aria_label = T("Catalog.OrderBy.Label"), @class = "w-full border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm font-medium text-slate-700 outline-none transition focus:border-[#1152d4] focus:bg-white rounded-lg" })
        </div>
        <script asp-location="Footer">
            $(function() {
                var $orderByEl = $('#products-orderby');
                $orderByEl.on('change', function () {
                    CatalogProducts.getProducts();
                });

                $(CatalogProducts).on('before', function (e) {
                    e.payload.urlBuilder
                        .addParameter('orderby', $orderByEl.val());
                });
            });
        </script>
    }
    else
    {
        <div class="selector-field">
            <label class="selector-label" for="products-reset-filters">Bộ lọc</label>
            <button type="button" class="selector-reset" id="products-reset-filters" aria-label="Làm mới bộ lọc">
                <span class="material-symbols-outlined text-[18px]">restart_alt</span>
                <span>Làm mới bộ lọc</span>
            </button>
        </div>
    }
</div>

<script asp-location="Footer">
    $(function() {
        var $quickSearch = $('#products-quick-search');
        var $categorySelect = $('#products-category-select');
        var $manufacturerSelect = $('#products-manufacturer-select');
        var $statusFilter = $('#products-status-filter');
        var $resetFiltersButton = $('#products-reset-filters');

        function applyLocalFilters() {
            var searchTerm = ($quickSearch.val() || '').toString().toLowerCase().trim();
            var statusTerm = ($statusFilter.val() || '').toString().trim();

            $('.products-wrapper .item-box').each(function() {
                var $card = $(this).find('[data-product-search]').first();
                var haystack = ($card.data('product-search') || '').toString().toLowerCase();
                var cardStatus = ($card.data('product-status') || '').toString();
                var matchSearch = searchTerm.length === 0 || haystack.indexOf(searchTerm) > -1;
                var matchStatus = statusTerm.length === 0 || cardStatus === statusTerm;

                $(this).toggle(matchSearch && matchStatus);
            });
        }

        @if (!lockCategorySelector)
        {
            <text>
            $categorySelect.on('change', function() {
                var url = $(this).find(':selected').data('url');
                if (url && url !== '#') {
                    window.location.href = url;
                }
            });
            </text>
            }
        
        $manufacturerSelect.on('change', function() {
            var url = $(this).find(':selected').data('url');
            if (url && url !== '#') {
                window.location.href = url;
            }
        });

        $quickSearch.on('input', applyLocalFilters);
        $statusFilter.on('change', applyLocalFilters);
        if ($resetFiltersButton.length) {
            $resetFiltersButton.on('click', function() {
                $quickSearch.val('');
                $statusFilter.val('');
                applyLocalFilters();
            });
        }

        $(CatalogProducts).on('loaded', applyLocalFilters);
    });
</script>
