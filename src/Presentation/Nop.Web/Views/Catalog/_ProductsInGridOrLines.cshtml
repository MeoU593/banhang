@model CatalogProductsModel

<style>
    .catalog-products-refined .catalog-grid {
        display: grid;
        gap: clamp(0.875rem, 1.4vw, 1.25rem);
        grid-template-columns: repeat(1, minmax(0, 1fr));
    }

    .catalog-products-refined .product-grid,
    .catalog-products-refined .product-list {
        margin: 0;
    }

    .catalog-products-refined .item-grid.catalog-grid {
        width: 100%;
    }

    .catalog-products-refined .item-box {
        float: none;
        width: 100%;
        margin: 0;
    }

    .catalog-products-refined .product-list .item-box {
        margin: 0;
    }

    .catalog-products-refined .product-list .item-box .picture {
        float: none;
        width: 100%;
        margin: 0;
    }

    .catalog-products-refined .product-list .item-box .picture + .details {
        margin: 0;
    }

    .catalog-products-refined .product-list .item-box .product-item::after {
        display: none;
    }

    .catalog-products-refined .product-list .item-box .product-title {
        padding: 0;
        font-size: inherit;
    }

    .catalog-products-refined .product-list .item-box .description {
        margin: 0;
        line-height: inherit;
    }

    .catalog-products-refined .product-list .item-box .buttons {
        margin-top: auto;
    }

    .catalog-products-refined .catalog-pagination-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: clamp(0.75rem, 1vw, 1rem);
        border: 1px solid #dbe3ef;
        border-radius: clamp(0.8rem, 1vw, 1.1rem);
        background: #ffffff;
        padding: clamp(0.75rem, 0.9vw, 1rem) clamp(0.875rem, 1.1vw, 1.25rem);
        box-shadow: 0 1.2vw 2.2vw -2vw rgba(15, 23, 42, 0.45);
    }

    .catalog-products-refined .catalog-pagination-summary {
        margin: 0;
        color: #475569;
        font-size: var(--public-font-meta);
        font-weight: 700;
    }

    .catalog-products-refined .catalog-pagination-legend {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: clamp(0.55rem, 0.7vw, 0.8rem);
    }

    .catalog-products-refined .legend-item {
        display: inline-flex;
        align-items: center;
        gap: clamp(0.3rem, 0.45vw, 0.55rem);
        border-radius: 999px;
        background: #f8fafc;
        padding: clamp(0.25rem, 0.35vw, 0.375rem) clamp(0.625rem, 0.75vw, 0.875rem);
        color: #475569;
        font-size: var(--public-font-label);
        font-weight: 700;
    }

    .catalog-products-refined .legend-dot {
        width: 7px;
        height: 7px;
        border-radius: 999px;
    }

    .catalog-products-refined .pager {
        margin: 0;
    }

    .catalog-products-refined .pager ul {
        display: flex;
        align-items: center;
        gap: 4px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .catalog-products-refined .pager li {
        margin: 0;
    }

    .catalog-products-refined .pager a,
    .catalog-products-refined .pager span {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: clamp(2rem, 2.2vw, 2.4rem);
        min-height: clamp(2rem, 2.2vw, 2.4rem);
        padding: 0 clamp(0.55rem, 0.7vw, 0.8rem);
        border: 1px solid #e2e8f0;
        border-radius: clamp(0.55rem, 0.7vw, 0.8rem);
        background: transparent;
        color: #475569;
        font-size: var(--public-font-meta);
        font-weight: 700;
        text-decoration: none;
        transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }

    .catalog-products-refined .pager a:hover {
        background: #f8fafc;
        color: #0f172a;
        border-color: #dbe3ef;
    }

    .catalog-products-refined .pager .current-page span {
        border-color: #b91d20;
        background: #b91d20;
        color: #ffffff;
    }

    .catalog-products-refined .pager .individual-page a,
    .catalog-products-refined .pager .next-page a,
    .catalog-products-refined .pager .previous-page a,
    .catalog-products-refined .pager .first-page a,
    .catalog-products-refined .pager .last-page a {
        border-color: #e2e8f0;
        background: #ffffff;
    }

    .catalog-products-refined .catalog-empty {
        border: 2px dashed #c4c6cc;
        border-radius: clamp(0.9rem, 1.1vw, 1.25rem);
        background: #f8fafc;
        padding: clamp(2rem, 3vw, 3rem) clamp(1rem, 1.2vw, 1.25rem);
        text-align: center;
    }

    .catalog-products-refined .catalog-empty .material-symbols-outlined {
        color: #94a3b8;
        font-size: 36px;
        margin-bottom: 8px;
    }

    @@media (min-width: 768px) {
        .catalog-products-refined .catalog-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (min-width: 1024px) {
        .catalog-products-refined .catalog-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (min-width: 1280px) {
        .catalog-products-refined .catalog-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    @@media (max-width: 767px) {
        .catalog-products-refined .catalog-pagination-row {
            padding: clamp(0.875rem, 2vw, 1.25rem);
        }

        .catalog-products-refined .catalog-pagination-summary {
            width: 100%;
        }
    }
</style>

@if (!string.IsNullOrEmpty(Model.WarningMessage))
{
    <div class="warning public-body-text mb-4 border border-amber-200 bg-amber-50 px-4 py-3 font-medium text-amber-800">
        @Model.WarningMessage
    </div>
}

@if (Model.Products.Count > 0)
{
    var paginationSummaryLabel = ViewData["PaginationSummaryLabel"] as string ?? "sản phẩm trong danh mục này";
    var availableCount = Model.Products.Count(product => !product.ProductPrice.DisableBuyButton && !product.ProductPrice.AvailableForPreOrder);
    var supplyingCount = Model.Products.Count(product => product.ProductPrice.DisableBuyButton && !product.ProductPrice.AvailableForPreOrder);
    var preOrderCount = Model.Products.Count(product => product.ProductPrice.AvailableForPreOrder);

    <div class="catalog-products-refined space-y-6">
        <div class="@(Model.ViewMode == "list" ? "product-list" : "product-grid")">
            <div class="item-grid catalog-grid @(Model.ViewMode == "list" ? "grid-cols-1" : string.Empty)">
                @foreach (var product in Model.Products)
                {
                    <div class="item-box h-full">
                        @await Html.PartialAsync("_ProductBox", product)
                    </div>
                }
            </div>
        </div>

        <div id="catalog-local-empty" class="catalog-empty hidden">
            <span class="material-symbols-outlined">restaurant</span>
            <div class="public-card-title font-bold tracking-tight text-slate-900">Không có sản phẩm trùng khớp bộ lọc</div>
            <div class="public-body-text mt-2 text-slate-500">Thử bỏ chọn bớt điều kiện lọc hoặc làm mới bộ lọc để xem lại danh sách.</div>
        </div>

        @{
            var pager = Html.Pager(Model)
                .QueryParam("pagenumber")
                .BooleanParameterName("advs")
                .BooleanParameterName("isc")
                .BooleanParameterName("sid")
                .RenderEmptyParameters(true);
        }

        @if (!await pager.IsEmpty())
        {
            <div class="catalog-pagination-row">
                <p class="catalog-pagination-summary">Hiển thị @Model.FirstItem-@Model.LastItem trong số @Model.TotalItems @paginationSummaryLabel (Trang @Model.PageNumber/@Model.TotalPages)</p>
                <div class="catalog-pagination-legend">
                    <span class="legend-item"><span class="legend-dot bg-emerald-500"></span> @availableCount Có sẵn</span>
                    <span class="legend-item"><span class="legend-dot bg-orange-500"></span> @supplyingCount Đang cung ứng</span>
                    @if (preOrderCount > 0)
                    {
                        <span class="legend-item"><span class="legend-dot bg-amber-500"></span> @preOrderCount Đặt trước</span>
                    }
                </div>
                <div class="pager">
                    @pager
                </div>
            </div>
        }
    </div>
}
else if (!string.IsNullOrEmpty(Model.NoResultMessage))
{
    <div class="catalog-products-refined">
        <div class="catalog-empty">
            <span class="material-symbols-outlined">restaurant</span>
            <div class="public-card-title font-bold tracking-tight text-slate-900">Không tìm thấy sản phẩm phù hợp</div>
        <div class="public-body-text mt-2 text-slate-500">
            @Model.NoResultMessage
        </div>
        </div>
    </div>
}
