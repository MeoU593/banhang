@model VendorModel

@{
    Layout = "_ColumnsOne";

    NopHtml.AddTitleParts(!string.IsNullOrWhiteSpace(Model.MetaTitle) ? Model.MetaTitle : Model.Name);
    NopHtml.AddMetaDescriptionParts(Model.MetaDescription);
    NopHtml.AddMetaKeywordParts(Model.MetaKeywords);
    NopHtml.AppendPageCssClassParts("html-unit-detail-page");
}

@section Breadcrumb
{
    <nav class="public-breadcrumb flex flex-wrap items-center gap-2 text-slate-500" aria-label="Breadcrumb">
        <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="transition hover:text-military-green">Trang chủ</a>
        <span class="material-symbols-outlined text-sm text-slate-400">chevron_right</span>
        <a href="@Url.RouteUrl(NopRouteNames.General.UNITS)" class="transition hover:text-military-green">Danh sách đơn vị</a>
        <span class="material-symbols-outlined text-sm text-slate-400">chevron_right</span>
        <span class="text-slate-700">@Model.Name</span>
    </nav>
}

<div class="page unit-detail-page public-page-shell public-page-stack">
<div class="page-body w-full public-page-stack">
    @Html.AntiForgeryToken()
    <section class="public-blue-hero unit-detail-hero">
        <div class="public-blue-hero-content unit-detail-hero-content">
            <div class="public-blue-hero-copy flex items-center gap-5">
                <div class="flex h-28 w-28 items-center justify-center rounded-2xl border border-sky-200 bg-white/70 p-3 shadow-sm backdrop-blur">
                    @if (!string.IsNullOrWhiteSpace(Model.PictureModel.ImageUrl))
                    {
                        <img src="@Model.PictureModel.ImageUrl" alt="@Model.PictureModel.AlternateText" title="@Model.PictureModel.Title" class="h-full w-full rounded-xl object-cover" />
                    }
                </div>
                <div>
                    <h1 class="public-hero-title public-blue-hero-title font-black tracking-tight">@Model.Name</h1>
                </div>
            </div>
            <div class="public-blue-hero-stats sm:grid-cols-2">
                <div class="public-blue-hero-stat">
                    <p class="public-label-text uppercase tracking-[0.14em]">Sản phẩm</p>
                    <p class="public-stat-value mt-1 font-black">@Model.NumberOfProducts</p>
                </div>
                <div class="public-blue-hero-stat">
                    <p class="public-label-text uppercase tracking-[0.14em]">Trạng thái</p>
                    <p class="public-control-text mt-1 font-black uppercase">@(Model.Active ? "Hoạt động" : "Tạm dừng")</p>
                </div>
            </div>
        </div>
    </section>

    <div class="flex flex-wrap items-center justify-end gap-3">
        <a href="@Url.RouteUrl(NopRouteNames.General.UNITS)" class="public-control-text inline-flex h-10 items-center justify-center rounded-xl border border-slate-200 bg-white px-4 font-semibold text-slate-700 shadow-sm transition hover:border-military-green hover:text-military-green">
            Quay lại danh sách đơn vị
        </a>
    </div>

    <div class="grid grid-cols-1 gap-6 xl:grid-cols-12">
        <section class="xl:col-span-8 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
            <div class="mb-5 flex items-center gap-3">
                <span class="h-8 w-1.5 rounded-full bg-amber-500"></span>
                <h2 class="public-section-title font-black uppercase tracking-tight text-slate-900">Lịch sử và sứ mệnh</h2>
            </div>
            @if (string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="public-body-text rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-5 text-slate-500">Nội dung giới thiệu đơn vị chưa được cập nhật.</p>
            }
            else
            {
                <div class="prose max-w-none prose-p:text-slate-600 prose-p:leading-relaxed prose-headings:text-slate-900">
                    @Html.Raw(Model.Description)
                </div>
            }
        </section>

        <aside class="xl:col-span-4 space-y-6">
            <section class="rounded-3xl bg-sky-700 p-6 text-white shadow-lg">
                <h2 class="public-card-title flex items-center gap-2 font-black uppercase tracking-tight">
                    <span class="material-symbols-outlined">analytics</span>
                    Năng lực hậu cần
                </h2>
                <div class="mt-6 space-y-4">
                    <div class="flex items-center justify-between border-b border-sky-500 pb-3">
                        <span class="public-label-text uppercase tracking-[0.16em] text-sky-100">Đơn vị trực thuộc</span>
                        <span class="public-stat-value font-black">@Model.ChildUnits.Count</span>
                    </div>
                    <div class="flex items-center justify-between border-b border-sky-500 pb-3">
                        <span class="public-label-text uppercase tracking-[0.16em] text-sky-100">Sản phẩm quản lý</span>
                        <span class="public-stat-value font-black">@Model.NumberOfProducts</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="public-label-text uppercase tracking-[0.16em] text-sky-100">Trực thuộc</span>
                        <span class="public-meta-text max-w-[55%] text-right font-bold">@(string.IsNullOrWhiteSpace(Model.ParentName) ? "BTL TTG" : Model.ParentName)</span>
                    </div>
                </div>
            </section>

            <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <h2 class="public-card-title flex items-center gap-2 font-black uppercase tracking-tight text-slate-900">
                    <span class="material-symbols-outlined text-sky-600">domain</span>
                    Hồ sơ đơn vị
                </h2>
                <dl class="public-body-text mt-5 space-y-3">
                    <div class="flex items-center justify-between gap-3 rounded-xl bg-slate-50 px-4 py-3">
                        <dt class="text-slate-500">Email</dt>
                        <dd class="max-w-[65%] break-all text-right font-bold text-slate-900">@(string.IsNullOrWhiteSpace(Model.Email) ? "Đang cập nhật" : Model.Email)</dd>
                    </div>
                </dl>
            </section>

            <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <h2 class="public-card-title flex items-center gap-2 font-black uppercase tracking-tight text-slate-900">
                    <span class="material-symbols-outlined text-sky-600">contact_support</span>
                    Liên hệ đơn vị
                </h2>
                <div class="public-body-text mt-4 rounded-2xl bg-slate-50 p-4 text-slate-600">
                    <p class="font-semibold text-slate-900">Phụ trách hiện tại</p>
                    <p id="unit-contact-current" class="mt-1">@(string.IsNullOrWhiteSpace(Model.ContactCustomerName) ? "Chưa thiết lập" : Model.ContactCustomerName)</p>
                </div>

                @if (Model.CanManageContactCustomer)
                {
                    <form id="unit-contact-assignment-form" class="mt-4 space-y-3">
                        <label for="unit-contact-customer-id" class="public-label-text block font-bold uppercase tracking-[0.16em] text-slate-500">Gán phụ trách liên hệ</label>
                        <select id="unit-contact-customer-id" name="contactCustomerId" class="public-control-text h-11 w-full rounded-xl border border-slate-200 bg-white px-3 font-semibold text-slate-700 outline-none transition focus:border-military-green">
                            <option value="0">Chưa thiết lập</option>
                            @foreach (var candidate in Model.ContactCandidates)
                            {
                                <option value="@candidate.Id" selected="@(candidate.Id == Model.ContactCustomerId)">@candidate.DisplayName</option>
                            }
                        </select>
                        <button type="submit" class="public-control-text inline-flex h-10 items-center justify-center rounded-xl bg-military-green px-4 font-bold text-white transition hover:bg-[#23301b]">Lưu phụ trách</button>
                        <p id="unit-contact-assignment-status" class="public-meta-text font-semibold text-slate-500"></p>
                    </form>
                }
            </section>
        </aside>
    </div>

    <section class="unit-products-section rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
            <h2 class="public-section-title font-black uppercase tracking-tight text-slate-900">Tin hoạt động của đơn vị</h2>
            <a href="@Url.RouteUrl(NopRouteNames.Standard.BLOG_NEWS, new { VendorId = Model.Id })" class="public-control-text inline-flex h-10 items-center rounded-xl border border-slate-200 px-4 font-semibold text-slate-600 transition hover:border-military-green hover:text-military-green">Xem tất cả</a>
        </div>

        @if (!Model.ActivityPosts.Any())
        {
            <p class="public-body-text rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-5 text-slate-500">Đơn vị hiện chưa có tin hoạt động.</p>
        }
        else
        {
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
                @foreach (var post in Model.ActivityPosts)
                {
                    var postUrl = Url.RouteUrl(NopRouteNames.Standard.BLOG_NEWS_POST, new { SeName = post.SeName }) ?? await NopUrl.RouteGenericUrlAsync<Nop.Core.Domain.Blogs.BlogPost>(new { SeName = post.SeName });
                    <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                        <a href="@postUrl" class="block aspect-[16/9] bg-slate-100">
                            @if (!string.IsNullOrWhiteSpace(post.ThumbnailImageUrl))
                            {
                                <img src="@post.ThumbnailImageUrl" alt="@post.Title" class="h-full w-full object-cover" />
                            }
                            else
                            {
                                <div class="public-label-text flex h-full w-full items-center justify-center font-semibold uppercase tracking-[0.12em] text-slate-400">Tin hoạt động</div>
                            }
                        </a>
                        <div class="p-4">
                            <p class="public-meta-text font-semibold text-slate-500">@post.CreatedOn.ToString("dd/MM/yyyy")</p>
                            <h3 class="public-list-title mt-2 line-clamp-2 font-black text-slate-900">
                                <a href="@postUrl" class="transition hover:text-military-green">@post.Title</a>
                            </h3>
                            <div class="public-body-text mt-2 line-clamp-2 text-slate-500">@Html.Raw(!string.IsNullOrWhiteSpace(post.BodyOverview) ? post.BodyOverview : post.Body)</div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
            <h2 class="public-section-title font-black uppercase tracking-tight text-slate-900">Đơn vị trực thuộc</h2>
            <span class="public-meta-text inline-flex items-center rounded-full bg-slate-100 px-3 py-1 font-semibold text-slate-600">@Model.ChildUnits.Count đơn vị</span>
        </div>

        @if (Model.ChildUnits.Count == 0)
        {
            <p class="public-body-text rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-5 text-slate-500">Đơn vị hiện tại chưa có đơn vị trực thuộc.</p>
        }
        else
        {
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
                @foreach (var child in Model.ChildUnits)
                {
                    var childDetailUrl = Url.RouteUrl(NopRouteNames.General.UNIT_DETAILS, new { vendorId = child.Id });

                    <article class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                        <div class="flex items-start gap-4">
                            <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-slate-100">
                                @if (!string.IsNullOrWhiteSpace(child.PictureModel.ImageUrl))
                                {
                                    <img src="@child.PictureModel.ImageUrl" alt="@child.PictureModel.AlternateText" class="h-12 w-12 rounded-lg object-cover" />
                                }
                            </div>
                            <div class="min-w-0 flex-1">
                                <h3 class="unit-child-title truncate font-black text-slate-900">
                                    <a href="@childDetailUrl" class="transition hover:text-military-green">@child.Name</a>
                                </h3>
                                <p class="public-label-text mt-1 font-semibold uppercase tracking-[0.16em] text-slate-500">Đơn vị trực thuộc</p>
                                <p class="public-meta-text mt-2 text-slate-500">@child.NumberOfProducts sản phẩm</p>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
            <h2 class="public-section-title font-black uppercase tracking-tight text-slate-900">Sản phẩm và năng lực của đơn vị</h2>
        </div>

        @{
            var catalogProductsViewData = new ViewDataDictionary(ViewData)
            {
                ["fetchUrl"] = Html.Raw(Url.RouteUrl(NopRouteNames.Ajax.GET_VENDOR_PRODUCTS, new { vendorId = Model.Id }))
            };
        }
        @await Html.PartialAsync("_CatalogProducts", Model.CatalogProductsModel, catalogProductsViewData)
    </section>
</div>

</div>

<script asp-location="Footer">
    $(function () {
        const vendorId = @Model.Id;
        const assignmentUrl = '@Url.Action("UpdateUnitContactCustomer", "Catalog")';

        function setStatus($target, message, isError) {
            $target.text(message || '').toggleClass('text-rose-600', !!isError).toggleClass('text-emerald-700', !isError && !!message);
        }

        $('#unit-contact-assignment-form').on('submit', function (event) {
            event.preventDefault();
            const postData = {
                vendorId,
                contactCustomerId: $('#unit-contact-customer-id').val()
            };
            addAntiForgeryToken(postData);

            const $status = $('#unit-contact-assignment-status');
            setStatus($status, 'Đang lưu...', false);

            $.post(assignmentUrl, postData)
                .done(function (response) {
                    if (!response || !response.success) {
                        setStatus($status, response && response.message ? response.message : 'Không lưu được phụ trách liên hệ.', true);
                        return;
                    }

                    $('#unit-contact-current').text(response.contactCustomerName || 'Chưa thiết lập');
                    setStatus($status, response.message || 'Đã lưu phụ trách liên hệ.', false);
                })
                .fail(function () {
                    setStatus($status, 'Không lưu được phụ trách liên hệ.', true);
                });
        });
    });
</script>
