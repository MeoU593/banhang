@model CatalogProductsModel

@{
    Layout = "_ColumnsOne";

    NopHtml.AddTitleParts("Sản phẩm / Năng lực");
    NopHtml.AppendPageCssClassParts("html-all-products-page");
}

<div class="page all-products-page bg-slate-100 px-4 py-6 lg:px-6 lg:py-8">
    <div class="page-body mx-auto w-full max-w-[1400px] space-y-6">
        <header class="overflow-hidden rounded-2xl border p-5 text-white shadow-[0_24px_60px_-35px_rgba(15,23,42,0.85)] sm:p-6" style="border-color: rgba(214,185,90,.28); background-color: rgba(33,45,27,.92); background-image: linear-gradient(120deg, #0f1a33 0%, #1f2b1a 52%, #314026 100%), repeating-linear-gradient(135deg, rgba(255,255,255,.05) 0, rgba(255,255,255,.05) 1px, transparent 1px, transparent 14px);">
            <nav class="mb-3 flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-slate-200" aria-label="Breadcrumb">
                <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="transition hover:text-white">Trang chủ</a>
                <span class="material-symbols-outlined text-sm text-slate-300">chevron_right</span>
                <span class="text-white">Sản phẩm / năng lực</span>
            </nav>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#f6dc9a]">Danh mục tổng hợp</p>
            <h1 class="public-hero-title mt-1.5 font-black tracking-tight text-white">Toàn bộ sản phẩm / năng lực</h1>
            <p class="mt-1.5 text-xs leading-5 text-slate-200 sm:text-sm">Danh sách dữ liệu tổng, có phân trang để tránh tràn dữ liệu khi số lượng sản phẩm lớn.</p>
        </header>

        <section class="space-y-5">
            <div class="sticky top-4 z-20 rounded-2xl bg-slate-100/90 pb-1 pt-1 backdrop-blur supports-[backdrop-filter]:bg-slate-100/75">
                @await Html.PartialAsync("_CatalogSelectors", Model)
            </div>

            @{
                var catalogProductsViewData = new ViewDataDictionary(ViewData)
                {
                    ["PaginationSummaryLabel"] = "sản phẩm trong hệ thống"
                };
            }

            @await Html.PartialAsync("_CatalogProducts", Model, catalogProductsViewData)
        </section>
    </div>
</div>
