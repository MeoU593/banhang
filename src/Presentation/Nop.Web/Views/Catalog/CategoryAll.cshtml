@model CatalogProductsModel

@{
    Layout = "_ColumnsOne";

    NopHtml.AddTitleParts("Sản phẩm / Năng lực");
    NopHtml.AppendPageCssClassParts("html-all-products-page");

    var postingUnitCount = Model.GetType().GetProperty("PostingUnitCount")?.GetValue(Model) as int? ?? 0;
}

@section Breadcrumb
{
    <nav class="public-breadcrumb flex flex-wrap items-center gap-2 text-slate-500" aria-label="Breadcrumb">
        <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="transition hover:text-military-green">Trang chủ</a>
        <span class="material-symbols-outlined text-sm text-slate-400">chevron_right</span>
        <span class="text-slate-700">Sản phẩm / năng lực</span>
    </nav>
}

<div class="page all-products-page bg-slate-100">
    <div class="page-body catalog-page-shell catalog-page-stack">
        <header class="public-blue-hero catalog-overview-hero">
            <div class="public-blue-hero-content">
                <div class="public-blue-hero-copy space-y-1.5">
                    <h1 class="public-hero-title public-blue-hero-title font-black tracking-tight">Toàn bộ sản phẩm / năng lực</h1>
                    <p class="public-hero-subtitle public-blue-hero-subtitle max-w-3xl">Tổng quan danh mục hậu cần, trang bị và năng lực phục vụ bảo đảm nhiệm vụ trong toàn hệ thống.</p>
                </div>
                <div class="public-blue-hero-stats catalog-overview-stats sm:grid-cols-2">
                    <div class="public-blue-hero-stat">
                        <p class="public-label-text font-bold uppercase tracking-[0.14em] text-amber-100">Tổng sản phẩm</p>
                        <p class="public-stat-value mt-1 font-black text-white">@Model.TotalItems</p>
                    </div>
                    <div class="public-blue-hero-stat">
                        <p class="public-label-text font-bold uppercase tracking-[0.14em] text-amber-100">Đơn vị đăng</p>
                        <p class="public-stat-value mt-1 font-black text-white">@postingUnitCount</p>
                    </div>
                </div>
            </div>
        </header>

        <section class="space-y-5">
            <div class="sticky top-4 z-20 rounded-2xl bg-slate-100/90 pb-1 pt-1 backdrop-blur supports-[backdrop-filter]:bg-slate-100/75">
                @await Html.PartialAsync("_CatalogSelectors", Model)
            </div>

            @{
                var catalogProductsViewData = new ViewDataDictionary(ViewData)
                {
                    ["PaginationSummaryLabel"] = "sản phẩm trong hệ thống"
                };
            }

            @await Html.PartialAsync("_CatalogProducts", Model, catalogProductsViewData)
        </section>
    </div>
</div>
