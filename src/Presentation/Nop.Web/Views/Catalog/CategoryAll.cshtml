@model CatalogProductsModel

@{
    Layout = "_ColumnsOne";

    NopHtml.AddTitleParts("Sản phẩm / Năng lực");
    NopHtml.AppendPageCssClassParts("html-all-products-page");
}

@section Breadcrumb
{
    <nav class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.14em] text-slate-500" aria-label="Breadcrumb">
        <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="transition hover:text-military-green">Trang chủ</a>
        <span class="material-symbols-outlined text-sm text-slate-400">chevron_right</span>
        <span class="text-slate-700">Sản phẩm / năng lực</span>
    </nav>
}

<div class="page all-products-page bg-slate-100 px-4 py-6 lg:px-6 lg:py-8">
    <div class="page-body mx-auto w-full max-w-[1400px] space-y-6">
        <header class="overflow-hidden rounded-2xl border border-[#d6b95a]/30 bg-[linear-gradient(120deg,#29313a_0%,#574500_52%,#8a6a2a_100%)] p-5 text-white shadow-[0_24px_60px_-35px_rgba(15,23,42,0.85)] sm:p-6">
            <div class="flex flex-wrap items-start justify-between gap-4">
                <div class="space-y-1.5">
                    <h1 class="public-hero-title font-black tracking-tight text-white">Toàn bộ sản phẩm / năng lực</h1>
                    <p class="max-w-3xl text-xs leading-5 text-slate-200 sm:text-sm">Danh sách dữ liệu tổng, có phân trang để tránh tràn dữ liệu khi số lượng sản phẩm lớn.</p>
                </div>
                <div class="rounded-xl border border-white/20 bg-white/10 px-4 py-3 text-center backdrop-blur">
                    <p class="text-[11px] uppercase tracking-[0.14em] text-slate-200">Sản phẩm</p>
                    <p class="mt-1 text-base font-black sm:text-lg">@Model.Products.Count</p>
                </div>
            </div>
        </header>

        <section class="space-y-5">
            <div class="sticky top-4 z-20 rounded-2xl bg-slate-100/90 pb-1 pt-1 backdrop-blur supports-[backdrop-filter]:bg-slate-100/75">
                @await Html.PartialAsync("_CatalogSelectors", Model)
            </div>

            @{
                var catalogProductsViewData = new ViewDataDictionary(ViewData)
                {
                    ["PaginationSummaryLabel"] = "sản phẩm trong hệ thống"
                };
            }

            @await Html.PartialAsync("_CatalogProducts", Model, catalogProductsViewData)
        </section>
    </div>
</div>
