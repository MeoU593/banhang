@model CatalogProductsModel

@if (!Model.PriceRangeFilter.Enabled &&
     !Model.SpecificationFilter.Enabled &&
     !Model.ManufacturerFilter.Enabled &&
     !Model.CanFilterByFavorites)
{
    return;
}

<style>
    .catalog-filter-shell {
        border: 1px solid #dbe3ef;
        border-radius: 18px;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
        padding: 14px;
        box-shadow: 0 14px 30px -26px rgba(15, 23, 42, 0.42);
    }

    .catalog-filter-shell .catalog-filter-heading {
        margin-bottom: 16px;
        color: #8a1114;
        font-size: var(--public-font-label);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.14em;
    }

    .catalog-filter-shell .product-filters {
        display: grid;
        gap: 16px;
    }

    .catalog-filter-shell .product-filter {
        border: 1px solid #dbe3ef;
        border-radius: 14px;
        background: #ffffff;
        overflow: hidden;
    }

    .catalog-filter-shell .filter-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 0;
        padding: 14px 16px;
        background: #fff7e6;
        color: #2e0001;
        font-size: var(--public-font-label);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        border-bottom: 1px solid #e2e8f0;
    }

    .catalog-filter-shell .filter-content {
        padding: 16px;
    }

    .catalog-filter-shell .group {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .catalog-filter-shell .group .name {
        margin-bottom: 10px;
        color: #0f172a;
        font-weight: 600;
    }

    .catalog-filter-shell .item {
        display: flex;
        gap: 10px;
        padding: 10px 0;
        border-bottom: 1px solid #eef2f7;
        color: #475569;
        border-radius: 10px;
        padding-inline: 8px;
    }

    .catalog-filter-shell .item:last-child {
        border-bottom: 0;
    }

    .catalog-filter-shell .item input {
        margin-top: 3px;
    }

    .catalog-filter-shell .item label {
        flex: 1;
        font-size: var(--public-font-control);
        line-height: 1.5;
        cursor: pointer;
        font-weight: 650;
    }

    .catalog-filter-shell .selected-price-range {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        padding: 12px 14px;
        border-radius: 12px;
        background: #fff7e6;
        color: #0f172a;
        font-size: var(--public-font-control);
        font-weight: 600;
    }
</style>

<section class="catalog-filter-shell block">
    <div class="catalog-filter-heading">Bộ lọc</div>

    <section class="product-filters">
        @if (Model.PriceRangeFilter.Enabled)
        {
            @await Html.PartialAsync("_FilterPriceBox", Model.PriceRangeFilter)
        }

        @if (Model.SpecificationFilter.Enabled)
        {
            @await Html.PartialAsync("_FilterSpecsBox", Model.SpecificationFilter)
        }

        @if (Model.ManufacturerFilter.Enabled)
        {
            @await Html.PartialAsync("_FilterManufacturerBox", Model.ManufacturerFilter)
        }

        @if (Model.CanFilterByFavorites)
        {
            <div class="product-filter product-favorites-filter">
                <h2 class="filter-title">Sản phẩm quan tâm</h2>
                <div class="filter-content">
                    <ul class="group">
                        <li class="item">
                            <input id="filter-favorites-only" type="checkbox" checked="@Model.FavoritesOnly" />
                            <label for="filter-favorites-only">Chỉ hiển thị sản phẩm quan tâm</label>
                        </li>
                    </ul>
                </div>
            </div>
        }
    </section>
</section>

<script asp-location="Footer">
    $(function() {
        $('.block .filter-title').off('click.catalogFilters').on('click.catalogFilters', function () {
            var e = window, a = 'inner';
            if (!('innerWidth' in window)) {
                a = 'client';
                e = document.documentElement || document.body;
            }
            var result = { width: e[a + 'Width'], height: e[a + 'Height'] };
            if (result.width < 1001) {
                $(this).siblings('.filter-content').slideToggle('slow');
            }
        });

        var $favoritesOnlyEl = $('#filter-favorites-only');
        $favoritesOnlyEl
            .off('change.catalogFilters')
            .on('change.catalogFilters', function () {
                CatalogProducts.getProducts();
            });

        $(CatalogProducts).off('before.catalogFilters').on('before.catalogFilters', function (e) {
            if ($favoritesOnlyEl.length && $favoritesOnlyEl.is(':checked')) {
                e.payload.urlBuilder.addParameter('favoritesOnly', true);
            }
        });
    });
</script>
