@model Nop.Web.Models.Catalog.SearchModel

@using Nop.Core.Domain.Blogs
@using Nop.Core.Domain.Catalog
@using Nop.Core.Domain.Vendors

@{
    Layout = "_ColumnsOne";

    NopHtml.AddTitleParts(T("PageTitle.Search").Text);
    NopHtml.AppendPageCssClassParts("html-search-page");

    string BuildSearchUrl(string type = null, int? productPage = null, int? unitPage = null, int? blogPage = null, int? documentPage = null)
    {
        return Url.RouteUrl(NopRouteNames.General.SEARCH, new
        {
            q = Model.q,
            type,
            ProductPage = productPage ?? Model.ProductPage,
            UnitPage = unitPage ?? Model.UnitPage,
            BlogPage = blogPage ?? Model.BlogPage,
            DocumentPage = documentPage ?? Model.DocumentPage
        }) ?? "#";
    }

    var hasProductResults = Model.ProductTotalCount > 0;
    var hasBlogResults = Model.BlogTotalCount > 0;
    var hasDocumentResults = Model.DocumentTotalCount > 0;
    var hasUnitResults = Model.UnitTotalCount > 0;

    bool ShouldRenderSection(bool isEnabled, bool hasAnyResults)
        => isEnabled && Model.HasQuery && (!Model.ShowAllSections || hasAnyResults);

    var showProductsSection = ShouldRenderSection(Model.ShowProductsSection, hasProductResults);
    var showBlogsSection = ShouldRenderSection(Model.ShowBlogsSection, hasBlogResults);
    var showDocumentsSection = ShouldRenderSection(Model.ShowDocumentsSection, hasDocumentResults);
    var showUnitsSection = ShouldRenderSection(Model.ShowUnitsSection, hasUnitResults);

    var totalResultCount = Model.ProductTotalCount + Model.BlogTotalCount + Model.DocumentTotalCount + Model.UnitTotalCount;
    var showGlobalEmptyState = Model.HasQuery && !showProductsSection && !showBlogsSection && !showDocumentsSection && !showUnitsSection;
    var showPopularSidebar = (Model.ShowBlogsSection && Model.TopBlogTags.Any()) || (Model.ShowDocumentsSection && Model.TopDocumentKeywords.Any());
    var resetTypeUrl = BuildSearchUrl(type: null, productPage: 1, unitPage: 1, blogPage: 1, documentPage: 1);
    var productTypeUrl = BuildSearchUrl(type: "products", productPage: 1, unitPage: 1, blogPage: 1, documentPage: 1);
    var newsTypeUrl = BuildSearchUrl(type: "news", productPage: 1, unitPage: 1, blogPage: 1, documentPage: 1);
    var documentTypeUrl = BuildSearchUrl(type: "documents", productPage: 1, unitPage: 1, blogPage: 1, documentPage: 1);
    var unitTypeUrl = BuildSearchUrl(type: "units", productPage: 1, unitPage: 1, blogPage: 1, documentPage: 1);
    const string resultCardBase = "group rounded-xl border px-3 py-2 text-center shadow-sm transition hover:-translate-y-0.5 hover:border-military-green hover:shadow-md";
    const string resultCardInactive = "border-slate-200 bg-white text-slate-700";
    const string resultCardActive = "border-military-green bg-military-green text-white";
}

<style>
    .search-page .catalog-products-refined .catalog-grid {
        display: grid;
        gap: 20px;
        grid-template-columns: repeat(1, minmax(0, 1fr));
    }

    .search-page .catalog-products-refined .product-grid {
        margin: 0;
    }

    .search-page .catalog-products-refined .item-grid.catalog-grid {
        width: 100%;
    }

    .search-page .catalog-products-refined .item-box {
        float: none;
        width: 100%;
        margin: 0;
    }

    .search-page .search-command-panel {
        display: grid;
        grid-template-columns: minmax(0, 36%) minmax(0, 1fr);
        align-items: stretch;
        gap: 1.2%;
    }

    .search-page .search-query-form {
        min-width: 0;
    }

    .search-page .search-query-shell {
        position: relative;
        min-width: 0;
        flex: 1 1 auto;
    }

    .search-page .search-query-shell .material-symbols-outlined {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        pointer-events: none;
    }

    .search-page .search-query-shell input {
        padding-left: 3rem !important;
    }

    @@media (max-width: 1279px) {
        .search-page .search-command-panel {
            grid-template-columns: 1fr;
            gap: 0.75rem;
        }
    }

    @@media (min-width: 768px) {
        .search-page .catalog-products-refined .catalog-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (min-width: 1024px) {
        .search-page .catalog-products-refined .catalog-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (min-width: 1280px) {
        .search-page .catalog-products-refined .catalog-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }
</style>

@section Breadcrumb
{
    <nav class="public-breadcrumb flex flex-wrap items-center gap-2 text-slate-500" aria-label="Breadcrumb">
        <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="transition hover:text-military-green">Trang chủ</a>
        <span class="material-symbols-outlined text-sm text-slate-400">chevron_right</span>
        <span class="text-slate-700">Tìm kiếm</span>
    </nav>
}

<div class="page search-page">
    <div class="page-body w-full space-y-6">
        <section class="public-blue-hero">
            <div class="public-blue-hero-content">
                <div class="public-blue-hero-copy space-y-1.5">
                    <h1 class="public-hero-title public-blue-hero-title font-black tracking-tight">Tìm kiếm toàn hệ thống</h1>
                    <p class="public-hero-subtitle public-blue-hero-subtitle max-w-3xl">Tìm trong sản phẩm, tin tức, văn bản kho tài liệu và đơn vị từ một giao diện thống nhất.</p>
                </div>
                <div class="public-blue-hero-stats">
                    <div class="public-blue-hero-stat">
                        <p class="public-label-text font-bold uppercase tracking-[0.14em]">Kết quả</p>
                        <p class="public-stat-value mt-1 font-black">@totalResultCount</p>
                    </div>
                </div>
            </div>
        </section>

        <div class="@(showPopularSidebar ? "grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_320px]" : "grid grid-cols-1 gap-6")">
            <div class="min-w-0 space-y-6">
                <section class="search-command-panel">
                    <form asp-route="@NopRouteNames.General.SEARCH" method="get" class="search-query-form flex min-w-0 flex-col gap-3 sm:flex-row">
                        <label class="search-query-shell block">
                            <span class="material-symbols-outlined text-[18px] text-slate-400">search</span>
                            <input asp-for="q" class="public-control-text h-11 w-full rounded-lg border border-slate-200 bg-white pl-12 pr-4 text-slate-700 outline-none transition focus:border-military-green focus:ring-2 focus:ring-military-green/10" placeholder="Nhập từ khóa sản phẩm, tin tức, văn bản, đơn vị..." />
                        </label>
                        <button type="submit" class="public-control-text inline-flex h-11 items-center justify-center gap-1.5 rounded-lg bg-[#2e0001] px-5 font-bold text-white transition hover:bg-[#550005]">
                            <span class="material-symbols-outlined text-[16px]">search</span>
                            Tìm kiếm
                        </button>
                    </form>

                    <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
                        <a href="@productTypeUrl" class="@($"{resultCardBase} {(string.Equals(Model.Type, "products", StringComparison.OrdinalIgnoreCase) ? resultCardActive : resultCardInactive)}")">
                            <div class="public-label-text font-black uppercase tracking-[0.14em]">Sản phẩm</div>
                            <div class="public-stat-value mt-1 font-black">@Model.ProductTotalCount</div>
                        </a>
                        <a href="@newsTypeUrl" class="@($"{resultCardBase} {(string.Equals(Model.Type, "news", StringComparison.OrdinalIgnoreCase) ? resultCardActive : resultCardInactive)}")">
                            <div class="public-label-text font-black uppercase tracking-[0.14em]">Tin tức</div>
                            <div class="public-stat-value mt-1 font-black">@Model.BlogTotalCount</div>
                        </a>
                        <a href="@documentTypeUrl" class="@($"{resultCardBase} {(string.Equals(Model.Type, "documents", StringComparison.OrdinalIgnoreCase) ? resultCardActive : resultCardInactive)}")">
                            <div class="public-label-text font-black uppercase tracking-[0.14em]">Văn bản</div>
                            <div class="public-stat-value mt-1 font-black">@Model.DocumentTotalCount</div>
                        </a>
                        <a href="@unitTypeUrl" class="@($"{resultCardBase} {(string.Equals(Model.Type, "units", StringComparison.OrdinalIgnoreCase) ? resultCardActive : resultCardInactive)}")">
                            <div class="public-label-text font-black uppercase tracking-[0.14em]">Đơn vị</div>
                            <div class="public-stat-value mt-1 font-black">@Model.UnitTotalCount</div>
                        </a>
                    </div>
                </section>

        @if (!Model.ShowAllSections)
        {
            <a href="@resetTypeUrl" class="public-control-text inline-flex items-center gap-1.5 font-semibold text-military-green hover:underline">
                <span class="material-symbols-outlined text-[16px]">arrow_back</span>
                Quay lại kết quả tổng hợp
            </a>
        }

        @if (!Model.HasQuery)
        {
            <div class="flex flex-col items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-16 text-center">
                <span class="material-symbols-outlined mb-3 text-5xl text-slate-400">manage_search</span>
                <h2 class="public-card-title font-bold text-slate-900">Nhập từ khóa để bắt đầu tìm kiếm</h2>
                <p class="public-body-text mt-2 max-w-xl text-slate-500">Bạn có thể tìm theo tên sản phẩm, mã văn bản, tiêu đề tin tức hoặc tên đơn vị.</p>
            </div>
        }
        else
        {
            @if (showGlobalEmptyState)
            {
                <div class="flex flex-col items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-16 text-center">
                    <span class="material-symbols-outlined mb-3 text-5xl text-slate-400">search_off</span>
                    <h2 class="public-card-title font-bold text-slate-900">Không tìm thấy kết quả phù hợp</h2>
                    <p class="public-body-text mt-2 max-w-xl text-slate-500">Thử rút gọn từ khóa hoặc dùng từ đồng nghĩa để mở rộng phạm vi tìm kiếm.</p>
                </div>
            }

            @if (showProductsSection)
            {
                <section class="space-y-4">
                    <div class="flex items-center justify-between gap-4">
                        <h2 class="public-section-title font-black tracking-tight text-slate-900">Sản phẩm (@Model.ProductTotalCount)</h2>
                        @if (Model.ShowAllSections && Model.ProductTotalCount > Model.ProductPageSize)
                        {
                            <a href="@BuildSearchUrl(type: "products", productPage: 1)" class="public-control-text font-semibold text-military-green hover:underline">Xem tất cả</a>
                        }
                    </div>

                    @if (!Model.ProductResults.Any())
                    {
                        <div class="public-body-text rounded-xl border border-dashed border-slate-300 bg-slate-50 px-6 py-8 text-slate-600">Không có sản phẩm phù hợp.</div>
                    }
                    else
                    {
                        <div class="catalog-products-refined">
                            <div class="product-grid">
                                <div class="item-grid catalog-grid">
                                    @foreach (var product in Model.ProductResults)
                                    {
                                        <div class="item-box h-full">
                                            @await Html.PartialAsync("_ProductBox", product)
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (Model.ProductTotalPages > 1)
                    {
                        <div class="flex flex-wrap items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white p-3 shadow-sm">
                            @if (Model.ProductPage > 1)
                            {
                                <a href="@BuildSearchUrl(type: Model.Type, productPage: Model.ProductPage - 1)" class="public-control-text inline-flex h-9 items-center rounded-lg border border-slate-200 px-3 font-semibold text-slate-600 transition hover:border-military-green hover:text-military-green">Trước</a>
                            }
                            @for (var pageNumber = 1; pageNumber <= Model.ProductTotalPages; pageNumber++)
                            {
                                var pageClass = pageNumber == Model.ProductPage
                                    ? "public-control-text inline-flex h-9 min-w-[36px] items-center justify-center rounded-lg bg-military-green px-3 font-bold text-white"
                                    : "public-control-text inline-flex h-9 min-w-[36px] items-center justify-center rounded-lg border border-slate-200 px-3 font-semibold text-slate-600 transition hover:border-military-green hover:text-military-green";
                                <a href="@BuildSearchUrl(type: Model.Type, productPage: pageNumber)" class="@pageClass">@pageNumber</a>
                            }
                            @if (Model.ProductPage < Model.ProductTotalPages)
                            {
                                <a href="@BuildSearchUrl(type: Model.Type, productPage: Model.ProductPage + 1)" class="public-control-text inline-flex h-9 items-center rounded-lg border border-slate-200 px-3 font-semibold text-slate-600 transition hover:border-military-green hover:text-military-green">Sau</a>
                            }
                        </div>
                    }
                </section>
            }

            @if (showBlogsSection)
            {
                <section class="space-y-4">
                    <div class="flex items-center justify-between gap-4">
                        <h2 class="public-section-title font-black tracking-tight text-slate-900">Tin tức (@Model.BlogTotalCount)</h2>
                        @if (Model.ShowAllSections && Model.BlogTotalCount > Model.BlogPageSize)
                        {
                            <a href="@BuildSearchUrl(type: "news", blogPage: 1)" class="public-control-text font-semibold text-military-green hover:underline">Xem tất cả</a>
                        }
                    </div>

                    @if (!Model.BlogResults.Any())
                    {
                        <div class="public-body-text rounded-xl border border-dashed border-slate-300 bg-slate-50 px-6 py-8 text-slate-600">Không có tin tức phù hợp.</div>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var post in Model.BlogResults)
                            {
                                var postUrl = !string.IsNullOrWhiteSpace(post.Url)
                                    ? post.Url
                                    : await NopUrl.RouteGenericUrlAsync<BlogPost>(new { SeName = post.SeName });
                                var badgeText = post.PostTypeId == 1 ? "Văn bản" : "Tin tức";
                                var badgeClass = post.PostTypeId == 1
                                    ? "bg-amber-50 text-amber-700"
                                    : "bg-blue-50 text-blue-700";

                                <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:shadow-md">
                                    <div class="flex items-start gap-3">
                                        <span class="material-symbols-outlined mt-0.5 text-military-green">newspaper</span>
                                        <div class="min-w-0 flex-1">
                                            <div class="mb-1.5 flex flex-wrap items-center gap-2">
                                                <span class="public-label-text rounded px-2 py-0.5 font-bold uppercase tracking-wider @badgeClass">@badgeText</span>
                                                <span class="public-meta-text text-slate-500">@post.CreatedOnUtc.ToString("dd/MM/yyyy")</span>
                                            </div>
                                            <h3 class="public-list-title font-bold text-slate-900">
                                                <a href="@postUrl" class="hover:text-military-green">@post.Title</a>
                                            </h3>
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    }

                    @if (Model.BlogTotalPages > 1)
                    {
                        <div class="flex flex-wrap items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white p-3 shadow-sm">
                            @if (Model.BlogPage > 1)
                            {
                                <a href="@BuildSearchUrl(type: Model.Type, blogPage: Model.BlogPage - 1)" class="public-control-text inline-flex h-9 items-center rounded-lg border border-slate-200 px-3 font-semibold text-slate-600 transition hover:border-military-green hover:text-military-green">Trước</a>
                            }
                            @for (var pageNumber = 1; pageNumber <= Model.BlogTotalPages; pageNumber++)
                            {
                                var pageClass = pageNumber == Model.BlogPage
                                    ? "public-control-text inline-flex h-9 min-w-[36px] items-center justify-center rounded-lg bg-military-green px-3 font-bold text-white"
                                    : "public-control-text inline-flex h-9 min-w-[36px] items-center justify-center rounded-lg border border-slate-200 px-3 font-semibold text-slate-600 transition hover:border-military-green hover:text-military-green";
                                <a href="@BuildSearchUrl(type: Model.Type, blogPage: pageNumber)" class="@pageClass">@pageNumber</a>
                            }
                            @if (Model.BlogPage < Model.BlogTotalPages)
                            {
                                <a href="@BuildSearchUrl(type: Model.Type, blogPage: Model.BlogPage + 1)" class="public-control-text inline-flex h-9 items-center rounded-lg border border-slate-200 px-3 font-semibold text-slate-600 transition hover:border-military-green hover:text-military-green">Sau</a>
                            }
                        </div>
                    }
                </section>
            }

            @if (showDocumentsSection)
            {
                <section class="space-y-4">
                    <div class="flex items-center justify-between gap-4">
                        <h2 class="public-section-title font-black tracking-tight text-slate-900">Văn bản kho tài liệu (@Model.DocumentTotalCount)</h2>
                        @if (Model.ShowAllSections && Model.DocumentTotalCount > Model.DocumentPageSize)
                        {
                            <a href="@BuildSearchUrl(type: "documents", documentPage: 1)" class="public-control-text font-semibold text-military-green hover:underline">Xem tất cả</a>
                        }
                    </div>

                    @if (!Model.DocumentResults.Any())
                    {
                        <div class="public-body-text rounded-xl border border-dashed border-slate-300 bg-slate-50 px-6 py-8 text-slate-600">Không có văn bản phù hợp.</div>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var document in Model.DocumentResults)
                            {
                                var documentUrl = !string.IsNullOrWhiteSpace(document.Slug)
                                    ? $"/tai-lieu/{document.Slug}"
                                    : "/tai-lieu";

                                <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:shadow-md">
                                    <div class="flex items-start gap-3">
                                        <span class="material-symbols-outlined mt-0.5 text-military-green">description</span>
                                        <div class="min-w-0 flex-1 space-y-1.5">
                                            <div class="flex flex-wrap items-center gap-2">
                                                @if (!string.IsNullOrWhiteSpace(document.Code))
                                                {
                                                    <span class="public-label-text rounded bg-slate-100 px-2 py-0.5 font-bold uppercase tracking-wider text-slate-700">@document.Code</span>
                                                }
                                                @if (document.IssuedDate.HasValue)
                                                {
                                                    <span class="public-meta-text text-slate-500">@document.IssuedDate.Value.ToString("dd/MM/yyyy")</span>
                                                }
                                            </div>
                                            <h3 class="public-list-title font-bold text-slate-900">
                                                <a href="@documentUrl" class="hover:text-military-green">@document.Title</a>
                                            </h3>
                                            @if (!string.IsNullOrWhiteSpace(document.Summary))
                                            {
                                                <p class="public-body-text line-clamp-2 text-slate-600">@document.Summary</p>
                                            }
                                        </div>
                                        <a href="@documentUrl" class="public-control-text inline-flex h-9 items-center rounded-lg border border-slate-200 px-3 font-semibold text-slate-600 transition hover:border-military-green hover:text-military-green">Xem</a>
                                    </div>
                                </article>
                            }
                        </div>
                    }

                    @if (Model.DocumentTotalPages > 1)
                    {
                        <div class="flex flex-wrap items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white p-3 shadow-sm">
                            @if (Model.DocumentPage > 1)
                            {
                                <a href="@BuildSearchUrl(type: Model.Type, documentPage: Model.DocumentPage - 1)" class="public-control-text inline-flex h-9 items-center rounded-lg border border-slate-200 px-3 font-semibold text-slate-600 transition hover:border-military-green hover:text-military-green">Trước</a>
                            }
                            @for (var pageNumber = 1; pageNumber <= Model.DocumentTotalPages; pageNumber++)
                            {
                                var pageClass = pageNumber == Model.DocumentPage
                                    ? "public-control-text inline-flex h-9 min-w-[36px] items-center justify-center rounded-lg bg-military-green px-3 font-bold text-white"
                                    : "public-control-text inline-flex h-9 min-w-[36px] items-center justify-center rounded-lg border border-slate-200 px-3 font-semibold text-slate-600 transition hover:border-military-green hover:text-military-green";
                                <a href="@BuildSearchUrl(type: Model.Type, documentPage: pageNumber)" class="@pageClass">@pageNumber</a>
                            }
                            @if (Model.DocumentPage < Model.DocumentTotalPages)
                            {
                                <a href="@BuildSearchUrl(type: Model.Type, documentPage: Model.DocumentPage + 1)" class="public-control-text inline-flex h-9 items-center rounded-lg border border-slate-200 px-3 font-semibold text-slate-600 transition hover:border-military-green hover:text-military-green">Sau</a>
                            }
                        </div>
                    }
                </section>
            }

            @if (showUnitsSection)
            {
                <section class="space-y-4">
                    <div class="flex items-center justify-between gap-4">
                        <h2 class="public-section-title font-black tracking-tight text-slate-900">Đơn vị (@Model.UnitTotalCount)</h2>
                        @if (Model.ShowAllSections && Model.UnitTotalCount > Model.UnitPageSize)
                        {
                            <a href="@BuildSearchUrl(type: "units", unitPage: 1)" class="public-control-text font-semibold text-military-green hover:underline">Xem tất cả</a>
                        }
                    </div>

                    @if (!Model.UnitResults.Any())
                    {
                        <div class="public-body-text rounded-xl border border-dashed border-slate-300 bg-slate-50 px-6 py-8 text-slate-600">Không có đơn vị phù hợp.</div>
                    }
                    else
                    {
                        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
                            @foreach (var unit in Model.UnitResults)
                            {
                                var unitUrl = !string.IsNullOrWhiteSpace(unit.Url)
                                    ? unit.Url
                                    : await NopUrl.RouteGenericUrlAsync<Vendor>(new { SeName = unit.SeName });

                                <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:shadow-md">
                                    <div class="flex items-start gap-3">
                                        <span class="material-symbols-outlined mt-0.5 text-military-green">corporate_fare</span>
                                        <div class="min-w-0 flex-1">
                                            <h3 class="public-list-title font-bold text-slate-900 line-clamp-2">
                                                <a href="@unitUrl" class="hover:text-military-green">@unit.Name</a>
                                            </h3>
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    }

                    @if (Model.UnitTotalPages > 1)
                    {
                        <div class="flex flex-wrap items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white p-3 shadow-sm">
                            @if (Model.UnitPage > 1)
                            {
                                <a href="@BuildSearchUrl(type: Model.Type, unitPage: Model.UnitPage - 1)" class="public-control-text inline-flex h-9 items-center rounded-lg border border-slate-200 px-3 font-semibold text-slate-600 transition hover:border-military-green hover:text-military-green">Trước</a>
                            }
                            @for (var pageNumber = 1; pageNumber <= Model.UnitTotalPages; pageNumber++)
                            {
                                var pageClass = pageNumber == Model.UnitPage
                                    ? "public-control-text inline-flex h-9 min-w-[36px] items-center justify-center rounded-lg bg-military-green px-3 font-bold text-white"
                                    : "public-control-text inline-flex h-9 min-w-[36px] items-center justify-center rounded-lg border border-slate-200 px-3 font-semibold text-slate-600 transition hover:border-military-green hover:text-military-green";
                                <a href="@BuildSearchUrl(type: Model.Type, unitPage: pageNumber)" class="@pageClass">@pageNumber</a>
                            }
                            @if (Model.UnitPage < Model.UnitTotalPages)
                            {
                                <a href="@BuildSearchUrl(type: Model.Type, unitPage: Model.UnitPage + 1)" class="public-control-text inline-flex h-9 items-center rounded-lg border border-slate-200 px-3 font-semibold text-slate-600 transition hover:border-military-green hover:text-military-green">Sau</a>
                            }
                        </div>
                    }
                </section>
            }
        }
            </div>

            @if (showPopularSidebar)
            {
                <aside class="space-y-4 lg:sticky lg:top-36 lg:self-start">
                    @if (Model.ShowBlogsSection && Model.TopBlogTags.Any())
                    {
                        <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                            <h2 class="public-meta-text mb-3 font-bold uppercase tracking-wider text-slate-700">Tag tin tức phổ biến</h2>
                            <div class="flex flex-wrap gap-2">
                                @foreach (var tag in Model.TopBlogTags)
                                {
                                    <a href="@(Url.RouteUrl(NopRouteNames.Standard.BLOG_BY_TAG, new { tag }) ?? "#")" class="public-keyword-chip public-label-text">@tag</a>
                                }
                            </div>
                        </section>
                    }

                    @if (Model.ShowDocumentsSection && Model.TopDocumentKeywords.Any())
                    {
                        <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                            <h2 class="public-meta-text mb-3 font-bold uppercase tracking-wider text-slate-700">Từ khóa tài liệu phổ biến</h2>
                            <div class="flex flex-wrap gap-2">
                                @foreach (var keyword in Model.TopDocumentKeywords)
                                {
                                    <a href="/tai-lieu/tim-kiem?q=@keyword" class="public-keyword-chip public-label-text">@keyword</a>
                                }
                            </div>
                        </section>
                    }
                </aside>
            }
        </div>
    </div>
</div>
