@model BlogPostTagListModel
@if (Model.Tags.Count > 0)
{
    <ul class="tags flex flex-wrap gap-1.5">
        @foreach (var item in Model.Tags)
        {
            <li><a href="@Url.RouteUrl(NopRouteNames.Standard.BLOG_BY_TAG, new { tag = item.Name })" class="public-keyword-chip public-label-text">@item.Name</a></li>
        }
    </ul>
}
