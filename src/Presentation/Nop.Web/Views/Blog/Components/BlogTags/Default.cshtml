@model BlogPostTagListModel
@if (Model.Tags.Count > 0)
{
    <section class="block block-popular-blogtags overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm mb-4">
        <h2 class="title border-b border-slate-100 bg-slate-900 px-4 py-3 text-xs font-semibold uppercase tracking-[0.18em] text-military-gold">
            @T("Blog.TagCloud")
        </h2>
        <div class="listbox p-4">
            <ul class="tags flex flex-wrap gap-2">
                @foreach (var item in Model.Tags)
                {
                    <li><a href="@Url.RouteUrl(NopRouteNames.Standard.BLOG_BY_TAG, new { tag = item.Name })" style="font-size:@(Model.GetFontSize(item))%;" class="inline-flex items-center rounded-xl border border-slate-200 bg-slate-50 px-3 py-1.5 font-semibold text-slate-700 transition hover:border-military-green hover:text-military-green">@item.Name</a>
                    </li>
                }
            </ul>
        </div>
    </section>
}
