@model BlogPostTagListModel
@if (Model.Tags.Count > 0)
{
    <section class="block block-popular-blogtags overflow-hidden rounded-xl border border-outline-variant/30 bg-surface-container-lowest shadow-sm mb-4">
        <h2 class="title public-label-text border-b border-outline-variant/20 bg-slate-900 px-4 py-3 font-semibold uppercase tracking-widest text-amber-400">
            @T("Blog.TagCloud")
        </h2>
        <div class="listbox p-4">
            <ul class="tags flex flex-wrap gap-1.5">
                @foreach (var item in Model.Tags)
                {
                    <li><a href="@Url.RouteUrl(NopRouteNames.Standard.BLOG_BY_TAG, new { tag = item.Name })" class="inline-flex items-center rounded-full border border-outline-variant/40 bg-surface-container px-2.5 py-0.5 text-[11px] font-medium leading-5 text-on-surface-variant transition hover:border-military-green hover:text-military-green">@item.Name</a>
                    </li>
                }
            </ul>
        </div>
    </section>
}
