@model BlogPostListModel
@using Nop.Core.Domain.Blogs

@{
    Layout = "_ColumnsOne";

    NopHtml.AddTitleParts(T("PageTitle.Blog").Text);
    NopHtml.AppendPageCssClassParts("html-blog-page");

    var currentType = Model.PagingFilteringContext.PostTypeId;
    var newsListUrl = Url.RouteUrl(NopRouteNames.Standard.BLOG_NEWS);
    var documentListUrl = Url.RouteUrl(NopRouteNames.Standard.BLOG_DOCUMENTS);

    var posts = Model.BlogPosts.ToList();
    var newsPosts = posts.Where(post => post.PostTypeId == 0).ToList();
    var documentPosts = posts.Where(post => post.PostTypeId == 1).ToList();
    var latestDocumentPosts = Model.LatestDocumentPosts.Any() ? Model.LatestDocumentPosts.ToList() : documentPosts;
    var firstHeroLabel = currentType == 0 ? "Đơn vị đăng tin" : currentType == 1 ? "Đơn vị đăng văn bản" : "Tin tức";
    var firstHeroValue = currentType == 0 ? Model.NewsPostingUnitCount : currentType == 1 ? Model.DocumentPostingUnitCount : Model.TotalNewsCount;
    var secondHeroLabel = currentType == 1 ? "Văn bản" : currentType == 0 ? "Tin tức" : "Văn bản";
    var secondHeroValue = currentType == 1 ? Model.TotalDocumentCount : currentType == 0 ? Model.TotalNewsCount : Model.TotalDocumentCount;
    var dateFromQuery = Model.PagingFilteringContext.DateFrom?.ToString("yyyy-MM-dd") ?? string.Empty;
    var dateToQuery = Model.PagingFilteringContext.DateTo?.ToString("yyyy-MM-dd") ?? string.Empty;
    var selectedVendorId = Model.PagingFilteringContext.VendorId;
    var selectedAuthor = Model.PagingFilteringContext.Author?.Trim() ?? string.Empty;

    string buildListUrl(string routeName)
    {
        return Url.RouteUrl(routeName, new
        {
            Q = Model.PagingFilteringContext.Q,
            VendorId = selectedVendorId > 0 ? (int?)selectedVendorId : null,
            Author = !string.IsNullOrWhiteSpace(selectedAuthor) ? selectedAuthor : null,
            DateFrom = dateFromQuery,
            DateTo = dateToQuery
        }) ?? "#";
    }

    newsListUrl = buildListUrl(NopRouteNames.Standard.BLOG_NEWS);
    documentListUrl = buildListUrl(NopRouteNames.Standard.BLOG_DOCUMENTS);

    const string filterLinkBase = "inline-flex h-10 items-center rounded-lg px-4 public-control-text font-semibold transition";
    const string filterLinkInactive = "border border-sky-200 bg-white text-sky-700 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-800";
    const string filterLinkActive = "blog-filter-link--active border border-sky-500 bg-sky-50 text-sky-700";
}

<style>
    .blog-page .blog-filter-link--active {
        border-color: #38bdf8 !important;
        background: #e0f2fe !important;
        color: #0369a1 !important;
        opacity: 1 !important;
    }

    .blog-page .blog-filter-submit-button {
        border: 0 !important;
        background: #2e0001 !important;
        color: #ffffff !important;
        opacity: 1 !important;
    }

    .blog-page .blog-filter-submit-button:hover,
    .blog-page .blog-filter-submit-button:focus {
        background: #550005 !important;
        color: #ffffff !important;
    }

    .blog-page .blog-document-filter-grid .public-date-filter-field {
        min-width: 0;
    }

    .blog-document-table {
        table-layout: fixed;
    }

    .blog-document-table th,
    .blog-document-table td {
        vertical-align: middle;
    }

    .blog-document-actions {
        white-space: nowrap;
    }
</style>

@section Breadcrumb
{
    <nav class="public-breadcrumb flex flex-wrap items-center gap-2 text-slate-500" aria-label="Breadcrumb">
        <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="transition hover:text-military-green">Trang chủ</a>
        <span class="material-symbols-outlined text-sm text-slate-400">chevron_right</span>
        <span class="text-slate-700">Tin tức &amp; văn bản</span>
    </nav>
}

<div class="page blog-page">
    <div class="page-body w-full space-y-8">
        <section class="blog-hero-banner">
            <div class="blog-hero-content">
                <div class="blog-hero-copy space-y-1.5">
                    <h1 class="public-hero-title blog-hero-title font-black tracking-tight">Tin tức &amp; Văn bản hậu cần</h1>
                    <p class="public-hero-subtitle blog-hero-subtitle max-w-3xl">Cập nhật hoạt động đơn vị, văn bản pháp quy và thông báo mới từ hệ thống hậu cần - quân nhu.</p>
                </div>
                <div class="blog-hero-stats">
                    <div class="blog-hero-stat-card">
                        <p class="public-label-text blog-hero-stat-label uppercase tracking-[0.14em]">@firstHeroLabel</p>
                        <p class="public-stat-value blog-hero-stat-value mt-1 font-black">@firstHeroValue</p>
                    </div>
                    <div class="blog-hero-stat-card">
                        <p class="public-label-text blog-hero-stat-label uppercase tracking-[0.14em]">@secondHeroLabel</p>
                        <p class="public-stat-value blog-hero-stat-value mt-1 font-black">@secondHeroValue</p>
                    </div>
                </div>
            </div>
        </section>

        <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="flex flex-wrap items-center gap-2">
                <a href="@newsListUrl" class="@($"{filterLinkBase} {(currentType == 0 ? filterLinkActive : filterLinkInactive)}")">Tin tức</a>
                <a href="@documentListUrl" class="@($"{filterLinkBase} {(currentType == 1 ? filterLinkActive : filterLinkInactive)}")">Văn bản</a>
            </div>
            @if (!currentType.HasValue)
            {
                <form action="@Url.RouteUrl(NopRouteNames.General.BLOG)" method="get" class="flex min-w-[260px] items-center gap-2">
                    <input type="hidden" name="Q" value="@Model.PagingFilteringContext.Q" />
                    <input type="hidden" name="Author" value="@selectedAuthor" />
                    <input type="hidden" name="DateFrom" value="@dateFromQuery" />
                    <input type="hidden" name="DateTo" value="@dateToQuery" />
                    <select name="VendorId" asp-items="Model.AvailableVendors" class="public-control-text h-10 w-full rounded-lg border border-slate-200 bg-white px-3 font-semibold text-slate-700 outline-none transition focus:border-military-green" onchange="this.form.submit()"></select>
                </form>
            }
        </div>

        @if (!currentType.HasValue)
        {
            var featuredNews = newsPosts.FirstOrDefault();
            var secondaryNews = newsPosts.Skip(1).Take(4).ToList();
            <div class="grid grid-cols-1 gap-8 xl:grid-cols-12">
                <section class="xl:col-span-7 space-y-4">
                    <div class="flex items-center justify-between">
                        <h3 class="public-card-title font-bold text-slate-900">Tin tức hoạt động</h3>
                        <a href="@newsListUrl" class="public-control-text home-section-action">Xem tất cả</a>
                    </div>
                    @if (featuredNews != null)
                    {
                        var featuredUrl = Url.RouteUrl(NopRouteNames.Standard.BLOG_NEWS_POST, new { SeName = featuredNews.SeName }) ?? await NopUrl.RouteGenericUrlAsync<BlogPost>(new { SeName = featuredNews.SeName });
                        var featuredAuthor = string.IsNullOrWhiteSpace(featuredNews.AuthorName) ? "Ban biên tập" : featuredNews.AuthorName;
                        <article class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
                            <a href="@featuredUrl" class="flex aspect-[21/9] items-center justify-center overflow-hidden bg-slate-100">
                                @if (!string.IsNullOrWhiteSpace(featuredNews.ThumbnailImageUrl))
                                {
                                    <img src="@featuredNews.ThumbnailImageUrl" alt="@featuredNews.Title" class="max-h-full max-w-full object-contain transition duration-500 hover:scale-105" />
                                }
                                else
                                {
                                    <div class="public-label-text flex h-full w-full items-center justify-center bg-gradient-to-br from-slate-100 to-slate-200 font-semibold uppercase tracking-[0.12em] text-slate-500">Ảnh tin tức</div>
                                }
                            </a>
                            <div class="p-5">
                                <div class="public-meta-text mb-2 flex flex-wrap items-center gap-3 text-slate-500">
                                    <span>@featuredNews.CreatedOn.ToString("dd/MM/yyyy")</span>
                                    <span class="h-1 w-1 rounded-full bg-slate-300"></span>
                                    <span>@featuredAuthor</span>
                                    <span class="h-1 w-1 rounded-full bg-slate-300"></span>
                                    <span>@featuredNews.ViewCount lượt xem</span>
                                </div>
                                <h4 class="public-section-title font-bold text-slate-900"><a href="@featuredUrl" class="hover:text-military-green">@featuredNews.Title</a></h4>
                                <div class="public-body-text mt-3 line-clamp-3 text-slate-600">@Html.Raw(!string.IsNullOrWhiteSpace(featuredNews.BodyOverview) ? featuredNews.BodyOverview : featuredNews.Body)</div>
                            </div>
                        </article>
                    }
                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        @foreach (var item in secondaryNews)
                        {
                            var postUrl = Url.RouteUrl(NopRouteNames.Standard.BLOG_NEWS_POST, new { SeName = item.SeName }) ?? await NopUrl.RouteGenericUrlAsync<BlogPost>(new { SeName = item.SeName });
                            <a href="@postUrl" class="flex gap-3 rounded-xl border border-slate-200 bg-white p-3 shadow-sm transition hover:border-military-green hover:shadow-md">
                                <div class="h-20 w-20 shrink-0 overflow-hidden rounded-lg bg-slate-100">
                                    @if (!string.IsNullOrWhiteSpace(item.ThumbnailImageUrl))
                                    {
                                        <img src="@item.ThumbnailImageUrl" alt="@item.Title" class="h-full w-full object-cover object-center" />
                                    }
                                    else
                                    {
                                        <div class="public-label-text flex h-full w-full items-center justify-center font-semibold uppercase text-slate-400">Ảnh</div>
                                    }
                                </div>
                                <div class="min-w-0">
                                    <h5 class="public-list-title line-clamp-2 font-bold text-slate-900">@item.Title</h5>
                                    <p class="public-label-text mt-2 text-slate-500">@item.CreatedOn.ToString("dd/MM/yyyy") · @item.ViewCount lượt xem</p>
                                </div>
                            </a>
                        }
                    </div>
                </section>

                <section class="xl:col-span-5 space-y-4">
                    <div class="flex items-center justify-between">
                        <h3 class="public-card-title font-bold text-slate-900">Văn bản mới nhất</h3>
                        <a href="@documentListUrl" class="public-control-text home-section-action">Xem tất cả</a>
                    </div>
                    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
                        <div class="divide-y divide-slate-100">
                            @foreach (var item in latestDocumentPosts.Take(8))
                            {
                                var postUrl = Url.RouteUrl(NopRouteNames.Standard.BLOG_DOCUMENT_POST, new { SeName = item.SeName }) ?? await NopUrl.RouteGenericUrlAsync<BlogPost>(new { SeName = item.SeName });
                                var pdfUrl = item.PdfDownloadGuid.HasValue ? Url.RouteUrl(NopRouteNames.Standard.DOWNLOAD_GET_FILE_UPLOAD, new { downloadId = item.PdfDownloadGuid.Value }) : null;
                                var docUrl = item.DocDownloadGuid.HasValue ? Url.RouteUrl(NopRouteNames.Standard.DOWNLOAD_GET_FILE_UPLOAD, new { downloadId = item.DocDownloadGuid.Value }) : null;

                                <div class="p-4">
                                    <a href="@postUrl" class="public-list-title line-clamp-2 font-semibold text-slate-800 hover:text-military-green">@item.Title</a>
                                    <div class="mt-3 flex items-center justify-between gap-3">
                                        <span class="public-label-text text-slate-500">@item.CreatedOn.ToString("dd/MM/yyyy") · @item.ViewCount lượt xem</span>
                                        <div class="flex items-center gap-2">
                                            <a href="@postUrl" class="public-label-text inline-flex h-8 items-center rounded-lg border border-slate-200 px-2.5 font-semibold text-slate-600 hover:border-military-green hover:text-military-green">Xem</a>
                                            @if (!string.IsNullOrWhiteSpace(pdfUrl))
                                            {
                                                <a href="@pdfUrl" target="_blank" rel="noopener" class="public-label-text inline-flex h-8 items-center rounded-lg border border-slate-200 px-2.5 font-semibold text-slate-600 hover:border-red-300 hover:text-red-600">PDF</a>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(docUrl))
                                            {
                                                <a href="@docUrl" target="_blank" rel="noopener" class="public-label-text inline-flex h-8 items-center rounded-lg border border-slate-200 px-2.5 font-semibold text-slate-600 hover:border-blue-300 hover:text-blue-600">DOC</a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </section>
            </div>
        }
        else if (currentType == 0)
        {
            <div class="grid grid-cols-1 gap-8 xl:grid-cols-12">
                <aside class="xl:col-span-3 space-y-4">
                    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                        <h3 class="public-meta-text mb-3 font-bold uppercase tracking-wider text-slate-700">Từ khóa</h3>
                        <form asp-route="@NopRouteNames.Standard.BLOG_NEWS" method="get">
                            <input name="Q" value="@Model.PagingFilteringContext.Q" class="public-control-text w-full rounded-lg border border-slate-200 px-3 py-2" placeholder="Nhập từ khóa..." type="text" />
                            <div class="mt-3 grid grid-cols-1 gap-2">
                                <select name="VendorId" asp-items="Model.AvailableVendors" class="public-control-text w-full rounded-lg border border-slate-200 px-3 py-2 font-semibold text-slate-700"></select>
                                <select name="Author" asp-items="Model.AvailableAuthors" class="public-control-text w-full rounded-lg border border-slate-200 px-3 py-2 font-semibold text-slate-700"></select>
                                <label class="public-date-filter-field">
                                    <span class="public-date-filter-label">Từ ngày</span>
                                    <input name="DateFrom" value="@dateFromQuery" class="public-date-filter-input public-control-text w-full rounded-lg border border-slate-200 px-3 py-2" aria-label="Từ ngày" title="Từ ngày" type="date" />
                                </label>
                                <label class="public-date-filter-field">
                                    <span class="public-date-filter-label">Đến ngày</span>
                                    <input name="DateTo" value="@dateToQuery" class="public-date-filter-input public-control-text w-full rounded-lg border border-slate-200 px-3 py-2" aria-label="Đến ngày" title="Đến ngày" type="date" />
                                </label>
                                <button type="submit" class="blog-filter-submit-button public-control-text inline-flex h-10 items-center justify-center rounded-lg px-4 font-semibold">Lọc</button>
                            </div>
                        </form>
                    </div>
                    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                        <h3 class="public-meta-text mb-3 font-bold uppercase tracking-wider text-slate-700">Từ khóa phổ biến</h3>
                        @await Component.InvokeAsync(typeof(BlogTagsViewComponent))
                    </div>
                </aside>

                <section class="xl:col-span-9 space-y-5">
                    @foreach (var item in posts)
                    {
                        var postUrl = Url.RouteUrl(NopRouteNames.Standard.BLOG_NEWS_POST, new { SeName = item.SeName }) ?? await NopUrl.RouteGenericUrlAsync<BlogPost>(new { SeName = item.SeName });
                        var author = string.IsNullOrWhiteSpace(item.AuthorName) ? "Ban biên tập" : item.AuthorName;
                        <article class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md">
                            <div class="flex flex-col md:flex-row">
                                <a href="@postUrl" class="md:w-72 h-48 shrink-0 overflow-hidden bg-slate-100">
                                    @if (!string.IsNullOrWhiteSpace(item.ThumbnailImageUrl))
                                    {
                                        <img src="@item.ThumbnailImageUrl" alt="@item.Title" class="h-full w-full object-cover object-center transition duration-500 hover:scale-105" />
                                    }
                                    else
                                    {
                                        <div class="public-label-text flex h-full w-full items-center justify-center font-semibold uppercase text-slate-500">Ảnh tin tức</div>
                                    }
                                </a>
                                <div class="flex-1 p-5">
                                    <div class="public-meta-text mb-2 flex flex-wrap items-center gap-3 text-slate-500">
                                        <span>@item.CreatedOn.ToString("dd/MM/yyyy")</span>
                                        <span class="h-1 w-1 rounded-full bg-slate-300"></span>
                                        <span>@author</span>
                                        <span class="h-1 w-1 rounded-full bg-slate-300"></span>
                                        <span>@item.ViewCount lượt xem</span>
                                    </div>
                                    <h3 class="public-card-title font-bold text-slate-900"><a href="@postUrl" class="hover:text-military-green">@item.Title</a></h3>
                                    <div class="public-body-text mt-3 line-clamp-3 text-slate-600">@Html.Raw(!string.IsNullOrWhiteSpace(item.BodyOverview) ? item.BodyOverview : item.Body)</div>
                                </div>
                            </div>
                        </article>
                    }

                    @{
                        var pager = Html.Pager(Model.PagingFilteringContext).QueryParam("pagenumber");
                    }
                    @if (!(await pager.IsEmpty()))
                    {
                        <div class="pager rounded-xl border border-slate-200 bg-white p-3 shadow-sm">@pager</div>
                    }
                </section>
            </div>
        }
        else
        {
            <div class="space-y-5">
                <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                    <form asp-route="@NopRouteNames.Standard.BLOG_DOCUMENTS" method="get" class="blog-document-filter-grid grid min-w-0 grid-cols-1 gap-2 lg:grid-cols-[minmax(0,36%)_repeat(4,minmax(0,16%))]">
                        <input name="Q" value="@Model.PagingFilteringContext.Q" class="public-control-text h-10 min-w-0 w-full rounded-lg border border-slate-200 px-3 py-2" placeholder="Tìm theo tiêu đề văn bản..." type="text" />
                        <select name="VendorId" asp-items="Model.AvailableVendors" class="public-control-text h-10 min-w-0 w-full rounded-lg border border-slate-200 bg-white px-3 font-semibold text-slate-700 outline-none transition focus:border-military-green" onchange="this.form.submit()"></select>
                        <select name="Author" asp-items="Model.AvailableAuthors" class="public-control-text h-10 min-w-0 w-full rounded-lg border border-slate-200 bg-white px-3 font-semibold text-slate-700 outline-none transition focus:border-military-green" onchange="this.form.submit()"></select>
                        <label class="public-date-filter-field">
                            <span class="public-date-filter-label">Từ ngày</span>
                            <input name="DateFrom" value="@dateFromQuery" class="public-date-filter-input public-control-text h-10 min-w-0 w-full rounded-lg border border-slate-200 px-3 py-2" aria-label="Từ ngày" title="Từ ngày" type="date" onchange="this.form.submit()" />
                        </label>
                        <label class="public-date-filter-field">
                            <span class="public-date-filter-label">Đến ngày</span>
                            <input name="DateTo" value="@dateToQuery" class="public-date-filter-input public-control-text h-10 min-w-0 w-full rounded-lg border border-slate-200 px-3 py-2" aria-label="Đến ngày" title="Đến ngày" type="date" onchange="this.form.submit()" />
                        </label>
                    </form>
                </div>

                <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
                    <div class="overflow-x-auto">
                        <table class="blog-document-table w-full min-w-[960px]">
                            <colgroup>
                                <col style="width: 12%" />
                                <col style="width: 43%" />
                                <col style="width: 20%" />
                                <col style="width: 10%" />
                                <col style="width: 15%" />
                            </colgroup>
                            <thead>
                                <tr class="public-label-text border-b border-slate-200 bg-slate-50 text-left uppercase tracking-wider text-slate-500">
                                    <th class="px-5 py-4">Ngày</th>
                                    <th class="px-5 py-4">Tên văn bản</th>
                                    <th class="px-5 py-4">Tác giả</th>
                                    <th class="px-5 py-4 text-center">Lượt xem</th>
                                    <th class="px-5 py-4 text-center">Xem / Tải xuống</th>
                                </tr>
                            </thead>
                            <tbody class="public-body-text divide-y divide-slate-100">
                                @foreach (var item in posts)
                                {
                                    var postUrl = Url.RouteUrl(NopRouteNames.Standard.BLOG_DOCUMENT_POST, new { SeName = item.SeName }) ?? await NopUrl.RouteGenericUrlAsync<BlogPost>(new { SeName = item.SeName });
                                    var author = string.IsNullOrWhiteSpace(item.AuthorName) ? "Ban hành nội bộ" : item.AuthorName;
                                    var pdfUrl = item.PdfDownloadGuid.HasValue ? Url.RouteUrl(NopRouteNames.Standard.DOWNLOAD_GET_FILE_UPLOAD, new { downloadId = item.PdfDownloadGuid.Value }) : null;
                                    var docUrl = item.DocDownloadGuid.HasValue ? Url.RouteUrl(NopRouteNames.Standard.DOWNLOAD_GET_FILE_UPLOAD, new { downloadId = item.DocDownloadGuid.Value }) : null;
                                    <tr class="hover:bg-slate-50">
                                        <td class="px-5 py-4 text-slate-600">@item.CreatedOn.ToString("dd/MM/yyyy")</td>
                                        <td class="px-5 py-4">
                                            <a href="@postUrl" class="public-list-title font-semibold text-slate-800 hover:text-military-green">@item.Title</a>
                                        </td>
                                        <td class="px-5 py-4 text-slate-600">@author</td>
                                        <td class="px-5 py-4 text-center text-slate-600">@item.ViewCount</td>
                                        <td class="blog-document-actions px-5 py-4">
                                            <div class="flex items-center justify-center gap-2 whitespace-nowrap">
                                                <a href="@postUrl" class="public-label-text inline-flex h-8 items-center rounded-lg border border-slate-200 px-2.5 font-semibold text-slate-600 hover:border-military-green hover:text-military-green">Xem</a>
                                                @if (!string.IsNullOrWhiteSpace(pdfUrl))
                                                {
                                                    <a href="@pdfUrl" target="_blank" rel="noopener" class="public-label-text inline-flex h-8 items-center rounded-lg border border-slate-200 px-2.5 font-semibold text-slate-600 hover:border-red-300 hover:text-red-600">PDF</a>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(docUrl))
                                                {
                                                    <a href="@docUrl" target="_blank" rel="noopener" class="public-label-text inline-flex h-8 items-center rounded-lg border border-slate-200 px-2.5 font-semibold text-slate-600 hover:border-blue-300 hover:text-blue-600">DOC</a>
                                                }
                                                @if (string.IsNullOrWhiteSpace(pdfUrl) && string.IsNullOrWhiteSpace(docUrl))
                                                {
                                                    <span class="public-label-text inline-flex h-8 items-center rounded-lg bg-slate-100 px-2.5 font-semibold text-slate-400">Chưa có file</span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @{
                    var pager = Html.Pager(Model.PagingFilteringContext).QueryParam("pagenumber");
                }
                @if (!(await pager.IsEmpty()))
                {
                    <div class="pager rounded-xl border border-slate-200 bg-white p-3 shadow-sm">@pager</div>
                }
            </div>
        }
    </div>
</div>
