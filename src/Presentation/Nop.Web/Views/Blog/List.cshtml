@model BlogPostListModel
@using Nop.Core.Domain.Blogs

@{
    Layout = "_ColumnsTwo";

    NopHtml.AddTitleParts(T("PageTitle.Blog").Text);
    NopHtml.AppendPageCssClassParts("html-blog-page");

    var currentType = Model.PagingFilteringContext.PostTypeId;
    var newsListUrl = Url.RouteUrl(NopRouteNames.Standard.BLOG_NEWS);
    var documentListUrl = Url.RouteUrl(NopRouteNames.Standard.BLOG_DOCUMENTS);
    var allListUrl = Url.RouteUrl(NopRouteNames.General.BLOG);

    var pageTitle = string.Empty;
    if (string.IsNullOrEmpty(Model.PagingFilteringContext.Tag))
    {
        if (currentType.HasValue)
        {
            pageTitle = currentType.Value == 1 ? "Văn bản" : "Tin tức";
        }
        else if (Model.PagingFilteringContext.GetParsedMonth().HasValue)
        {
            pageTitle = string.Format(T("Blog.FilteredByMonth").Text,
                Model.PagingFilteringContext.GetParsedMonth().Value.Year,
                Model.PagingFilteringContext.GetParsedMonth().Value.ToString("MMMM"));
        }
        else
        {
            pageTitle = T("Blog").Text;
        }
    }
    else
    {
        pageTitle = string.Format(T("Blog.TaggedWith").Text, Model.PagingFilteringContext.Tag);
    }
}

@section left {
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.LeftSideColumnBlogBefore, additionalData = Model })
    @await Component.InvokeAsync(typeof(BlogMonthsViewComponent))
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.LeftSideColumnAfterBlogArchive, additionalData = Model })
    @await Component.InvokeAsync(typeof(BlogTagsViewComponent))
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.LeftSideColumnBlogAfter, additionalData = Model })
}

<div class="page blog-page">
    <div class="mb-8">
        <h2 class="text-2xl font-bold tracking-tight text-on-surface">@pageTitle</h2>
        <div class="mt-1 flex items-center gap-2">
            <span class="h-1 w-12 rounded-full bg-military-green"></span>
            <p class="text-sm font-medium text-on-surface-variant">
                @if (currentType == 1)
                {
                    @:Kho văn bản nội bộ được quản lý trong blog
                }
                else if (currentType == 0)
                {
                    @:Cập nhật tin tức và thông báo mới nhất
                }
                else
                {
                    @:Hệ thống blog hợp nhất cho tin tức và văn bản
                }
            </p>
        </div>
        <div class="mt-4 flex flex-wrap gap-2">
            <a href="@allListUrl" class="@(currentType.HasValue ? "inline-flex items-center gap-2 rounded-lg border border-outline-variant/40 bg-surface-container-lowest px-4 py-2 text-sm font-semibold text-on-surface-variant transition hover:bg-surface-container" : "inline-flex items-center gap-2 rounded-lg bg-military-green px-4 py-2 text-sm font-bold text-white shadow-sm transition")">Tất cả</a>
            <a href="@newsListUrl" class="@(currentType == 0 ? "inline-flex items-center gap-2 rounded-lg bg-military-green px-4 py-2 text-sm font-bold text-white shadow-sm transition" : "inline-flex items-center gap-2 rounded-lg border border-outline-variant/40 bg-surface-container-lowest px-4 py-2 text-sm font-semibold text-on-surface-variant transition hover:bg-surface-container")">Tin tức</a>
            <a href="@documentListUrl" class="@(currentType == 1 ? "inline-flex items-center gap-2 rounded-lg bg-military-green px-4 py-2 text-sm font-bold text-white shadow-sm transition" : "inline-flex items-center gap-2 rounded-lg border border-outline-variant/40 bg-surface-container-lowest px-4 py-2 text-sm font-semibold text-on-surface-variant transition hover:bg-surface-container")">Văn bản</a>
        </div>
    </div>

    <div class="page-body">
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BlogListPageBeforePosts, additionalData = Model })

        <div class="blog-posts space-y-4">
            @foreach (var item in Model.BlogPosts)
            {
                var postRouteName = item.PostTypeId == 1 ? NopRouteNames.Standard.BLOG_DOCUMENT_POST : NopRouteNames.Standard.BLOG_NEWS_POST;
                var postUrl = Url.RouteUrl(postRouteName, new { SeName = item.SeName }) ?? await NopUrl.RouteGenericUrlAsync<BlogPost>(new { SeName = item.SeName });
                var commentsUrl = $"{postUrl}#comments";
                var typeLabel = item.PostTypeId == 1 ? "Văn bản" : "Tin tức";
                var typeClass = item.PostTypeId == 1
                    ? "bg-amber-50 text-amber-700 border border-amber-200"
                    : "bg-red-50 text-red-700 border border-red-100";

                @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BlogListPageBeforePost, additionalData = item })
                <article class="post group rounded-xl border border-outline-variant/30 bg-surface-container-lowest p-5 shadow-sm transition hover:shadow-md">
                    <div class="mb-3 flex flex-wrap items-center gap-2">
                        <span class="rounded px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider @typeClass">@typeLabel</span>
                        <time datetime="@item.CreatedOn.ToString("yyyy-MM-dd")" class="text-xs text-on-surface-variant">
                            @item.CreatedOn.ToString("dd/MM/yyyy")
                        </time>
                    </div>

                    <h2 class="mb-2 text-base font-bold leading-snug text-on-surface transition group-hover:text-military-green">
                        <a href="@postUrl">@item.Title</a>
                    </h2>

                    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BlogListPageBeforePostBody, additionalData = item })
                    <div class="post-body mt-2 line-clamp-3 text-sm leading-relaxed text-on-surface-variant">
                        @Html.Raw(!string.IsNullOrEmpty(item.BodyOverview) ? item.BodyOverview : item.Body)
                    </div>
                    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BlogListPageAfterPostBody, additionalData = item })

                    <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-outline-variant/20 pt-3">
                        @if (item.Tags.Count > 0)
                        {
                            <div class="tags flex flex-wrap items-center gap-1.5">
                                @for (var i = 0; i < item.Tags.Count; i++)
                                {
                                    var tag = item.Tags[i];
                                    <a href="@Url.RouteUrl(NopRouteNames.Standard.BLOG_BY_TAG, new { tag = tag })" class="inline-flex items-center rounded-full border border-outline-variant/40 bg-surface-container px-2.5 py-0.5 text-xs font-medium text-on-surface-variant transition hover:border-military-green hover:text-military-green">@tag</a>
                                }
                            </div>
                        }

                        <div class="buttons flex items-center gap-2">
                            @if (item.AllowComments)
                            {
                                <a href="@commentsUrl" class="read-comments inline-flex h-8 items-center justify-center rounded-lg border border-outline-variant/40 px-3 text-xs font-semibold text-on-surface-variant transition hover:border-military-green hover:text-military-green">
                                    @string.Format(T("Blog.CommentsLink").Text, item.NumberOfComments)
                                </a>
                            }
                            <a href="@postUrl" class="read-more inline-flex h-8 items-center justify-center rounded-lg bg-military-green px-4 text-xs font-semibold text-white transition hover:bg-military-green/90">
                                @T("Blog.MoreInfo")
                            </a>
                        </div>
                    </div>

                    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BlogListPageInsidePost, additionalData = item })
                </article>
                @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BlogListPageAfterPost, additionalData = item })
            }
        </div>

        @{
            var pager = Html.Pager(Model.PagingFilteringContext).QueryParam("pagenumber");
        }
        @if (!(await pager.IsEmpty()))
        {
            <div class="pager mt-6 rounded-xl border border-outline-variant/30 bg-surface-container-lowest p-3 shadow-sm">
                @pager
            </div>
        }

        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.BlogListPageAfterPosts, additionalData = Model })
    </div>
</div>
