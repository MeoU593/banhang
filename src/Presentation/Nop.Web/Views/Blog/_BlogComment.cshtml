@inject Nop.Services.Html.IHtmlFormatter htmlFormatter
@model BlogCommentModel

@{
    var blogPostId = ViewData["BlogPostId"] as int? ?? 0;
    var canReply = ViewData["CanReply"] as bool? ?? false;
    var allowCommenting = ViewData["AllowCommenting"] as bool? ?? false;
    var customerInitial = !string.IsNullOrWhiteSpace(Model.CustomerName)
        ? Model.CustomerName.Substring(0, 1).ToUpperInvariant()
        : "?";
}

<article class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm" id="comment@Model.Id">
    <div class="flex items-start gap-3">
        @if (!string.IsNullOrWhiteSpace(Model.CustomerAvatarUrl))
        {
            <img src="@Model.CustomerAvatarUrl" alt="avatar" class="h-10 w-10 rounded-full object-cover" />
        }
        else
        {
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-800 text-xs font-bold text-amber-300">@customerInitial</div>
        }

        <div class="min-w-0 flex-1 space-y-3">
            <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="flex flex-wrap items-center gap-2 text-xs">
                    <span class="font-bold text-slate-900">
                        @if (Model.AllowViewingProfiles)
                        {
                            @Html.RouteLink(Model.CustomerName, NopRouteNames.Standard.CUSTOMER_PROFILE, new { id = Model.CustomerId }, new { @class = "hover:text-military-green" })
                        }
                        else
                        {
                            @Model.CustomerName
                        }
                    </span>
                    @if (!string.IsNullOrWhiteSpace(Model.Rank))
                    {
                        <span class="rounded bg-slate-100 px-2 py-0.5 font-semibold text-slate-600">@Model.Rank</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.UnitName))
                    {
                        <span class="rounded bg-slate-100 px-2 py-0.5 text-slate-500">@Model.UnitName</span>
                    }
                    <span class="text-slate-400">@Model.CreatedOn.ToString("g")</span>
                </div>

                <a class="inline-flex h-7 items-center justify-center rounded-md border border-slate-200 bg-white px-2.5 text-xs font-semibold text-slate-700 transition hover:border-military-green hover:text-military-green" href="#comment@Model.Id">#@Model.Id</a>
            </div>

            <div class="prose prose-slate w-full max-w-full break-words rounded-xl border border-slate-100 bg-slate-50 px-4 py-3 text-sm leading-7 text-slate-700" style="overflow-wrap:anywhere;word-break:break-word;">
                @Html.Raw(htmlFormatter.FormatText(Model.CommentText, false, true, false, false, false, false))
            </div>

            @if (canReply)
            {
                <div class="mt-3 border-t border-slate-100 pt-3">
                    <a href="#"
                       class="inline-flex h-8 items-center justify-center rounded-lg border px-3 text-xs font-semibold shadow-sm transition hover:brightness-110"
                       style="background-color:#2f5e2b;border-color:#2f5e2b;color:#ffffff;text-decoration:none;"
                       data-blog-reply-target="blog-reply-form-@Model.Id">Trả lời</a>
                </div>

                <form id="blog-reply-form-@Model.Id"
                      asp-controller="Blog"
                      asp-action="BlogCommentAdd"
                      asp-route-blogpostid="@blogPostId"
                      method="post"
                      class="mt-3 rounded-lg border border-slate-200 bg-slate-50 p-3"
                      style="display:none;">
                    <input type="hidden" name="AddNewComment.ReplyToCommentId" value="@Model.Id" />

                    <label class="mb-2 block text-xs font-semibold uppercase tracking-[0.12em] text-slate-600">Trả lời @Model.CustomerName</label>
                    @if (allowCommenting)
                    {
                        <textarea name="AddNewComment.CommentText" rows="3" required
                                  class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm leading-6 text-slate-700 outline-none transition focus:border-military-green"></textarea>
                    }
                    else
                    {
                        <textarea name="AddNewComment.CommentText" rows="3" required disabled
                                  class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm leading-6 text-slate-700 outline-none transition focus:border-military-green"></textarea>
                    }

                    <div class="mt-2 flex items-center justify-end gap-2">
                        <button type="button"
                                class="inline-flex h-8 items-center justify-center rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-700"
                                data-blog-reply-cancel="blog-reply-form-@Model.Id">Hủy</button>
                        <button type="submit"
                                class="inline-flex h-8 items-center justify-center rounded-lg border px-3 text-xs font-semibold shadow-sm"
                                style="background-color:#2f5e2b;border-color:#2f5e2b;color:#ffffff;">Gửi trả lời</button>
                    </div>
                </form>
            }
        </div>
    </div>
</article>
