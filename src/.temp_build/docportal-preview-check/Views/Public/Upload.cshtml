@model Nop.Plugin.Misc.DocumentPortal.Models.Public.DocumentUploadModel

@{
    Layout = "_ColumnsOne";
}

<div class="page document-upload-page">
    <div class="page-body">
        <div class="mx-auto max-w-2xl space-y-6">

            <nav class="flex items-center gap-2 text-xs text-slate-500">
                <a href="/tai-lieu" class="hover:text-military-green hover:underline">Kho tài liệu</a>
                <span class="material-symbols-outlined" style="font-size:14px">chevron_right</span>
                <span class="text-slate-700">Gửi tài liệu mới</span>
            </nav>

            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                <div class="border-b border-slate-100 px-6 py-5">
                    <h1 class="flex items-center gap-2 text-xl font-black text-slate-900">
                        <span class="material-symbols-outlined text-military-green" style="font-size:24px">upload_file</span>
                        Gửi tài liệu mới
                    </h1>
                    <p class="mt-1 text-sm text-slate-500">Tài liệu sẽ được kiểm duyệt trước khi xuất bản.</p>
                </div>

                <form method="post" action="/tai-lieu/upload" enctype="multipart/form-data" class="space-y-5 px-6 py-6">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="rounded-lg bg-red-50 p-4 text-sm text-red-700"></div>

                    <div class="space-y-1">
                        <label for="Title" class="block text-sm font-semibold text-slate-700">
                            Tiêu đề <span class="text-red-500">*</span>
                        </label>
                        <input type="text" id="Title" name="Title" value="@(Model.Title ?? "")"
                               class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-military-green/50 focus:bg-white focus:outline-none" />
                        <span asp-validation-for="Title" class="text-xs text-red-600"></span>
                    </div>

                    <div class="space-y-1">
                        <label for="Code" class="block text-sm font-semibold text-slate-700">Mã tài liệu</label>
                        <input type="text" id="Code" name="Code" value="@(Model.Code ?? "")"
                               placeholder="VD: CV-001/2024"
                               class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-military-green/50 focus:bg-white focus:outline-none" />
                    </div>

                    <div class="space-y-1">
                        <label for="Summary" class="block text-sm font-semibold text-slate-700">Tóm tắt</label>
                        <textarea id="Summary" name="Summary" rows="3"
                                  class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-military-green/50 focus:bg-white focus:outline-none">@(Model.Summary ?? "")</textarea>
                    </div>

                    <div class="grid gap-4 sm:grid-cols-2">
                        <div class="space-y-1">
                            <label for="DocumentCategoryId" class="block text-sm font-semibold text-slate-700">Danh mục</label>
                            <select id="DocumentCategoryId" name="DocumentCategoryId" asp-items="Model.AvailableCategories"
                                    class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:outline-none"></select>
                        </div>
                        <div class="space-y-1">
                            <label for="DocumentTypeId" class="block text-sm font-semibold text-slate-700">Loại tài liệu</label>
                            <select id="DocumentTypeId" name="DocumentTypeId" asp-items="Model.AvailableTypes"
                                    class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:outline-none"></select>
                        </div>
                    </div>

                    <div class="grid gap-4 sm:grid-cols-2">
                        <div class="space-y-1">
                            <label for="IssuerId" class="block text-sm font-semibold text-slate-700">Cơ quan ban hành</label>
                            <select id="IssuerId" name="IssuerId" asp-items="Model.AvailableIssuers"
                                    class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:outline-none"></select>
                        </div>
                        <div class="space-y-1">
                            <label for="IssuedDate" class="block text-sm font-semibold text-slate-700">Ngày ban hành</label>
                            <input type="date" id="IssuedDate" name="IssuedDate"
                                   value="@(Model.IssuedDate.HasValue ? Model.IssuedDate.Value.ToString("yyyy-MM-dd") : "")"
                                   class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-military-green/50 focus:bg-white focus:outline-none" />
                        </div>
                    </div>

                    <div class="grid gap-4 sm:grid-cols-2">
                        <div class="space-y-1">
                            <label for="AccessScopeId" class="block text-sm font-semibold text-slate-700">
                                Mức truy cập <span class="text-red-500">*</span>
                            </label>
                            <select id="AccessScopeId" name="AccessScopeId" asp-items="Model.AvailableAccessScopes"
                                     class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:outline-none"></select>
                            <span asp-validation-for="AccessScopeId" class="text-xs text-red-600"></span>
                            <p class="text-xs text-slate-500">Công khai: ai cũng xem/tải được. Nội bộ: cần đăng nhập để xem/tải.</p>
                        </div>
                    </div>

                    <div class="space-y-1">
                        <label for="File" class="block text-sm font-semibold text-slate-700">
                            File tài liệu <span class="text-red-500">*</span>
                        </label>
                        <div class="rounded-xl border-2 border-dashed border-slate-200 bg-slate-50 px-6 py-8 text-center transition hover:border-military-green/40">
                            <span class="material-symbols-outlined mb-2 text-4xl text-slate-300">cloud_upload</span>
                            <p class="text-sm text-slate-500">PDF, Word, Excel, ảnh...</p>
                            <input type="file" id="File" name="File" class="mt-3 text-sm text-slate-600" />
                        </div>
                        <span asp-validation-for="File" class="text-xs text-red-600"></span>
                    </div>

                    <div class="flex gap-3 border-t border-slate-100 pt-5">
                        <button type="submit"
                                class="inline-flex items-center gap-2 rounded-xl bg-military-green px-6 py-2.5 text-sm font-bold text-white shadow-md transition hover:bg-opacity-90">
                            <span class="material-symbols-outlined" style="font-size:18px">send</span>
                            Gửi tài liệu
                        </button>
                        <a href="/tai-lieu"
                           class="inline-flex items-center gap-2 rounded-xl border border-slate-200 px-6 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
                            Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
