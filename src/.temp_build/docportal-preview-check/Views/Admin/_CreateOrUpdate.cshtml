@model Nop.Plugin.Misc.DocumentPortal.Models.Admin.DocumentModel

<div class="row">
    <div class="col-md-9">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <nop-tabs id="document-tabs">
            <nop-tab asp-name="tab-general" asp-title="Thông tin chung" asp-default="true">
                <div class="card card-modern">
                    <div class="card-body">
                        <div class="form-group row">
                            <div class="col-md-3"><nop-label asp-for="Title" /></div>
                            <div class="col-md-9"><nop-editor asp-for="Title" /><span asp-validation-for="Title" class="text-danger"></span></div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3"><nop-label asp-for="Slug" /></div>
                            <div class="col-md-9"><nop-editor asp-for="Slug" /></div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3"><nop-label asp-for="Code" /></div>
                            <div class="col-md-9"><nop-editor asp-for="Code" /></div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3"><nop-label asp-for="Summary" /></div>
                            <div class="col-md-9"><nop-textarea asp-for="Summary" html-attributes="@(new { rows = "3" })" /></div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3"><nop-label asp-for="Content" /></div>
                            <div class="col-md-9"><nop-textarea asp-for="Content" html-attributes="@(new { rows = "8" })" /></div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3"><nop-label asp-for="Keywords" /></div>
                            <div class="col-md-9"><nop-editor asp-for="Keywords" /></div>
                        </div>
                    </div>
                </div>
            </nop-tab>

            <nop-tab asp-name="tab-classification" asp-title="Phân loại">
                <div class="card card-modern">
                    <div class="card-body">
                        <div class="form-group row">
                            <div class="col-md-3"><nop-label asp-for="DocumentCategoryId" /></div>
                            <div class="col-md-9"><nop-select asp-for="DocumentCategoryId" asp-items="Model.AvailableCategories" /></div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3"><nop-label asp-for="DocumentTypeId" /></div>
                            <div class="col-md-9"><nop-select asp-for="DocumentTypeId" asp-items="Model.AvailableTypes" /></div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3"><nop-label asp-for="IssuerId" /></div>
                            <div class="col-md-9"><nop-select asp-for="IssuerId" asp-items="Model.AvailableIssuers" /></div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3"><nop-label asp-for="IssuedDate" /></div>
                            <div class="col-md-9"><nop-editor asp-for="IssuedDate" /></div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3"><nop-label asp-for="EffectiveDate" /></div>
                            <div class="col-md-9"><nop-editor asp-for="EffectiveDate" /></div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3"><nop-label asp-for="DisplayOrder" /></div>
                            <div class="col-md-9"><nop-editor asp-for="DisplayOrder" /></div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3"><label>Đơn vị sở hữu</label></div>
                            <div class="col-md-9">
                                @if (Model.CanSelectOwnerVendor)
                                {
                                    <nop-select asp-for="OwnerVendorId" asp-items="Model.AvailableOwnerVendors" />
                                }
                                else
                                {
                                    <input type="hidden" asp-for="OwnerVendorId" />
                                    <div class="form-text">@(string.IsNullOrWhiteSpace(Model.OwnerVendorName) ? "Đơn vị hiện tại" : Model.OwnerVendorName)</div>
                                }
                                <span asp-validation-for="OwnerVendorId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </nop-tab>

            <nop-tab asp-name="tab-access" asp-title="File & Quyền truy cập">
                <div class="card card-modern">
                    <div class="card-body">
                        <div class="form-group row">
                            <div class="col-md-3"><nop-label asp-for="DownloadId" /></div>
                            <div class="col-md-9"><nop-editor asp-for="DownloadId" /></div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3"><nop-label asp-for="ThumbnailPictureId" /></div>
                            <div class="col-md-9"><nop-editor asp-for="ThumbnailPictureId" /></div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3"><nop-label asp-for="Published" /></div>
                            <div class="col-md-9"><nop-editor asp-for="Published" /></div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3"><nop-label asp-for="ShowOnHomepage" /></div>
                            <div class="col-md-9"><nop-editor asp-for="ShowOnHomepage" /></div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3"><label>Mức truy cập</label></div>
                            <div class="col-md-9"><nop-select asp-for="AccessScopeId" asp-items="Model.AvailableAccessScopes" /><span asp-validation-for="AccessScopeId" class="text-danger"></span></div>
                        </div>
                    </div>
                </div>
            </nop-tab>
        </nop-tabs>
    </div>

    <div class="col-md-3">
        <div class="card card-modern">
            <div class="card-header"><strong>Thống kê</strong></div>
            <div class="card-body">
                <div class="mb-2"><strong>Lượt xem:</strong> @Model.ViewCount</div>
                <div class="mb-2"><strong>Lượt tải:</strong> @Model.DownloadCount</div>
                @if (Model.CreatedOnUtc.HasValue)
                {
                    <div class="mb-2"><strong>Tạo lúc:</strong> @Model.CreatedOnUtc.Value.ToString("dd/MM/yyyy HH:mm")</div>
                }
                @if (Model.UpdatedOnUtc.HasValue)
                {
                    <div><strong>Cập nhật:</strong> @Model.UpdatedOnUtc.Value.ToString("dd/MM/yyyy HH:mm")</div>
                }
            </div>
        </div>
    </div>
</div>
