@model Nop.Plugin.Misc.DocumentPortal.Models.Admin.DocumentIssuerManageModel

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = Model.Id == 0 ? "Thêm cơ quan ban hành" : "Sửa cơ quan ban hành";
}

<div class="content-header clearfix">
    <h1 class="float-left">@ViewBag.PageTitle</h1>
</div>

<div class="card card-default">
    <div class="card-body">
        <form method="post">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group">
                <label asp-for="Name">Tên cơ quan ban hành</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description">Mô tả</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DisplayOrder">Thứ tự hiển thị</label>
                <input asp-for="DisplayOrder" class="form-control" />
                <span asp-validation-for="DisplayOrder" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Lưu</button>
            <a asp-action="List" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</div>
